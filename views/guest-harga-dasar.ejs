<%- include('partials/guest-header', {
  pageTitle: 'Harga Dasar',
  pageSubtitle: 'Pantau daftar harga dasar material pokok beserta status datanya. Halaman ini hanya menampilkan informasi, tanpa akses menambah, mengubah, atau menghapus.',
  active: 'harga'
}) %>
<%- include('partials/head') %>

<section class="card-grid">
  <div class="stat-card card-blue">
    <div class="card-header">
      <span class="card-title">Total Item Harga Dasar</span>
      <div class="icon-wrapper icon-blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
          <line x1="7" y1="15" x2="7.01" y2="15"></line>
          <line x1="12" y1="15" x2="12.01" y2="15"></line>
        </svg>
      </div>
    </div>
    <div class="card-body">
      <span class="card-value"><%= totalItem || 0 %></span>
      <span class="card-unit">Item</span>
    </div>
    <div class="card-footer">
      <span class="text-blue">Data Terbaru</span>
      <span>Harga Material</span>
    </div>
  </div>

  <div class="stat-card card-green">
    <div class="card-header">
      <span class="card-title">Status Ready</span>
      <div class="icon-wrapper icon-green">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>
    </div>
    <div class="card-body">
      <span class="card-value"><%= totalReady || 0 %></span>
      <span class="card-unit">Item</span>
    </div>
    <div class="card-footer">
      <span class="text-green">Siap Digunakan</span>
      <span>Status Valid</span>
    </div>
  </div>

  <div class="stat-card card-gold">
    <div class="card-header">
      <span class="card-title">Status Pending</span>
      <div class="icon-wrapper icon-gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
    </div>
    <div class="card-body">
      <span class="card-value"><%= totalPending || 0 %></span>
      <span class="card-unit">Item</span>
    </div>
    <div class="card-footer">
      <span class="text-orange">Menunggu Review</span>
      <span>Dalam Peninjauan</span>
    </div>
  </div>
</section>

<section class="main-box">
  <div class="box-header">
    <div class="box-title">Daftar Harga Dasar</div>
    <input type="search" class="search-input" placeholder="Cari barang..." aria-label="Cari harga dasar"
           data-table-search="#hargaTable" data-empty="hargaEmpty">
  </div>

  <div class="table-wrap">
    <table class="data-table" id="hargaTable">
      <thead>
        <tr>
          <th>Tanggal</th>
          <th>ID Barang</th>
          <th>Nama Barang</th>
          <th>Merk</th>
          <th>Spesifikasi</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!items || items.length === 0) { %>
          <tr>
            <td colspan="6">
              <div class="empty-state">Belum ada data harga dasar yang ditambahkan.</div>
            </td>
          </tr>
        <% } else { %>
          <% items.forEach(function (item) { %>
            <tr data-row>
              <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
              <td><span class="code-chip"><%= item.idBarang || '-' %></span></td>
              <td class="strong"><%= item.namaBarang || '-' %></td>
              <td><%= item.namaMerk || '-' %></td>
              <td><%= item.spesifikasi || '-' %></td>
              <td>
                <span class="badge <%= item.status === 'Ready' ? 'badge-ready' : (item.status === 'Pending' ? 'badge-pending' : 'badge-nonaktif') %>">
                  <%= item.status || 'Pending' %>
                </span>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    <div class="empty-state filter-empty" id="hargaEmpty">Tidak ada data yang cocok dengan pencarian.</div>
  </div>
</section>

<%- include('partials/guest-footer') %>
