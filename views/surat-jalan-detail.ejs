<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Surat - <%= suratJalan.noSuratJalan %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f4f6f9; color: #333; padding: 40px 20px; }
    .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #edf2f7; padding-bottom: 20px; margin-bottom: 25px; }
    .header h2 { color: #7a1b1b; font-size: 22px; }
    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; }
    .btn-secondary { background: #e2e8f0; color: #475569; }
    .btn-primary { background: #7a1b1b; color: #fff; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; }
    .info-item label { font-size: 12px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px; text-transform: uppercase; }
    .info-item span { font-size: 14px; font-weight: 600; color: #1e293b; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 25px; }
    th, td { padding: 10px 12px; border: 1px solid #e2e8f0; font-size: 13px; text-align: left; }
    th { background: #f8fafc; color: #475569; }
    .actions { display: flex; justify-content: flex-end; gap: 10px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Detail Surat</h2>
      <a href="javascript:history.back()" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Kembali</a>
    </div>

    <div class="info-grid">
      <!-- Informasi Jenis Surat -->
      <div class="info-item">
        <label>Jenis Surat</label>
        <span><%= suratJalan.jenisSurat || 'Surat Jalan' %></span>
      </div>
      <div class="info-item">
        <label>No. Surat Jalan</label>
        <span><%= suratJalan.noSuratJalan %></span>
      </div>
      <div class="info-item">
        <label>Tanggal Pengiriman</label>
        <span><%= suratJalan.tanggal ? new Date(suratJalan.tanggal).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'}) : '-' %></span>
      </div>
      <div class="info-item">
        <label>Nama Perusahaan</label>
        <span><%= suratJalan.namaPerusahaan || '-' %></span>
      </div>
      <div class="info-item">
        <label>Jenis Pengiriman</label>
        <span><%= suratJalan.jenisKirim %></span>
      </div>
      <div class="info-item">
        <label>Kepada Yth</label>
        <span><%= suratJalan.kepadaYth %></span>
      </div>
      <div class="info-item">
        <label>Nama Penerima</label>
        <span><%= suratJalan.namaPenerima || '-' %></span>
      </div>
      <div class="info-item">
        <label>No. Telepon</label>
        <span><%= suratJalan.noTelepon || '-' %></span>
      </div>
      <div class="info-item">
        <label>Nama Penyerah</label>
        <span><%= suratJalan.namaPenyerah || suratJalan.diinputOleh || '-' %></span>
      </div>
      <div class="info-item" style="grid-column: span 2;">
        <label>Alamat Tujuan</label>
        <span><%= suratJalan.alamat %></span>
      </div>
      <div class="info-item">
        <label>Perihal</label>
        <span><%= suratJalan.perihal || '-' %></span>
      </div>
      <div class="info-item">
        <label>Pekerjaan / Proyek</label>
        <span><%= suratJalan.pekerjaan || '-' %></span>
      </div>
    </div>

    <!-- Tabel Daftar Barang / Material -->
    <h3 style="font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 5px;">Daftar Barang / Material</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 50px; text-align: center;">No</th>
          <th>Deskripsi Barang</th>
          <th style="width: 100px; text-align: center;">Jumlah</th>
          <th style="width: 100px; text-align: center;">Satuan</th>
          <th>Keterangan</th>
        </tr>
      </thead>
      <tbody>
        <% if (suratJalan.items && suratJalan.items.length > 0) { %>
          <% suratJalan.items.forEach((item, index) => { %>
            <tr>
              <td style="text-align: center;"><%= index + 1 %></td>
              <td style="white-space: pre-line;"><%= item.diskripsi %></td>
              <td style="text-align: center; white-space: pre-line;"><%= item.jumlah %></td>
              <td style="text-align: center;"><%= item.satuan %></td>
              <td style="white-space: pre-line;"><%= item.keterangan || '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" style="text-align: center; color: #888;">Tidak ada item barang.</td></tr>
        <% } %>
      </tbody>
    </table>

    <!-- Keterangan Kode Barang -->
    <% if (suratJalan.kodeBarangList && suratJalan.kodeBarangList.length > 0) { %>
      <div style="margin-top: 20px; margin-bottom: 25px;">
        <label style="font-size: 12px; color: #64748b; font-weight: 600; display: block; margin-bottom: 6px; text-transform: uppercase;">Keterangan Kode Barang</label>
        <div style="display: flex; flex-direction: column; gap: 6px; font-size: 14px;">
          <% suratJalan.kodeBarangList.forEach((kb) => { %>
            <div>
              <span style="font-weight: 600; color: #1e293b;"><%= kb.namaBarang %></span> : 
              <span style="color: #334155;"><%= kb.kodeBarang %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="info-item" style="margin-top: 20px; margin-bottom: 25px;">
      <label>Diinput Oleh</label>
      <span><%= suratJalan.diinputOleh || 'System' %></span>
    </div>

    <div class="actions">
      <a href="/surat-jalan/cetak/<%= suratJalan._id %>" target="_blank" class="btn btn-primary">
        <i class="fa-solid fa-print"></i> Cetak <%= suratJalan.jenisSurat || 'Surat Jalan' %>
      </a>
      <button type="button" onclick="downloadPDFDirect()" class="btn" style="background-color: #7a1b1b; color: #fff; padding: 10px 16px; border-radius: 6px; font-weight: 600; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
       <i class="fa-solid fa-file-pdf"></i> Unduh PDF
      </button>
    </div>
  </div>

  <script>
  function downloadPDFDirect() {
    // Kita ambil elemen tampilan cetak atau bungkus konten detail
    // Atau bisa fetch halaman cetak secara background lalu convert ke PDF
    const element = document.querySelector('.container') || document.body;
    
    const opt = {
      margin:       5,
      filename:     '<%= (suratJalan.jenisSurat || "Surat-Jalan").replace(/\s+/g, "-") %>-<%= suratJalan.noSuratJalan.replace(/\//g, "-") %>.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    html2pdf().from(element).set(opt).save();
  }
</script>

</body>
</html>