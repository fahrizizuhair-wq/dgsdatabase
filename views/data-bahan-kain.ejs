  <main class="main-content">
    <button class="toggle-btn" onclick="toggleSidebar()">☰</button>

    <header class="header-section">
      <h1>Data Bahan Kain</h1>
      <p>Kelola data pemasok khusus bahan kain.</p>
    </header>

    <section class="cards-grid">
      <div class="card">
        <div class="card-title">Total Vendor Kain</div>
        <div class="card-value1"><%= typeof vendors !== 'undefined' ? vendors.length : 0 %> Vendor</div>
      </div>
      <div class="card">
        <div class="card-title">Total Kategori</div>
        <div class="card-value2"><%= typeof totalKategori !== 'undefined' ? totalKategori : 0 %> Kategori</div>
      </div>
      <div class="card">
        <div class="card-title">Kategori Utama</div>
        <div class="card-value3">Bahan Kain</div>
      </div>
    </section>  

    <section class="table-container">
      <div class="table-header">
          <h2>Daftar Vendor Bahan Kain</h2>
          <input type="text" id="searchInput" class="search-input" placeholder="Cari vendor..." onkeyup="filterVendor()">
          <button type="button" class="btn-add" onclick="openModal()">+ Tambah Vendor</button>
      </div>

      <div class="table-responsive-container">
        <table id="vendorTable">
          <thead>
            <tr>
              <th>ID Vendor</th>
              <th>Nama Vendor</th>
              <th>Wilayah</th>
              <th>Kategori Supply</th>
              <th>Kontak</th>
              <th>Rating</th>
              <th>Status</th>
              <th style="text-align: center;">Aksi</th>
            </tr>
          </thead>
          <tbody>
          <% if (!vendors || vendors.length === 0) { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 20px; color: #888;">Belum ada data vendor bahan kain.</td>
            </tr>
          <% } else { %>
            <% vendors.forEach((vendor) => { %>
              <tr class="vendor-row">
                <td><strong><%= vendor.idVendor %></strong></td>
                <td><%= vendor.namaVendor %></td>
                <td><%= vendor.wilayah ? vendor.wilayah : '-' %></td>
                <td><%= vendor.kategoriSupply || 'Bahan Kain' %></td>
                <td><%= vendor.kontak %></td>
                <td>⭐ <%= vendor.rating %></td>
                <td>
                  <span class="badge <%= vendor.status === 'Aktif' ? 'badge-active' : 'badge-inactive' %>">
                    <%= vendor.status || 'Aktif' %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <a href="/katalog-vendor/<%= vendor.vendorId %>" class="btn-catalog">Katalog</a>
                </td>
              </tr>
            <% }); %>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- MODAL TAMBAH VENDOR DENGAN ENCTYPE UNTUK UPLOAD FOTO -->
  <div class="modal" id="vendorModal">
    <div class="modal-content">
      <h3 style="margin-bottom: 15px; color: #7a1b1b;">Tambah Vendor Bahan Kain</h3>
      <!-- WAJIB ADA: enctype="multipart/form-data" AGAR FOTO TER-UPLOAD -->
      <form action="/data-bahan-kain/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>ID Vendor</label>
          <input type="text" name="idVendor" value="<%= typeof nextIdVendor !== 'undefined' ? nextIdVendor : 'VND-001' %>" required>
        </div>
        <div class="form-group">
          <label>Nama Vendor</label>
          <input type="text" name="namaVendor" placeholder="Masukan Nama Vendor" required>
        </div>
        <div class="form-group">
          <label>Wilayah</label>
          <select name="wilayah">
            <option value="Jakarta">Jakarta</option>
            <option value="Bandung">Bandung</option>
            <option value="Surabaya">Surabaya</option>
            <option value="Semarang">Semarang</option>
            <option value="Bogor">Bogor</option>
            <option value="Depok">Depok</option>
            <option value="Bekasi">Bekasi</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>
        <div class="form-group">
          <label>Kategori Supply</label>
          <input type="text" name="kategoriSupply" placeholder="Masukan Kategori" required>
        </div>
        <div class="form-group">
          <label>Kontak & PIC</label>
          <input type="text" name="kontak" placeholder="Masukan Kontak & PIC" required>
        </div>
        <div class="form-group">
          <label>Rating (1 - 5)</label>
          <input type="number" name="rating" min="1" max="5" step="0.1" value="5" required>
        </div>
        <div class="form-group">
            <label>Deskripsi Vendor</label>
            <textarea name="deskripsi" rows="5" 
            style="width: 100%; min-height: 120px; padding: 10px; border: 1px solid #ccc; 
                   border-radius: 6px; font-family: inherit; font-size: 14px; resize: vertical;" 
                   placeholder="Tuliskan catatan/deskripsi..."></textarea>
        </div>
        <div class="form-group">    
          <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
          <input type="file" name="foto" accept="image/*" multiple>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn-add">Simpan Vendor</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebarOverlay');
      sidebar.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    function openModal() {
      document.getElementById('vendorModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('vendorModal').style.display = 'none';
    }

    function filterVendor() {
      const input = document.getElementById('searchInput').value.toLowerCase();
      const rows = document.querySelectorAll('#vendorTable tbody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
      });
    }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('active');
            overlay.classList.toggle('active');
        }

        // FUNGSI UNTUK MEMBUKA/MENUTUP DROPDOWN STOK & BARANG
        function toggleDropdown(element) {
            const parent = element.closest('.dropdown');
            parent.classList.toggle('active');
        }

        function openModal() {
            document.getElementById('vendorModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('vendorModal').style.display = 'none';
        }

        function filterVendor() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#vendorTable tbody tr');
            rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
            });
        }
  </script>
</body>
</html>