<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Database Vendor</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * { box-sizing: border-box; }

        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                        url('/images/background.jpg') no-repeat center top fixed;
            background-size: cover;
            z-index: -1;
        }
        
        .container-pilihan {
            display: flex;
            flex-direction: row;
            gap: 20px;
            width: 100%;
            max-width: 720px;
            justify-content: center;
            align-items: stretch;
        }

        .kartu-pilihan {
            padding: 30px 20px; 
            border-radius: 20px; 
            width: 100%;
            max-width: 340px; 
            min-height: 280px; 
            height: auto;
            text-align: center; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
            transition: all 0.3s ease-in-out; 
            cursor: pointer;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .kartu-pembeli-hover:hover {
            transform: translateY(-5px);
            background-color: rgba(252, 234, 234, 0.9); 
            box-shadow: 0 10px 30px rgba(122, 27, 27, 0.2);
        }

        .kartu-kasir-hover:hover {
            transform: translateY(-5px);
            background-color: rgba(244, 244, 244, 0.9); 
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .teks-hover-rahasia {
            opacity: 0;
            visibility: hidden;
            font-size: 16px;
            font-weight: 700;
            margin-top: 15px;
            transition: all 0.2s ease-in-out;
        }

        .kartu-pembeli-hover:hover .teks-hover-rahasia,
        .kartu-kasir-hover:hover .teks-hover-rahasia {
            opacity: 1;
            visibility: visible;
            color: #cf3939;
        }

        /* ==========================================
           RESPONSIF MOBILE (CARD TETAP BERDAMPINGAN)
           ========================================== */
        @media (max-width: 768px) {
            .container-pilihan {
                display: grid !important;
                grid-template-columns: 1fr 1fr !important; /* Memaksa 2 kolom berdampingan */
                gap: 10px !important;
                padding: 0 10px !important;
            }

            .kartu-pilihan {
                max-width: 100% !important;
                min-height: auto !important;
                padding: 18px 10px !important; /* Padding ramping agar pas */
            }

            .kartu-pilihan .icon-box {
                width: 44px !important;
                height: 44px !important;
                margin-bottom: 10px !important;
                border-radius: 12px !important;
            }

            .kartu-pilihan .icon-box svg {
                width: 20px !important;
                height: 20px !important;
            }

            .kartu-pilihan h2 {
                font-size: 15px !important;
                margin-bottom: 6px !important;
            }

            .kartu-pilihan p {
                font-size: 10.5px !important; /* Ukuran teks pas untuk layar HP sempit */
                line-height: 1.35 !important;
            }

            .teks-hover-rahasia {
                display: none !important;
            }
        }
    </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body style="font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f7f5f0; display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; box-sizing: border-box;">

    <!-- Bagian Logo & Slogan Atas -->
    <div style="text-align: center; margin-bottom: 30px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <img src="/images/dgs.png" alt="Logo DGS" style="width: 130px; height: auto; margin-bottom: 12px; object-fit: contain; background: transparent !important; box-shadow: none !important; border: none !important;">
        
        <h1 style="color: #ffffff; font-size: 28px; margin: 0; font-weight: 700; letter-spacing: -0.5px;">DIAN GIRI SAPUTRA</h1>
        <p style="color: #ffffff; font-size: 13px; margin: 0; text-transform: uppercase; letter-spacing: 2px;">DATA VENDOR</p>
        <div style="width: 40px; height: 1.5px; background-color: #000000; margin: 8px auto;"></div>
    </div>

    <!-- Container Utama Dua Pilihan (Kiri Kanan) -->
    <div class="container-pilihan">
        
        <!-- KARTU PENGUNJUNG / PEMBELI -->
        <div class="kartu-pilihan kartu-pembeli-hover" onclick="window.location.href='/dashboard'">
            <div class="icon-box" style="background-color: #fcf6f6; width: 60px; height: 60px; border-radius: 15px; display: flex; justify-content: center; align-items: center; margin-bottom: 15px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#7a1b1b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </div>
            
            <h2 style="color: #000000; font-size: 20px; margin: 0 0 8px 0; font-weight: 700;">Saya User</h2>
            <p style="color: #222; font-size: 13.5px; line-height: 1.5; margin: 0;">Masuk sebagai user untuk eksplorasi data vendor dan referensi harga dasar</p>
            <div class="teks-hover-rahasia">Masuk User &rarr;</div>
        </div>

        <!-- KARTU KASIR / ADMIN -->
        <div class="kartu-pilihan kartu-kasir-hover" onclick="bukaLogin()">
            <div class="icon-box" style="background-color: #fcf6f6; width: 60px; height: 60px; border-radius: 15px; display: flex; justify-content: center; align-items: center; margin-bottom: 15px;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            
            <h2 style="color: #2c2c2c; font-size: 20px; margin: 0 0 8px 0; font-weight: 700;">Saya Admin</h2>
            <p style="color: #222; font-size: 13.5px; line-height: 1.5; margin: 0;">Kelola transaksi, pantau data, dan update data vendor.</p>
            <div class="teks-hover-rahasia">Masuk Sebagai Admin &rarr;</div>
        </div>

    </div>

    <div style="text-align: center; margin-top: 40px; color: #000000; font-size: 12.5px; letter-spacing: 0.5px; opacity: 0.85;">
        &copy; 2026 <span style="color: #cc0e0e; font-weight: 600;">Dian Giri Saputra</span>. All Rights Reserved.
    </div>

    <!-- MODAL POP-UP FORM LOGIN & LUPA PASSWORD ADMIN -->
    <div id="modalLogin" onclick="tutupLoginLuar(event)" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); justify-content: center; align-items: center; z-index: 1000; padding: 20px; box-sizing: border-box;">
        <div style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.5); padding: 30px; border-radius: 20px; width: 100%; max-width: 360px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); position: relative;">
            <span onclick="tutupLogin()" style="position: absolute; top: 15px; right: 20px; font-size: 22px; cursor: pointer; color: #888; font-weight: bold;">&times;</span>
            
            <% if (typeof error !== 'undefined') { %>
                <script>setTimeout(() => { document.getElementById('modalLogin').style.display = 'flex'; }, 100);</script>
                <div style="background-color: rgba(255, 235, 233, 0.9); color: #ff3b30; padding: 10px; border-radius: 8px; font-size: 13px; margin-bottom: 15px; border: 1px solid #ffccd5; text-align: left;">
                    ⚠️ <%= error %>
                </div>
            <% } %>

            <!-- FORM 1: LOGIN -->
            <div id="boxLogin">
                <h3 style="margin: 0 0 5px 0; color: #2c2c2c; font-size: 20px; font-weight: 700;">Verifikasi Admin</h3>
                <p style="margin: 0 0 20px 0; color: #666; font-size: 13px;">Masukkan kredensial bahwa anda adalah admin</p>

                <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
                    <input type="text" name="username" placeholder="Username" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
                    
                    <div style="position: relative; width: 100%;">
                        <input type="password" name="password" id="loginPassword" placeholder="Password" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                        <span onclick="togglePassword('loginPassword', 'iconLoginPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                            <i id="iconLoginPass" class="fa-solid fa-eye"></i>
                        </span>
                    </div>
                    
                    <div style="text-align: right; margin-top: -5px;">
                        <a href="javascript:void(0)" onclick="tampilLupaPassword()" style="font-size: 13px; color: #7a1b1b; text-decoration: none; font-weight: 600;">Lupa Password?</a>
                    </div>

                    <button type="submit" style="padding: 12px; background-color: #cf3939; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Masuk Ke Dashboard</button>
                </form>
            </div>

            <!-- FORM 2: LUPA PASSWORD -->
            <div id="boxLupaPassword" style="display: none;">
                <h3 style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Lupa Password</h3>
                <p style="margin: 0 0 20px 0; color: #666; font-size: 13px;">Masukkan username/email Anda untuk verifikasi akun.</p>

                <form onsubmit="prosesVerifikasiUser(event)" style="display: flex; flex-direction: column; gap: 15px;">
                    <input type="text" id="inputUsernameLupa" placeholder="Username / Email" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
                    
                    <button type="submit" style="padding: 12px; background-color: #7a1b1b; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Lanjutkan</button>
                    
                    <div style="text-align: center; margin-top: 5px;">
                        <a href="javascript:void(0)" onclick="tampilFormLogin()" style="font-size: 13px; color: #666; text-decoration: none;">&larr; Kembali ke Login</a>
                    </div>
                </form>
            </div>

            <!-- FORM 3: UBAH PASSWORD BARU -->
            <div id="boxResetPassword" style="display: none;">
                <h3 style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Ubah Password</h3>
                <p style="margin: 0 0 20px 0; color: #666; font-size: 13px;">Buat password baru untuk akun Anda.</p>

                <form onsubmit="prosesResetPassword(event)" style="display: flex; flex-direction: column; gap: 15px;">
                    <input type="hidden" name="username" id="hiddenUsernameReset">
                    
                    <div style="position: relative; width: 100%;">
                        <input type="password" name="newPassword" id="newPassword" placeholder="Password Baru" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                        <span onclick="togglePassword('newPassword', 'iconNewPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                            <i id="iconNewPass" class="fa-solid fa-eye"></i>
                        </span>
                    </div>

                    <div style="position: relative; width: 100%;">
                        <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Konfirmasi Password Baru" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                        <span onclick="togglePassword('confirmPassword', 'iconConfirmPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                            <i id="iconConfirmPass" class="fa-solid fa-eye"></i>
                        </span>
                    </div>
                    
                    <button type="submit" style="padding: 12px; background-color: #28a745; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Simpan Password Baru</button>
                    
                    <div style="text-align: center; margin-top: 5px;">
                        <a href="javascript:void(0)" onclick="tampilFormLogin()" style="font-size: 13px; color: #666; text-decoration: none;">Batal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        
        if (urlParams.get('error') === 'Unauthorized') {
            // 1. Bersihkan parameter URL terlebih dahulu agar bersih seketika
            window.history.replaceState({}, document.title, window.location.pathname);

            // 2. Baru tampilkan pop-up peringatan SweetAlert2
            Swal.fire({
                icon: 'warning',
                title: 'Akses Ditolak!',
                text: 'Silakan login terlebih dahulu sebagai admin untuk mengakses dashboard.',
                confirmButtonColor: '#7a1b1b',
                confirmButtonText: 'Mengerti'
            });
        }
    });

    function bukaLogin() {
        document.getElementById('modalLogin').style.display = 'flex';
        tampilFormLogin();
    }
    function tutupLogin() {
        document.getElementById('modalLogin').style.display = 'none';
    }
    function tutupLoginLuar(e) {
        if (e.target.id === 'modalLogin') tutupLogin();
    }

    function tampilFormLogin() {
        document.getElementById('boxLogin').style.display = 'block';
        document.getElementById('boxLupaPassword').style.display = 'none';
        document.getElementById('boxResetPassword').style.display = 'none';
    }

    function tampilLupaPassword() {
        document.getElementById('boxLogin').style.display = 'none';
        document.getElementById('boxLupaPassword').style.display = 'block';
        document.getElementById('boxResetPassword').style.display = 'none';
    }

    async function prosesVerifikasiUser(event) {
        event.preventDefault();
        const valUser = document.getElementById('inputUsernameLupa').value.trim();
        if (valUser === '') return;

        try {
            const response = await fetch('/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: valUser })
            });

            const result = await response.json();
            if (result.success) {
                document.getElementById('hiddenUsernameReset').value = valUser;
                document.getElementById('boxLogin').style.display = 'none';
                document.getElementById('boxLupaPassword').style.display = 'none';
                document.getElementById('boxResetPassword').style.display = 'block';
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: result.message || "User / Admin tidak ditemukan!",
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Error:", err);
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Server',
                text: "Terjadi kesalahan pada server.",
                confirmButtonColor: '#dc3545'
            });
        }
    }

    async function prosesResetPassword(event) {
        event.preventDefault();
        const username = document.getElementById('hiddenUsernameReset').value;
        const newPassword = event.target.newPassword.value;
        const confirmPassword = event.target.confirmPassword.value;

        if (newPassword !== confirmPassword) {
            Swal.fire({
                icon: 'warning',
                title: 'Perhatian',
                text: "Konfirmasi password tidak cocok!",
                confirmButtonColor: '#ffc107'
            });
            return;
        }

        try {
            const response = await fetch('/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, newPassword, confirmPassword })
            });

            const result = await response.json();
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: result.message,
                    confirmButtonText: 'Masuk Sekarang',
                    confirmButtonColor: '#28a745',
                    timer: 4000,
                    timerProgressBar: true
                }).then(() => {
                    tutupLogin();
                    tampilFormLogin();
                    event.target.reset();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal',
                    text: result.message,
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Error:", err);
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Server',
                text: "Terjadi kesalahan pada server.",
                confirmButtonColor: '#dc3545'
            });
        }
    }

    function togglePassword(inputId, iconId) {
        const inputField = document.getElementById(inputId);
        const iconField = document.getElementById(iconId);

        if (inputField.type === "password") {
            inputField.type = "text";
            iconField.classList.remove("fa-eye");
            iconField.classList.add("fa-eye-slash");
        } else {
            inputField.type = "password";
            iconField.classList.remove("fa-eye-slash");
            iconField.classList.add("fa-eye");
        }
    }
</script>
</body>
</html>