<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Master Database Vendor</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
/* ============================================================
   LOGIN — MODERN GLASS PANEL
   Tema & background tetap sama dengan halaman sebelumnya
   ============================================================ */
:root {
  --maroon-900: #4d0e0e;
  --maroon-800: #5f1414;
  --maroon-700: #7a1b1b;
  --maroon-600: #9e2a2b;
  --maroon-500: #b03a3a;
  --gold: #c9933b;
  --ink: #1e293b;
  --muted: #64748b;
  --line: #eee6e6;
  --surface: #ffffff;
}

*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  min-height: 100vh;
  margin: 0;
  padding: 40px 20px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background-color: #f4f6f9;
  color: var(--ink);
  position: relative;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Background lama dipertahankan */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%),
              url('/images/background.jpg') no-repeat center top fixed;
  background-size: cover;
  z-index: -1;
  pointer-events: none;
}

/* Ornamen ambient */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: -1;
  opacity: 0.6;
}
.orb-1 {
  width: 420px;
  height: 420px;
  top: -140px;
  right: -100px;
  background: radial-gradient(circle, rgba(122, 27, 27, 0.6) 0%, transparent 70%);
  animation: floatOrb1 14s ease-in-out infinite;
}
.orb-2 {
  width: 360px;
  height: 360px;
  bottom: -120px;
  left: -100px;
  background: radial-gradient(circle, rgba(201, 147, 59, 0.38) 0%, transparent 70%);
  animation: floatOrb2 17s ease-in-out infinite;
}
@keyframes floatOrb1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-24px, 34px) scale(1.06); }
}
@keyframes floatOrb2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(28px, -26px) scale(1.05); }
}

/* Layout */
.auth-page {
  width: 100%;
  max-width: 462px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  position: relative;
  z-index: 1;
  margin: auto;
}

/* Kartu utama */
.auth-card {
  width: 100%;
  position: relative;
  padding: 32px 32px 28px;
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.92) 100%);
  border: 1px solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 35px 70px -28px rgba(35, 10, 10, 0.45),
    0 16px 32px -18px rgba(122, 27, 27, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  overflow: hidden;
  animation: cardIn 0.65s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.auth-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--maroon-700) 0%, var(--gold) 50%, var(--maroon-700) 100%);
}
.auth-card::after {
  content: "";
  position: absolute;
  width: 210px;
  height: 210px;
  top: -110px;
  right: -90px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(122, 27, 27, 0.07) 0%, transparent 70%);
  pointer-events: none;
}
@keyframes cardIn {
  from { opacity: 0; transform: translateY(22px) scale(0.975); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Header brand */
.auth-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 26px;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
}
.brand-logo {
  width: 54px;
  height: 54px;
  flex: 0 0 auto;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #f3e6e6;
  box-shadow: 0 8px 18px -6px rgba(122, 27, 27, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.brand-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 7px;
  display: block;
}
.brand-text { min-width: 0; }
.brand-eyebrow {
  display: block;
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 2.4px;
  text-transform: uppercase;
  color: var(--maroon-700);
  margin-bottom: 3px;
  opacity: 0.85;
}
.brand-text h1 {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.2px;
  color: #2a1212;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.head-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex: 0 0 auto;
  padding: 7px 11px;
  border-radius: 999px;
  background: #fdf2f2;
  border: 1px solid #f2dada;
  color: var(--maroon-700);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
}
.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55);
  animation: pulseGreen 2.2s infinite;
}
@keyframes pulseGreen {
  0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
  70% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
  100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
}

/* Intro */
.auth-intro { margin-bottom: 22px; }
.auth-intro h2 {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.9px;
  line-height: 1.15;
  color: #2a1212;
}
.auth-intro h2 span {
  background: linear-gradient(120deg, var(--maroon-700) 0%, var(--maroon-500) 60%, var(--gold) 120%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.auth-intro p {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.65;
  color: var(--muted);
  max-width: 360px;
}

/* Role switch */
.role-switch {
  position: relative;
  display: flex;
  padding: 5px;
  border-radius: 15px;
  background: #f4f0f0;
  border: 1px solid #ece3e3;
  margin-bottom: 22px;
  isolation: isolate;
}
.role-slider {
  position: absolute;
  top: 5px;
  bottom: 5px;
  left: 5px;
  width: calc(50% - 5px);
  border-radius: 11px;
  background: #ffffff;
  box-shadow: 0 4px 12px rgba(122, 27, 27, 0.14), 0 1px 2px rgba(0, 0, 0, 0.04);
  transition: transform 0.36s cubic-bezier(0.2, 0.8, 0.2, 1);
  z-index: 0;
}
.role-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 8px;
  border: none;
  border-radius: 11px;
  background: transparent;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  color: #8d7c7c;
  cursor: pointer;
  transition: color 0.25s ease;
}
.role-btn svg {
  width: 16px;
  height: 16px;
  transition: transform 0.25s ease;
}
.role-btn.active { color: var(--maroon-700); }
.role-btn.active svg { transform: scale(1.06); }
.role-btn:hover:not(.active) { color: #5f4d4d; }

/* Form */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.field label {
  display: block;
  margin-bottom: 7px;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.25px;
  color: #5b4a4a;
}
.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 13px;
  background: #fbfafa;
  border: 1.5px solid var(--line);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.input-wrap:focus-within {
  background: #ffffff;
  border-color: rgba(122, 27, 27, 0.45);
  box-shadow: 0 0 0 4px rgba(122, 27, 27, 0.08);
}
.input-wrap > svg {
  width: 18px;
  height: 18px;
  margin-left: 14px;
  flex: 0 0 auto;
  color: #a99494;
  transition: color 0.2s ease;
}
.input-wrap:focus-within > svg { color: var(--maroon-700); }
.input-wrap input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  padding: 13px 12px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink);
}
.input-wrap input::placeholder { color: #b6a8a8; font-weight: 400; }
.input-wrap input:-webkit-autofill {
  -webkit-box-shadow: 0 0 0 40px #fbfafa inset;
  -webkit-text-fill-color: var(--ink);
}
.eye-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 14px;
  border: none;
  background: transparent;
  color: #a99494;
  font-size: 14px;
  cursor: pointer;
  transition: color 0.2s ease;
}
.eye-btn:hover { color: var(--maroon-700); }

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: -2px;
}
.remember {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  color: var(--muted);
  cursor: pointer;
  user-select: none;
}
.remember input {
  width: 15px;
  height: 15px;
  accent-color: var(--maroon-700);
  cursor: pointer;
}
.link-muted {
  font-size: 12px;
  font-weight: 700;
  color: var(--maroon-700);
  text-decoration: none;
}
.link-muted:hover { text-decoration: underline; }

.btn-primary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  padding: 14px 18px;
  border: none;
  border-radius: 13px;
  background: linear-gradient(135deg, var(--maroon-700) 0%, var(--maroon-600) 55%, var(--maroon-500) 100%);
  color: #ffffff;
  font-family: inherit;
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.1px;
  cursor: pointer;
  box-shadow: 0 14px 26px -10px rgba(122, 27, 27, 0.55);
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  overflow: hidden;
}
.btn-primary::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 20%, rgba(255, 255, 255, 0.22) 50%, transparent 80%);
  transform: translateX(-120%);
  transition: transform 0.6s ease;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 34px -12px rgba(122, 27, 27, 0.6);
  filter: brightness(1.03);
}
.btn-primary:hover::before { transform: translateX(120%); }
.btn-primary:active { transform: translateY(0); }
.btn-primary:disabled { opacity: 0.72; cursor: not-allowed; transform: none; }
.btn-primary svg { width: 17px; height: 17px; }

/* Divider */
.divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0 15px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.1px;
  text-transform: uppercase;
  color: #b3a4a4;
}
.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, #ece3e3, transparent);
}

/* Guest */
.btn-guest {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  padding: 12.5px 16px;
  border-radius: 13px;
  border: 1.5px solid var(--line);
  background: #ffffff;
  color: #5b4a4a;
  font-size: 13.5px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s ease;
}
.btn-guest > svg:first-child {
  width: 17px;
  height: 17px;
  color: var(--maroon-700);
}
.btn-guest .guest-arrow {
  width: 15px;
  height: 15px;
  margin-left: auto;
  color: #b3a4a4;
  transition: transform 0.2s ease, color 0.2s ease;
}
.btn-guest:hover {
  border-color: rgba(122, 27, 27, 0.35);
  background: #fdf7f7;
  color: var(--maroon-700);
  transform: translateY(-1px);
  box-shadow: 0 10px 20px -12px rgba(122, 27, 27, 0.4);
}
.btn-guest:hover .guest-arrow {
  transform: translateX(3px);
  color: var(--maroon-700);
}

/* Footer card */
.auth-foot {
  margin-top: 19px;
  text-align: center;
  font-size: 12.5px;
  color: var(--muted);
}
.auth-foot a {
  color: var(--maroon-700);
  font-weight: 800;
  text-decoration: none;
}
.auth-foot a:hover { text-decoration: underline; }

/* Copyright di luar card */
.copyright {
  margin: 0;
  text-align: center;
  font-size: 11.5px;
  letter-spacing: 0.3px;
  color: #5b4a4a;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.7);
  padding: 8px 16px;
  border-radius: 999px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.copyright strong { color: var(--maroon-700); font-weight: 800; }

/* ============================================================
   MODAL — disamakan dengan gaya panel utama
   ============================================================ */
.modal-card {
  position: relative;
  width: 100%;
  max-width: 400px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 30px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 35px 70px -25px rgba(0, 0, 0, 0.55);
  animation: cardIn 0.3s ease both;
  scrollbar-width: thin;
}
.modal-card::-webkit-scrollbar { width: 7px; }
.modal-card::-webkit-scrollbar-thumb {
  background: #e3d6d6;
  border-radius: 99px;
}
#modalLogin input[type="text"],
#modalLogin input[type="password"] {
  width: 100% !important;
  padding: 12px 14px !important;
  background: #fbfafa !important;
  border: 1.5px solid var(--line) !important;
  border-radius: 12px !important;
  font-family: inherit !important;
  font-size: 13.5px !important;
  color: var(--ink) !important;
  outline: none !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease !important;
}
#modalLogin input[type="password"] { padding-right: 44px !important; }
#modalLogin input[type="text"]:focus,
#modalLogin input[type="password"]:focus {
  background: #ffffff !important;
  border-color: rgba(122, 27, 27, 0.45) !important;
  box-shadow: 0 0 0 4px rgba(122, 27, 27, 0.08) !important;
}
#modalLogin button[type="submit"] {
  width: 100%;
  border-radius: 12px !important;
  font-family: inherit !important;
  letter-spacing: 0.1px;
  box-shadow: 0 12px 22px -12px rgba(122, 27, 27, 0.55);
  transition: transform 0.2s ease, box-shadow 0.2s ease !important;
}
#modalLogin button[type="submit"]:hover {
  transform: translateY(-1px);
  box-shadow: 0 16px 26px -12px rgba(122, 27, 27, 0.6);
}

/* Responsive */
@media (max-width: 520px) {
  body { padding: 26px 14px; }
  .auth-card { padding: 26px 20px 24px; border-radius: 24px; }
  .auth-head { align-items: flex-start; }
  .brand-logo { width: 48px; height: 48px; border-radius: 14px; }
  .brand-eyebrow { letter-spacing: 1.8px; }
  .head-badge { display: none; }
  .auth-intro h2 { font-size: 22px; }
  .auth-intro p { font-size: 12.5px; }
  .form-row { flex-wrap: wrap; }
  .modal-card { padding: 26px 20px; border-radius: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

    </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body>

  <!-- Ornamen ambient -->
  <div class="bg-orb orb-1" aria-hidden="true"></div>
  <div class="bg-orb orb-2" aria-hidden="true"></div>

  <main class="auth-page">

    <!-- PANEL LOGIN MODERN -->
    <section class="auth-card" id="authCard">

      <header class="auth-head">
        <div class="brand-row">
          <div class="brand-logo">
            <img src="/images/dgs.png" alt="Logo DGS">
          </div>
          <div class="brand-text">
            <span class="brand-eyebrow">Warehouse System</span>
            <h1>Dian Giri Saputra</h1>
          </div>
        </div>
        <div class="head-badge">
          <span class="badge-dot"></span>
          Secure Portal
        </div>
      </header>

      <div class="auth-intro">
        <h2>Selamat Datang <span>Kembali</span></h2>
        <p>Pilih tipe akun dan masuk untuk mengelola data vendor, harga dasar, serta stok barang dalam satu sistem terintegrasi.</p>
      </div>

      <!-- Switch role User / Admin -->
      <div class="role-switch" role="tablist" aria-label="Pilih tipe akun">
        <span class="role-slider" id="roleSlider" aria-hidden="true"></span>

        <button type="button" id="roleBtnUser" class="role-btn active" role="tab" aria-selected="true" onclick="setRole('user')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>User</span>
        </button>

        <button type="button" id="roleBtnAdmin" class="role-btn" role="tab" aria-selected="false" onclick="setRole('admin')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
          <span>Admin</span>
        </button>
      </div>

      <!-- Form login langsung di halaman -->
      <form id="formLoginUtama" class="auth-form" onsubmit="prosesLoginUtama(event)">
        <div class="field">
          <label for="loginUsername" id="loginUsernameLabel">Username User</label>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <input type="text" id="loginUsername" name="username" placeholder="Masukkan username user" autocomplete="username" required>
          </div>
        </div>

        <div class="field">
          <label for="loginPassword">Password</label>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" id="loginPassword" name="password" placeholder="Masukkan password" autocomplete="current-password" required>
            <button type="button" class="eye-btn" onclick="togglePassword('loginPassword', 'iconLoginPass')" aria-label="Tampilkan password">
              <i id="iconLoginPass" class="fa-solid fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-row">
          <label class="remember" for="rememberMe">
            <input type="checkbox" id="rememberMe">
            <span>Ingat saya</span>
          </label>
          <a href="javascript:void(0)" class="link-muted" onclick="tampilLupaPassword(roleAktif)">
            Lupa password?
          </a>
        </div>

        <button type="submit" class="btn-primary" id="btnLoginUtama">
          <span id="btnLoginText">Masuk sebagai User</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <div class="divider"><span>atau akses cepat</span></div>

      <a href="/dashboard-guest" class="btn-guest">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span>Masuk sebagai Guest (Tamu)</span>
