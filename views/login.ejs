<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Master Database Vendor</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/LOGODGS.png">
    
   <style>
/* ============================================================
   LOGIN — RIGHT FORM & CENTERED COPYRIGHT ON LEFT BACKGROUND
   ============================================================ */
:root {
  --maroon-900: #4d0e0e;
  --maroon-800: #5f1414;
  --maroon-700: #7a1b1b;
  --maroon-600: #9e2a2b;
  --maroon-500: #b03a3a;
  --gold: #c9933b;
  --ink: #1e293b;
  --muted: #64748b;
  --line: #eee6e6;
  --surface: #ffffff;
}

*, *::before, *::after { box-sizing: border-box; }

html, body {
  height: 100vh;
  overflow-x: hidden;
  overflow-y: auto; 
}

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin: 0;
  padding: 8px 24px 8px 8px; 
  display: flex;
  align-items: center; 
  justify-content: flex-end; /* Posisi form di sebelah kanan mentok */
  background-color: #f4f6f9;
  color: var(--ink);
  position: relative;
  -webkit-font-smoothing: antialiased;
}

/* Background */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(to left, rgba(122, 27, 27, 0.9) 0%, rgba(122, 27, 27, 0.4) 50%, rgba(235, 225, 225, 0.88) 100%),
              url('/images/BGLOGIN.png') no-repeat center center fixed;
  background-size: cover;
  z-index: -1;
  pointer-events: none;
}

/* Ornamen ambient */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: -1;
  opacity: 0.6;
}
.orb-1 { width: 420px; height: 420px; top: -140px; right: -100px; background: radial-gradient(circle, rgba(122, 27, 27, 0.6) 0%, transparent 70%); }
.orb-2 { width: 360px; height: 360px; bottom: -120px; left: -100px; background: radial-gradient(circle, rgba(201, 147, 59, 0.38) 0%, transparent 70%); }

/* Layout di kanan */
.auth-page {
  width: 100%;
  max-width: 460px; 
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center; 
  gap: 8px;
  position: relative;
  z-index: 1;
}

/* Kartu utama mentok atas-bawah */
.auth-card {
  width: 100%;
  position: relative;
  padding: 22px 30px 20px; 
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 100%);
  border: 1px solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 30px 60px -20px rgba(35, 10, 10, 0.5);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  overflow: hidden;
}
.auth-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--maroon-700) 0%, var(--gold) 50%, var(--maroon-700) 100%);
}

/* Header brand */
.auth-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}
.brand-logo {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid #f3e6e6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.brand-logo img { width: 100%; height: 100%; object-fit: contain; padding: 5px; display: block; }
.brand-eyebrow { font-size: 8.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--maroon-700); margin-bottom: 1px; }
.brand-text h1 { font-size: 14px; font-weight: 800; color: #2a1212; }
.head-badge { padding: 4px 9px; border-radius: 999px; background: #fdf2f2; border: 1px solid #f2dada; color: var(--maroon-700); font-size: 9px; font-weight: 800; }
.badge-dot { width: 5px; height: 5px; border-radius: 50%; background: #22c55e; }

/* Intro */
.auth-intro { margin-bottom: 12px; }
.auth-intro h2 { font-size: 20.5px; font-weight: 800; line-height: 1.15; color: #2a1212; }
.auth-intro h2 span { background: linear-gradient(120deg, var(--maroon-700) 0%, var(--maroon-500) 60%, var(--gold) 120%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.auth-intro p { margin-top: 3px; font-size: 12px; line-height: 1.4; color: var(--muted); }

/* Role switch */
.role-switch {
  position: relative; display: flex; padding: 3px; border-radius: 12px; background: #f4f0f0; border: 1px solid #ece3e3; margin-bottom: 12px;
}
.role-slider {
  position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px); border-radius: 9px; background: #ffffff; box-shadow: 0 2px 8px rgba(122, 27, 27, 0.14); transition: transform 0.3s ease;
}
.role-btn {
  position: relative; z-index: 1; flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 6px; border: none; border-radius: 9px; background: transparent; font-family: inherit; font-size: 12px; font-weight: 700; color: #8d7c7c; cursor: pointer;
}
.role-btn svg { width: 14px; height: 14px; }
.role-btn.active { color: var(--maroon-700); }

/* Form */
.auth-form { display: flex; flex-direction: column; gap: 9px; }
.field label { display: block; margin-bottom: 3px; font-size: 11px; font-weight: 700; color: #5b4a4a; }
.input-wrap {
  position: relative; display: flex; align-items: center; border-radius: 11px; background: #fbfafa; border: 1.5px solid var(--line);
}
.input-wrap:focus-within { background: #ffffff; border-color: rgba(122, 27, 27, 0.45); box-shadow: 0 0 0 3px rgba(122, 27, 27, 0.08); }
.input-wrap > svg { width: 16px; height: 16px; margin-left: 12px; color: #a99494; }
.input-wrap input {
  flex: 1; min-width: 0; border: none; outline: none; background: transparent; padding: 9px 12px; font-family: inherit; font-size: 13.5px; color: var(--ink);
}
.eye-btn { display: flex; align-items: center; justify-content: center; height: 100%; padding: 0 12px; border: none; background: transparent; color: #a99494; cursor: pointer; }

.form-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: -1px; }
.remember { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--muted); }
.remember input { width: 13px; height: 13px; accent-color: var(--maroon-700); }
.link-muted { font-size: 11.5px; font-weight: 700; color: var(--maroon-700); text-decoration: none; }

.btn-primary {
  display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px 16px; border: none; border-radius: 11px; background: linear-gradient(135deg, var(--maroon-700) 0%, var(--maroon-500) 100%); color: #ffffff; font-family: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; box-shadow: 0 8px 18px -6px rgba(122, 27, 27, 0.5);
}
.btn-primary svg { width: 15px; height: 15px; }

/* Divider */
.divider {
  display: flex; align-items: center; gap: 10px; margin: 10px 0 8px; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #b3a4a4;
}
.divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #ece3e3; }

/* Guest */
.btn-guest {
  display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 10px 16px; border-radius: 11px; border: 1.5px solid var(--line); background: #ffffff; color: #5b4a4a; font-size: 12.5px; font-weight: 700; text-decoration: none;
}
.btn-guest > svg:first-child { width: 15px; height: 15px; color: var(--maroon-700); }
.btn-guest .guest-arrow { width: 13px; height: 13px; margin-left: auto; color: #b3a4a4; }

/* Footer card */
.auth-foot { margin-top: 10px; text-align: center; font-size: 11.5px; color: var(--muted); }
.auth-foot a { color: var(--maroon-700); font-weight: 800; text-decoration: none; }


.copyright {
  position: absolute;
  left: 450px;
  bottom: 16px;
  transform: translateX(-50%);
  margin: 0; 
  text-align: center; 
  font-size: 11px; 
  color: #fff; 
  background: rgba(0, 0, 0, 0.4); 
  border: 1px solid rgba(255, 255, 255, 0.2); 
  padding: 6px 16px; 
  border-radius: 999px; 
  backdrop-filter: blur(8px);
  white-space: nowrap;
  z-index: 10;
}
.copyright strong {
  color: rgb(151, 44, 44);
} 

/* Responsive */
@media (max-width: 768px) {
  body { justify-content: center; padding: 8px 12px; }
  .copyright { position: relative; left: auto; transform: none; bottom: auto; margin-top: 8px; color: #5b4a4a; background: rgba(255, 255, 255, 0.85); }
}
</style>
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body>

  <!-- Ornamen ambient -->
  <div class="bg-orb orb-1" aria-hidden="true"></div>
  <div class="bg-orb orb-2" aria-hidden="true"></div>

  <main class="auth-page">

    <!-- PANEL LOGIN MODERN -->
    <section class="auth-card" id="authCard">

      <header class="auth-head">
        <div class="brand-row">
          <div class="brand-logo">
            <img src="/images/dgs.png" alt="Logo DGS">
          </div>
          <div class="brand-text">
            <span class="brand-eyebrow">Warehouse System</span>
            <h1>Dian Giri Saputra</h1>
          </div>
        </div>
        <div class="head-badge">
          <span class="badge-dot"></span>
          Secure Portal
        </div>
      </header>

      <div class="auth-intro">
        <h2>Selamat Datang <span>Kembali</span></h2>
        <p>Pilih tipe akun dan masuk untuk mengelola data vendor, harga dasar, serta stok barang dalam satu sistem terintegrasi.</p>
      </div>

      <!-- Switch role User / Admin -->
      <div class="role-switch" role="tablist" aria-label="Pilih tipe akun">
        <span class="role-slider" id="roleSlider" aria-hidden="true"></span>

        <button type="button" id="roleBtnUser" class="role-btn active" role="tab" aria-selected="true" onclick="setRole('user')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>User</span>
        </button>

        <button type="button" id="roleBtnAdmin" class="role-btn" role="tab" aria-selected="false" onclick="setRole('admin')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
          <span>Admin</span>
        </button>
      </div>

      <!-- Form login langsung di halaman -->
      <form id="formLoginUtama" class="auth-form" onsubmit="prosesLoginUtama(event)">
        <div class="field">
          <label for="loginUsername" id="loginUsernameLabel">Username User</label>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <input type="text" id="loginUsername" name="username" placeholder="Masukkan username user" autocomplete="username" required>
          </div>
        </div>

        <div class="field">
          <label for="loginPassword">Password</label>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <input type="password" id="loginPassword" name="password" placeholder="Masukkan password" autocomplete="current-password" required>
            <button type="button" class="eye-btn" onclick="togglePassword('loginPassword', 'iconLoginPass')" aria-label="Tampilkan password">
              <i id="iconLoginPass" class="fa-solid fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-row">
          <label class="remember" for="rememberMe">
            <input type="checkbox" id="rememberMe">
            <span>Ingat saya</span>
          </label>
          <a href="javascript:void(0)" class="link-muted" onclick="tampilLupaPassword(roleAktif)">
            Lupa password?
          </a>
        </div>

        <button type="submit" class="btn-primary" id="btnLoginUtama">
          <span id="btnLoginText">Masuk sebagai User</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <div class="divider"><span>atau akses cepat</span></div>

      <a href="/dashboard-guest" class="btn-guest">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span>Masuk sebagai Guest (Tamu)</span>
        <svg class="guest-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>

      <p class="auth-foot">
        Belum punya akun?
        <a href="javascript:void(0)" onclick="bukaRegisterAktif()">Daftar sekarang</a>
      </p>
    </section>

    <p class="copyright">&copy; 2026 <strong>Dian Giri Saputra</strong>. All Rights Reserved.</p>
  </main>

    <!-- MODAL POP-UP FORM LOGIN & REGISTER -->
    <div id="modalLogin" onclick="tutupLoginLuar(event)" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); justify-content: center; align-items: center; z-index: 1000; padding: 20px; box-sizing: border-box;">
        <div class="modal-card">
            <span onclick="tutupLogin()" style="position: absolute; top: 15px; right: 20px; font-size: 22px; cursor: pointer; color: #888; font-weight: bold;">&times;</span>
            
            <% if (typeof error !== 'undefined') { %>
                <script>setTimeout(() => { document.getElementById('modalLogin').style.display = 'flex'; }, 100);</script>
                <div style="background-color: rgba(255, 235, 233, 0.9); color: #ff3b30; padding: 10px; border-radius: 8px; font-size: 13px; margin-bottom: 15px; border: 1px solid #ffccd5; text-align: left;">
                    ⚠️ <%= error %>
                </div>
            <% } %>

           <div class="auth-container">
    <!-- FORM 1A: LOGIN ADMIN -->
    <div id="boxLoginAdmin" style="display: none;">
        <h3 style="margin: 0 0 5px 0; color: #2c2c2c; font-size: 20px; font-weight: 700;">Verifikasi Admin</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Masukkan kredensial akun administrator Anda</p>

        <form onsubmit="prosesLogin(event, 'admin')" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="text" id="adminLoginUsername" name="username" placeholder="Username Admin" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <div style="position: relative; width: 100%;">
                <input type="password" name="password" id="adminPassword" placeholder="Password Admin" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('adminPassword', 'iconAdminPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconAdminPass" class="fa-solid fa-eye"></i>
                </span>
            </div>
            
            <div style="text-align: right; margin-top: -4px;">
                <a href="javascript:void(0)" onclick="tampilLupaPassword('admin')" style="font-size: 13px; color: #cf3939; text-decoration: none; font-weight: 600;">Lupa Password?</a>
            </div>

            <button type="submit" id="btnSubmitAdmin" style="padding: 12px; background-color: #cf3939; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Masuk Sebagai Admin</button>
            
            <div style="text-align: center; margin-top: 10px; font-size: 13px; color: #555;">
                Belum punya akun admin? <br>
                <a href="javascript:void(0)" onclick="bukaRegisterAdmin()" style="color: #cf3939; font-weight: 700; text-decoration: none;">Buat Akun Admin &rarr;</a>
            </div>
        </form>
    </div>

    <!-- FORM 1B: REGISTER ADMIN -->
    <div id="boxRegisterAdmin" style="display: none;">
        <h3 style="margin: 0 0 5px 0; color: #cf3939; font-size: 20px; font-weight: 700;">Buat Akun Admin</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Daftarkan akun administrator baru untuk kontrol sistem</p>

        <form onsubmit="prosesRegisterAdmin(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="text" id="adminRegUsername" placeholder="Username Admin Baru" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <div style="position: relative; width: 100%;">
                <input type="password" id="adminRegPassword" placeholder="Password Admin Baru" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('adminRegPassword', 'iconAdminRegPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconAdminRegPass" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div style="position: relative; width: 100%;">
                <input type="password" id="adminRegConfirmPassword" placeholder="Konfirmasi Password Admin" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('adminRegConfirmPassword', 'iconAdminRegConfirm')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconAdminRegConfirm" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <button type="submit" id="btnRegisterAdmin" style="padding: 12px; background-color: #cf3939; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Daftar Akun Admin</button>

            <div style="text-align: center; margin-top: 10px; font-size: 13px; color: #555;">
                Sudah punya akun admin? <br>
                <a href="javascript:void(0)" onclick="bukaLoginAdmin()" style="color: #cf3939; font-weight: 700; text-decoration: none;">&larr; Masuk Admin</a>
            </div>
        </form>
    </div>

    <!-- FORM 2A: LOGIN USER -->
    <div id="boxLoginUser" style="display: none;">
        <h3 style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Login Akun User</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Masukkan username dan password akun user Anda</p>

        <form onsubmit="prosesLogin(event, 'user')" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="text" id="userLoginUsername" name="username" placeholder="Username User" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <div style="position: relative; width: 100%;">
                <input type="password" name="password" id="userPassword" placeholder="Password User" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('userPassword', 'iconUserPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconUserPass" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div style="text-align: right; margin-top: -4px;">
                <a href="javascript:void(0)" onclick="tampilLupaPassword('user')" style="font-size: 13px; color: #7a1b1b; text-decoration: none; font-weight: 600;">Lupa Password?</a>
            </div>

            <button type="submit" id="btnSubmitUser" style="padding: 12px; background-color: #7a1b1b; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Masuk Ke Dashboard</button>

            <div style="text-align: center; margin-top: 10px; font-size: 13px; color: #555;">
                Belum punya akun user? <br>
                <a href="javascript:void(0)" onclick="bukaRegisterUser()" style="color: #7a1b1b; font-weight: 700; text-decoration: none;">Buat Akun User &rarr;</a>
            </div>

            <!-- TOMBOL GUEST / TAMU -->
            <div style="text-align: center; margin-top: 14px;">
                <a href="/dashboard-guest" style="display: block; padding: 10px; background-color: #f1f1f1; color: #444; border: 1px solid #ddd; border-radius: 8px; font-weight: 600; font-size: 14px; text-decoration: none; transition: 0.2s;">
                    <i class="fa-solid fa-eye" style="margin-right: 6px;"></i> Masuk sebagai Guest (Tamu)
                </a>
            </div>
        </form>
    </div>

    <!-- FORM 2B: REGISTER USER -->
    <div id="boxRegisterUser" style="display: none;">
        <h3 style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Buat Akun User</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Daftarkan akun user baru untuk akses operasional</p>

        <form onsubmit="prosesRegisterUser(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="text" id="userRegNama" placeholder="Nama Lengkap (Opsional)" style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <input type="text" id="userRegUsername" placeholder="Username User Baru" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <div style="position: relative; width: 100%;">
                <input type="password" id="userRegPassword" placeholder="Password User Baru" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('userRegPassword', 'iconUserRegPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconUserRegPass" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div style="position: relative; width: 100%;">
                <input type="password" id="userRegConfirmPassword" placeholder="Konfirmasi Password User" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('userRegConfirmPassword', 'iconUserRegConfirm')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconUserRegConfirm" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div style="position: relative; width: 100%;">
              <input type="text" id="userRegKodeRahasia" name="kodeRahasia" placeholder="Masukkan Kode Verifikasi Pendaftaran" required style="width: 100%; padding: 12px; background: #fffdfd; border: 2px dashed #7a1b1b; border-radius: 8px; font-size: 14px; outline: none; font-weight: bold; color: #7a1b1b; box-sizing: border-box;">
            </div>

            <button type="submit" id="btnRegisterUser" style="padding: 12px; background-color: #7a1b1b; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Daftar Akun User</button>

            <div style="text-align: center; margin-top: 10px; font-size: 13px; color: #555;">
                Sudah punya akun user? <br>
                <a href="javascript:void(0)" onclick="bukaLoginUser()" style="color: #7a1b1b; font-weight: 700; text-decoration: none;">&larr; Masuk User</a>
            </div>
        </form>
    </div>

    <!-- FORM 3: LUPA PASSWORD -->
    <div id="boxLupaPassword" style="display: none;">
        <h3 id="judulLupaPassword" style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Lupa Password</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Masukkan username Anda untuk verifikasi data akun di database.</p>

        <form onsubmit="prosesVerifikasiUser(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="hidden" id="roleLupaPassword" value="admin">
            <input type="text" id="inputUsernameLupa" placeholder="Masukkan Username Anda" required style="padding: 12px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none;">
            
            <button type="submit" id="btnVerifLupa" style="padding: 12px; background-color: #7a1b1b; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Lanjutkan & Verifikasi</button>
            
            <div style="text-align: center; margin-top: 6px;">
                <a href="javascript:void(0)" onclick="kembaliKeLoginRole()" style="font-size: 13px; color: #666; text-decoration: none;">&larr; Kembali ke Form Login</a>
            </div>
        </form>
    </div>

    <!-- FORM 4: UBAH PASSWORD BARU -->
    <div id="boxResetPassword" style="display: none;">
        <h3 id="judulResetPassword" style="margin: 0 0 5px 0; color: #7a1b1b; font-size: 20px; font-weight: 700;">Ubah Password Baru</h3>
        <p style="margin: 0 0 18px 0; color: #666; font-size: 13px;">Buat password baru. Password akan langsung diperbarui ke database.</p>

        <form onsubmit="prosesResetPassword(event)" style="display: flex; flex-direction: column; gap: 14px;">
            <input type="hidden" id="hiddenUsernameReset">
            <input type="hidden" id="hiddenRoleReset">
            
            <div style="position: relative; width: 100%;">
                <input type="password" name="newPassword" id="newPassword" placeholder="Password Baru (min. 4 karakter)" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('newPassword', 'iconNewPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconNewPass" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div style="position: relative; width: 100%;">
                <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Konfirmasi Password Baru" required style="width: 100%; padding: 12px; padding-right: 40px; background: rgba(255,255,255,0.9); border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; box-sizing: border-box;">
                <span onclick="togglePassword('confirmPassword', 'iconConfirmPass')" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #666;">
                    <i id="iconConfirmPass" class="fa-solid fa-eye"></i>
                </span>
            </div>
            
            <button type="submit" id="btnSimpanPassBaru" style="padding: 12px; background-color: #28a745; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 5px;">Simpan Password Baru</button>
            
            <div style="text-align: center; margin-top: 6px;">
                <a href="javascript:void(0)" onclick="kembaliKeLoginRole()" style="font-size: 13px; color: #666; text-decoration: none;">Batal</a>
            </div>
        </form>
    </div>
</div>

    <script>
    let roleAktif = 'admin'; // 'admin' atau 'user'

    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        
        if (urlParams.get('error') === 'Unauthorized') {
            window.history.replaceState({}, document.title, window.location.pathname);

            Swal.fire({
                icon: 'warning',
                title: 'Akses Ditolak!',
                text: 'Silakan login terlebih dahulu untuk mengakses dashboard.',
                confirmButtonColor: '#7a1b1b',
                confirmButtonText: 'Mengerti'
            });
        }
    });

    function sembunyikanSemuaBox() {
        document.getElementById('boxLoginAdmin').style.display = 'none';
        document.getElementById('boxRegisterAdmin').style.display = 'none';
        document.getElementById('boxLoginUser').style.display = 'none';
        document.getElementById('boxRegisterUser').style.display = 'none';
        document.getElementById('boxLupaPassword').style.display = 'none';
        document.getElementById('boxResetPassword').style.display = 'none';
    }

    function bukaLoginAdmin() {
        roleAktif = 'admin';
        document.getElementById('modalLogin').style.display = 'flex';
        sembunyikanSemuaBox();
        document.getElementById('boxLoginAdmin').style.display = 'block';
    }

    function bukaRegisterAdmin() {
        roleAktif = 'admin';
        document.getElementById('modalLogin').style.display = 'flex';
        sembunyikanSemuaBox();
        document.getElementById('boxRegisterAdmin').style.display = 'block';
    }

    function bukaLoginUser() {
        roleAktif = 'user';
        document.getElementById('modalLogin').style.display = 'flex';
        sembunyikanSemuaBox();
        document.getElementById('boxLoginUser').style.display = 'block';
    }

    function bukaRegisterUser() {
        roleAktif = 'user';
        document.getElementById('modalLogin').style.display = 'flex';
        sembunyikanSemuaBox();
        document.getElementById('boxRegisterUser').style.display = 'block';
    }

    function tutupLogin() {
        document.getElementById('modalLogin').style.display = 'none';
    }

    function tutupLoginLuar(e) {
        if (e.target.id === 'modalLogin') tutupLogin();
    }

    function tampilLupaPassword(role) {
        roleAktif = role || 'admin';
        document.getElementById('modalLogin').style.display = 'flex';
        sembunyikanSemuaBox();
        document.getElementById('boxLupaPassword').style.display = 'block';
        document.getElementById('roleLupaPassword').value = roleAktif;

        const judul = document.getElementById('judulLupaPassword');
        const btnVerif = document.getElementById('btnVerifLupa');
        if (roleAktif === 'admin') {
            judul.textContent = "Lupa Password Admin";
            judul.style.color = "#cf3939";
            btnVerif.style.backgroundColor = "#cf3939";
        } else {
            judul.textContent = "Lupa Password User";
            judul.style.color = "#7a1b1b";
            btnVerif.style.backgroundColor = "#7a1b1b";
        }
    }

    function kembaliKeLoginRole() {
        if (roleAktif === 'user') {
            bukaLoginUser();
        } else {
            bukaLoginAdmin();
        }
    }

    // PROSES LOGIN (ADMIN / USER)
    async function prosesLogin(event, role) {
        event.preventDefault();
        const username = event.target.username.value.trim();
        const password = event.target.password.value;

        if (!username || !password) {
            Swal.fire({
                icon: 'warning',
                title: 'Data Belum Lengkap',
                text: 'Silakan isi username dan password!',
                confirmButtonColor: '#7a1b1b'
            });
            return;
        }

        const endpoint = (role === 'user') ? '/login-user' : '/login-admin';
        const btn = (role === 'user') ? document.getElementById('btnSubmitUser') : document.getElementById('btnSubmitAdmin');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';
        btn.disabled = true;

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const result = await response.json();
            btn.innerHTML = originalText;
            btn.disabled = false;

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Login Berhasil!',
                    text: 'Selamat datang, mengalihkan ke dashboard...',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = result.redirect;
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Login Gagal',
                    text: result.message || 'Username atau password salah!',
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Login Error:", err);
            btn.innerHTML = originalText;
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Sistem',
                text: 'Terjadi gangguan koneksi ke server.',
                confirmButtonColor: '#dc3545'
            });
        }
    }

    // PROSES REGISTER ADMIN
    async function prosesRegisterAdmin(event) {
        event.preventDefault();
        const username = document.getElementById('adminRegUsername').value.trim();
        const password = document.getElementById('adminRegPassword').value;
        const confirmPassword = document.getElementById('adminRegConfirmPassword').value;

        if (password !== confirmPassword) {
            Swal.fire({
                icon: 'warning',
                title: 'Perhatian',
                text: 'Konfirmasi password tidak cocok!',
                confirmButtonColor: '#ffc107'
            });
            return;
        }

        const btn = document.getElementById('btnRegisterAdmin');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mendaftarkan...';
        btn.disabled = true;

        try {
            const response = await fetch('/register-admin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password, confirmPassword })
            });

            const result = await response.json();
            btn.innerHTML = 'Daftar Akun Admin';
            btn.disabled = false;

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Pendaftaran Berhasil!',
                    text: result.message,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Masuk Sekarang'
                }).then(() => {
                    bukaLoginAdmin();
                    document.getElementById('adminLoginUsername').value = username;
                    event.target.reset();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal Mendaftar',
                    text: result.message,
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Register Admin Error:", err);
            btn.innerHTML = 'Daftar Akun Admin';
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Sistem',
                text: 'Terjadi gangguan saat membuat akun admin.',
                confirmButtonColor: '#dc3545'
            });
        }
    }

    // PROSES REGISTER USER
    async function prosesRegisterUser(event) {
    event.preventDefault();

    const namaLengkap = document.getElementById('userRegNama').value;
    const username = document.getElementById('userRegUsername').value;
    const password = document.getElementById('userRegPassword').value;
    const confirmPassword = document.getElementById('userRegConfirmPassword').value;
    
    // Ambil nilai dari input yang baru diberi ID di atas
    const kodeRahasia = document.getElementById('userRegKodeRahasia').value;

    try {
        const response = await fetch('/register-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                namaLengkap,
                username,
                password,
                confirmPassword,
                kodeRahasia // Sekarang variabel ini terkirim dengan benar ke server!
            })
        });

        const result = await response.json();

        if (response.ok && result.success) {
            alert(result.message);
            bukaLoginUser(); // Kembali ke form login
        } else {
            alert(result.message || 'Gagal mendaftarkan akun.');
        }
    } catch (err) {
        console.error('Error:', err);
        alert('Terjadi kesalahan koneksi ke server.');
    }
}

    // VERIFIKASI USERNAME LUPA PASSWORD
    async function prosesVerifikasiUser(event) {
        event.preventDefault();
        const valUser = document.getElementById('inputUsernameLupa').value.trim();
        const role = document.getElementById('roleLupaPassword').value;
        if (valUser === '') return;

        const btn = document.getElementById('btnVerifLupa');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memeriksa...';
        btn.disabled = true;

        try {
            const response = await fetch('/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: valUser, role })
            });

            const result = await response.json();
            btn.innerHTML = 'Lanjutkan & Verifikasi';
            btn.disabled = false;

            if (result.success) {
                document.getElementById('hiddenUsernameReset').value = result.username || valUser;
                document.getElementById('hiddenRoleReset').value = result.role || role;
                sembunyikanSemuaBox();
                document.getElementById('boxResetPassword').style.display = 'block';
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Akun Tidak Ditemukan',
                    text: result.message || "Akun tidak terdaftar di database!",
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Error:", err);
            btn.innerHTML = 'Lanjutkan & Verifikasi';
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Server',
                text: "Terjadi kesalahan saat memeriksa akun.",
                confirmButtonColor: '#dc3545'
            });
        }
    }

    // PROSES RESET PASSWORD BARU
    async function prosesResetPassword(event) {
        event.preventDefault();
        const username = document.getElementById('hiddenUsernameReset').value;
        const role = document.getElementById('hiddenRoleReset').value;
        const newPassword = event.target.newPassword.value;
        const confirmPassword = event.target.confirmPassword.value;

        if (newPassword !== confirmPassword) {
            Swal.fire({
                icon: 'warning',
                title: 'Perhatian',
                text: "Konfirmasi password tidak cocok!",
                confirmButtonColor: '#ffc107'
            });
            return;
        }

        const btn = document.getElementById('btnSimpanPassBaru');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';
        btn.disabled = true;

        try {
            const response = await fetch('/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, role, newPassword, confirmPassword })
            });

            const result = await response.json();
            btn.innerHTML = 'Simpan Password Baru';
            btn.disabled = false;

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil Diperbarui!',
                    text: result.message,
                    confirmButtonText: 'Masuk Sekarang',
                    confirmButtonColor: '#28a745'
                }).then(() => {
                    kembaliKeLoginRole();
                    event.target.reset();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal Menyimpan',
                    text: result.message,
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (err) {
            console.error("Error:", err);
            btn.innerHTML = 'Simpan Password Baru';
            btn.disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Kesalahan Server',
                text: "Terjadi kesalahan pada server.",
                confirmButtonColor: '#dc3545'
            });
        }
    }

    function togglePassword(inputId, iconId) {
        const inputField = document.getElementById(inputId);
        const iconField = document.getElementById(iconId);

        if (inputField.type === "password") {
            inputField.type = "text";
            iconField.classList.remove("fa-eye");
            iconField.classList.add("fa-eye-slash");
        } else {
            inputField.type = "password";
            iconField.classList.remove("fa-eye-slash");
            iconField.classList.add("fa-eye");
        }
    }
</script>
  <script>
    /* ============================================================
       LOGIN UTAMA — ROLE SWITCH, REMEMBER ME, & SUBMIT
       ============================================================ */
    document.addEventListener('DOMContentLoaded', function () {
      // User sebagai pilihan default
      setRole('user');

      // Prefill username jika sebelumnya memilih "Ingat saya"
      try {
        const remembered = localStorage.getItem('dgs_remember_username');
        const rememberBox = document.getElementById('rememberMe');
        const usernameInput = document.getElementById('loginUsername');
        if (remembered && rememberBox && usernameInput) {
          usernameInput.value = remembered;
          rememberBox.checked = true;
        }
      } catch (err) {
        // localStorage tidak tersedia — abaikan
      }

      // Fokus otomatis ke field username
      const usernameField = document.getElementById('loginUsername');
      if (usernameField) {
        setTimeout(function () { usernameField.focus(); }, 400);
      }
    });

    function setRole(role) {
      roleAktif = role;
      const isUser = role === 'user';

      const btnUser = document.getElementById('roleBtnUser');
      const btnAdmin = document.getElementById('roleBtnAdmin');
      const slider = document.getElementById('roleSlider');
      const label = document.getElementById('loginUsernameLabel');
      const usernameInput = document.getElementById('loginUsername');
      const btnText = document.getElementById('btnLoginText');

      if (btnUser) {
        btnUser.classList.toggle('active', isUser);
        btnUser.setAttribute('aria-selected', String(isUser));
      }
      if (btnAdmin) {
        btnAdmin.classList.toggle('active', !isUser);
        btnAdmin.setAttribute('aria-selected', String(!isUser));
      }
      if (slider) {
        slider.style.transform = isUser ? 'translateX(0)' : 'translateX(100%)';
      }
      if (label) {
        label.textContent = isUser ? 'Username User' : 'Username Admin';
      }
      if (usernameInput) {
        usernameInput.placeholder = isUser ? 'Masukkan username user' : 'Masukkan username admin';
      }
      if (btnText) {
        btnText.textContent = isUser ? 'Masuk sebagai User' : 'Masuk sebagai Admin';
      }
    }

    function bukaRegisterAktif() {
      if (roleAktif === 'admin') {
        bukaRegisterAdmin();
      } else {
        bukaRegisterUser();
      }
    }

    async function prosesLoginUtama(event) {
      event.preventDefault();

      const usernameInput = document.getElementById('loginUsername');
      const passwordInput = document.getElementById('loginPassword');
      const btn = document.getElementById('btnLoginUtama');
      const btnText = document.getElementById('btnLoginText');
      const rememberBox = document.getElementById('rememberMe');

      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      if (!username || !password) {
        Swal.fire({
          icon: 'warning',
          title: 'Data Belum Lengkap',
          text: 'Silakan isi username dan password terlebih dahulu.',
          confirmButtonColor: '#7a1b1b'
        });
        return;
      }

      const role = roleAktif;
      const endpoint = (role === 'user') ? '/login-user' : '/login-admin';
      const originalText = btnText ? btnText.textContent : 'Masuk';

      if (btnText) btnText.textContent = 'Memproses...';
      if (btn) btn.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username, password: password })
        });

        const result = await response.json();

        if (btnText) btnText.textContent = originalText;
        if (btn) btn.disabled = false;

        if (result.success) {
          try {
            if (rememberBox && rememberBox.checked) {
              localStorage.setItem('dgs_remember_username', username);
            } else {
              localStorage.removeItem('dgs_remember_username');
            }
          } catch (err) {
            // abaikan jika localStorage diblokir
          }

          Swal.fire({
            icon: 'success',
            title: 'Login Berhasil!',
            text: 'Selamat datang, mengalihkan ke dashboard...',
            timer: 1500,
            timerProgressBar: true,
            showConfirmButton: false
          }).then(function () {
            window.location.href = result.redirect;
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Login Gagal',
            text: result.message || 'Username atau password salah!',
            confirmButtonColor: '#dc3545'
          });
        }
      } catch (err) {
        console.error('Login Error:', err);
        if (btnText) btnText.textContent = originalText;
        if (btn) btn.disabled = false;
        Swal.fire({
          icon: 'error',
          title: 'Kesalahan Sistem',
          text: 'Terjadi gangguan koneksi ke server.',
          confirmButtonColor: '#dc3545'
        });
      }
    }
  </script>

</body>
</html>
