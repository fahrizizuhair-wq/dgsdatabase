<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Master Database Vendor</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/LOGODGS.png">
    
   <style>
/* ============================================================
   LOGIN — RIGHT FORM & CENTERED COPYRIGHT ON LEFT BACKGROUND
   ============================================================ */
:root {
  --maroon-900: #4d0e0e;
  --maroon-800: #5f1414;
  --maroon-700: #7a1b1b;
  --maroon-600: #9e2a2b;
  --maroon-500: #b03a3a;
  --gold: #c9933b;
  --ink: #1e293b;
  --muted: #64748b;
  --line: #eee6e6;
  --surface: #ffffff;
}

*, *::before, *::after { box-sizing: border-box; }

html {
  height: 100%;
}

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background-color: #f4f6f9;
  color: var(--ink);
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-font-smoothing: antialiased;
}

/* Shell halaman: navbar kiri atas, form kanan atas, copyright di bawah */
.login-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(380px, 460px);
  grid-template-rows: auto 1fr auto;
  column-gap: 40px;
  padding: 22px 40px 0;
  align-items: start; /* Mengunci agar baris atas langsung rata */
}

/* Background */  
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(to left, rgba(122, 27, 27, 0.9) 0%, rgba(122, 27, 27, 0.4) 50%, rgba(255, 255, 255, 0.694) 100%),
              url('/images/BGLOGIN.png') no-repeat center center fixed;
  background-size: cover;
  z-index: -1;
  pointer-events: none;
}

/* Ornamen ambient */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: -1;
  opacity: 0.6;
}
.orb-1 { width: 420px; height: 420px; top: -140px; right: -100px; background: radial-gradient(circle, rgba(122, 27, 27, 0.6) 0%, transparent 70%); }
.orb-2 { width: 360px; height: 360px; bottom: -120px; left: -100px; background: radial-gradient(circle, rgba(201, 147, 59, 0.38) 0%, transparent 70%); }

/* Layout di kanan — form tetap di bagian atas */
.auth-page {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: start;
  width: 100%;
  max-width: 460px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 8px;
  padding-top: 0; /* Form sejajar dengan navbar kiri atas */
  position: relative;
  z-index: 1;
}

/* Kartu utama mentok atas-bawah */
.auth-card {
  width: 100%;
  position: relative;
  padding: 22px 30px 20px; 
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.94) 100%);
  border: 1px solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 30px 60px -20px rgba(35, 10, 10, 0.5);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  overflow: hidden;
}
.auth-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--maroon-700) 0%, var(--gold) 50%, var(--maroon-700) 100%);
}

/* Header brand */
.auth-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}
.brand-logo {
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid #f3e6e6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.brand-logo img { width: 100%; height: 100%; object-fit: contain; padding: 5px; display: block; }
.brand-eyebrow { font-size: 8.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--maroon-700); margin-bottom: 1px; }
.brand-text h1 { font-size: 14px; font-weight: 800; color: #2a1212; }
.head-badge { padding: 4px 9px; border-radius: 999px; background: #fdf2f2; border: 1px solid #f2dada; color: var(--maroon-700); font-size: 9px; font-weight: 800; }
.badge-dot { width: 5px; height: 5px; border-radius: 50%; background: #22c55e; }

/* Intro */
.auth-intro { margin-bottom: 12px; }
.auth-intro h2 { font-size: 20.5px; font-weight: 800; line-height: 1.15; color: #2a1212; }
.auth-intro h2 span { background: linear-gradient(120deg, var(--maroon-700) 0%, var(--maroon-500) 60%, var(--gold) 120%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.auth-intro p { margin-top: 3px; font-size: 12px; line-height: 1.4; color: var(--muted); }

/* Role switch */
.role-switch {
  position: relative; display: flex; padding: 3px; border-radius: 12px; background: #f4f0f0; border: 1px solid #ece3e3; margin-bottom: 12px;
}
.role-slider {
  position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px); border-radius: 9px; background: #ffffff; box-shadow: 0 2px 8px rgba(122, 27, 27, 0.14); transition: transform 0.3s ease;
}
.role-btn {
  position: relative; z-index: 1; flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 6px; border: none; border-radius: 9px; background: transparent; font-family: inherit; font-size: 12px; font-weight: 700; color: #8d7c7c; cursor: pointer;
}
.role-btn svg { width: 14px; height: 14px; }
.role-btn.active { color: var(--maroon-700); }

/* Form */
.auth-form { display: flex; flex-direction: column; gap: 9px; }
.field label { display: block; margin-bottom: 3px; font-size: 11px; font-weight: 700; color: #5b4a4a; }
.input-wrap {
  position: relative; display: flex; align-items: center; border-radius: 11px; background: #fbfafa; border: 1.5px solid var(--line);
}
.input-wrap:focus-within { background: #ffffff; border-color: rgba(122, 27, 27, 0.45); box-shadow: 0 0 0 3px rgba(122, 27, 27, 0.08); }
.input-wrap > svg { width: 16px; height: 16px; margin-left: 12px; color: #a99494; }
.input-wrap input {
  flex: 1; min-width: 0; border: none; outline: none; background: transparent; padding: 9px 12px; font-family: inherit; font-size: 13.5px; color: var(--ink);
}
.eye-btn { display: flex; align-items: center; justify-content: center; height: 100%; padding: 0 12px; border: none; background: transparent; color: #a99494; cursor: pointer; }

.form-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: -1px; }
.remember { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--muted); }
.remember input { width: 13px; height: 13px; accent-color: var(--maroon-700); }
.link-muted { font-size: 11.5px; font-weight: 700; color: var(--maroon-700); text-decoration: none; }

.btn-primary {
  display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px 16px; border: none; border-radius: 11px; background: linear-gradient(135deg, var(--maroon-700) 0%, var(--maroon-500) 100%); color: #ffffff; font-family: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; box-shadow: 0 8px 18px -6px rgba(122, 27, 27, 0.5);
}
.btn-primary svg { width: 15px; height: 15px; }

/* Divider */
.divider {
  display: flex; align-items: center; gap: 10px; margin: 10px 0 8px; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #b3a4a4;
}
.divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #ece3e3; }

/* Guest */
.btn-guest {
  display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 10px 16px; border-radius: 11px; border: 1.5px solid var(--line); background: #ffffff; color: #5b4a4a; font-size: 12.5px; font-weight: 700; text-decoration: none;
}
.btn-guest > svg:first-child { width: 15px; height: 15px; color: var(--maroon-700); }
.btn-guest .guest-arrow { width: 13px; height: 13px; margin-left: auto; color: #b3a4a4; }

/* Footer card */
.auth-foot { margin-top: 10px; text-align: center; font-size: 11.5px; color: var(--muted); }
.auth-foot a { color: var(--maroon-700); font-weight: 800; text-decoration: none; }


/* Navbar sederhana di area kiri atas */
.login-nav {
  grid-column: 1;
  grid-row: 1;
  justify-self: center;
  align-self: start;
  display: flex;
  align-items: center;
  
  /* Padding tipis atas-bawah agar pas rapat dengan teks, renggang di samping */
  padding: 5px 6px; 
  
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12); /* Semi transparan gelap/terang */
  border: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 2;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: #2a1212;
  min-width: 0;
}

.nav-brand img {
  width: 34px;
  height: 34px;
  padding: 4px;
  border-radius: 9px;
  background: #ffffff;
  border: 1px solid #f3e6e6;
  object-fit: contain;
  flex: 0 0 auto;
}

.nav-brand strong {
  display: block;
  font-size: 12.5px;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.nav-brand small {
  display: block;
  margin-top: 1px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--maroon-700);
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 100px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-links a {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px; /* Padding rapat atas-bawah, lebar ke samping */
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.nav-links a:hover {
  color: #ffffff;
  background: rgba(151, 49, 49, 0.957);
  box-shadow: 0 2px 8px rgba(157, 33, 33, 0.1);
}

.copyright {
  grid-column: 1 / -1;
  grid-row: 3;
  justify-self: center;
  align-self: end;
  margin: 30px 0 18px;
  padding: 6px 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(122, 27, 27, 0.12);
  font-size: 11px;
  color: #5b4a4a;
  text-align: center;
  white-space: nowrap;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 10;
}
.copyright strong {
  color: rgb(151, 44, 44);
} 

.hero-text {
  grid-column: 1;
  grid-row: 1;
  justify-self: center;
  align-self: center;
  margin-top: 180px;
  transform: translateY(20px);
  color: #ffffff;
  z-index: 2;
}

.hero-text h1 {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 750 !important;
  font-style: normal !important;
  font-size: 35px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: px;
  letter-spacing: -0.5px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
}

.hero-text h2 {
  font-family: 'Montserrat', sans-serif !important;
  font-weight: 650 !important;
  font-style: normal !important;
  font-size: 27px;
  font-weight: 500;
  color: rgba(255, 255, 255);
  letter-spacing: 0.3px;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
}

/* ============================================================
   MODAL AUTH — Buat Akun Admin/User, Lupa Password, Reset
   ============================================================ */
@keyframes modalFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes modalPopIn {
  from { opacity: 0; transform: translateY(14px) scale(0.985); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

#modalLogin {
  animation: modalFadeIn 0.18s ease both;
}

.modal-card {
  position: relative;
  width: 100%;
  max-width: 420px;
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  padding: 28px 28px 24px;
  border-radius: 22px;
  background: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 30px 70px -20px rgba(35, 10, 10, 0.55);
  animation: modalPopIn 0.22s ease both;
  scrollbar-width: thin;
  scrollbar-color: #d9c7c7 transparent;
}
.modal-card::-webkit-scrollbar { width: 8px; }
.modal-card::-webkit-scrollbar-thumb { background: #d9c7c7; border-radius: 999px; }
.modal-card::-webkit-scrollbar-track { background: transparent; }

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: #f6eeee;
  color: #8a6a6a;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  transition: background 0.18s ease, color 0.18s ease;
  z-index: 3;
}
.modal-close:hover { background: #f0dede; color: #7a1b1b; }

.modal-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 2px 0 20px;
  padding-right: 30px;
}

.modal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 13px;
  flex: 0 0 auto;
}
.modal-icon svg { width: 22px; height: 22px; }
.icon-admin { background: #fdeaea; color: #cf3939; }
.icon-user  { background: #f7eeee; color: #7a1b1b; }
.icon-lupa  { background: #fdf3e2; color: #b07a21; }
.icon-reset { background: #e9f7ee; color: #1f9d55; }

.modal-head h3 {
  margin: 0 0 4px;
  font-size: 19px;
  font-weight: 800;
  line-height: 1.2;
  color: #2a1212;
}
.modal-head p {
  margin: 0;
  font-size: 12.5px;
  line-height: 1.5;
  color: #7a6a6a;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.modal-field label {
  display: block;
  margin: 0 0 5px;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: #6b5a5a;
}

.modal-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: #fbf8f8;
  border: 1px solid #e8dede;
  border-radius: 11px;
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.modal-input-wrap:focus-within {
  background: #ffffff;
  border-color: rgba(122, 27, 27, 0.45);
  box-shadow: 0 0 0 3px rgba(122, 27, 27, 0.08);
}
.modal-input-wrap > svg {
  width: 16px;
  height: 16px;
  margin-left: 12px;
  flex: 0 0 auto;
  color: #b09c9c;
  pointer-events: none;
}
.modal-input-wrap input {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border: none;
  background: transparent;
  font: inherit;
  font-size: 13.5px;
  color: #2a1212;
  outline: none;
}
.modal-input-wrap input::placeholder { color: #b5a5a5; }
.modal-input-wrap.is-code {
  background: #fffdfd;
  border: 1.5px dashed #c9a3a3;
}
.modal-input-wrap.is-code:focus-within {
  border-style: solid;
  border-color: #7a1b1b;
}

.modal-eye {
  display: flex;
  align-items: center;
  align-self: stretch;
  padding: 0 12px;
  border: none;
  background: transparent;
  color: #a89494;
  cursor: pointer;
}
.modal-eye:hover { color: #7a1b1b; }

.modal-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -4px;
}

.modal-link {
  font-size: 12.5px;
  font-weight: 700;
  color: #7a1b1b;
  text-decoration: none;
}
.modal-link:hover { text-decoration: underline; }
.modal-link.is-admin { color: #cf3939; }

.modal-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 5px;
  padding: 12px 16px;
  border: none;
  border-radius: 11px;
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: filter 0.18s ease, transform 0.12s ease;
}
.modal-submit:hover { filter: brightness(1.06); }
.modal-submit:active { transform: translateY(1px); }
.modal-submit:disabled { opacity: 0.65; cursor: progress; }
.btn-admin { background: #cf3939; }
.btn-user  { background: #7a1b1b; }
.btn-lupa  { background: #b07a21; }
.btn-reset { background: #1f9d55; }

.modal-switch {
  margin: 4px 0 0;
  text-align: center;
  font-size: 12.5px;
  line-height: 1.6;
  color: #7a6a6a;
}
.modal-switch a {
  color: #7a1b1b;
  font-weight: 800;
  text-decoration: none;
}
.modal-switch a:hover { text-decoration: underline; }
.modal-switch.is-admin a { color: #cf3939; }

.modal-guest {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  padding: 12px;
  border: 1px solid #e8dede;
  border-radius: 11px;
  background: #faf7f7;
  color: #5b4a4a;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.18s ease;
}
.modal-guest:hover { background: #f4ecec; }

@media (max-width: 560px) {
  .modal-card {
    max-height: calc(100vh - 24px);
    padding: 24px 18px 20px;
    border-radius: 18px;
  }
  .modal-head { gap: 10px; padding-right: 26px; }
  .modal-head h3 { font-size: 17px; }
  .modal-head p { font-size: 12px; }
}

/* Responsive: di bawah 820px navbar & form ditumpuk (tidak muat berdampingan) */
@media (max-width: 820px) {
  .login-shell {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
    min-height: calc(100vh + 70px);
    padding: 16px 16px 0;
    row-gap: 8px;
  }
  .login-nav {
  grid-column: 1;
  grid-row: 1;
  justify-self: start;
  flex-wrap: wrap;
  padding: 20px 24px; 

}
  .auth-page {
    grid-column: 1;
    grid-row: 2;
    justify-self: center;
    align-self: start;
    width: 100%;
    max-width: 460px;
    padding-top: 8px;
  }
  .copyright {
    grid-column: 1;
    grid-row: 3;
    margin: 22px 0 14px;
    white-space: normal;
  }
}

@media (max-width: 560px) {
  .login-nav { flex-direction: column; align-items: flex-start; gap: 8px; }
  .nav-links { flex-wrap: wrap; }
  .nav-brand strong { font-size: 11.5px; }
}
</style>
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body>

  <!-- Ornamen ambient -->
  <div class="bg-orb orb-1" aria-hidden="true"></div>
  <div class="bg-orb orb-2" aria-hidden="true"></div>

  <div class="login-shell">
    <nav class="login-nav" aria-label="Navigasi utama">
      <ul class="nav-links">
        <li><a href="https://diangirisaputra.com/">Home</a></li>
        <li><a href="https://diangirisaputra.com/">About Us</a></li>
        <li><a href="https://diangirisaputra.com/">Contact Us</a></li>
      </ul>
    </nav>

    <div class="hero-text">
      <h1>Selamat Datang!</h1>
      <h2>Portal Internal Management System</h2>
    </div>
 
    <main class="auth-page">

    <!-- PANEL LOGIN MODERN -->
    <section class="auth-card" id="authCard">

      <header class="auth-head">
        <div class="brand-row">
          <div class="brand-logo">
            <img src="/images/dgs.png" alt="Logo DGS">
          </div>
          <div class="brand-text">
            <span class="brand-eyebrow">Warehouse System</span>
            <h1>Dian Giri Saputra</h1>
          </div>
        </div>
        <div class="head-badge">
          <span class="badge-dot"></span>
          Secure Portal
        </div>
      </header>

      <div class="auth-intro">
        <h2>Selamat Datang <span>Kembali</span></h2>
        <p>Pilih tipe akun dan masuk untuk mengelola data vendor, harga dasar, serta stok barang dalam satu sistem terintegrasi.</p>
      </div>

      <!-- Switch role User / Admin -->
      <div class="role-switch" role="tablist" aria-label="Pilih tipe akun">
        <span class="role-slider" id="roleSlider" aria-hidden="true"></span>

