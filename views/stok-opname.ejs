<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin - Stok Opname</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #333;
        display: flex;
        min-height: 100vh;
        position: relative;
        background-color: #f4f6f9;
      }

      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background:
          linear-gradient(
            to bottom,
            rgba(122, 27, 27, 0.85) 0%,
            rgba(122, 27, 27, 0.1) 40%,
            rgba(244, 246, 249, 0.88) 100%
          ),
          url('/images/background.jpg') no-repeat center top fixed;
        background-size: cover;
        z-index: -1;
        pointer-events: none;
      }

      /* Sidebar Styling */
      .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .sidebar-overlay.active {
        display: block;
        opacity: 1;
      }

      /* SIDEBAR */
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        height: 100vh;
        background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
        color: white;
        padding: 28px 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 1000;
        transform: translateX(-100%);
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25);
        overflow-y: auto;
      }
      .sidebar.active {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }
      .brand-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .brand-logo-img {
        width: 42px;
        height: 42px;
        object-fit: contain;
        background: rgba(255, 255, 255, 0.12);
        padding: 5px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      .brand-text h2 {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.3px;
        line-height: 1.2;
      }
      .brand-text span {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
      }
      .close-sidebar-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.2s;
      }
      .close-sidebar-btn:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .sidebar-user-card {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .user-avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
      }
      .sidebar-user-info h4 {
        font-size: 13px;
        font-weight: 600;
        color: white;
      }
      .sidebar-user-info span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: #86efac;
        font-weight: 500;
      }
      .sidebar-user-info span::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
      }

      .nav-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255, 255, 255, 0.5);
        margin: 10px 0 10px 8px;
      }
      .nav-menu {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .nav-item a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        color: rgba(255, 255, 255, 0.82);
        text-decoration: none;
        border-radius: 10px;
        font-weight: 500;
        font-size: 13.5px;
        transition: all 0.2s ease;
      }
      .nav-item a svg {
        width: 18px;
        height: 18px;
        opacity: 0.8;
        transition: transform 0.2s;
      }
      .nav-item a:hover {
        background-color: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        transform: translateX(3px);
      }
      .nav-item a:hover svg {
        opacity: 1;
        transform: scale(1.1);
      }
      .nav-item.active a {
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%);
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        border-left: 3px solid #f87171;
      }
      .nav-item.active a svg {
        opacity: 1;
      }

      /* DROPDOWN SIDEBAR */
      .nav-item.dropdown {
        position: relative;
      }
      .dropdown-toggle {
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
      }
      .dropdown-toggle-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .dropdown-toggle .arrow {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 11px;
        opacity: 0.8;
      }
      .dropdown-menu {
        list-style: none;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: rgba(50, 10, 10, 0.45);
        border-radius: 10px;
        margin-top: 4px;
        padding-left: 10px;
        border: 1px solid rgba(255, 255, 255, 0.06);
      }
      .dropdown-menu li a {
        padding: 9px 14px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.75);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .dropdown-menu li a:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
      }
      .nav-item.dropdown.active .dropdown-menu {
        max-height: 200px;
        padding-top: 6px;
        padding-bottom: 6px;
      }
      .nav-item.dropdown.active .arrow {
        transform: rotate(180deg);
      }

      .sidebar-footer {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
      }
      .btn-bottom {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.2s;
      }
      .btn-bottom:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
      }

      /* MAIN CONTENT */
      .main-content {
        flex: 1;
        padding: 30px;
        width: 100%;
      }
      .header-section h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #ffffff;
      }
      .header-section p {
        color: #ffffff;
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin: 25px 0;
      }
      .card {
        background: rgba(255, 255, 255, 0.95);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eef0f4;
        backdrop-filter: blur(5px);
      }
      .card-title {
        font-size: 14px;
        color: #666;
        margin-bottom: 8px;
      }
      .card-value {
        font-size: 26px;
        font-weight: 700;
        color: #7a1b1b;
      }

      /* TABLE */
      .table-container {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #eef0f4;
        backdrop-filter: blur(5px);
      }
      .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }
      .table-header h2 {
        color: #7a1b1b;
        margin-right: auto;
      }
      .search-input {
        padding: 10px 14px;
        border: 1px solid #dde1e5;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        width: 260px;
        background: white;
      }
      .btn-add {
        background-color: #7a1b1b;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-add:hover {
        background-color: #5c1313;
      }

      /* Kontainer khusus scroll horizontal tabel */
      .table-responsive-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 800px;
      }
      th,
      td {
        padding: 14px 16px;
        border-bottom: 1px solid #edf0f2;
        font-size: 14px;
        white-space: nowrap;
      }
      th {
        background-color: #f8f9fa;
        color: #555;
      }

      .item-row {
        transition: background-color 0.2s ease;
      }
      .item-row:hover {
        background-color: #f8eded;
      }

      .text-success {
        font-weight: 600;
        color: #137333;
      }
      .text-danger {
        font-weight: 600;
        color: #c5221f;
      }
      .text-normal {
        font-weight: bold;
        color: #333;
      }

      .btn-edit {
        background-color: #000000;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        margin-right: 4px;
      }
      .btn-edit:hover {
        background-color: #333;
      }
      .btn-delete {
        background-color: #912d2d;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-delete:hover {
        background-color: #7a2222;
      }

      /* MODAL */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 1000;
      }
      .modal-content {
        background: white;
        padding: 30px;
        border-radius: 12px;
        width: 450px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }
      .form-group {
        margin-bottom: 15px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
      }
      .form-group input,
      .form-group select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-family: inherit;
      }
      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
      }
      .btn-cancel {
        background: #e0e0e0;
        border: none;
        padding: 10px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
      }

      .toggle-btn {
        font-size: 20px;
        background: #ffffff;
        color: rgb(0, 0, 0);
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        margin-bottom: 20px;
      }

      /* ==========================================
       RESPONSIF MOBILE (Layar di bawah 768px)
       ========================================== */
      @media (max-width: 768px) {
        .main-content {
          padding: 16px !important;
        }
        .cards-grid {
          grid-template-columns: 1fr !important;
          gap: 12px !important;
        }
        .table-header {
          flex-direction: column !important;
          align-items: stretch !important;
          gap: 10px !important;
        }
        .search-input {
          width: 100% !important;
        }
        .table-container {
          padding: 16px 12px !important;
        }
      }
    </style>
    <link rel="stylesheet" href="/css/stat-cards.css" />

  <style id="mobile-card-view">
    /* ============================================================
       TAMPILAN KARTU MOBILE — HANYA UNTUK LAYAR <= 768px
       Desktop/laptop tidak berubah.
       ============================================================ */
    @media (max-width: 768px) {
      .main-content {
        padding: 16px !important;
      }
      .main-box {
        padding: 16px !important;
        overflow: visible !important;
      }
      .table-responsive-container,
      .table-responsive-wrapper,
      .table-responsive {
        overflow: visible !important;
      }
      
      /* dasar kartu */
      #stokTable {
        min-width: 0 !important;
        width: 100% !important;
        border: 0 !important;
        background: transparent !important;
      }
      #stokTable thead {
        display: none !important;
      }
      #stokTable,
      #stokTable tbody {
        display: block !important;
        width: 100% !important;
      }
      #stokTable tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 3px 12px;
        align-items: center;
        margin: 0 0 10px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
      }
      #stokTable tbody td {
        display: block;
        padding: 0;
        border: 0 !important;
        background: transparent;
        font-size: 13px;
        line-height: 1.4;
        color: #475569;
        text-align: left !important;
        vertical-align: middle;
        white-space: normal;
      }
      #stokTable tbody td[colspan] {
        display: block !important;
        grid-column: 1 / -1 !important;
        grid-row: 1 / span 4 !important;
        padding: 18px 8px !important;
        text-align: center !important;
      }
      #stokTable tbody td .badge {
        font-size: 10.5px;
        padding: 4px 9px;
      }
      /* tombol aksi kompak */
      #stokTable tbody td .btn-detail,
      #stokTable tbody td .btn-edit,
      #stokTable tbody td .btn-delete,
      #stokTable tbody td .btn-action,
      #stokTable tbody td .btn-sub-action {
        margin: 0 !important;
        padding: 6px 10px !important;
        font-size: 11.5px !important;
        line-height: 1.2;
        border-radius: 6px;
        white-space: nowrap;
      }
      #stokTable tbody td form {
        margin: 0 !important;
        display: inline-flex !important;
      }
      
  
      
      #stokTable tbody tr {
        grid-template-areas:
          "kategori total"
          "title actions"
          "masuk keluar";
      }
      #stokTable tbody td:nth-child(1) {
        grid-area: title;
        font-size: 14.5px;
        font-weight: 700;
        color: #0f172a;
      }
      #stokTable tbody td:nth-child(2) {
        grid-area: kategori;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        color: #94a3b8;
      }
      #stokTable tbody td:nth-child(4) {
        grid-area: masuk;
        font-size: 12px;
        font-weight: 700;
        color: #15803d;
        white-space: nowrap;
      }
      #stokTable tbody td:nth-child(4)::before {
        content: "Masuk ";
        font-size: 10.5px;
        font-weight: 600;
        color: #94a3b8;
      }
      #stokTable tbody td:nth-child(5) {
        grid-area: keluar;
        justify-self: end;
        font-size: 12px;
        font-weight: 700;
        color: #b91c1c;
        white-space: nowrap;
      }
      #stokTable tbody td:nth-child(5)::before {
        content: "Keluar ";
        font-size: 10.5px;
        font-weight: 600;
        color: #94a3b8;
      }
      #stokTable tbody td:nth-child(6) {
        grid-area: total;
        justify-self: end;
        align-self: start;
        padding: 3px 9px !important;
        border-radius: 999px;
        background: #f1f5f9;
        font-size: 11.5px;
        font-weight: 800;
        white-space: nowrap;
      }
      
      #stokTable tbody td:nth-child(8) {
        grid-area: actions;
        justify-self: end;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: flex-end;
      }
      #stokTable tbody td:nth-child(3),
      #stokTable tbody td:nth-child(7) {
        display: none;
      }
  
    }
  </style>

    <link rel="stylesheet" href="/css/system-banner.css" />
</head>
  <body>

     <%- include('partials/sidebar-admin', { activePage: 'stok-opname' }) %>

    <main class="main-content">
      <header class="system-banner no-print">
        <div class="banner-title-wrap">
          <button type="button" class="banner-toggle-btn" onclick="toggleSidebar()" title="Buka Sidebar" aria-label="Buka Sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="banner-text">
            <span>System Pengadaan &bull; Admin</span>
            <h1>Manajemen Stok Opname</h1>
            <p>Audit fisik dan kalkulasi ketersediaan stok barang.</p>
          </div>
        </div>
      </header>

      <%
  var _opnameList = (typeof listStokOpname !== 'undefined' && listStokOpname) ? listStokOpname : [];
  var _opnameMasuk = _opnameList.reduce(function (a, i) { return a + (Number(i.stokMasuk) || 0); }, 0);
  var _opnameKeluar = _opnameList.reduce(function (a, i) { return a + (Number(i.stokKeluar) || 0); }, 0);
%>
      <section class="card-grid">
        <div class="stat-card card-blue">
          <div class="card-header">
            <span class="card-title">Total Jenis Barang</span>
            <div class="icon-wrapper icon-blue">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalOpname !== 'undefined' ? totalOpname : 0 %></span>
            <span class="card-unit">Item</span>
          </div>
          <div class="card-footer">
            <span class="text-blue">Data Opname</span>
            <span>Seluruh Barang</span>
          </div>
        </div>
        <div class="stat-card card-green">
          <div class="card-header">
            <span class="card-title">Total Stok Masuk</span>
            <div class="icon-wrapper icon-green">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof _opnameMasuk !== 'undefined' ? _opnameMasuk : 0 %></span>
            <span class="card-unit">Pcs</span>
          </div>
          <div class="card-footer">
            <span class="text-green">Penambahan Stok</span>
            <span>Barang Masuk</span>
          </div>
        </div>
        <div class="stat-card card-red">
          <div class="card-header">
            <span class="card-title">Total Stok Keluar</span>
            <div class="icon-wrapper icon-red">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof _opnameKeluar !== 'undefined' ? _opnameKeluar : 0 %></span>
            <span class="card-unit">Pcs</span>
          </div>
          <div class="card-footer">
            <span class="text-red">Pengurangan Stok</span>
            <span>Barang Keluar</span>
          </div>
        </div>
      </section>

      <section class="table-container">
        <div class="table-header">
          <h2>Daftar Stok Opname</h2>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Cari barang..."
            onkeyup="filterTable()"
          />
          <button class="btn-add" onclick="openModal()">+ Tambah Opname</button>
        </div>

        <div class="table-responsive-wrapper">
          <table id="stokTable">
            <thead>
              <tr>
                <th>Nama Barang</th>
                <th>Kategori</th>
                <th>Stok Awal</th>
                <th>Stok Masuk</th>
                <th>Stok Keluar</th>
                <th>Stok Akhir</th>
                <th>Diinput Oleh</th>
                <th style="text-align: center">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (!listStokOpname || listStokOpname.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 20px; color: #888">Belum ada data stok opname.</td>
              </tr>
              <% } else { %>
              <% listStokOpname.forEach(function(item) { %>
              <% 
                  var stokAwal = Number(item.stokAwal) || 0;
                  var stokMasuk = Number(item.stokMasuk) || 0;
                  var stokKeluar = Number(item.stokKeluar) || 0;
                  var totalAkhir = stokAwal + stokMasuk - stokKeluar;
                  var kelasWarna = 'text-normal';
                  if (totalAkhir < 0) {
                    kelasWarna = 'text-danger';
                  }
                %>
              <tr class="item-row">
                <td
                  ><strong><%= item.namaBarang %></strong></td
                >
                <td><%= item.kategori %></td>
                <td><%= stokAwal %></td>
                <td class="text-success">+<%= stokMasuk %></td>
                <td class="text-danger">-<%= stokKeluar %></td>
                <td class="<%= kelasWarna %>"><%= totalAkhir %></td>
                <td><%= item.diinputOleh || '-' %></td>
                <td style="text-align: center; white-space: nowrap">
                  <button
                    type="button"
                    class="btn-edit"
                    data-id="<%= item._id %>"
                    data-namabarang="<%= item.namaBarang %>"
                    data-kategori="<%= item.kategori %>"
                    data-stokawal="<%= stokAwal %>"
                    data-stokmasuk="<%= stokMasuk %>"
                    data-stokkeluar="<%= stokKeluar %>"
                    onclick="openEditModalFromBtn(this)"
                    >Edit</button
                  >
                  <form
                    action="/stok-opname/delete/<%= item._id %>"
                    method="POST"
                    style="display: inline"
                    onsubmit="return confirm('Hapus opname barang <%= item.namaBarang %>?');"
                  >
                    <button type="submit" class="btn-delete">Hapus</button>
                  </form>
                </td>
              </tr>
              <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- MODAL TAMBAH -->
    <div class="modal" id="addModal">
      <div class="modal-content">
        <h3 style="margin-bottom: 15px; color: #7a1b1b">Tambah Stok Opname</h3>
        <form action="/stok-opname/add" method="POST">
          <div class="form-group"
            ><label>Nama Barang</label><input type="text" name="namaBarang" placeholder="Nama Barang" required
          /></div>
          <div class="form-group"
            ><label>Kategori</label><input type="text" name="kategori" placeholder="Kategori Barang" required
          /></div>
          <div class="form-group"
            ><label>Stok Awal</label><input type="number" name="stokAwal" min="0" value="0" required
          /></div>
          <div class="form-group"
            ><label>Stok Masuk</label><input type="number" name="stokMasuk" min="0" value="0" required
          /></div>
          <div class="form-group"
            ><label>Stok Keluar</label><input type="number" name="stokKeluar" min="0" value="0" required
          /></div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
            <button type="submit" class="btn-add">Simpan</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL EDIT -->
    <div class="modal" id="editModal">
      <div class="modal-content">
        <h3 style="margin-bottom: 15px; color: #7a1b1b">Edit Stok Opname</h3>
        <form id="editForm" method="POST">
          <div class="form-group"
            ><label>Nama Barang</label><input type="text" id="editNamaBarang" name="namaBarang" required
          /></div>
          <div class="form-group"
            ><label>Kategori</label><input type="text" id="editKategori" name="kategori" required
          /></div>
          <div class="form-group"
            ><label>Stok Awal</label><input type="number" id="editStokAwal" name="stokAwal" min="0" required
          /></div>
          <div class="form-group"
            ><label>Stok Masuk</label><input type="number" id="editStokMasuk" name="stokMasuk" min="0" required
          /></div>
          <div class="form-group"
            ><label>Stok Keluar</label><input type="number" id="editStokKeluar" name="stokKeluar" min="0" required
          /></div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeEditModal()">Batal</button>
            <button type="submit" class="btn-add">Perbarui</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function openModal() {
        document.getElementById('addModal').style.display = 'flex';
      }
      function closeModal() {
        document.getElementById('addModal').style.display = 'none';
      }

      function openEditModalFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        document.getElementById('editForm').action = '/stok-opname/edit/' + id;
        document.getElementById('editNamaBarang').value = btn.getAttribute('data-namabarang');
        document.getElementById('editKategori').value = btn.getAttribute('data-kategori');
        document.getElementById('editStokAwal').value = btn.getAttribute('data-stokawal');
        document.getElementById('editStokMasuk').value = btn.getAttribute('data-stokmasuk');
        document.getElementById('editStokKeluar').value = btn.getAttribute('data-stokkeluar');
        document.getElementById('editModal').style.display = 'flex';
      }
      function closeEditModal() {
        document.getElementById('editModal').style.display = 'none';
      }

      function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay') || document.getElementById('overlay');
        if (sidebar) sidebar.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
      }

      function toggleDropdown(element) {
        element.parentElement.classList.toggle('active');
      }

      function filterTable() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.getElementsByClassName('item-row');
        for (let row of rows) {
          row.style.display = row.textContent.toLowerCase().includes(input) ? '' : 'none';
        }
      }
    </script>
  </body>
</html>
