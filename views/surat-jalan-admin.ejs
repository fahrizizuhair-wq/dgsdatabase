<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Surat Jalan dan Tanda Terima - Admin</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f4f6f9; color: #333; }
    
    /* Top Banner / Hero Section */
    .hero {
      background: linear-gradient(135deg, #7a1b1b 0%, #5c1313 100%);
      color: #fff;
      padding: 40px 40px 80px 40px;
    }
    .hero-title { font-size: 26px; font-weight: 700; margin-bottom: 8px; }
    .hero-subtitle { font-size: 14px; opacity: 0.9; }

    /* Main Container */
    .main-container { max-width: 1300px; margin: -40px auto 40px auto; padding: 0 20px; }

    /* Summary Cards */
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
    .card { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); position: relative; }
    .card-title { font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 12px; }
    .card-value { font-size: 32px; font-weight: 700; color: #1e293b; margin-bottom: 15px; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #64748b; border-top: 1px solid #f1f5f9; padding-top: 12px; }
    .card-footer span:last-child { font-weight: 600; color: #1e293b; }

    /* Content Box / Table Section */
    .content-box { background: #fff; border-radius: 12px; padding: 30px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .box-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .box-title { font-size: 20px; font-weight: 700; color: #1e293b; }

    /* Buttons */
    .btn { padding: 9px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: none; }
    .btn-primary { background: #7a1b1b; color: #fff; }
    .btn-primary:hover { background: #5c1313; }
    .btn-secondary { background: #e2e8f0; color: #475569; }
    .btn-warning { background: #d97706; color: #fff; }
    .btn-danger { background: #dc2626; color: #fff; }

    /* Table Styling */
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 14px 16px; border-bottom: 1px solid #edf2f7; font-size: 13px; text-align: left; }
    th { color: #64748b; font-weight: 700; background: #f8fafc; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
    td { color: #1e293b; font-weight: 500; }
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .badge-barang { background: #e0f2fe; color: #0369a1; }
    .badge-dokumen { background: #fef3c7; color: #b45309; }

    /* Modal Pop-up Styling */
    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); overflow-y: auto; padding: 20px; }
    .modal-content { background: #fff; max-width: 650px; margin: 40px auto; padding: 30px; border-radius: 12px; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .close-modal { position: absolute; right: 20px; top: 20px; font-size: 20px; cursor: pointer; color: #64748b; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 12px; font-weight: 600; color: #64748b; margin-bottom: 5px; text-transform: uppercase; }
    .form-control { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; font-family: inherit; }
    .action-btns { display: flex; gap: 6px; }
  </style>
</head>
<body>

  <!-- HERO HEADER -->
  <div class="hero">
    <div style="max-width: 1300px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div>
        <div class="hero-title">Data Surat Jalan dan Tanda Terima (Admin)</div>
        <div class="hero-subtitle">Kelola, edit, dan pantau seluruh dokumen pengiriman barang PT Dian Giri Saputra</div>
      </div>
      <div>
        <a href="/surat-jalan-user" class="btn" style="background: rgba(255,255,255,0.2); color: #fff;"><i class="fa-solid fa-user"></i> Mode User</a>
      </div>
    </div>
  </div>

  <div class="main-container">
    <% 
      const totalSurat = daftarSurat ? daftarSurat.length : 0;
      const totalBarang = daftarSurat ? daftarSurat.filter(s => (s.jenisKirim || 'Barang').toLowerCase() === 'barang').length : 0;
      const totalDokumen = daftarSurat ? daftarSurat.filter(s => (s.jenisKirim || '').toLowerCase() === 'dokumen').length : 0;
    %>

    <!-- STATS CARDS -->
    <div class="cards-grid">
      <div class="card">
        <div class="card-title">Total Surat & Dokumen</div>
        <div class="card-value"><%= totalSurat %> <span style="font-size: 16px; font-weight: 500; color: #64748b;">Dokumen</span></div>
        <div class="card-footer">
          <span>Arsip Tersedia</span>
          <span>PT Dian Giri Saputra</span>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Pengiriman Barang</div>
        <div class="card-value"><%= totalBarang %> <span style="font-size: 16px; font-weight: 500; color: #64748b;">Barang</span></div>
        <div class="card-footer">
          <span style="color: #0284c7; font-weight: 600;">Logistik</span>
          <span>Aktif</span>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Pengiriman Dokumen</div>
        <div class="card-value"><%= totalDokumen %> <span style="font-size: 16px; font-weight: 500; color: #64748b;">Dokumen</span></div>
        <div class="card-footer">
          <span style="color: #d97706; font-weight: 600;">Administrasi</span>
          <span>Resmi</span>
        </div>
      </div>
    </div>

    <!-- TABLE SECTION -->
    <div class="content-box">
      <div class="box-header">
        <div class="box-title">Daftar Dokumen Keseluruhan</div>
        <button class="btn btn-primary" onclick="openModal()"><i class="fa-solid fa-plus"></i> Buat Surat Baru</button>
      </div>

      <table>
        <thead>
          <tr>
            <th style="width: 50px; text-align: center;">No</th>
            <th>Jenis Surat</th>
            <th>No. Surat Jalan</th>
            <th>Tanggal</th>
            <th>Kepada Yth</th>
            <th>Perihal / Pekerjaan</th>
            <th>Jenis</th>
            <th>Diinput Oleh</th>
            <th style="width: 210px; text-align: center;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (daftarSurat && daftarSurat.length > 0) { %>
            <% daftarSurat.forEach((surat, index) => { %>
              <tr>
                <td style="text-align: center;"><%= index + 1 %></td>
                <td><strong><%= surat.jenisSurat || 'Surat Jalan' %></strong></td>
                <td><%= surat.noSuratJalan %></td>
                <td><%= surat.tanggal ? new Date(surat.tanggal).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) : '-' %></td>
                <td><%= surat.kepadaYth %></td>
                <td><%= surat.perihal || surat.pekerjaan || '-' %></td>
                <td>
                  <span class="badge <%= (surat.jenisKirim || 'Barang').toLowerCase() === 'dokumen' ? 'badge-dokumen' : 'badge-barang' %>">
                    <%= surat.jenisKirim || 'Barang' %>
                  </span>
                </td>
                <td><%= surat.diinputOleh || 'System' %></td>
                <td style="text-align: center;">
                  <div class="action-btns" style="justify-content: center;">
                    <a href="/surat-jalan/detail/<%= surat._id %>" class="btn btn-secondary" style="padding: 5px 10px;" title="Detail"><i class="fa-solid fa-eye"></i></a>
                    <a href="/surat-jalan/cetak/<%= surat._id %>" target="_blank" class="btn btn-primary" style="padding: 5px 10px;" title="Cetak"><i class="fa-solid fa-print"></i></a>
                    <button class="btn btn-warning" style="padding: 5px 10px;" onclick="openEditModal('<%= JSON.stringify(surat) %>')" title="Edit"><i class="fa-solid fa-pen"></i></button>
                    <form action="/surat-jalan-admin/delete/<%= surat._id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus dokumen ini?');" style="display:inline;">
                      <button type="submit" class="btn btn-danger" style="padding: 5px 10px;" title="Hapus"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="9" style="text-align: center; color: #888; padding: 30px;">Belum ada data dokumen yang tersedia.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL FORM TAMBAH / EDIT -->
  <div id="suratModal" class="modal">
    <div class="modal-content">
      <span class="close-modal" onclick="closeModal()">&times;</span>
      <h3 id="modalTitle" style="color: #7a1b1b; margin-bottom: 20px;">Buat Surat Baru</h3>
      
      <form id="suratForm" method="POST" action="/surat-jalan-admin/add">
        <div class="form-group">
          <label>Jenis Surat</label>
          <select name="jenisSurat" id="jenisSurat" class="form-control" required>
            <option value="Surat Jalan">Surat Jalan</option>
            <option value="Tanda Terima">Tanda Terima</option>
          </select>
        </div>

        <div class="form-group">
          <label>No. Surat Jalan</label>
          <input type="text" name="noSuratJalan" id="noSuratJalan" class="form-control" required placeholder="Contoh: 034/DGS-PTPL/SJ-BRG/X/2026">
        </div>

        <div class="form-group">
          <label>Nama Perusahaan</label>
          <input type="text" name="namaPerusahaan" id="namaPerusahaan" class="form-control" required value="PT DIAN GIRI SAPUTRA">
        </div>

        <div class="form-group">
          <label>Kepada Yth</label>
          <input type="text" name="kepadaYth" id="kepadaYth" class="form-control" required placeholder="Nama perusahaan tujuan...">
        </div>

        <div class="form-group">
          <label>Alamat Tujuan</label>
          <textarea name="alamat" id="alamat" class="form-control" rows="3" required placeholder="Alamat lengkap..."></textarea>
        </div>

        <div class="form-group">
          <label>Perihal</label>
          <input type="text" name="perihal" id="perihal" class="form-control" placeholder="Perihal pengiriman...">
        </div>

        <div style="text-align: right; margin-top: 20px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn btn-primary">Simpan Data</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() {
      document.getElementById('modalTitle').innerText = "Buat Surat Baru";
      document.getElementById('suratForm').action = "/surat-jalan-admin/add";
      document.getElementById('suratForm').reset();
      document.getElementById('suratModal').style.display = "block";
    }

    function openEditModal(dataStr) {
      const surat = JSON.parse(dataStr);
      document.getElementById('modalTitle').innerText = "Edit Dokumen";
      document.getElementById('suratForm').action = "/surat-jalan-admin/edit/" + surat._id;
      
      document.getElementById('jenisSurat').value = surat.jenisSurat || 'Surat Jalan';
      document.getElementById('noSuratJalan').value = surat.noSuratJalan || '';
      document.getElementById('namaPerusahaan').value = surat.namaPerusahaan || '';
      document.getElementById('kepadaYth').value = surat.kepadaYth || '';
      document.getElementById('alamat').value = surat.alamat || '';
      document.getElementById('perihal').value = surat.perihal || '';

      document.getElementById('suratModal').style.display = "block";
    }

    function closeModal() {
      document.getElementById('suratModal').style.display = "none";
    }

    window.onclick = function(event) {
      var modal = document.getElementById('suratModal');
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  </script>
</body>
</html>