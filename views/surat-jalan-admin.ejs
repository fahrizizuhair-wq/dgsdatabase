<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Database - Surat Jalan</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow-x: hidden; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; color: #333; display: flex; min-height: 100vh; position: relative; background-color: #f4f6f9; }

    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    
    .sidebar-overlay { 
      display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
      background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(4px); z-index: 999; opacity: 0; transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active { display: block; opacity: 1; }

    .sidebar { 
      position: fixed; top: 0; left: 0; width: 280px; height: 100vh; 
      background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
      color: white; padding: 28px 22px; display: flex; flex-direction: column; justify-content: space-between; 
      z-index: 1000; transform: translateX(-100%); transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); 
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25); overflow-y: auto;
    }
    .sidebar.active { transform: translateX(0); }

    .sidebar-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 25px; padding-bottom: 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .brand-wrap { display: flex; align-items: center; gap: 12px; }
    .brand-logo-img {
      width: 42px; height: 42px; object-fit: contain; background: rgba(255, 255, 255, 0.12);
      padding: 5px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .brand-text h2 { font-size: 15px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.2; }
    .brand-text span { font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.7); font-weight: 600; }
    
    .close-sidebar-btn {
      background: rgba(255, 255, 255, 0.1); border: none; color: white; width: 32px; height: 32px;
      border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; transition: all 0.2s;
    }
    .close-sidebar-btn:hover { background: rgba(255, 255, 255, 0.2); }

    .sidebar-user-card {
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px; padding: 12px 14px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px;
    }
    .user-avatar-circle {
      width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
      color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }
    .sidebar-user-info h4 { font-size: 13px; font-weight: 600; color: white; }
    .sidebar-user-info span { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #86efac; font-weight: 500; }
    .sidebar-user-info span::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px #22c55e; }

    .nav-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.5); margin: 10px 0 10px 8px; }
    .nav-menu { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .nav-item a { 
      display: flex; align-items: center; gap: 12px; padding: 11px 14px; color: rgba(255, 255, 255, 0.82); 
      text-decoration: none; border-radius: 10px; font-weight: 500; font-size: 13.5px; transition: all 0.2s ease;
    }
    .nav-item a svg { width: 18px; height: 18px; opacity: 0.8; transition: transform 0.2s; }
    .nav-item a:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; transform: translateX(3px); }
    .nav-item a:hover svg { opacity: 1; transform: scale(1.1); }
    .nav-item.active > a { 
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%); 
      color: #ffffff; font-weight: 600; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15); border-left: 3px solid #f87171;
    }
    .nav-item.active > a svg { opacity: 1; }

    .nav-item.dropdown { position: relative; }
    .dropdown-toggle { display: flex !important; justify-content: space-between; align-items: center; cursor: pointer; }
    .dropdown-toggle-left { display: flex; align-items: center; gap: 12px; }
    .dropdown-toggle .arrow { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); font-size: 11px; opacity: 0.8; }
    .dropdown-menu {
      list-style: none; max-height: 0; overflow: hidden; transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      background-color: rgba(50, 10, 10, 0.45); border-radius: 10px; margin-top: 4px; padding-left: 10px; border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .dropdown-menu li a { padding: 9px 14px; font-size: 13px; color: rgba(255, 255, 255, 0.75); display: flex; align-items: center; gap: 10px; }
    .dropdown-menu li a:hover { color: #ffffff; background-color: rgba(255, 255, 255, 0.08); }
    .nav-item.dropdown.active .dropdown-menu { max-height: 200px; padding-top: 6px; padding-bottom: 6px; }
    .nav-item.dropdown.active .arrow { transform: rotate(180deg); }

    .sidebar-footer { display: flex; flex-direction: column; gap: 10px; margin-top: 25px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.12); }
    .btn-bottom {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: rgba(255, 255, 255, 0.8);
      text-decoration: none; font-size: 13.5px; font-weight: 500; border-radius: 8px; transition: all 0.2s;
    }
    .btn-bottom:hover { background: rgba(255, 255, 255, 0.1); color: white; }

    .main-content { flex: 1; padding: 30px; width: 100%; overflow-x: auto; }
    .header-section h1 { font-size: 28px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .header-section p { color: #ffffff; }
    
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
    
    .report-container { background: rgba(255, 255, 255, 0.95); border-radius: 12px; padding: 24px; border: 1px solid #eef0f4; backdrop-filter: blur(5px); overflow-x: auto; }
    .report-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .report-header h2 { color: #7a1b1b; margin-right: auto; }

    .btn-action { background-color: #7a1b1b; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { background-color: #5c1313; }

    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 980px; margin-top: 10px; }
    th, td { padding: 12px 14px; border-bottom: 1px solid #edf0f2; font-size: 13px; vertical-align: middle; }
    th { background-color: #f8f9fa; color: #555; }

    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-barang { background-color: #e0f2fe; color: #0369a1; }
    .badge-dokumen { background-color: #fef3c7; color: #b45309; }

    .action-btns { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn-sub-action {
      padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;
      text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: none; cursor: pointer;
    }
    .btn-view { background-color: #f1f5f9; color: #475569; }
    .btn-view:hover { background-color: #e2e8f0; }
    .btn-print { background-color: #7a1b1b; color: #fff; }
    .btn-print:hover { background-color: #5c1313; }
    .btn-edit { background-color: #fef3c7; color: #b45309; }
    .btn-edit:hover { background-color: #fde68a; }
    .btn-delete { background-color: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background-color: #fecaca; }

    .empty-state { text-align: center; padding: 40px; color: #64748b; }
    .empty-state i { font-size: 40px; margin-bottom: 10px; color: #cbd5e1; }

    .toggle-btn { 
      font-size: 20px; background: #ffffff !important; color: #000000 !important; border: none; 
      padding: 8px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }

    /* MODAL TAMBAH / EDIT SURAT JALAN */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 2000; overflow-y: auto; padding: 20px 0; }
    .modal-content { background: white; padding: 30px; border-radius: 12px; width: 820px; max-width: 96%; max-height: 90vh; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px; color: #334155; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 13.5px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .form-group.full-width { grid-column: span 2; }
    
    .item-row { display: grid; grid-template-columns: 38px minmax(0, 1fr) 64px 64px minmax(0, 1fr) 36px; gap: 8px; align-items: stretch; margin-bottom: 8px; }
    .item-row input, .item-row textarea { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 12.5px; }
    .item-row input[readonly] { background: #f1f5f9; text-align: center; }
    .item-row textarea { min-height: 40px; line-height: 1.35; resize: vertical; }
    .item-head { display: grid; grid-template-columns: 38px minmax(0, 1fr) 64px 64px minmax(0, 1fr) 36px; gap: 8px; margin-bottom: 6px; font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .3px; }
    
    /* Style khusus baris Keterangan Kode Barang */
    .kode-row { display: grid; grid-template-columns: 38px minmax(0, 1fr) minmax(0, 1fr) 36px; gap: 8px; align-items: stretch; margin-bottom: 8px; }
    .kode-row input, .kode-row textarea { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 12.5px; }
    .kode-row input[readonly] { background: #f1f5f9; text-align: center; }
    .kode-row textarea { min-height: 40px; line-height: 1.35; resize: vertical; }
    .kode-head { display: grid; grid-template-columns: 38px minmax(0, 1fr) minmax(0, 1fr) 36px; gap: 8px; margin-bottom: 6px; font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .3px; }

    .btn-remove-item { background: #fee2e2; color: #dc2626; border: none; width: 36px; height: 100%; min-height: 40px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; padding-top: 15px; border-top: 1px solid #edf2f7; }
    .btn-cancel { background: #e2e8f0; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; color: #475569; }
  </style>
  <link rel="stylesheet" href="/css/stat-cards.css">
</head>
<body>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top-section">
      <div class="sidebar-header">
        <div class="brand-wrap">
          <img src="/images/dgs.png" alt="Logo DGS" class="brand-logo-img" onerror="this.style.display='none'">
          <div class="brand-text">
            <h2>Dian Giri Saputra</h2>
            <span>Admin Database</span>
          </div>
        </div>
        <button class="close-sidebar-btn" onclick="toggleSidebar()" title="Tutup Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="6"></line>
          </svg>
        </button>
      </div>

      <div class="sidebar-user-card">
        <div class="user-avatar-circle">
          <%= (typeof user !== 'undefined' && user && user.username) ? user.username.substring(0,2).toUpperCase() : 'AD' %>
        </div>
        <div class="sidebar-user-info">
          <h4><%= (typeof user !== 'undefined' && user && (user.namaLengkap || user.username)) ? (user.namaLengkap || user.username) : 'Administrator' %></h4>
          <span>Admin Master Control</span>
        </div>
      </div>

      <div class="nav-label">Menu Administrasi</div>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/dashboard-admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard Admin</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            <span>Data Vendor</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/harga-dasar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>
            <span>Harga Dasar</span>
          </a>
        </li>
        <li class="nav-item dropdown">
          <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
            <div class="dropdown-toggle-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
              <span>Stok & Barang</span>
            </div>
            <span class="arrow">&#9662;</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/stok-masuk">Stok Masuk</a></li>
            <li><a href="/stok-keluar">Stok Keluar</a></li>
            <li><a href="/stok-opname">Stok Opname</a></li>
          </ul>
        </li>

        <!-- Menu Dropdown Laporan -->
        <li class="nav-item dropdown">
          <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
            <div class="dropdown-toggle-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Laporan</span>
            </div>
            <span class="arrow">&#9662;</span>
          </a>
          <ul class="dropdown-menu">
            <li>
              <a href="/laporan">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Data Laporan</span>
              </a>
            </li>
            <li>
              <a href="/surat-jalan-admin">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Surat Jalan</span>
              </a>
            </li>
          </ul>
        </li>

        <li class="nav-item">
          <a href="/data-kain-admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
            <span>Data Kain</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-footer">
      <a href="/logout" class="btn-bottom">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
        <span>Keluar / Logout</span>
      </a>
    </div>
  </aside>

  <main class="main-content">
    <header class="header-section">
      <button class="toggle-btn" onclick="toggleSidebar()" title="Buka Sidebar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <h1>Data Surat Jalan dan Tanda Terima</h1>
      <p>Kelola dan cetak surat pengiriman barang PT Dian Giri Saputra</p>
    </header>

    <%
      var _sjList = (typeof suratJalans !== 'undefined' && suratJalans)
        ? suratJalans
        : ((typeof daftarSurat !== 'undefined' && daftarSurat) ? daftarSurat : []);
      var _sjDokumen = _sjList.filter(function (i) { return i.jenisKirim === 'Dokumen'; }).length;
      var _sjBarang = _sjList.length - _sjDokumen;
    %>
    
    <section class="cards-grid">
      <!-- 1. Total Surat Jalan -->
      <div class="stat-card card-blue">
        <div class="card-header">
          <span class="card-title">Total Surat Jalan</span>
          <div class="icon-wrapper icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjList.length %></span>
          <span class="card-unit">Dokumen</span>
        </div>
        <div class="card-footer">
          <span class="text-blue">Arsip Tersedia</span>
          <span>PT Dian Giri Saputra</span>
        </div>
      </div>

      <!-- 2. Pengiriman Barang -->
      <div class="stat-card card-green">
        <div class="card-header">
          <span class="card-title">Pengiriman Barang</span>
          <div class="icon-wrapper icon-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjBarang %></span>
          <span class="card-unit">Barang</span>
        </div>
        <div class="card-footer">
          <span class="text-green">Logistik</span>
          <span>Aktif</span>
        </div>
      </div>

      <!-- 3. Pengiriman Dokumen -->
      <div class="stat-card card-red">
        <div class="card-header">
          <span class="card-title">Pengiriman Dokumen</span>
          <div class="icon-wrapper icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjDokumen %></span>
          <span class="card-unit">Dokumen</span>
        </div>
        <div class="card-footer">
          <span class="text-red">Administrasi</span>
          <span>Resmi</span>
        </div>
      </div>
    </section>

    <section class="report-container">
      <div class="report-header">
        <h2>Daftar Surat Jalan</h2>
        <button class="btn-action" onclick="openModal()">+ Buat Surat Jalan Baru</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>No. Surat Jalan</th>
            <th>Tanggal</th>
            <th>Kepada Yth</th>
            <th>Perihal / Pekerjaan</th>
            <th>Jenis</th>
            <th>Diinput Oleh</th>
            <th style="text-align: center;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (_sjList.length > 0) { %>
            <% _sjList.forEach(item => { %>
              <tr>
                <td><strong><%= item.noSuratJalan %></strong></td>
                <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
                <td><%= item.kepadaYth %></td>
                <td>
                  <div style="font-weight: 600;"><%= item.perihal || '-' %></div>
                  <div style="font-size: 12px; color: #64748b;"><%= item.pekerjaan || '' %></div>
                </td>
                <td>
                  <span class="badge <%= item.jenisKirim === 'Dokumen' ? 'badge-dokumen' : 'badge-barang' %>">
                    <%= item.jenisKirim || 'Barang' %>
                  </span>
                </td>
                <td><%= item.diinputOleh || '-' %></td>
                <td style="text-align: center;">
                  <div class="action-btns" style="justify-content: center;">
                    <a href="/surat-jalan/detail/<%= item._id %>" class="btn-sub-action btn-view" title="Detail">
                      <i class="fa-solid fa-eye"></i> Detail
                    </a>
                    <a href="/surat-jalan/cetak/<%= item._id %>" target="_blank" class="btn-sub-action btn-print" title="Cetak PDF">
                      <i class="fa-solid fa-print"></i> Cetak
                    </a>
                    <button type="button" class="btn-sub-action btn-edit" title="Edit" onclick="openEditModal('<%= item._id %>')">
                      <i class="fa-solid fa-pen-to-square"></i> Edit
                    </button>
                    <form action="/surat-jalan-admin/delete/<%= item._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Hapus surat jalan <%= (item.noSuratJalan || '').replace(/'/g, "\\'") %>? Data yang dihapus tidak dapat dikembalikan.');">
                      <button type="submit" class="btn-sub-action btn-delete" title="Hapus">
                        <i class="fa-solid fa-trash"></i> Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <i class="fa-regular fa-folder-open"></i>
                  <p>Belum ada data Surat Jalan yang diinput.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>
  </main>

  <!-- MODAL TAMBAH / EDIT SURAT JALAN -->
  <div class="modal" id="suratJalanModal">
    <div class="modal-content">
      <h3 id="modalTitle" style="margin-bottom: 15px; color: #7a1b1b; font-weight: 700;">Buat Surat Jalan Baru</h3>
      <form id="suratJalanForm" action="/surat-jalan-admin/add" method="POST">
        <div class="form-group full-width">
            <label>Jenis Surat</label>
            <select name="jenisSurat" id="inputJenisSurat">
              <option value="Surat Jalan">Surat Jalan</option>
              <option value="Surat Tanda Terima">Surat Tanda Terima</option>
            </select>
          </div>
        <div class="form-grid">
          <div class="form-group">
            <label>No. Surat Jalan</label>
            <input type="text" id="inputNoSuratJalan" name="noSuratJalan" placeholder="Contoh: DGS/SJ/V/2026/001" required>
          </div>
          <div class="form-group">
            <label>Tanggal Pengiriman</label>
            <input type="date" name="tanggal" id="inputTanggal" required>
          </div>
          <div class="form-group full-width">
            <label>Nama Perusahaan</label>
            <select name="namaPerusahaan" id="inputNamaPerusahaan">
              <option value="PT.DIAN GIRI SAPUTRA">PT.DIAN GIRI SAPUTRA</option>
              <option value="PT.PRASASTI NUSALESTARI">PT.PRASASTI NUSALESTARI</option>
              <option value="PT.PUSPITA JAYA GIRI">PT.PUSPITA JAYA GIRI</option>
              <option value="PT.INSAN GIRI MAHARTA">PT.INSAN GIRI MAHARTA</option>
            </select>
          </div>
          <div class="form-group">
            <label>Kepada Yth</label>
            <input type="text" id="inputKepadaYth" name="kepadaYth" placeholder="Nama perusahaan penerima..." required>
          </div>
          <div class="form-group">
            <label>Nama Penerima (opsional)</label>
            <input type="text" id="inputNamaPenerima" name="namaPenerima" placeholder="Kosongkan bila sama dengan Kepada Yth">
          </div>
          <div class="form-group">
            <label>No. Telepon / Kontak</label>
            <input type="text" id="inputNoTelepon" name="noTelepon" placeholder="Nomor telepon...">
          </div>
          <div class="form-group">
            <label>Nama Penyerah (Tanda Tangan)</label>
            <input type="text" id="inputNamaPenyerah" name="namaPenyerah" placeholder="Kosongkan = nama user yang login">
          </div>
          <div class="form-group full-width">
            <label>Alamat Tujuan</label>
            <textarea name="alamat" id="inputAlamat" rows="3" placeholder="Alamat lengkap lokasi pengiriman..." required></textarea>
            <small style="display:block; margin-top:4px; color:#94a3b8; font-size:11.5px;">Tekan Enter untuk memisahkan baris alamat (maksimal 3 baris agar rapi di hasil cetak).</small>
          </div>
          <div class="form-group">
            <label>Perihal</label>
            <input type="text" id="inputPerihal" name="perihal" placeholder="Contoh: Pengiriman Material">
          </div>
          <div class="form-group">
            <label>Pekerjaan</label>
            <input type="text" id="inputPekerjaan" name="pekerjaan" placeholder="Nama Pekerjaan">
          </div>
          <div class="form-group full-width">
            <label>Jenis Pengiriman</label>
            <select name="jenisKirim" id="inputJenisKirim">
              <option value="Barang">Barang</option>
              <option value="Dokumen">Dokumen</option>
            </select>
          </div>
        </div>

        <!-- DAFTAR BARANG UTAMA -->
        <div style="margin-top: 20px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
          <label style="font-size: 13px; font-weight: 600; color: #334155;">Daftar Barang</label>
          <button type="button" class="btn-action" style="padding: 5px 10px; font-size: 12px;" onclick="addItemRow()">+ Tambah Barang</button>
        </div>

        <div class="item-head">
          <span>No</span>
          <span>Diskripsi</span>
          <span>Jumlah</span>
          <span>Satuan</span>
          <span>Keterangan</span>
          <span></span>
        </div>
        <small style="display:block; margin:-2px 0 8px; color:#94a3b8; font-size:11px;">Jumlah dan satuan boleh diisi beberapa baris (tekan Enter) untuk barang dengan beberapa kode dalam satu baris.</small>
        <div id="itemContainer"></div>

        <!-- KETERANGAN KODE BARANG -->
        <div style="margin-top: 20px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
          <label style="font-size: 13px; font-weight: 600; color: #334155;">Keterangan Kode Barang</label>
          <button type="button" class="btn-action" style="padding: 5px 10px; font-size: 12px;" onclick="addKodeRow()">+ Tambah Kode Barang</button>
        </div>

        <div class="kode-head" style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 36px; gap: 8px; margin-bottom: 6px; font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase;">
          <span>Nama Barang</span>
          <span>Kode Barang</span>
          <span></span>
        </div>
        <div id="kodeBarangContainer"></div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
          <button type="submit" id="submitBtn" class="btn-action">Simpan Surat Jalan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const SURAT_JALAN_DATA = <%- JSON.stringify((typeof suratJalans !== 'undefined' && suratJalans) ? suratJalans : ((typeof daftarSurat !== 'undefined' && daftarSurat) ? daftarSurat : [])).replace(/</g, '\\u003c') %>;

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
    function toggleDropdown(element) {
      const parentLi = element.parentElement;
      parentLi.classList.toggle('active');
    }

    function setSelectValue(select, value) {
      if (!select) return;
      if (value === undefined || value === null || value === '') {
        select.selectedIndex = 0;
        return;
      }
      const ada = Array.prototype.some.call(select.options, function (opt) { return opt.value === value; });
      if (!ada) {
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = value;
        select.appendChild(opt);
      }
      select.value = value;
    }

    function tanggalUntukInput(nilai) {
      if (!nilai) return '';
      const d = new Date(nilai);
      if (isNaN(d.getTime())) return '';
      return d.toISOString().slice(0, 10);
    }

    // ---------- Baris item barang ----------
    function buatItemRow(index, data) {
      const row = document.createElement('div');
      row.className = 'item-row';
      row.innerHTML = `
        <input type="number" data-field="no" name="items[${index}][no]" value="${index + 1}" readonly style="background:#f1f5f9; text-align:center;">
        <textarea data-field="diskripsi" name="items[${index}][diskripsi]" placeholder="Nama barang / deskripsi (boleh beberapa baris)..." rows="2" required></textarea>
        <textarea data-field="jumlah" name="items[${index}][jumlah]" placeholder="Jml" rows="2" required></textarea>
        <input type="text" data-field="satuan" name="items[${index}][satuan]" placeholder="Satuan" required>
        <textarea data-field="keterangan" name="items[${index}][keterangan]" placeholder="Keterangan (opsional)..." rows="2"></textarea>
        <button type="button" class="btn-remove-item" onclick="removeItemRow(this)"><i class="fa-solid fa-trash"></i></button>
      `;
      row.querySelector('[data-field="diskripsi"]').value = data.diskripsi || '';
      row.querySelector('[data-field="jumlah"]').value = data.jumlah === undefined || data.jumlah === null ? '' : data.jumlah;
      row.querySelector('[data-field="satuan"]').value = data.satuan || '';
      row.querySelector('[data-field="keterangan"]').value = data.keterangan || '';
      return row;
    }

    function renderItemRows(items) {
      const container = document.getElementById('itemContainer');
      container.innerHTML = '';
      const list = (items && items.length) ? items : [{}];
      list.forEach(function (item, i) {
        container.appendChild(buatItemRow(i, item || {}));
      });
    }

    function addItemRow() {
      const container = document.getElementById('itemContainer');
      const rowCount = container.getElementsByClassName('item-row').length;
      container.appendChild(buatItemRow(rowCount, {}));
    }

    function removeItemRow(btn) {
      const container = document.getElementById('itemContainer');
      if (container.getElementsByClassName('item-row').length > 1) {
        btn.closest('.item-row').remove();
        reindexRows();
      } else {
        alert("Minimal harus ada 1 baris item barang.");
      }
    }

    function reindexRows() {
      const rows = document.getElementById('itemContainer').getElementsByClassName('item-row');
      for (let i = 0; i < rows.length; i++) {
        const fields = rows[i].querySelectorAll('[data-field]');
        fields.forEach(field => {
          field.name = `items[${i}][${field.dataset.field}]`;
          if (field.dataset.field === 'no') field.value = i + 1;
        });
      }
    }

    // ---------- Baris keterangan kode barang ----------
    function buatKodeRow(index, data) {
      const row = document.createElement('div');
      row.className = 'kode-row';
      row.style.cssText = "display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 36px; gap: 8px; align-items: stretch; margin-bottom: 8px;";
      row.innerHTML = `
        <textarea data-field="namaBarang" name="kodeBarangList[${index}][namaBarang]" placeholder="Nama barang" rows="2" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;"></textarea>
        <textarea data-field="kodeBarang" name="kodeBarangList[${index}][kodeBarang]" placeholder="Kode Barang" rows="2" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;"></textarea>
        <button type="button" class="btn-remove-item" onclick="removeKodeRow(this)" style="background: #fee2e2; color: #dc2626; border: none; width: 36px; height: 100%; min-height: 40px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center;"><i class="fa-solid fa-trash"></i></button>
      `;
      row.querySelector('[data-field="namaBarang"]').value = data.namaBarang || '';
      row.querySelector('[data-field="kodeBarang"]').value = data.kodeBarang || '';
      return row;
    }

    function renderKodeRows(listKode) {
      const container = document.getElementById('kodeBarangContainer');
      container.innerHTML = '';
      const list = (listKode && listKode.length) ? listKode : [{}];
      list.forEach(function (kode, i) {
        container.appendChild(buatKodeRow(i, kode || {}));
      });
    }

    function addKodeRow() {
      const container = document.getElementById('kodeBarangContainer');
      const rowCount = container.getElementsByClassName('kode-row').length;
      container.appendChild(buatKodeRow(rowCount, {}));
    }

    function removeKodeRow(btn) {
      const container = document.getElementById('kodeBarangContainer');
      if (container.getElementsByClassName('kode-row').length > 1) {
        btn.closest('.kode-row').remove();
        reindexKodeRows();
      } else {
        alert("Minimal harus ada 1 baris keterangan kode barang.");
      }
    }

    function reindexKodeRows() {
      const rows = document.getElementById('kodeBarangContainer').getElementsByClassName('kode-row');
      for (let i = 0; i < rows.length; i++) {
        const fields = rows[i].querySelectorAll('[data-field]');
        fields.forEach(field => {
          field.name = `kodeBarangList[${i}][${field.dataset.field}]`;
        });
      }
    }

    // ---------- Modal tambah / edit ----------
    function resetForm() {
      const form = document.getElementById('suratJalanForm');
      form.reset();
      form.action = '/surat-jalan-admin/add';
      document.getElementById('modalTitle').innerText = 'Buat Surat Jalan Baru';
      document.getElementById('submitBtn').innerText = 'Simpan Surat Jalan';
      document.getElementById('inputTanggal').valueAsDate = new Date();
      setSelectValue(document.getElementById('inputJenisSurat'), 'Surat Jalan');
      setSelectValue(document.getElementById('inputNamaPerusahaan'), 'PT.DIAN GIRI SAPUTRA');
      setSelectValue(document.getElementById('inputJenisKirim'), 'Barang');
      renderItemRows([{}]);
      renderKodeRows([{}]);
    }

    function openModal() {
      resetForm();
      document.getElementById('suratJalanModal').style.display = 'flex';
    }

    function openEditModal(id) {
      const item = SURAT_JALAN_DATA.find(function (s) { return String(s._id) === String(id); });
      if (!item) {
        alert('Data surat jalan tidak ditemukan.');
        return;
      }

      resetForm();

      const form = document.getElementById('suratJalanForm');
      form.action = '/surat-jalan-admin/edit/' + id;
      document.getElementById('modalTitle').innerText = 'Edit Surat Jalan';
      document.getElementById('submitBtn').innerText = 'Simpan Perubahan';

      setSelectValue(document.getElementById('inputJenisSurat'), item.jenisSurat || 'Surat Jalan');
      document.getElementById('inputNoSuratJalan').value = item.noSuratJalan || '';
      document.getElementById('inputTanggal').value = tanggalUntukInput(item.tanggal);
      setSelectValue(document.getElementById('inputNamaPerusahaan'), item.namaPerusahaan || '');
      document.getElementById('inputKepadaYth').value = item.kepadaYth || '';
      document.getElementById('inputNamaPenerima').value = item.namaPenerima || '';
      document.getElementById('inputNoTelepon').value = item.noTelepon || '';
      document.getElementById('inputNamaPenyerah').value = item.namaPenyerah || '';
      document.getElementById('inputAlamat').value = item.alamat || '';
      document.getElementById('inputPerihal').value = item.perihal || '';
      document.getElementById('inputPekerjaan').value = item.pekerjaan || '';
      setSelectValue(document.getElementById('inputJenisKirim'), item.jenisKirim || 'Barang');

      renderItemRows(item.items || []);
      renderKodeRows(item.kodeBarangList || []);

      document.getElementById('suratJalanModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('suratJalanModal').style.display = 'none';
    }

    window.addEventListener('DOMContentLoaded', function () {
      resetForm();
    });
  </script>
</body>
</html>
