    <div class="card-header">
      <span class="card-title">TOTAL VENDOR AKTIF</span>
      <div class="icon-wrapper icon-green">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
    </div>
    <div class="card-body">
      <span class="card-value">
        <%= locals.totalVendorAktif !== undefined ? totalVendorAktif : vendors.filter(v => v.status === 'Aktif').length %>
      </span>
      <span class="card-unit">Vendor</span>
    </div>
    <div class="card-footer">
      <span class="text-green">📈 Status Operasional</span>
      <span class="footer-text">Siap Memenuhi Suplai</span>
    </div>
  </div>

  <!-- Card 2: Total Vendor Tidak Aktif / Review -->
