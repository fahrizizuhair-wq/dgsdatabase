    <div class="card-header">
      <span class="card-title">TOTAL VENDOR TIDAK AKTIF / REVIEW</span>
      <div class="icon-wrapper icon-red">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
    </div>
    <div class="card-body">
      <span class="card-value">
        <%= locals.totalVendorTidakAktif !== undefined ? totalVendorTidakAktif : vendors.filter(v => v.status !== 'Aktif').length %>
      </span>
      <span class="card-unit">Vendor</span>
    </div>
    <div class="card-footer">
      <span class="text-orange">⚠️ Butuh Review</span>
      <span class="footer-text">Dalam Peninjauan</span>
    </div>
  </div>

  <!-- Card 3: Kategori Bahan Baku -->
