    <!-- Tombol Export Excel -->
    <a href="/export-vendor-excel" style="padding: 10px 18px; background-color: #1d6f42; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px;">
        Export Excel
    </a>
    
    <!-- Tombol & Panel Filter -->
   <div class="filter-container">
    <button type="button" id="filter-toggle-btn" class="btn-filter-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        <span>Filter Data</span>
    </button>

    <!-- PANEL FILTER HARUS DI DALAM SINI AGAR MELAYANG -->
    <div id="filter-panel" class="filter-panel-right">
        <form id="filter-form" action="/admin" method="GET"> <!-- Sesuaikan action dengan /admin atau /user -->
            <div class="filter-form-grid">
                <div class="filter-group">
                    <label for="kategori">Kategori:</label>
                    <select name="kategori" id="kategori">
                        <option value="">Semua Kategori</option>
                        <option value="ATK">ATK</option>
                        <option value="Pakaian">Pakaian</option>
                        <option value="Kain">Kain</option>
                        <option value="Elektronik">Elektronik</option>
                        <option value="Packaging">Packaging</option>
                        <option value="Percetakan">Percetakan</option>
                        <option value="Merchandise">Merchandise</option>
                        <option value="Logistik">Logistik</option>
                        <option value="Voucher">Voucher</option>
                        <option value="Rental">Rental</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="status">Status Vendor:</label>
                    <select name="status" id="status">
                        <option value="">Semua Status</option>
                        <option value="Aktif">Aktif</option>
                        <option value="Review">Review</option>
                        <option value="Nonaktif">Nonaktif</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="wilayah">Wilayah:</label>
                    <select name="wilayah" id="wilayah">
                        <option value="">Semua Wilayah</option>
                        <option value="Jakarta">Jakarta</option>
                        <option value="Bogor">Bogor</option>
                        <option value="Depok">Depok</option>
                        <option value="Tanggerang">Tanggerang</option>
                        <option value="Bekasi">Bekasi</option>
                        <option value="Garut">Garut</option>
                        <option value="Bandung">Bandung</option>
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-apply">Terapkan</button>
                    <a href="/admin" class="btn-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Tabel Data Vendor -->
    <table>
      <thead>
        <tr>
          <th>ID Vendor</th>
          <th>Nama Vendor</th>
          <th>Wilayah</th>
          <th>Kategori Supply</th>
          <th>Kontak</th>
          <th>Rating</th>
          <th>Status</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody id="vendorTableBody">
        <% if (vendors.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: #777; padding: 30px;">Belum ada data vendor.</td>
          </tr>
        <% } else { %>
          <% vendors.forEach(v => { %>
            <tr class="vendor-row">
              <td><strong><%= v.idVendor %></strong></td>
              <td><%= v.namaVendor %></td>
              <td><%= v.wilayah || '-' %></td>
              <td><%= v.kategori %></td>
              <td><%= v.kontak %></td>
              <td>⭐ <%= v.rating %></td>
              <td>
                <span class="badge <%= v.status === 'Aktif' ? 'badge-active' : (v.status === 'Review' ? 'badge-review' : 'badge-inactive') %>">
                  <%= v.status %>
                </span>
              </td>
              <td>
                <a href="/user/vendor/<%= v._id %>" class="btn-detail">Detail</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="pagination-container">
            <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/user?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof kategori !== 'undefined' && kategori ? '&kategori=' + kategori : '' %><%= typeof status !== 'undefined' && status ? '&status=' + status : '' %><%= typeof wilayah !== 'undefined' && wilayah ? '&wilayah=' + wilayah : '' %>" 
                   class="page-btn <%= currentPage === i ? 'active' : '' %>">
                    <%= i %>
                </a>
            <% } %>
        </div>
    <% } %>
  </div>

  <!-- Modal Tambah Vendor -->
  <div id="addModal" class="modal">
    <div class="modal-content">
      <h2 style="margin-bottom: 20px; color: #7a1b1b; font-size: 20px;">Tambah Vendor Baru</h2>
      <form action="/user/vendor/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label>ID Vendor</label>
          <input type="text" name="idVendor" value="<%= nextIdVendor %>" readonly style="background: #f4f4f4;">
        </div>
        <div class="form-group">
            <label>Nama Vendor</label>
            <input type="text" name="namaVendor" placeholder="Masukan Nama" required>
        </div>
        <div class="form-group">
          <label>Wilayah</label>
          <select name="wilayah">
            <option value="Jakarta">Jakarta</option>
            <option value="Depok">Depok</option>
            <option value="Bekasi">Bekasi</option>
            <option value="Bogor">Bogor</option>
            <option value="Tangerang">Tangerang</option>
            <option value="Bandung">Bandung</option>
            <option value="Semarang">Semarang</option>
            <option value="Garut">Garut</option>
          </select>
        </div>
        <div class="form-group">
          <label>Kategori Supply</label>
          <select name="kategori">
            <option value="ATK">ATK</option>
            <option value="Pakaian">Pakaian</option>
            <option value="Kain">Kain</option>
            <option value="Elektronik">Elektronik</option>
            <option value="Packaging">Packaging</option>
            <option value="Percetakan">Percetakan</option>
            <option value="Merchandise">Merchandise</option>
            <option value="Logistik">Logistik</option>
            <option value="Voucher">Voucher</option>
            <option value="Rental">Rental</option>
          </select>
        </div>
        <div class="form-group">
          <label>Kontak & PIC</label>
          <input type="text" name="kontak" placeholder="Masukan Kontak & PIC" required>
        </div>
        <div class="form-group">
          <label>Rating (1 - 5)</label>
          <input type="number" name="rating" min="1" max="5" value="5" required>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="Aktif">Aktif</option>
            <option value="Review">Review</option>
            <option value="Nonaktif">Nonaktif</option>
          </select>
        </div>
        <div class="form-group">
            <label>Deskripsi Vendor</label>
            <textarea name="deskripsi" rows="5" class="input-lg"
            style="width: 100%; min-height: 120px; padding: 10px; border: 1px solid #ccc; 
                   border-radius: 6px; font-family: inherit; font-size: 14px; resize: vertical;" 
                   placeholder="Tuliskan catatan/deskripsi..."></textarea>
        </div>
        <div class="form-group">
          <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
          <input type="file" name="foto" accept="image/*" multiple>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeAddModal()">Batal</button>
          <button type="submit" class="btn">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // 1. Sidebar & Dropdown Script
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('overlay').classList.toggle('active');
    }

    function toggleDropdown(element) {
      const parentLi = element.parentElement;
      parentLi.classList.toggle('active');
    }

    // 2. Modal Tambah Script
    const addModal = document.getElementById('addModal');
    function openAddModal() { addModal.style.display = 'flex'; }
    function closeAddModal() { addModal.style.display = 'none'; }
    window.onclick = function(event) { if (event.target == addModal) closeAddModal(); }

    // 3. Toggle Panel Filter Pop-up & Klik di Luar Area
    document.addEventListener('DOMContentLoaded', function () {
        const filterToggleBtn = document.getElementById('filter-toggle-btn');
        const filterPanel = document.getElementById('filter-panel');

        if (filterToggleBtn && filterPanel) {
            filterToggleBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                filterPanel.style.display = filterPanel.style.display === 'block' ? 'none' : 'block';
            });

            document.addEventListener('click', function (e) {
                if (!filterPanel.contains(e.target) && e.target !== filterToggleBtn) {
                    filterPanel.style.display = 'none';
                }
            });

            filterPanel.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }
    });
    

    // 4. AJAX Live Search Otomatis (Lintas Halaman & Filter)
    let searchTimeout = null;
    const searchInput = document.getElementById('searchInput');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const query = this.value;
            
            // Ambil nilai filter kategori, status, dan wilayah yang sedang aktif
            const kategori = document.getElementById('kategori') ? document.getElementById('kategori').value : '';
            const status = document.getElementById('status') ? document.getElementById('status').value : '';
            const wilayah = document.getElementById('wilayah') ? document.getElementById('wilayah').value : '';

            // Beri jeda 300ms agar pencarian terasa mulus saat diketik cepat
            searchTimeout = setTimeout(() => {
                let url = `/user?search=${encodeURIComponent(query)}`;
                if (kategori) url += `&kategori=${encodeURIComponent(kategori)}`;
                if (status) url += `&status=${encodeURIComponent(status)}`;
                if (wilayah) url += `&wilayah=${encodeURIComponent(wilayah)}`;

                // Ambil data dari server secara asynchronous
                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        
                        // Ambil elemen tabel dan pagination baru dari hasil fetch
                        const newTbody = doc.getElementById('vendorTableBody');
                        const newPagination = doc.querySelector('.pagination-container');
                        
                        // Perbarui isi tabel di halaman saat ini
                        const currentTbody = document.getElementById('vendorTableBody');
                        if (newTbody && currentTbody) {
                            currentTbody.innerHTML = newTbody.innerHTML;
                        }
                        
                        // Perbarui navigasi pagination secara dinamis
                        const currentPagination = document.querySelector('.pagination-container');
                        const mainBox = document.querySelector('.main-box');

                        if (newPagination && currentPagination) {
                            currentPagination.innerHTML = newPagination.innerHTML;
                        } else if (newPagination && !currentPagination && mainBox) {
                            mainBox.appendChild(newPagination);
                        } else if (!newPagination && currentPagination) {
                            currentPagination.remove();
                        }

                        // Jaga agar kursor tetap fokus di kotak pencarian
                        const activeInput = document.getElementById('searchInput');
                        if (activeInput) {
                            activeInput.focus();
                            const val = activeInput.value;
                            activeInput.value = '';
                            activeInput.value = val;
                        }
                    })
                    .catch(err => console.error('Gagal memuat data pencarian:', err));
            }, 300);
        });

        
        
      }

       document.addEventListener('DOMContentLoaded', function () {
          const urlParams = new URLSearchParams(window.location.search);
          if (urlParams.get('success') === 'true') { // Ubah jadi 'true'
              Swal.fire({
                  icon: 'success',
                  title: 'Berhasil!',
                  text: 'Data vendor baru berhasil ditambahkan.',
                  showConfirmButton: false,
                  timer: 2000,
                  customClass: {
                      popup: 'rounded-xl'
                  }
              });
          }
      });
    
  </script>
</body>
</html>
