<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head', { pageTitle: 'Payment Request — PT. DIAN GIRI SAPUTRA', useTailwind: true }) %>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/payment-request.css" />
  </head>
  <body class="text-slate-800 antialiased selection:bg-maroon-800 selection:text-white">
    <%
      var dataPRUser = (typeof listMateri !== 'undefined' && listMateri) ? listMateri : [];
      var namaPemohonUser = (typeof user !== 'undefined' && user && (user.namaLengkap || user.username))
        ? String(user.namaLengkap || user.username)
        : 'User';

      function jsonUntukScriptUser(nilai) {
        return JSON.stringify(nilai || [])
          .replace(/</g, '\\u003c')
          .replace(/>/g, '\\u003e')
          .replace(/&/g, '\\u0026')
          .replace(/\u2028/g, '\\u2028')
          .replace(/\u2029/g, '\\u2029');
      }
    %>

    <%- include('partials/sidebar-user', { activePage: 'payment-request', user: (typeof user !== 'undefined' ? user : null) }) %>

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none no-print"></div>

    <main class="pr-main">
      <!-- HEADBAR: hamburger membuka sidebar (bukan link dashboard) -->
      <header class="system-banner no-print">
        <div class="banner-title-wrap">
          <button type="button" class="banner-toggle-btn" onclick="toggleSidebar()" aria-label="Buka menu navigasi" title="Buka Menu">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
          <div class="banner-text">
            <span>System Payment Request &bull; User</span>
            <h1>Aplikasi Payment Request (PR)</h1>
          </div>
        </div>
        <div class="banner-actions">
          <button type="button" onclick="openCreateForm()" class="btn-banner-primary cursor-pointer" title="Buat Pengajuan Baru">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Buat Pengajuan Baru</span>
            <span class="sm:hidden">Buat PR</span>
          </button>
        </div>
      </header>

      <!-- ALUR 1: DAFTAR -->
      <section id="view-list" data-live-view="list" class="view-section space-y-6">
        <div class="pr-stats-grid">
          <div class="pr-stat-card card-blue">
            <div class="card-header">
              <span class="card-title">Total Pengajuan PR</span>
              <div class="icon-wrapper icon-blue"><i data-lucide="credit-card" class="w-5 h-5"></i></div>
            </div>
            <div class="card-body"><span id="stat-total-count" class="card-value">0 Dokumen</span></div>
            <div class="card-footer">
              <span id="stat-total-nominal" class="font-bold text-blue-600 text-xs">Rp 0</span>
              <span class="text-[11px] text-slate-500">Total Akumulasi</span>
            </div>
          </div>

          <div class="pr-stat-card card-gold">
            <div class="card-header">
              <span class="card-title">Menunggu / Disetujui</span>
              <div class="icon-wrapper icon-gold"><i data-lucide="clock" class="w-5 h-5"></i></div>
            </div>
            <div class="card-body"><span id="stat-pending-count" class="card-value text-amber-600">0 Dokumen</span></div>
            <div class="card-footer">
              <span class="font-bold text-amber-600 text-xs">Perlu Proses</span>
              <span class="text-[11px] text-slate-500">Finance &amp; Verifikasi</span>
            </div>
          </div>

          <div class="pr-stat-card card-green">
            <div class="card-header">
              <span class="card-title">Sudah Transfer (Lunas)</span>
              <div class="icon-wrapper icon-green"><i data-lucide="check-circle" class="w-5 h-5"></i></div>
            </div>
            <div class="card-body"><span id="stat-paid-count" class="card-value text-emerald-600">0 Dokumen</span></div>
            <div class="card-footer">
              <span id="stat-paid-nominal" class="font-bold text-emerald-600 text-xs">Rp 0</span>
              <span class="text-[11px] text-slate-500">Telah Dicairkan</span>
            </div>
          </div>
        </div>

        <div class="pr-data-panel space-y-4">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-900">Riwayat Pengajuan Payment Request</h2>
            <p class="text-xs text-slate-500 mt-0.5">Klik dokumen untuk membuka surat resmi Payment Request pada halaman tersendiri.</p>
          </div>

          <div class="pr-filter-toolbar">
            <div class="flex-1 relative min-w-[240px]">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="search-pr-input" oninput="renderPRList()" placeholder="Cari nama pekerjaan, lokasi, atau nama vendor..." class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white focus:outline-none focus:border-maroon-800" />
            </div>
            <div class="w-full sm:w-64">
              <select id="filter-pr-status" onchange="renderPRList()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white focus:outline-none focus:border-maroon-800 font-semibold text-slate-700">
                <option value="ALL">Semua Status</option>
                <option value="Pending">Pending (Menunggu Persetujuan)</option>
                <option value="Disetujui">Disetujui (Siap Transfer)</option>
                <option value="Ditolak">Ditolak</option>
                <option value="Sudah Transfer">Sudah Transfer (Lunas)</option>
              </select>
            </div>
          </div>

          <div id="pr-cards-list" class="space-y-3 pt-1"></div>
        </div>
      </section>

      <!-- ALUR 2: FORM (MASIH DI HALAMAN YANG SAMA) -->
      <section id="view-form" data-live-view="form" class="view-section hidden space-y-5">
        <div class="flex items-center justify-between gap-3">
          <button type="button" onclick="navigateTo('list')" class="btn-banner-nav cursor-pointer">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Kembali ke Daftar PR</span>
          </button>
          <span id="form-mode-badge" class="text-xs font-bold px-3.5 py-1.5 rounded-full bg-maroon-50 text-maroon-800 border border-maroon-200">Pengajuan Baru</span>
        </div>

        <form id="pr-editor-form" class="space-y-5">
          <input type="hidden" id="edit-pr-id" value="" />

          <div class="pr-form-card space-y-4">
            <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
              <span class="w-7 h-7 rounded-full bg-maroon-800 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
              <h2 class="text-sm sm:text-base font-bold text-slate-900">Informasi Pekerjaan &amp; Jadwal Transfer</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="sm:col-span-2">
                <label for="inp-pekerjaan" class="block text-xs font-semibold text-slate-700 mb-1.5">Nama Pekerjaan / Proyek *</label>
                <select id="inp-pekerjaan" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none focus:border-maroon-800">
                  <option value="">-- Pilih project dari LPJ --</option>
                  <% (listLpjPR || []).forEach(function (lpj) { %>
                    <option value="<%= lpj.id %>" data-nama="<%= lpj.nama %>" data-anggaran="<%= lpj.anggaranKasbon %>" data-sisa="<%= lpj.sisaSaldo %>"><%= lpj.nama %></option>
                  <% }); %>
                </select>
                <p id="lpj-kosong" class="text-[11px] text-amber-700 mt-1 <%= (listLpjPR || []).length ? 'hidden' : '' %>">Belum ada project LPJ yang tersedia.</p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Estimasi Tanggal Transfer *</label>
                <input type="date" id="inp-transfer" required placeholder="Contoh: 16 November 2026" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-maroon-800" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Lokasi *</label>
                <input type="text" id="inp-lokasi" required placeholder="Contoh: Jakarta" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-maroon-800" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Detail Keperluan *</label>
                <input type="text" id="inp-detail" required placeholder="Contoh: Biaya Sampel dan Operasional" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-maroon-800" />
              </div>
              <div id="info-lpj-pr" class="sm:col-span-2 hidden">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-3 py-2 rounded-lg bg-maroon-50/70 border border-maroon-100 text-[11px] text-slate-600">
                  <span class="font-bold text-maroon-800" id="info-lpj-nama">-</span>
                  <span>Anggaran Kasbon: <b id="info-lpj-anggaran" class="text-slate-900">Rp 0</b></span>
                  <span>Sisa Saldo LPJ: <b id="info-lpj-sisa" class="text-emerald-700">Rp 0</b></span>
                </div>
              </div>
            </div>
          </div>

          <div class="pr-form-card space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-100">
              <div class="flex items-center gap-2.5">
                <span class="w-7 h-7 rounded-full bg-maroon-800 text-white text-xs font-bold flex items-center justify-center shrink-0">2</span>
                <div>
                  <h2 class="text-sm sm:text-base font-bold text-slate-900">Penerima Transfer &amp; Rincian Biaya</h2>
                  <p class="text-[11px] text-slate-500">Total Rupiah &amp; Terbilang dihitung otomatis per penerima</p>
                </div>
              </div>
              <button type="button" onclick="addRecipientBlock()" class="px-3.5 py-2 rounded-xl bg-maroon-50 hover:bg-maroon-100 text-maroon-800 text-xs font-bold inline-flex items-center gap-1.5 transition-colors cursor-pointer self-start sm:self-center">
                <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                <span>+ Tambah Penerima / Vendor</span>
              </button>
            </div>
            <div id="form-recipients-container" class="space-y-4"></div>
          </div>

          <div class="pr-form-card space-y-4">
            <div class="flex items-center gap-2.5 pb-3 border-b border-slate-100">
              <span class="w-7 h-7 rounded-full bg-maroon-800 text-white text-xs font-bold flex items-center justify-center shrink-0">3</span>
              <h2 class="text-sm sm:text-base font-bold text-slate-900">Catatan Lampiran &amp; Konfirmasi</h2>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1.5">Daftar Lampiran Dokumen (1 baris = 1 lampiran)</label>
              <textarea id="inp-attachments" rows="3" placeholder="Masukan daftar lampiran" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:outline-none focus:border-maroon-800"></textarea>
            </div>

            <div class="p-5 rounded-2xl bg-gradient-to-r from-maroon-800 to-maroon-900 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
              <div>
                <span class="text-[11px] uppercase tracking-wider text-maroon-200 font-bold block">Total Pengajuan Keseluruhan</span>
                <span id="form-live-grand-total" class="text-2xl sm:text-3xl font-extrabold block mt-0.5">Rp 0</span>
                <span id="form-live-terbilang" class="text-xs italic text-maroon-100 block mt-0.5">Nol Rupiah</span>
              </div>
              <div class="flex items-center gap-2.5">
                <button type="button" onclick="navigateTo('list')" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold cursor-pointer">Batal</button>
                <button type="submit" id="btn-simpan-pr" class="px-5 py-2.5 rounded-xl bg-white text-maroon-800 hover:bg-maroon-50 text-xs sm:text-sm font-extrabold shadow-sm inline-flex items-center gap-1.5 cursor-pointer disabled:opacity-60">
                  <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                  <span>Simpan &amp; Lihat Dokumen</span>
                </button>
              </div>
            </div>
          </div>
        </form>
      </section>
    </main>

    <script>
      var PR_DATA_USER = <%- jsonUntukScriptUser(dataPRUser) %>;
      var PR_LIST_LPJ = <%- JSON.stringify(listLpjPR || []) %>;
      var PR_NAMA_PEMOHON = <%- JSON.stringify(namaPemohonUser) %>;

      var colorStylesUser = [
        { bg: 'bg-[#d9ead3]/85', border: 'border-[#b6d7a8]', docBg: 'bg-[#d9ead3]' },
        { bg: 'bg-[#f4cccc]/85', border: 'border-[#ea9999]', docBg: 'bg-[#f4cccc]' },
        { bg: 'bg-[#ffe599]/85', border: 'border-[#ffd966]', docBg: 'bg-[#ffe599]' },
        { bg: 'bg-[#ead1dc]/85', border: 'border-[#d5a6bd]', docBg: 'bg-[#ead1dc]' },
        { bg: 'bg-[#cfe2f3]/85', border: 'border-[#9fc5e8]', docBg: 'bg-[#cfe2f3]' },
      ];

      var prList = [];

      function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (sidebar) sidebar.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
      }

      function toggleDropdown(element) {
        var parent = element.closest('.nav-item.dropdown');
        if (parent) parent.classList.toggle('active');
      }

      function initIcons() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          try { window.lucide.createIcons(); } catch (err) {}
        }
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function formatRupiah(num) {
        return new Intl.NumberFormat('id-ID', {
          style: 'currency', currency: 'IDR', minimumFractionDigits: 0, maximumFractionDigits: 0,
        }).format(Number(num) || 0);
      }

      function terbilang(nilai) {
        var angka = Math.floor(Math.abs(Number(nilai) || 0));
        if (angka === 0) return 'Nol Rupiah';
        var satuan = ['', 'Satu', 'Dua', 'Tiga', 'Empat', 'Lima', 'Enam', 'Tujuh', 'Delapan', 'Sembilan', 'Sepuluh', 'Sebelas'];
        function convert(n) {
          if (n < 12) return satuan[n];
          if (n < 20) return convert(n - 10) + ' Belas';
          if (n < 100) return convert(Math.floor(n / 10)) + ' Puluh' + (n % 10 ? ' ' + convert(n % 10) : '');
          if (n < 200) return 'Seratus' + (n % 100 ? ' ' + convert(n % 100) : '');
          if (n < 1000) return convert(Math.floor(n / 100)) + ' Ratus' + (n % 100 ? ' ' + convert(n % 100) : '');
          if (n < 2000) return 'Seribu' + (n % 1000 ? ' ' + convert(n % 1000) : '');
          if (n < 1000000) return convert(Math.floor(n / 1000)) + ' Ribu' + (n % 1000 ? ' ' + convert(n % 1000) : '');
          if (n < 1000000000) return convert(Math.floor(n / 1000000)) + ' Juta' + (n % 1000000 ? ' ' + convert(n % 1000000) : '');
          if (n < 1000000000000) return convert(Math.floor(n / 1000000000)) + ' Miliar' + (n % 1000000000 ? ' ' + convert(n % 1000000000) : '');
          return '';
        }
        return convert(angka).replace(/\s+/g, ' ').trim() + ' Rupiah';
      }

      function formatTanggal(value) {
        if (!value) return '-';
        var d = new Date(value);
        if (isNaN(d.getTime())) return String(value);
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      }

      function tanggalISO(teks) {
        if (!teks) return '';
        var d = new Date(teks);
        if (isNaN(d.getTime())) return '';
        return d.toISOString().slice(0, 10);
      }

      function statusKey(status) {
        var teks = String(status || '').trim().toLowerCase();
        if (teks.indexOf('transfer') !== -1) return 'Sudah Transfer';
        if (['ditolak', 'rejected', 'batal', 'dibatalkan'].indexOf(teks) !== -1) return 'Ditolak';
        if (['disetujui', 'approved', 'selesai'].indexOf(teks) !== -1) return 'Disetujui';
        return 'Pending';
      }

      function getStatusBadge(status) {
        var kunci = statusKey(status);
        if (kunci === 'Sudah Transfer') {
          return '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">✓ Sudah Transfer</span>';
        }
        if (kunci === 'Ditolak') {
          return '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Ditolak</span>';
        }
        if (kunci === 'Disetujui') {
          return '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200">Disetujui</span>';
        }
        return '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">Pending</span>';
      }

      function jadiArray(value) {
        if (Array.isArray(value)) return value.filter(Boolean);
        if (value && typeof value === 'object') {
          return Object.keys(value).sort().map(function (k) { return value[k]; }).filter(Boolean);
        }
        return [];
      }

      function normalizePR(doc) {
        var penerimaRaw = jadiArray(doc && doc.penerimaTransfer);
        var recipients = penerimaRaw.map(function (p) {
          var itemsRaw = jadiArray(p.items);
          var rincianRaw = jadiArray(p.rincianBiaya);
          if (itemsRaw.length === 0 && rincianRaw.length > 0) {
            itemsRaw = rincianRaw.map(function (r) {
              return { desc: r.deskripsi || '', qty: r.qty || 1, price: r.hargaSatuan || r.jumlah || 0 };
            });
          }
          var items = itemsRaw.map(function (it) {
            var qty = Number(it.qty != null ? it.qty : 1) || 1;
            var price = Number(it.price != null ? it.price : (it.hargaSatuan || 0)) || 0;
            return { desc: String(it.desc || it.deskripsi || ''), qty: qty, price: price };
          });
          if (items.length === 0) {
            items = [{ desc: String(p.keterangan || ''), qty: 1, price: Number(p.subtotal) || 0 }];
          }
          return {
            summaryTitle: String(p.summaryTitle || p.namaPenerima || '-'),
            vendorName: String(p.vendorName || p.namaPenerima || '-'),
            pic: String(p.pic || p.keterangan || '-'),
            bank: String(p.bank || ''),
            accountNo: String(p.accountNo || p.noRekening || ''),
            accountHolder: String(p.accountHolder || p.atasNama || ''),
            items: items,
          };
        });

        var attachments = jadiArray(doc && doc.attachments).map(String);
        if (attachments.length === 0 && doc && doc.daftarDokumen) {
          attachments = String(doc.daftarDokumen).split(/\r?\n/).map(function (s) {
            return s.replace(/^[-•*]\s*/, '').trim();
          }).filter(Boolean);
        }

        var nomorTampil = doc && (doc.nomorPengajuan || doc._id);
        if (!nomorTampil && doc && doc.id) nomorTampil = doc.id;
        var idInternal = doc && doc._id ? String(doc._id) : String(nomorTampil || '-');

        return {
          id: idInternal,
          nomor: String(nomorTampil || '-'),
          _id: doc && doc._id ? String(doc._id) : '',
          pekerjaan: String((doc && (doc.pekerjaan || doc.namaMaterial)) || '-'),
          lpjId: doc && doc.lpjId ? String(doc.lpjId) : '',
          estTransfer: String((doc && doc.estimasiTransfer) || formatTanggal(doc && doc.tanggalTransfer)),
          lokasi: String((doc && doc.lokasi) || '-'),
          detail: String((doc && (doc.detailPekerjaan || doc.deskripsi)) || '-'),
          status: statusKey(doc && doc.statusApproval),
          attachments: attachments,
          recipients: recipients,
        };
      }

      function calcRecipientTotal(rec) {
        return (rec.items || []).reduce(function (sum, item) {
          return sum + ((Number(item.qty) || 0) * (Number(item.price) || 0));
        }, 0);
      }

      function calcPRTotal(pr) {
        return (pr.recipients || []).reduce(function (sum, rec) { return sum + calcRecipientTotal(rec); }, 0);
      }

      function showToast(msg, type) {
        var tipe = type || 'success';
        var container = document.getElementById('toast-container');
        if (!container) return;
        var el = document.createElement('div');
        var borderColor = tipe === 'error' ? 'border-rose-500' : tipe === 'info' ? 'border-amber-400' : 'border-emerald-500';
        el.className = 'bg-slate-900 text-white border-l-4 ' + borderColor + ' rounded-xl p-3.5 shadow-xl text-xs font-medium pointer-events-auto transition-all duration-300';
        el.innerHTML = msg;
        container.appendChild(el);
        window.setTimeout(function () {
          el.style.opacity = '0';
          window.setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 250);
        }, 3200);
      }

      // Hanya daftar dan form yang ada di halaman ini. Detail dibuka sebagai
      // halaman tersendiri, jadi navigasi internal tidak pernah ke 'detail'.
      function navigateTo(viewName) {
        var nama = (viewName === 'form') ? 'form' : 'list';
        var daftar = document.getElementById('view-list');
        var form = document.getElementById('view-form');
        if (daftar) daftar.classList.toggle('hidden', nama !== 'list');
        if (form) form.classList.toggle('hidden', nama !== 'form');
        if (nama === 'list') renderPRList();
        initIcons();
        try { window.scrollTo({ top: 0, behavior: 'smooth' }); } catch (err) { window.scrollTo(0, 0); }
      }

      function renderPRList() {
        var totalNominal = prList.reduce(function (s, p) { return s + calcPRTotal(p); }, 0);
        var pendingItems = prList.filter(function (p) { return p.status !== 'Sudah Transfer' && p.status !== 'Ditolak'; });
        var paidItems = prList.filter(function (p) { return p.status === 'Sudah Transfer'; });
        var paidNominal = paidItems.reduce(function (s, p) { return s + calcPRTotal(p); }, 0);

        var elTotal = document.getElementById('stat-total-count');
        var elTotalNom = document.getElementById('stat-total-nominal');
        var elPending = document.getElementById('stat-pending-count');
        var elPaid = document.getElementById('stat-paid-count');
        var elPaidNom = document.getElementById('stat-paid-nominal');
        if (elTotal) elTotal.textContent = prList.length + ' Dokumen';
        if (elTotalNom) elTotalNom.textContent = formatRupiah(totalNominal);
        if (elPending) elPending.textContent = pendingItems.length + ' Dokumen';
        if (elPaid) elPaid.textContent = paidItems.length + ' Dokumen';
        if (elPaidNom) elPaidNom.textContent = formatRupiah(paidNominal);

        var inputCari = document.getElementById('search-pr-input');
        var filterStatus = document.getElementById('filter-pr-status');
        var query = inputCari ? inputCari.value.toLowerCase().trim() : '';
        var filter = filterStatus ? filterStatus.value : 'ALL';

        var filtered = prList.filter(function (pr) {
          var vendorNames = (pr.recipients || []).map(function (r) { return String(r.vendorName || '').toLowerCase(); }).join(' ');
          var matchText = !query ||
            pr.pekerjaan.toLowerCase().indexOf(query) !== -1 ||
            pr.lokasi.toLowerCase().indexOf(query) !== -1 ||
            pr.nomor.toLowerCase().indexOf(query) !== -1 ||
            vendorNames.indexOf(query) !== -1;
          var matchStatus = filter === 'ALL' || pr.status === filter;
          return matchText && matchStatus;
        });

        var listContainer = document.getElementById('pr-cards-list');
        if (!listContainer) return;
        if (filtered.length === 0) {
          listContainer.innerHTML = '<div class="py-10 text-center text-xs text-slate-400 border border-dashed border-slate-200 rounded-2xl">Tidak ada dokumen Payment Request yang cocok dengan pencarian Anda.</div>';
          return;
        }

        listContainer.innerHTML = filtered.map(function (pr) {
          var total = calcPRTotal(pr);
          var vendorSummary = (pr.recipients || []).map(function (r) { return r.vendorName; }).join(', ');
          return '' +
            '<div class="pr-card" data-pr-id="' + escapeHtml(pr.id) + '">' +
              '<div class="space-y-1.5 min-w-0 flex-1">' +
                '<div class="flex flex-wrap items-center gap-2">' +
                  '<span class="font-mono text-xs font-bold text-maroon-800 bg-maroon-50 border border-maroon-200/60 px-2.5 py-0.5 rounded-md">' + escapeHtml(pr.nomor) + '</span>' +
                  getStatusBadge(pr.status) +
                  '<span class="text-[11.5px] text-slate-500 font-medium">&bull; Est. Transfer: <strong class="text-slate-700">' + escapeHtml(pr.estTransfer) + '</strong></span>' +
                '</div>' +
                '<h3 class="font-bold text-sm sm:text-base text-slate-900 truncate mt-1">' + escapeHtml(pr.pekerjaan) + '</h3>' +
                '<p class="text-xs text-slate-500 truncate"><span class="font-semibold text-slate-700">' + pr.recipients.length + ' Penerima:</span> ' + escapeHtml(vendorSummary) + '</p>' +
              '</div>' +
              '<div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100">' +
                '<span class="text-base sm:text-lg font-extrabold text-slate-900 tracking-tight">' + formatRupiah(total) + '</span>' +
                '<span class="pr-card-btn-view">Buka Dokumen <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i></span>' +
              '</div>' +
            '</div>';
        }).join('');
        initIcons();
      }

      function updateInfoLpj() {
        var select = document.getElementById('inp-pekerjaan');
        var box = document.getElementById('info-lpj-pr');
        if (!select || !box) return;
        var opt = select.selectedIndex >= 0 ? select.options[select.selectedIndex] : null;
        if (!opt || !opt.value) {
          box.classList.add('hidden');
          return;
        }
        box.classList.remove('hidden');
        var nama = document.getElementById('info-lpj-nama');
        var anggaran = document.getElementById('info-lpj-anggaran');
        var sisa = document.getElementById('info-lpj-sisa');
        if (nama) nama.textContent = opt.getAttribute('data-nama') || opt.textContent;
        if (anggaran) anggaran.textContent = formatRupiah(opt.getAttribute('data-anggaran'));
        if (sisa) sisa.textContent = formatRupiah(opt.getAttribute('data-sisa'));
      }

      function pilihLpjDiForm(id, namaFallback) {
        var select = document.getElementById('inp-pekerjaan');
        if (!select) return;
        var nilai = String(id || '');
        var nama = String(namaFallback || 'Project LPJ (data lama)');
        if (nilai && !Array.prototype.some.call(select.options, function (o) { return o.value === nilai; })) {
          var opsi = document.createElement('option');
          opsi.value = nilai;
          opsi.textContent = nama;
          opsi.setAttribute('data-nama', nama);
          opsi.setAttribute('data-anggaran', '0');
          opsi.setAttribute('data-sisa', '0');
          select.appendChild(opsi);
        }
        select.value = nilai;
        updateInfoLpj();
      }

      // Detail bukan section lagi: pindah ke halaman dokumen mandiri.
      function openPRDetail(id) {
        var pr = prList.find(function (item) { return item.id === id || item._id === id; });
        var docId = (pr && (pr._id || pr.id)) || id;
        window.location.href = '/payment-request/detail/' + encodeURIComponent(docId);
      }

      function openCreateForm() {
        var form = document.getElementById('pr-editor-form');
        if (form) form.reset();
        var editId = document.getElementById('edit-pr-id');
        if (editId) editId.value = '';
        var badge = document.getElementById('form-mode-badge');
        if (badge) badge.textContent = 'Pengajuan Baru';
        var container = document.getElementById('form-recipients-container');
        if (container) container.innerHTML = '';
        addRecipientBlock();
        pilihLpjDiForm('', '');
        navigateTo('form');
      }

      function bukaFormEdit(id) {
        var pr = prList.find(function (item) { return item.id === id || item._id === id; });
        if (!pr) {
          showToast('Dokumen payment request tidak ditemukan.', 'error');
          return;
        }
        var editId = document.getElementById('edit-pr-id');
        if (editId) editId.value = pr._id || pr.id;
        var badge = document.getElementById('form-mode-badge');
        if (badge) badge.textContent = 'Edit ' + pr.nomor;
        pilihLpjDiForm(pr.lpjId || (pr.pekerjaan === '-' ? '' : pr.pekerjaan), pr.pekerjaan);
        document.getElementById('inp-transfer').value = pr.estTransfer === '-' ? '' : tanggalISO(pr.estTransfer);
        document.getElementById('inp-lokasi').value = pr.lokasi === '-' ? '' : pr.lokasi;
        document.getElementById('inp-detail').value = pr.detail === '-' ? '' : pr.detail;
        document.getElementById('inp-attachments').value = (pr.attachments || []).map(function (a) { return '- ' + a; }).join('\n');
        var container = document.getElementById('form-recipients-container');
        container.innerHTML = '';
        pr.recipients.forEach(function (rec) { addRecipientBlock(rec); });
        navigateTo('form');
      }

      function addRecipientBlock(data) {
        var container = document.getElementById('form-recipients-container');
        var idx = container.children.length;
        var theme = colorStylesUser[idx % colorStylesUser.length];
        var block = document.createElement('div');
        block.className = 'rec-block rounded-2xl border ' + theme.border + ' ' + theme.bg + ' p-4 sm:p-5 space-y-3.5';
        var d = data || {};
        block.innerHTML = '' +
          '<div class="flex items-center justify-between gap-2">' +
            '<span class="text-xs font-extrabold text-slate-900 uppercase tracking-wide rec-number-label">Penerima Transfer ' + (idx + 1) + '</span>' +
            '<button type="button" onclick="removeRecipientBlock(this)" class="text-xs font-semibold text-rose-700 hover:underline cursor-pointer">Hapus Penerima</button>' +
          '</div>' +
          '<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">Keterangan Pengeluaran *</label><input type="text" required value="' + escapeHtml(d.summaryTitle || '') + '" placeholder="Masukan keterangan..." class="rec-summary-title w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-maroon-800" /></div>' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">Nama Vendor *</label><input type="text" required value="' + escapeHtml(d.vendorName || '') + '" placeholder="Masukan nama vendor..." class="rec-vendor-name w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-maroon-800" /></div>' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">PIC &amp; No. HP *</label><input type="text" required value="' + escapeHtml(d.pic || '') + '" placeholder="Contoh: Nama - 0812 1105 0038" class="rec-pic w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-maroon-800" /></div>' +
          '</div>' +
          '<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">Nama Bank *</label><select class="rec-bank w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-medium focus:outline-none focus:border-maroon-800">' +
              ['Bank BCA', 'Bank BSI', 'Bank Mandiri', 'Bank BNI', 'Bank BRI', 'Bank SMBC'].map(function (b) {
                return '<option value="' + b + '"' + ((d.bank || 'Bank BCA') === b ? ' selected' : '') + '>' + b + '</option>';
              }).join('') +
            '</select></div>' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">Nomor Rekening *</label><input type="text" required value="' + escapeHtml(d.accountNo || '') + '" placeholder="Masukan nomer rekening" class="rec-acc-no w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-mono font-bold focus:outline-none focus:border-maroon-800" /></div>' +
            '<div><label class="block text-[11px] font-semibold text-slate-700 mb-1">Atas Nama Rekening (a.n) *</label><input type="text" required value="' + escapeHtml(d.accountHolder || '') + '" placeholder="Masukan nama rekening" class="rec-acc-holder w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs focus:outline-none focus:border-maroon-800" /></div>' +
          '</div>' +
          '<div class="bg-white/90 rounded-xl p-3 border border-slate-300 space-y-2">' +
            '<div class="flex items-center justify-between">' +
              '<span class="text-[11px] font-bold text-slate-700">Rincian Item Pembayaran:</span>' +
              '<button type="button" onclick="addItemRowToBlock(this)" class="text-[11px] font-bold text-maroon-800 hover:underline cursor-pointer">+ Tambah Baris Item</button>' +
            '</div>' +
            '<div class="rec-items-list space-y-2"></div>' +
            '<div class="pt-2 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2 text-xs">' +
              '<span class="italic text-slate-600 rec-subtotal-terbilang">Nol Rupiah</span>' +
              '<span class="font-extrabold text-slate-900">Subtotal: <span class="rec-subtotal-val text-maroon-800">Rp 0</span></span>' +
            '</div>' +
          '</div>';

        container.appendChild(block);
        var itemsListEl = block.querySelector('.rec-items-list');
        var items = (d.items && d.items.length) ? d.items : [null];
        items.forEach(function (item) { createItemRowElement(itemsListEl, item); });
        recalcFormLiveTotal();
        initIcons();
      }

      function createItemRowElement(listEl, itemData) {
        var item = itemData || {};
        var row = document.createElement('div');
        row.className = 'item-row grid grid-cols-1 sm:grid-cols-12 gap-2 items-center';
        row.innerHTML = '' +
          '<div class="sm:col-span-6"><input type="text" required value="' + escapeHtml(item.desc || '') + '" placeholder="Deskripsi item / biaya..." class="item-desc w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs focus:outline-none focus:border-maroon-800" /></div>' +
          '<div class="sm:col-span-2"><input type="number" min="1" required value="' + escapeHtml(item.qty == null ? 1 : item.qty) + '" oninput="recalcFormLiveTotal()" placeholder="Qty" class="item-qty w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-center focus:outline-none focus:border-maroon-800" /></div>' +
          '<div class="sm:col-span-3"><input type="number" min="0" step="500" required value="' + escapeHtml(item.price == null ? 0 : item.price) + '" oninput="recalcFormLiveTotal()" placeholder="Harga Satuan" class="item-price w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-bold text-right focus:outline-none focus:border-maroon-800" /></div>' +
          '<div class="sm:col-span-1 flex justify-end"><button type="button" onclick="removeItemRowFromBlock(this)" class="p-1.5 text-slate-400 hover:text-rose-600 cursor-pointer" title="Hapus baris"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button></div>';
        listEl.appendChild(row);
        initIcons();
      }

      function addItemRowToBlock(btn) {
        var listEl = btn.closest('.rec-block').querySelector('.rec-items-list');
        createItemRowElement(listEl);
        recalcFormLiveTotal();
      }

      function removeItemRowFromBlock(btn) {
        var listEl = btn.closest('.rec-items-list');
        if (listEl.children.length <= 1) {
          showToast('Minimal harus ada 1 rincian item pada setiap penerima.', 'error');
          return;
        }
        btn.closest('.item-row').remove();
        recalcFormLiveTotal();
      }

      function removeRecipientBlock(btn) {
        var container = document.getElementById('form-recipients-container');
        if (container.children.length <= 1) {
          showToast('Minimal harus ada 1 penerima pembayaran.', 'error');
          return;
        }
        btn.closest('.rec-block').remove();
        Array.prototype.forEach.call(container.children, function (el, i) {
          el.querySelector('.rec-number-label').textContent = 'Penerima Transfer ' + (i + 1);
        });
        recalcFormLiveTotal();
      }

      function recalcFormLiveTotal() {
        var grandTotal = 0;
        document.querySelectorAll('.rec-block').forEach(function (block) {
          var sub = 0;
          block.querySelectorAll('.item-row').forEach(function (row) {
            var q = Number(row.querySelector('.item-qty').value) || 0;
            var p = Number(row.querySelector('.item-price').value) || 0;
            sub += q * p;
          });
          grandTotal += sub;
          block.querySelector('.rec-subtotal-val').textContent = formatRupiah(sub);
          block.querySelector('.rec-subtotal-terbilang').textContent = terbilang(sub);
        });
        var totalEl = document.getElementById('form-live-grand-total');
        var terbilangEl = document.getElementById('form-live-terbilang');
        if (totalEl) totalEl.textContent = formatRupiah(grandTotal);
        if (terbilangEl) terbilangEl.textContent = 'Terbilang: ' + terbilang(grandTotal);
      }

      function kumpulkanPayload() {
        var fd = new FormData();
        var selectLpj = document.getElementById('inp-pekerjaan');
        var opsiLpj = selectLpj && selectLpj.selectedIndex >= 0 ? selectLpj.options[selectLpj.selectedIndex] : null;
        var lpjId = opsiLpj && opsiLpj.value ? opsiLpj.value : '';
        var pekerjaan = lpjId ? (opsiLpj.getAttribute('data-nama') || opsiLpj.textContent.trim()) : '';
        var estTransfer = document.getElementById('inp-transfer').value.trim();
        var lokasi = document.getElementById('inp-lokasi').value.trim();
        var detail = document.getElementById('inp-detail').value.trim();
        var rawAtt = document.getElementById('inp-attachments').value.trim();
        var attachments = rawAtt
          ? rawAtt.split(/\r?\n/).map(function (line) { return line.replace(/^[-•*]\s*/, '').trim(); }).filter(Boolean)
          : ['1 (satu) lembar dokumen bukti tagihan'];

        fd.append('lpjId', lpjId);
        fd.append('pekerjaan', pekerjaan);
        fd.append('estimasiTransfer', estTransfer);
        fd.append('tanggalTransfer', tanggalISO(estTransfer));
        fd.append('lokasi', lokasi);
        fd.append('detailPekerjaan', detail);
        fd.append('daftarDokumen', attachments.join('\n'));
        fd.append('deskripsi', detail);
        fd.append('unitKerja', pekerjaan);
        fd.append('pemohon', PR_NAMA_PEMOHON);
        fd.append('kategori', 'Payment Request');
        fd.append('urgensi', 'Normal');

        var allRecipients = Array.prototype.map.call(document.querySelectorAll('.rec-block'), function (block, i) {
          var items = Array.prototype.map.call(block.querySelectorAll('.item-row'), function (row) {
            return {
              desc: row.querySelector('.item-desc').value.trim(),
              qty: Number(row.querySelector('.item-qty').value) || 1,
              price: Number(row.querySelector('.item-price').value) || 0,
            };
          });
          var rec = {
            summaryTitle: block.querySelector('.rec-summary-title').value.trim(),
            vendorName: block.querySelector('.rec-vendor-name').value.trim(),
            pic: block.querySelector('.rec-pic').value.trim(),
            bank: block.querySelector('.rec-bank').value,
            accountNo: block.querySelector('.rec-acc-no').value.trim(),
            accountHolder: block.querySelector('.rec-acc-holder').value.trim(),
            items: items,
          };
          fd.append('penerimaTransfer[' + i + '][summaryTitle]', rec.summaryTitle);
          fd.append('penerimaTransfer[' + i + '][vendorName]', rec.vendorName);
          fd.append('penerimaTransfer[' + i + '][pic]', rec.pic);
          fd.append('penerimaTransfer[' + i + '][bank]', rec.bank);
          fd.append('penerimaTransfer[' + i + '][accountNo]', rec.accountNo);
          fd.append('penerimaTransfer[' + i + '][accountHolder]', rec.accountHolder);
          fd.append('penerimaTransfer[' + i + '][namaPenerima]', rec.vendorName);
          fd.append('penerimaTransfer[' + i + '][noRekening]', rec.accountNo);
          fd.append('penerimaTransfer[' + i + '][atasNama]', rec.accountHolder);
          fd.append('penerimaTransfer[' + i + '][keterangan]', rec.pic);
          items.forEach(function (item, j) {
            fd.append('penerimaTransfer[' + i + '][items][' + j + '][desc]', item.desc);
            fd.append('penerimaTransfer[' + i + '][items][' + j + '][qty]', item.qty);
            fd.append('penerimaTransfer[' + i + '][items][' + j + '][price]', item.price);
            fd.append('penerimaTransfer[' + i + '][rincianBiaya][' + j + '][deskripsi]', item.desc);
            fd.append('penerimaTransfer[' + i + '][rincianBiaya][' + j + '][jumlah]', item.qty * item.price);
            fd.append('penerimaTransfer[' + i + '][rincianBiaya][' + j + '][qty]', item.qty);
            fd.append('penerimaTransfer[' + i + '][rincianBiaya][' + j + '][hargaSatuan]', item.price);
          });
          rec.items = items;
          return rec;
        });

        var fieldSumber = document.querySelector('#pr-editor-form input[name="_liveClientId"]');
        if (fieldSumber) fd.append('_liveClientId', fieldSumber.value);
        fd.append('_jumlahPenerima', String(allRecipients.length));
        return fd;
      }

      async function handleSavePR(event) {
        event.preventDefault();
        var editIdEl = document.getElementById('edit-pr-id');
        var editId = editIdEl ? editIdEl.value : '';
        var tombol = document.getElementById('btn-simpan-pr');
        var teksTombol = tombol ? tombol.innerHTML : '';
        if (tombol) { tombol.disabled = true; tombol.textContent = 'Menyimpan...'; }

        try {
          var url = editId
            ? '/payment-request-user/update/' + encodeURIComponent(editId)
            : '/payment-request-user/add';
          var response = await fetch(url, {
            method: 'POST',
            headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: kumpulkanPayload(),
          });
          var hasil;
          try { hasil = await response.json(); } catch (err) { hasil = null; }
          if (!response.ok || !hasil || hasil.success === false) {
            throw new Error((hasil && hasil.message) || 'Gagal menyimpan payment request.');
          }
          var tersimpan = normalizePR(hasil.data || hasil);
          var idx = prList.findIndex(function (p) { return p.id === tersimpan.id || (tersimpan._id && p._id === tersimpan._id); });
          if (idx >= 0) prList[idx] = tersimpan; else prList.unshift(tersimpan);
          renderPRList();
          var docId = tersimpan._id || tersimpan.id;
          window.location.href = '/payment-request/detail/' + encodeURIComponent(docId);
        } catch (err) {
          showToast('Gagal menyimpan: ' + escapeHtml(err.message || 'terjadi kesalahan'), 'error');
        } finally {
          if (tombol) { tombol.disabled = false; tombol.innerHTML = teksTombol; initIcons(); }
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        prList = jadiArray(PR_DATA_USER).map(normalizePR);
        var cari = document.getElementById('search-pr-input');
        var filter = document.getElementById('filter-pr-status');
        if (cari) cari.value = '';
        if (filter) filter.value = 'ALL';

        renderPRList();

        var listContainer = document.getElementById('pr-cards-list');
        if (listContainer) {
          listContainer.addEventListener('click', function (event) {
            var card = event.target.closest('[data-pr-id]');
            if (card) openPRDetail(card.getAttribute('data-pr-id'));
          });
        }

        var form = document.getElementById('pr-editor-form');
        if (form) form.addEventListener('submit', handleSavePR);

        var selectLpjAwal = document.getElementById('inp-pekerjaan');
        if (selectLpjAwal) selectLpjAwal.addEventListener('change', updateInfoLpj);
        updateInfoLpj();

        var params = new URLSearchParams(window.location.search);
        var editId = params.get('edit');
        if (editId) {
          bukaFormEdit(editId);
        } else {
          navigateTo('list');
        }
        initIcons();
      });
    </script>
  </body>
</html>
