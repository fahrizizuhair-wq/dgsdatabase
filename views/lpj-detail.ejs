<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Workspace Detail - <%= lpj.namaKegiatan %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      color: #333; display: flex; min-height: 100vh;
      position: relative; background-color: #f4f6f9;
    }
    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    .main-content { flex: 1; padding: 30px; width: 100%; overflow-x: auto; }
    
    .system-banner {
      background: #1e293b; color: #ffffff; border-radius: 12px; padding: 22px 24px;
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15); flex-wrap: wrap; gap: 15px;
    }
    .banner-title-wrap { display: flex; align-items: center; gap: 14px; }
    .banner-icon { background: #7a1b1b; color: white; width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; }
    .banner-text span { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: #f87171; font-weight: 700; }
    .banner-text h1 { font-size: 20px; font-weight: 700; color: #fff; margin-top: 2px; }

    .btn-back { background-color: #475569; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; }
    .btn-back:hover { background-color: #334155; }

    .workspace-container {
      background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(8px); border-radius: 14px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 25px; }
    .info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; }
    .info-box span { font-size: 12px; color: #64748b; font-weight: 600; display: block; margin-bottom: 4px; }
    .info-box h3 { font-size: 18px; font-weight: 700; color: #0f172a; }
  </style>
</head>
<body>

  <main class="main-content">
    <!-- BANNER HEADER DETAIL -->
    <div class="system-banner">
      <div class="banner-title-wrap">
        <div class="banner-icon">WS</div>
        <div class="banner-text">
          <span>Workspace Detail Kegiatan</span>
          <h1><%= lpj.namaKegiatan %></h1>
        </div>
      </div>
      <a href="/lpj" class="btn-back">← Kembali ke Dashboard</a>
    </div>

    <!-- KONTEN UTAMA DETAIL WORKSPACE -->
    <div class="workspace-container">
      <div class="info-grid">
        <div class="info-box">
          <span>Kategori & Tahun</span>
          <h3><%= lpj.kategori %></h3>
        </div>
        <div class="info-box">
          <span>Status LPJ</span>
          <h3 style="color: #2563eb;"><%= lpj.status %></h3>
        </div>
        <div class="info-box">
          <span>Anggaran Kasbon</span>
          <h3>Rp <%= (lpj.anggaranKasbon || 0).toLocaleString('id-ID') %></h3>
        </div>
        <div class="info-box">
          <span>Sisa Saldo</span>
          <h3 style="color: #16a34a;">Rp <%= (lpj.sisaSaldo || 0).toLocaleString('id-ID') %></h3>
        </div>
      </div>

      <div style="background: #f1f5f9; padding: 20px; border-radius: 10px; margin-top: 20px;">
        <h4 style="margin-bottom: 10px; color: #0f172a;">Keterangan / Catatan Kegiatan:</h4>
        <p style="color: #475569; font-size: 14px;"><%= lpj.keterangan || 'Tidak ada catatan tambahan.' %></p>
      </div>
    </div>
  </main>

</body>
</html>