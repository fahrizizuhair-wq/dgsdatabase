                    <select name="kategori" id="kategori">
                        <option value="">Semua Kategori</option>
                        <option value="ATK">ATK</option>
                        <option value="Pakaian">Pakaian</option>
                        <option value="Kain">Kain</option>
                        <option value="Elektronik">Elektronik</option>
                        <option value="Packaging">Packaging</option>
                        <option value="Percetakan">Percetakan</option>
                        <option value="Merchandise">Merchandise</option>
                        <option value="Logistik">Logistik</option>
                        <option value="Voucher">Voucher</option>
                        <option value="Rental">Rental</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="status">Status Vendor:</label>
                    <select name="status" id="status">
                        <option value="">Semua Status</option>
                        <option value="Aktif">Aktif</option>
                        <option value="Review">Review</option>
                        <option value="Nonaktif">Nonaktif</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label for="wilayah">Wilayah:</label>
                    <select name="wilayah" id="wilayah">
                        <option value="">Semua Wilayah</option>
                        <option value="Jakarta">Jakarta</option>
                        <option value="Bogor">Bogor</option>
                        <option value="Depok">Depok</option>
                        <option value="Tanggerang">Tanggerang</option>
                        <option value="Bekasi">Bekasi</option>
                        <option value="Garut">Garut</option>
                        <option value="Bandung">Bandung</option>
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-apply">Terapkan</button>
                    <a href="/admin" class="btn-reset">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>
  
      <!-- Bungkus tabel dengan div container responsif -->
      <div class="table-responsive-container">
        <table id="vendorTable">
          <thead>
            <tr>
              <th>ID Vendor</th>
              <th>Nama Vendor</th>
              <th>Wilayah</th>
              <th>Kategori Supply</th>
              <th>Kontak</th>
              <th>Rating</th>
              <th>Status</th>
              <th style="text-align: center;">Aksi</th>
            </tr>
          </thead>
          <tbody id="vendorTableBody">
          <% if (!vendors || vendors.length === 0) { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 20px; color: #888;">Belum ada data vendor.</td>
            </tr>
          <% } else { %>
            <% vendors.forEach((vendor) => { %>
              <tr class="vendor-row" data-id="<%= vendor._id %>">
                <td><strong><%= vendor.idVendor %></strong></td>
                <td><%= vendor.namaVendor %></td>
                <td><%= vendor.wilayah ? vendor.wilayah : '-' %></td>
                <td><%= vendor.kategori %></td>
                <td><%= vendor.kontak %></td>
                <td>⭐ <%= vendor.rating %></td>
                <td>
                  <span class="badge <%= vendor.status === 'Aktif' ? 'badge-active' : (vendor.status === 'Review' ? 'badge-review' : 'badge-inactive') %>">
                    <%= vendor.status %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <button type="button" class="btn-edit" 
                          data-id="<%= vendor._id %>"
                          data-idvendor="<%= vendor.idVendor %>"
                          data-namavendor="<%= vendor.namaVendor %>"
                          data-wilayah="<%= vendor.wilayah || '' %>"
                          data-kategori="<%= vendor.kategori %>"
                          data-kontak="<%= vendor.kontak %>"
                          data-rating="<%= vendor.rating %>"
                          data-status="<%= vendor.status %>"
                          data-deskripsi="<%= vendor.deskripsi || '' %>"
                          onclick="openEditModalFromBtn(event, this)">Edit</button>
                  <form action="/admin/vendor/delete/<%= vendor._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus vendor <%= vendor.namaVendor %>?');">
                    <button type="submit" class="btn-delete" onclick="event.stopPropagation();">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="pagination-container">
        <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %><%= typeof search !== 'undefined' && search ? '&search=' + search : '' %><%= typeof kategori !== 'undefined' && kategori ? '&kategori=' + kategori : '' %><%= typeof status !== 'undefined' && status ? '&status=' + status : '' %><%= typeof wilayah !== 'undefined' && wilayah ? '&wilayah=' + wilayah : '' %>" 
               class="page-btn <%= currentPage === i ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>
    </div>
<% } %>
    </section>
  </main>

