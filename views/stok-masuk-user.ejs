<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Database - Stok Masuk</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html, body { width: 100%; height: 100%; margin: 0; padding: 0; overflow-x: hidden; }

    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; color: #333; display: flex; min-height: 100vh;
      position: relative; background-color: #f4f6f9;
    }

    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    
   /* Sidebar Styling */
    .sidebar-overlay { 
      display: none; 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 100vw; 
      height: 100vh; 
      background: rgba(15, 23, 42, 0.55); 
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 999; 
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active { 
      display: block; 
      opacity: 1;
    }

    /* SIDEBAR */
    .sidebar { 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 280px; 
      height: 100vh; 
      background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
      color: white; 
      padding: 28px 22px; 
      display: flex; 
      flex-direction: column; 
      justify-content: space-between; 
      z-index: 1000; 
      transform: translateX(-100%); 
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); 
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25); 
      overflow-y: auto;
    }
    .sidebar.active { transform: translateX(0); }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 25px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-logo-img {
      width: 42px;
      height: 42px;
      object-fit: contain;
      background: rgba(255, 255, 255, 0.12);
      padding: 5px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .brand-text h2 {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }
    .brand-text span {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 600;
    }
    .close-sidebar-btn {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: white;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 16px;
      transition: all 0.2s;
    }
    .close-sidebar-btn:hover { background: rgba(255, 255, 255, 0.2); }

    .sidebar-user-card {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 12px 14px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .user-avatar-circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }
    .sidebar-user-info h4 {
      font-size: 13px;
      font-weight: 600;
      color: white;
    }
    .sidebar-user-info span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: #86efac;
      font-weight: 500;
    }
    .sidebar-user-info span::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
    }

    .nav-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: rgba(255, 255, 255, 0.5);
      margin: 10px 0 10px 8px;
    }
    .nav-menu { 
      list-style: none; 
      display: flex; 
      flex-direction: column; 
      gap: 6px; 
    }
    .nav-item a { 
      display: flex; 
      align-items: center;
      gap: 12px;
      padding: 11px 14px; 
      color: rgba(255, 255, 255, 0.82); 
      text-decoration: none; 
      border-radius: 10px; 
      font-weight: 500; 
      font-size: 13.5px; 
      transition: all 0.2s ease;
    }
    .nav-item a svg {
      width: 18px;
      height: 18px;
      opacity: 0.8;
      transition: transform 0.2s;
    }
    .nav-item a:hover { 
      background-color: rgba(255, 255, 255, 0.12); 
      color: #ffffff; 
      transform: translateX(3px);
    }
    .nav-item a:hover svg {
      opacity: 1;
      transform: scale(1.1);
    }
    .nav-item.active a { 
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%); 
      color: #ffffff; 
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      border-left: 3px solid #f87171;
    }
    .nav-item.active a svg { opacity: 1; }

    /* DROPDOWN SIDEBAR */
    .nav-item.dropdown { position: relative; }
    .dropdown-toggle { 
      display: flex !important; 
      justify-content: space-between; 
      align-items: center; 
      cursor: pointer;
    }
    .dropdown-toggle-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .dropdown-toggle .arrow { 
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
      font-size: 11px; 
      opacity: 0.8;
    }
    .dropdown-menu {
      list-style: none; 
      max-height: 0; 
      overflow: hidden; 
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      background-color: rgba(50, 10, 10, 0.45); 
      border-radius: 10px; 
      margin-top: 4px; 
      padding-left: 10px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .dropdown-menu li a { 
      padding: 9px 14px; 
      font-size: 13px; 
      color: rgba(255, 255, 255, 0.75); 
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .dropdown-menu li a:hover { 
      color: #ffffff; 
      background-color: rgba(255, 255, 255, 0.08); 
    }
    .nav-item.dropdown.active .dropdown-menu { 
      max-height: 200px; 
      padding-top: 6px;
      padding-bottom: 6px;
    }
    .nav-item.dropdown.active .arrow { transform: rotate(180deg); }

    .sidebar-footer { 
      display: flex; 
      flex-direction: column; 
      gap: 10px; 
      margin-top: 25px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .btn-bottom {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 500;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .btn-bottom:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
    }

    /* MAIN CONTENT */
    .main-content { flex: 1; padding: 30px; width: 100%; }
    .header-section h1 { font-size: 28px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .header-section p { color: #ffffff; }
    
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
    .card { background: rgba(255, 255, 255, 0.95); padding: 20px; border-radius: 12px; border: 1px solid #eef0f4; backdrop-filter: blur(5px); }
    .card-title { font-size: 14px; color: #666; margin-bottom: 8px; }
    .card-value { font-size: 26px; font-weight: 700; color: #7a1b1b; }

    /* TABLE & RESPONSIVE CONTAINER */
    .table-container { background: rgba(255, 255, 255, 0.95); border-radius: 12px; padding: 24px; border: 1px solid #eef0f4; backdrop-filter: blur(5px); }
    .table-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .table-header h2 { color: #7a1b1b; margin-right: auto; }
    .search-input { padding: 10px 14px; border: 1px solid #dde1e5; border-radius: 8px; font-size: 14px; outline: none; width: 260px; background: white; }
    .btn-add { background-color: #7a1b1b; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .btn-add:hover { background-color: #5c1313; }

    /* Kontainer khusus scroll horizontal tabel */
    .table-responsive-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 800px; }
    th, td { padding: 14px 16px; border-bottom: 1px solid #edf0f2; font-size: 14px; white-space: nowrap; }
    th { background-color: #f8f9fa; color: #555; }

    .item-row { transition: background-color 0.2s ease; }
    .item-row:hover { background-color: #f8eded; }

    /* BADGES */
    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-active { background-color: #e6f4ea; color: #137333; }
    .badge-review { background-color: #fef7e0; color: #b06000; }
    .badge-inactive { background-color: #fce8e6; color: #c5221f; }

    /* MODAL */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
    .modal-content { background: white; padding: 30px; border-radius: 12px; width: 450px; max-height: 85vh; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-family: inherit; }
    textarea.input-lg { min-height: 90px; resize: vertical; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
    .btn-cancel { background: #e0e0e0; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; }

    .toggle-btn { font-size: 20px; background: #ffffff; color: rgb(0, 0, 0); border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 20px; }

    /* ==========================================
       RESPONSIF MOBILE (Layar di bawah 768px)
       ========================================== */
    @media (max-width: 768px) {
      .main-content {
        padding: 16px !important;
      }
      .cards-grid {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
      }
      .table-header {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 10px !important;
      }
      .search-input {
        width: 100% !important;
      }
      .table-container {
        padding: 16px 12px !important;
      }
    }
  </style>
</head>
<body>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top-section">
      <div class="sidebar-header">
        <div class="brand-wrap">
          <img src="/images/dgs.png" alt="Logo DGS" class="brand-logo-img" onerror="this.style.display='none'">
          <div class="brand-text">
            <h2>Dian Giri Saputra</h2>
            <span>User Database</span>
          </div>
        </div>
        <button class="close-sidebar-btn" onclick="toggleSidebar()" title="Tutup Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="6"></line>
          </svg>
        </button>
      </div>

      <!-- Mini Profile Info -->
      <div class="sidebar-user-card">
        <div class="user-avatar-circle">DG</div>
        <div class="sidebar-user-info">
          <h4>Dian Giri Saputra</h4>
          <span>User Operasional</span>
        </div>
      </div>

      <div class="nav-label">Menu Navigasi</div>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Dashboard Utama</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/user">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Data Vendor</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/harga-dasar-user">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>Harga Dasar</span>
          </a>
        </li>
        <li class="nav-item dropdown active">
          <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
            <div class="dropdown-toggle-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
              <span>Stok & Barang</span>
            </div>
            <span class="arrow">&#9662;</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/stok-masuk-user" style="color: #fff; font-weight: 600;">Stok Masuk</a></li>
            <li><a href="/stok-keluar-user">Stok Keluar</a></li>
            <li><a href="/stok-opname-user">Stok Opname</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a href="/laporan-user">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Laporan</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/data-bahan-kain">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Data Kain</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="sidebar-footer">
      <a href="/" class="btn-bottom">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Keluar / Logout</span>
      </a>
    </div>
  </aside>

  <main class="main-content">
    <button class="toggle-btn" onclick="toggleSidebar()">☰</button>

    <header class="header-section">
      <h1>Manajemen Stok Masuk</h1>
      <p>Lihat pencatatan barang masuk dan pasokan inventaris.</p>
    </header>

    <section class="cards-grid">
      <div class="card">
        <div class="card-title">Total Item Masuk</div>
        <div class="card-value"><%= typeof totalTransaksi !== 'undefined' ? totalTransaksi : 0 %> Item</div>
      </div>
      <div class="card">
        <div class="card-title">Total Qty Barang</div>
        <div class="card-value"><%= typeof totalQtyMasuk !== 'undefined' ? totalQtyMasuk : 0 %> Pcs</div>
      </div>
    </section>

    <section class="table-container">
      <div class="table-header">
        <h2>Daftar Stok Masuk</h2>
        <input type="text" id="searchInput" class="search-input" placeholder="Cari transaksi..." onkeyup="filterTable()">
        <% if (role !== 'guest') { %>
        <button class="btn-add" onclick="openModal()">
          + Tambah Stok Masuk
        </button>
        <% } %>
      </div>

      <div class="table-responsive-wrapper">
        <table id="stokTable">
          <thead>
            <tr>
              <th>No</th>
              <th>Nama Barang</th>
              <th>Merk</th>
              <th>Jumlah</th>
              <th>Supplier</th>
              <th>Tanggal</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (!listStokMasuk || listStokMasuk.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 20px; color: #888;">Belum ada data stok masuk.</td>
              </tr>
            <% } else { %>
              <% listStokMasuk.forEach((item) => { %>
                <tr class="item-row">
                  <td><strong><%= item.idTransaksi %></strong></td>
                  <td><%= item.namaBarang %></td>
                  <td><%= item.namaMerk %></td>
                  <td><%= item.jumlah %></td>
                  <td><%= item.supplier %></td>
                  <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
                  <td>
                    <span class="badge <%= item.status === 'Selesai' ? 'badge-active' : (item.status === 'Proses' ? 'badge-review' : 'badge-inactive') %>">
                      <%= item.status %>
                    </span>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- MODAL TAMBAH -->
  <div class="modal" id="addModal">
    <div class="modal-content">
      <h3 style="margin-bottom: 15px; color: #7a1b1b;">Tambah Stok Masuk</h3>
      <form action="/stok-masuk-user/add" method="POST">
        <div class="form-group"><label>No</label><input type="text" name="idTransaksi" placeholder="No" required></div>
        <div class="form-group"><label>Nama Barang</label><input type="text" name="namaBarang" placeholder="Nama Barang" required></div>
        <div class="form-group"><label>Nama Merk</label><input type="text" name="namaMerk" placeholder="Merk Barang" required></div>
        <div class="form-group"><label>Jumlah Barang</label><input type="number" name="jumlah" min="1" value="1" required></div>
        <div class="form-group"><label>Supplier / Sumber</label><input type="text" name="supplier" placeholder="Nama Supplier" required></div>
        <div class="form-group"><label>Status</label>
          <select name="status">
            <option value="Selesai">Selesai</option>
            <option value="Proses">Proses</option>
            <option value="Pending">Pending</option>
          </select>
        </div>
        <div class="form-group"><label>Keterangan</label><textarea name="keterangan" class="input-lg" placeholder="Catatan tambahan..."></textarea></div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn-add">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() { document.getElementById('addModal').style.display = 'flex'; }
    function closeModal() { document.getElementById('addModal').style.display = 'none'; }

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }

    function toggleDropdown(element) {
      const parentLi = element.parentElement;
      parentLi.classList.toggle('active');
    }

    function filterTable() {
      const input = document.getElementById('searchInput').value.toLowerCase();
      const rows = document.getElementsByClassName('item-row');
      for (let row of rows) {
        row.style.display = row.textContent.toLowerCase().includes(input) ? '' : 'none';
      }
    }
  </script>
</body>
</html>