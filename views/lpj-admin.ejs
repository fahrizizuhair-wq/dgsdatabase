<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Management Multi-LPJ (Admin)</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html, body {
      width: 100%; height: 100%; margin: 0; padding: 0; overflow-x: hidden;
    }

    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      color: #333; display: flex; min-height: 100vh;
      position: relative; background-color: #f4f6f9;
    }

    /* GRADASI MERAH BACKGROUND KONSISTEN */
    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    
    /* MAIN CONTENT & BANNER */
    .main-content { flex: 1; padding: 30px; width: 100%; overflow-x: auto; }

    .system-banner {
      background: #f4f6f9; color: #7a1b1b; border-radius: 12px; padding: 22px 24px;
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15); flex-wrap: wrap; gap: 15px;
    }
    .banner-title-wrap { display: flex; align-items: center; gap: 14px; }
    
    /* TOMBOL TOGGLE DI DALAM BANNER */
    .banner-toggle-btn { 
      background: #ffffff; color: #7a1b1b; width: 44px; height: 44px; border-radius: 10px; border: none;
      display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;
    }
    .banner-toggle-btn:hover { background: #7a1b1b; color: #ffffff ; }

    .banner-text span { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; color: #000000; font-weight: 700; }
    .banner-text h1 { font-size: 20px; font-weight: 700; color: #000000; margin-top: 2px; }

    .btn-buat-lpj { background-color: #7a1b1b; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; }
    .btn-buat-lpj:hover { background-color: #5c1313; }

    /* FILTER & SEARCH TOOLBAR */
    .filter-search-toolbar { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; gap: 15px; flex-wrap: wrap; }
    .search-box-wrap { position: relative; flex: 1; min-width: 260px; }
    .search-box-wrap input { width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; outline: none; background: #fff; }
    .search-box-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; width: 16px; height: 16px; }

    .filter-status-wrap { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #475569; font-weight: 600; }
    .filter-status-wrap select { padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; outline: none; background: #fff; font-family: inherit; }

    /* LPJ CARD GRID CONTAINER */
    .lpj-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; width: 100%; }
    .lpj-card { background: #ffffff; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.06); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s; }
    .lpj-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
    
    .lpj-card-top { padding: 20px; }
    .lpj-meta-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .badge-kategori { font-size: 10px; font-weight: 700; text-transform: uppercase; color: #475569; background: #f1f5f9; padding: 4px 8px; border-radius: 6px; letter-spacing: 0.5px; }
    
    .badge-status { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
    .status-selesai { background: #dcfce7; color: #15803d; }
    .status-review { background: #fef9c3; color: #a16207; }
    .status-draft { background: #f1f5f9; color: #475569; }

    .lpj-delete-btn {
      background: #fee2e2;
      color: #dc2626;
      border: 1px solid #fecaca;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      line-height: 1;
      padding: 0;
    }
    .lpj-delete-btn:hover {
      background: #dc2626;
      color: #ffffff;
      border-color: #dc2626;
      transform: scale(1.12);
      box-shadow: 0 2px 6px rgba(220, 38, 38, 0.3);
    }

    .lpj-card h3 { font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 16px; line-height: 1.4; }

    .lpj-finances { background: #f8fafc; border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; border: 1px solid #f1f5f9; }
    .finance-row { display: flex; justify-content: space-between; font-size: 13px; align-items: center; }
    .finance-row span:first-child { color: #64748b; }
    .finance-row span:last-child { font-weight: 600; color: #0f172a; }
    .finance-row.saldo span:last-child { color: #2563eb; }
    .finance-row.pengeluaran span:last-child { color: #dc2626; }

    .progress-wrap { margin-bottom: 4px; }
    .progress-info { display: flex; justify-content: space-between; font-size: 11.5px; color: #64748b; margin-bottom: 5px; font-weight: 500; }
    .progress-bar-bg { width: 100%; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden; }
    .progress-bar-fill { height: 100%; background: #7a1b1b; border-radius: 3px; }

    .lpj-card-footer { border-top: 1px solid #f1f5f9; padding: 12px 20px; background: #fafafa; text-align: center; }
    .btn-workspace { display: block; width: 100%; background: #7a1b1b; color: white; text-decoration: none; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 600; transition: background 0.2s; }
    .btn-workspace:hover { background: #501212; }

    /* MODAL */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
    .modal-content { background: white; padding: 30px; border-radius: 12px; width: 480px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 12.5px; font-weight: 600; margin-bottom: 5px; color: #334155; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 13px; outline: none; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
    .btn-cancel { background: #e2e8f0; border: none; padding: 9px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; color: #334155; }
  </style>
  <link rel="stylesheet" href="/css/stat-cards.css">
  <link rel="stylesheet" href="/css/sidebar.css">
</head>
<body>

  <%- include('partials/sidebar-admin', { activePage: 'lpj' }) %>

  <main class="main-content">
    
    <!-- SYSTEM BANNER HEADER (TOMBOL TOGGLE BERADA DI DALAMNYA) -->
    <div class="system-banner">
      <div class="banner-title-wrap">
        <button class="banner-toggle-btn" onclick="toggleSidebar()" title="Buka Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div class="banner-text">
          <span>System LPJ Terpusat — Admin</span>
          <h1>Dashboard Management Multi-LPJ</h1>
        </div>
      </div>
      <button class="btn-buat-lpj" onclick="openModal()">+ Buat LPJ Baru</button>
    </div>

    <!-- STAT CARDS (RINGKASAN) -->
    <section class="card-grid">
      <div class="stat-card card-blue">
        <div class="card-header">
          <span class="card-title">Total Anggaran Kelolaan</span>
          <div class="icon-wrapper icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="6" width="20" height="14" rx="2"></rect>
              <path d="M2 10h20"></path>
              <circle cx="17" cy="15" r="1"></circle>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value" style="font-size: 1.55rem;">Rp <%= (typeof totalAnggaranKelolaan !== 'undefined' ? totalAnggaranKelolaan : 0).toLocaleString('id-ID') %></span>
        </div>
        <div class="card-footer">
          <span class="text-blue">Dari <%= typeof totalLpjTerdaftar !== 'undefined' ? totalLpjTerdaftar : 0 %> LPJ</span>
          <span>Terdaftar</span>
        </div>
      </div>

      <div class="stat-card card-red">
        <div class="card-header">
          <span class="card-title">Total Pengeluaran Saat Ini</span>
          <div class="icon-wrapper icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
              <polyline points="17 18 23 18 23 12"></polyline>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value" style="font-size: 1.55rem;">Rp <%= (typeof totalPengeluaran !== 'undefined' ? totalPengeluaran : 0).toLocaleString('id-ID') %></span>
        </div>
        <div class="card-footer">
          <span class="text-red">Realisasi Anggaran</span>
          <span>Pengeluaran</span>
        </div>
      </div>

      <div class="stat-card card-green">
        <div class="card-header">
          <span class="card-title">Total Sisa Saldo</span>
          <div class="icon-wrapper icon-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l7-4 7 4v14"></path>
              <path d="M9 21v-6h6v6"></path>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value" style="font-size: 1.55rem;">Rp <%= (typeof totalSisaSaldo !== 'undefined' ? totalSisaSaldo : 0).toLocaleString('id-ID') %></span>
        </div>
        <div class="card-footer">
          <span class="text-green">Tersedia</span>
          <span>Pengembalian</span>
        </div>
      </div>
    </section>

    <!-- KOTAK WRAPPER UTAMA BERLATAR BELAKANG PUTIH (MENUTUP BACKGROUND WEB) -->
    <div style="background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(8px); border-radius: 14px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-top: 25px;">
      
      <!-- PENCARIAN & FILTER TOOLBAR -->
      <div class="filter-search-toolbar">
        <form action="/lpj-admin" method="GET" style="display: flex; width: 100%; gap: 15px; flex-wrap: wrap; align-items: center;">
          <div class="search-box-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Cari LPJ (Merchandise, Seminar, Baksos)...">
          </div>
          <div class="filter-status-wrap">
            <label for="status">Filter Status:</label>
            <select name="status" id="status" onchange="this.form.submit()">
              <option value="">Semua LPJ</option>
              <option value="Selesai" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'Selesai') ? 'selected' : '' %>>Selesai</option>
              <option value="Sedang Direview" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'Sedang Direview') ? 'selected' : '' %>>Sedang Direview</option>
              <option value="Draft" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'Draft') ? 'selected' : '' %>>Draft</option>
            </select>
          </div>
        </form>
      </div>

      <!-- DAFTAR KARTU LPJ (GRID) -->
      <div class="lpj-grid">
        <% if (!listLpj || listLpj.length === 0) { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #64748b;">
            Belum ada data LPJ terdaftar. Silakan buat LPJ baru.
          </div>
        <% } else { %>
          <% listLpj.forEach(lpj => { 
             let statusClass = 'status-draft';
             if (lpj.status === 'Selesai') statusClass = 'status-selesai';
             else if (lpj.status === 'Sedang Direview') statusClass = 'status-review';
          %>
            <div class="lpj-card">
              <div class="lpj-card-top">
                <div class="lpj-meta-row">
                  <span class="badge-kategori"><%= lpj.kategori %></span>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="badge-status <%= statusClass %>"><%= lpj.status %></span>
                    <form action="/lpj-admin/hapus/<%= lpj._id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus LPJ &quot;<%= lpj.namaKegiatan %>&quot;?');" style="margin: 0; display: inline-flex;">
                      <button type="submit" class="lpj-delete-btn" title="Hapus LPJ">✕</button>
                    </form>
                  </div>
                </div>
                <h3><%= lpj.namaKegiatan %></h3>

                <div class="lpj-finances">
                  <div class="finance-row">
                    <span>Anggaran Kasbon:</span>
                    <span>Rp <%= (lpj.anggaranKasbon || 0).toLocaleString('id-ID') %></span>
                  </div>
                  <div class="finance-row pengeluaran">
                    <span>Total Pengeluaran:</span>
                    <span>Rp <%= (lpj.totalPengeluaran || 0).toLocaleString('id-ID') %></span>
                  </div>
                  <div class="finance-row saldo">
                    <span>Sisa Saldo:</span>
                    <span>Rp <%= ((lpj.anggaranKasbon || 0) - (lpj.totalPengeluaran || 0)).toLocaleString('id-ID') %></span>
                  </div>
                </div>

                <div class="progress-wrap">
                  <div class="progress-info">
                    <span>Progress Belanja</span>
                    <span><%= lpj.progressBelanja || 0 %>%</span>
                  </div>
                  <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: <%= lpj.progressBelanja || 0 %>%"></div>
                  </div>
                </div>
              </div>

              <div class="lpj-card-footer">
                <a href="/lpj/detail/<%= lpj._id %>" class="btn-workspace">👁️ Lihat Detail Workspace LPJ</a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

    </div>
  </main>

  <div class="modal" id="lpjModal">
    <div class="modal-content">
      <h3 style="margin-bottom: 16px; color: #7a1b1b;">Buat LPJ Baru</h3>
      <form action="/lpj-admin/add" method="POST">
        <div class="form-group">
          <label>Nama Kegiatan / Judul LPJ</label>
          <input type="text" name="namaKegiatan" placeholder="Contoh: LPJ Pengadaan Merchandise..." required>
        </div>
        <div class="form-group">
          <label>Tanggal LPJ</label>
          <input type="date" name="tanggal" id="inputTanggalLpj" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
        <div class="form-group">
          <label>Kategori & Tahun</label>
          <input type="text" name="kategori" placeholder="Contoh: PENGADAAN BARANG" required>
        </div>
        <div class="form-group">
          <label>Status Awal</label>
          <select name="status">
            <option value="Draft">Draft</option>
            <option value="Proses">Proses</option>
            <option value="Selesai">Selesai</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>Anggaran Kasbon (Rp)</label>
          <input type="number" id="inputAnggaran" name="anggaranKasbon" placeholder="Contoh: 43000000" required oninput="formatEstimasiRupiah(this)">
        </div>

        <div id="previewEstimasi" style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 10px 14px; margin-bottom: 15px; display: none;">
          <span style="font-size: 11px; color: #1e40af; font-weight: 600; display: block; margin-bottom: 2px;">Estimasi Anggaran Kasbon:</span>
          <span id="textEstimasiRupiah" style="font-size: 15px; font-weight: 700; color: #1d4ed8;">Rp 0</span>
        </div>

        <div class="form-group">
          <label>Keterangan Tambahan</label>
          <textarea name="keterangan" rows="2" placeholder="Catatan singkat..."></textarea>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn-buat-lpj" style="border-radius: 6px; padding: 9px 16px;">Simpan LPJ</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() { 
      const tglInput = document.getElementById('inputTanggalLpj');
      if (tglInput && !tglInput.value) {
        const today = new Date().toISOString().split('T')[0];
        tglInput.value = today;
      }
      document.getElementById('lpjModal').style.display = 'flex'; 
    }
    function closeModal() { document.getElementById('lpjModal').style.display = 'none'; }
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }

    function toggleDropdown(el) {
      el.closest('.nav-item.dropdown').classList.toggle('active');
    }

    // Buka modal otomatis jika diarahkan dari halaman detail (?buat=1)
    document.addEventListener('DOMContentLoaded', function () {
      const params = new URLSearchParams(window.location.search);
      if (params.get('buat') === '1') openModal();
    });

    function formatEstimasiRupiah(input) {
      const previewBox = document.getElementById('previewEstimasi');
      const textRupiah = document.getElementById('textEstimasiRupiah');
      const nilai = input.value;

      if (nilai && !isNaN(nilai) && Number(nilai) > 0) {
        const formatRp = Number(nilai).toLocaleString('id-ID', {
          style: 'currency',
          currency: 'IDR',
          maximumFractionDigits: 0
        });
        
        textRupiah.textContent = formatRp.replace('IDR', 'Rp');
        previewBox.style.display = 'block';
      } else {
        previewBox.style.display = 'none';
      }
    }
  </script>
</body>
</html>