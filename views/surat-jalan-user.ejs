<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Database - Surat Jalan</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html, body {
      width: 100%; height: 100%; margin: 0; padding: 0; overflow-x: hidden;
    }

    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      color: #333; display: flex; min-height: 100vh;
      position: relative; background-color: #f4f6f9;
    }

    /* Background Gradasi Merah Khas DGS */
    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    
    /* SIDEBAR OVERLAY */
    .sidebar-overlay { 
      display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
      background: rgba(15, 23, 42, 0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      z-index: 999; opacity: 0; transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active { display: block; opacity: 1; }

    /* SIDEBAR */
    .sidebar { 
      position: fixed; top: 0; left: 0; width: 280px; height: 100vh; 
      background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
      color: white; padding: 28px 22px; display: flex; flex-direction: column; justify-content: space-between; 
      z-index: 1000; transform: translateX(-100%); transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); 
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25); overflow-y: auto;
    }
    .sidebar.active { transform: translateX(0); }

    .sidebar-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 25px; padding-bottom: 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .brand-wrap { display: flex; align-items: center; gap: 12px; }
    .brand-logo-img {
      width: 42px; height: 42px; object-fit: contain; background: rgba(255, 255, 255, 0.12);
      padding: 5px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .brand-text h2 { font-size: 15px; font-weight: 700; letter-spacing: -0.3px; line-height: 1.2; }
    .brand-text span { font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.7); font-weight: 600; }
    
    .close-sidebar-btn {
      background: rgba(255, 255, 255, 0.1); border: none; color: white; width: 32px; height: 32px;
      border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; transition: all 0.2s;
    }
    .close-sidebar-btn:hover { background: rgba(255, 255, 255, 0.2); }

    .sidebar-user-card {
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px; padding: 12px 14px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px;
    }
    .user-avatar-circle {
      width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
      color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }
    .sidebar-user-info h4 { font-size: 13px; font-weight: 600; color: white; }
    .sidebar-user-info span { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #86efac; font-weight: 500; }
    .sidebar-user-info span::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 6px #22c55e; }

    .nav-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.5); margin: 10px 0 10px 8px; }
    .nav-menu { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .nav-item a { 
      display: flex; align-items: center; gap: 12px; padding: 11px 14px; color: rgba(255, 255, 255, 0.82); 
      text-decoration: none; border-radius: 10px; font-weight: 500; font-size: 13.5px; transition: all 0.2s ease;
    }
    .nav-item a svg { width: 18px; height: 18px; opacity: 0.8; transition: transform 0.2s; }
    .nav-item a:hover { background-color: rgba(255, 255, 255, 0.12); color: #ffffff; transform: translateX(3px); }
    .nav-item a:hover svg { opacity: 1; transform: scale(1.1); }
    .nav-item.active > a { 
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%); 
      color: #ffffff; font-weight: 600; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15); border-left: 3px solid #f87171;
    }
    .nav-item.active > a svg { opacity: 1; }

    /* DROPDOWN SIDEBAR */
    .nav-item.dropdown { position: relative; }
    .dropdown-toggle { display: flex !important; justify-content: space-between; align-items: center; cursor: pointer; }
    .dropdown-toggle-left { display: flex; align-items: center; gap: 12px; }
    .dropdown-toggle .arrow { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); font-size: 11px; opacity: 0.8; }
    .dropdown-menu {
      list-style: none; max-height: 0; overflow: hidden; transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      background-color: rgba(50, 10, 10, 0.45); border-radius: 10px; margin-top: 4px; padding-left: 10px; border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .dropdown-menu li a { padding: 9px 14px; font-size: 13px; color: rgba(255, 255, 255, 0.75); display: flex; align-items: center; gap: 10px; }
    .dropdown-menu li a:hover { color: #ffffff; background-color: rgba(255, 255, 255, 0.08); }
    .nav-item.dropdown.active .dropdown-menu { max-height: 200px; padding-top: 6px; padding-bottom: 6px; }
    .nav-item.dropdown.active .arrow { transform: rotate(180deg); }

    .sidebar-footer { display: flex; flex-direction: column; gap: 10px; margin-top: 25px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.12); }
    .btn-bottom {
      display: flex; align-items: center; gap: 10px; padding: 10px 14px; color: rgba(255, 255, 255, 0.8);
      text-decoration: none; font-size: 13.5px; font-weight: 500; border-radius: 8px; transition: all 0.2s;
    }
    .btn-bottom:hover { background: rgba(255, 255, 255, 0.1); color: white; }

    /* MAIN CONTENT */
    .main-content { flex: 1; padding: 30px; width: 100%; overflow-x: auto; }
    .header-section h1 { font-size: 28px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .header-section p { color: #ffffff; }
    
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
    
    /* REPORT CONTAINER & TABLE */
    .report-container { background: rgba(255, 255, 255, 0.95); border-radius: 12px; padding: 24px; border: 1px solid #eef0f4; backdrop-filter: blur(5px); overflow-x: auto; }
    .report-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .report-header h2 { color: #7a1b1b; margin-right: auto; }

    .btn-action { background-color: #7a1b1b; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-action:hover { background-color: #5c1313; }

    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 800px; margin-top: 10px; }
    th, td { padding: 12px 14px; border-bottom: 1px solid #edf0f2; font-size: 13px; vertical-align: middle; }
    th { background-color: #f8f9fa; color: #555; }

    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-barang { background-color: #e0f2fe; color: #0369a1; }
    .badge-dokumen { background-color: #fef3c7; color: #b45309; }

    .action-btns { display: flex; gap: 8px; }
    .btn-sub-action {
      padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;
      text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: none; cursor: pointer;
    }
    .btn-view { background-color: #f1f5f9; color: #475569; }
    .btn-view:hover { background-color: #e2e8f0; }
    .btn-print { background-color: #7a1b1b; color: #fff; }
    .btn-print:hover { background-color: #5c1313; }

    .empty-state { text-align: center; padding: 40px; color: #64748b; }
    .empty-state i { font-size: 40px; margin-bottom: 10px; color: #cbd5e1; }

    /* TOGGLE BUTTON */
    .toggle-btn { 
      font-size: 20px; background: #ffffff !important; color: #000000 !important; border: none; 
      padding: 8px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }

    @media (max-width: 768px) {
      .main-content { padding: 15px; }
      .report-header { flex-direction: column; align-items: flex-start; }
    }
  </style>
  <link rel="stylesheet" href="/css/stat-cards.css">
</head>
<body>

  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <!-- SIDEBAR NAVIGATION -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-top-section">
      <div class="sidebar-header">
        <div class="brand-wrap">
          <img src="/images/dgs.png" alt="Logo DGS" class="brand-logo-img" onerror="this.style.display='none'">
          <div class="brand-text">
            <h2>Dian Giri Saputra</h2>
            <span>User Database</span>
          </div>
        </div>
        <button class="close-sidebar-btn" onclick="toggleSidebar()" title="Tutup Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="6"></line>
          </svg>
        </button>
      </div>

      <!-- Mini Profile Info -->
      <div class="sidebar-user-card">
        <div class="user-avatar-circle">
          <%= (typeof user !== 'undefined' && user && user.username) ? user.username.substring(0,2).toUpperCase() : 'DG' %>
        </div>
        <div class="sidebar-user-info">
          <h4><%= (typeof user !== 'undefined' && user && (user.namaLengkap || user.username)) ? (user.namaLengkap || user.username) : 'User' %></h4>
          <span>User Operasional</span>
        </div>
      </div>

      <div class="nav-label">Menu Navigasi</div>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Dashboard Utama</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/user">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>Data Vendor</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="/harga-dasar-user">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>Harga Dasar</span>
          </a>
        </li>
        <li class="nav-item dropdown">
          <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
            <div class="dropdown-toggle-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
              <span>Stok & Barang</span>
            </div>
            <span class="arrow">&#9662;</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/stok-masuk-user">Stok Masuk</a></li>
            <li><a href="/stok-keluar-user">Stok Keluar</a></li>
            <li><a href="/stok-opname-user">Stok Opname</a></li>
          </ul>
        </li>

        <!-- Menu Dropdown Laporan (Aktif dengan Submenu Data Laporan & Surat Jalan) -->
        <li class="nav-item dropdown active open">
          <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
            <div class="dropdown-toggle-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Laporan</span>
            </div>
            <span class="arrow">&#9662;</span>
          </a>
          <ul class="dropdown-menu">
            <li><a href="/laporan-user">Data Laporan</a></li>
            <li><a href="/surat-jalan-user" style="color: #fff; font-weight: 700;">Surat Jalan</a></li>
          </ul>
        </li>

        <li class="nav-item">
          <a href="/data-bahan-kain">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Data Kain</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sidebar-footer">
      <a href="/" class="btn-bottom">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span>Keluar / Logout</span>
      </a>
    </div>
  </aside>

  <!-- KONTEN UTAMA -->
  <main class="main-content">
    <header class="header-section">
      <button class="toggle-btn" onclick="toggleSidebar()" title="Buka Sidebar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <h1>Data Surat Jalan</h1>
      <p>Kelola dan cetak surat jalan pengiriman barang / dokumen PT Dian Giri Saputra</p>
    </header>

    <%
      var _sjList = (typeof suratJalans !== 'undefined' && suratJalans) ? suratJalans : [];
      var _sjDokumen = _sjList.filter(function (i) { return i.jenisKirim === 'Dokumen'; }).length;
      var _sjBarang = _sjList.length - _sjDokumen;
    %>
    <section class="cards-grid">
      <div class="stat-card card-blue">
        <div class="card-header">
          <span class="card-title">Total Surat Jalan</span>
          <div class="icon-wrapper icon-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjList.length %></span>
          <span class="card-unit">Dokumen</span>
        </div>
        <div class="card-footer">
          <span class="text-blue">Arsip Tersedia</span>
          <span>PT Dian Giri Saputra</span>
        </div>
      </div>
      <div class="stat-card card-green">
        <div class="card-header">
          <span class="card-title">Pengiriman Barang</span>
          <div class="icon-wrapper icon-green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjBarang %></span>
          <span class="card-unit">Barang</span>
        </div>
        <div class="card-footer">
          <span class="text-green">Logistik</span>
          <span>Aktif</span>
        </div>
      </div>
      <div class="stat-card card-red">
        <div class="card-header">
          <span class="card-title">Pengiriman Dokumen</span>
          <div class="icon-wrapper icon-red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </div>
        </div>
        <div class="card-body">
          <span class="card-value"><%= _sjDokumen %></span>
          <span class="card-unit">Dokumen</span>
        </div>
        <div class="card-footer">
          <span class="text-red">Administrasi</span>
          <span>Resmi</span>
        </div>
      </div>
    </section>

    <!-- TABEL DATA SURAT JALAN -->
    <section class="report-container">
      <div class="report-header">
        <h2>Daftar Surat Jalan</h2>
        <a href="/surat-jalan/tambah" class="btn-action">+ Buat Surat Jalan Baru</a>
      </div>

      <table>
        <thead>
          <tr>
            <th>No. Surat Jalan</th>
            <th>Tanggal</th>
            <th>Kepada Yth</th>
            <th>Perihal / Pekerjaan</th>
            <th>Jenis</th>
            <th>Diinput Oleh</th>
            <th style="text-align: center;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof suratJalans !== 'undefined' && suratJalans.length > 0) { %>
            <% suratJalans.forEach(item => { %>
              <tr>
                <td><strong><%= item.noSuratJalan %></strong></td>
                <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
                <td><%= item.kepadaYth %></td>
                <td>
                  <div style="font-weight: 600;"><%= item.perihal || '-' %></div>
                  <div style="font-size: 12px; color: #64748b;"><%= item.pekerjaan || '' %></div>
                </td>
                <td>
                  <span class="badge <%= item.jenisKirim === 'Dokumen' ? 'badge-dokumen' : 'badge-barang' %>">
                    <%= item.jenisKirim || 'Barang' %>
                  </span>
                </td>
                <td><%= item.diinputOleh || '-' %></td>
                <td style="text-align: center;">
                  <div class="action-btns" style="justify-content: center;">
                    <a href="/surat-jalan/detail/<%= item._id %>" class="btn-sub-action btn-view" title="Detail">
                      <i class="fa-solid fa-eye"></i> Detail
                    </a>
                    <a href="/surat-jalan/cetak/<%= item._id %>" target="_blank" class="btn-sub-action btn-print" title="Cetak PDF">
                      <i class="fa-solid fa-print"></i> Cetak
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7">
                <div class="empty-state">
                  <i class="fa-regular fa-folder-open"></i>
                  <p>Belum ada data Surat Jalan yang diinput.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </section>
  </main>

  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }
    function toggleDropdown(element) {
      const parentLi = element.parentElement;
      parentLi.classList.toggle('active');
    }
  </script>
</body>
</html>