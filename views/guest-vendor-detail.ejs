<%- include('partials/guest-header', {
  pageTitle: 'Detail Vendor',
  pageSubtitle: 'Informasi vendor dan foto dalam mode read-only. Data tidak dapat diubah dari halaman guest.',
  active: 'vendor'
}) %>
<%- include('partials/head') %>

<div class="detail-topbar">
  <a href="/guest/vendor" class="btn-back">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    Kembali ke Data Vendor
  </a>
</div>

<section class="detail-layout">
  <article class="detail-card">
    <div class="detail-card-head">
      <span class="eyebrow">Detail Vendor</span>
      <h2><%= vendor.namaVendor || '-' %></h2>
      <span class="tag"><%= vendor.kategori || '-' %></span>
    </div>

    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-label">ID Vendor</div>
        <div class="detail-value"><span class="code-chip"><%= vendor.idVendor || '-' %></span></div>
      </div>

      <div class="detail-item">
        <div class="detail-label">Nama Vendor</div>
        <div class="detail-value"><%= vendor.namaVendor || '-' %></div>
      </div>

      <div class="detail-item">
        <div class="detail-label">Wilayah</div>
        <div class="detail-value"><%= vendor.wilayah || '-' %></div>
      </div>

      <div class="detail-item">
        <div class="detail-label">Kategori Supply</div>
        <div class="detail-value"><%= vendor.kategori || '-' %></div>
      </div>

      <div class="detail-item">
        <div class="detail-label">Diinput Oleh</div>
        <div class="detail-value"><%= vendor.diinputOleh || '-' %></div>
      </div>
    </div>

    <p class="readonly-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      Halaman ini hanya menampilkan informasi vendor dan foto. Guest tidak dapat mengubah atau menghapus data.
    </p>
  </article>

  <aside class="photo-card">
    <h3>Foto Vendor</h3>
    <p>Klik foto untuk melihat ukuran penuh.</p>

    <% if (fotoUrls && fotoUrls.length > 0) { %>
    <div class="photo-grid">
        <% fotoUrls.forEach(function (src, index) { %>
            <button type="button" class="photo-thumb" onclick="openLightbox('<%= index %>')" aria-label="Buka foto">
                <img src="<%= src %>" alt="Foto vendor" onerror="this.closest('.photo-thumb').style.display='none'">
            </button>
        <% }) %>
    </div>
<% } else { %>
    <div class="empty-state">Belum ada foto untuk vendor ini.</div>
<% } %>
  </aside>
</section>

<div class="lightbox" id="lightbox" onclick="closeLightboxOnBackdrop(event)">
  <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Tutup">&times;</button>
  <button type="button" class="lightbox-nav lightbox-prev" onclick="moveLightbox(-1)" aria-label="Foto sebelumnya">&#10094;</button>
  <img id="lightboxImage" src="" alt="Foto vendor">
  <button type="button" class="lightbox-nav lightbox-next" onclick="moveLightbox(1)" aria-label="Foto berikutnya">&#10095;</button>
  <span class="lightbox-count" id="lightboxCount"></span>
</div>

<script>
  const rawImages = '<%- JSON.stringify(fotoUrls || []) %>';
    const galleryImages = JSON.parse(rawImages.replace(/</g, '\\u003c'));
    let lightboxIndex = 0;

  function renderLightbox() {
    const image = document.getElementById('lightboxImage');
    const count = document.getElementById('lightboxCount');
    if (!image || galleryImages.length === 0) return;

    image.src = galleryImages[lightboxIndex];
    if (count) count.textContent = (lightboxIndex + 1) + ' / ' + galleryImages.length;
  }

  function openLightbox(index) {
    if (galleryImages.length === 0) return;
    lightboxIndex = index;
    renderLightbox();
    document.getElementById('lightbox').classList.add('active');
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
    document.getElementById('lightboxImage').src = '';
  }

  function closeLightboxOnBackdrop(event) {
    if (event.target.id === 'lightbox') closeLightbox();
  }

  function moveLightbox(step) {
    if (galleryImages.length === 0) return;
    lightboxIndex = (lightboxIndex + step + galleryImages.length) % galleryImages.length;
    renderLightbox();
  }

  document.addEventListener('keydown', function (event) {
    const lightbox = document.getElementById('lightbox');
    if (!lightbox || !lightbox.classList.contains('active')) return;

    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') moveLightbox(-1);
    if (event.key === 'ArrowRight') moveLightbox(1);
  });
</script>

<%- include('partials/guest-footer') %>
