<%- include('partials/guest-header', {
  pageTitle: 'Data Kain',
  pageSubtitle: 'Daftar data bahan kain. Anda hanya dapat melihat data yang sudah tersedia.',
  active: 'kain',
  totalCount: items.length
}) %>

<section class="panel">
  <div class="panel-head">
    <div>
      <h2>Daftar Data Kain</h2>
      <p>Kolom yang ditampilkan: ID Vendor, Nama Vendor, Wilayah, Kategori Supply, dan Status.</p>
    </div>
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="search" placeholder="Cari data kain..." aria-label="Cari data kain"
             data-table-search="#kainTable" data-empty="kainEmpty">
    </div>
  </div>

  <div class="table-wrap">
    <table class="data-table" id="kainTable">
      <thead>
        <tr>
          <th>ID Vendor</th>
          <th>Nama Vendor</th>
          <th>Wilayah</th>
          <th>Kategori Supply</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (!items || items.length === 0) { %>
          <tr>
            <td colspan="5">
              <div class="empty-state">Belum ada data kain yang ditambahkan.</div>
            </td>
          </tr>
        <% } else { %>
          <% items.forEach(function (item) { %>
            <tr data-row>
              <td><span class="code-chip"><%= item.idVendor || '-' %></span></td>
              <td class="strong"><%= item.namaVendor || '-' %></td>
              <td><%= item.wilayah || '-' %></td>
              <td><span class="tag"><%= item.kategoriSupply || 'Bahan Kain' %></span></td>
              <td>
                <span class="badge <%= item.status === 'Aktif' ? 'badge-aktif' : (item.status === 'Review' ? 'badge-review' : 'badge-nonaktif') %>">
                  <%= item.status || 'Aktif' %>
                </span>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
    <div class="empty-state filter-empty" id="kainEmpty">Tidak ada data yang cocok dengan pencarian.</div>
  </div>
</section>

<%- include('partials/guest-footer') %>
