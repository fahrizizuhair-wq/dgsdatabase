                  <th>Harga Produksi</th>
                  <th>Biaya Tambahan</th>
                  <th>Harga All-In</th>
                  <th>Total Harga</th>
                  <th>PIC &amp; Waktu</th>
                  <th class="no-print">Aksi</th>
                </tr>
              </thead>
              <tbody id="ph-table-body"></tbody>
            </table>
          </div>
        </div>
      </section>
      <% } %>
    </main>

    <% if (modeProyekPH) { %>
    <!-- FORM POPUP -->
    <div id="ph-form-modal" class="ph-modal ph-form-modal" onclick="if (event.target === this) tutupForm()">
      <div class="ph-modal-dialog ph-form-dialog">
        <div class="ph-modal-head">
          <div>
            <span class="text-[10px] uppercase tracking-widest text-maroon-100 font-bold">Form Pengajuan</span>
            <h2 id="ph-form-judul">Input Pengajuan Baru</h2>
            <p id="ph-form-subjudul">Lengkapi data merchandise, rincian biaya, dan foto produk.</p>
          </div>
          <button type="button" class="ph-modal-close" onclick="tutupForm()" aria-label="Tutup form">×</button>
        </div>

        <form id="ph-form" action="/pengajuan-harga/simpan" method="POST" enctype="multipart/form-data" onsubmit="return validasiForm()">
          <input type="hidden" id="ph-project-id" name="projectId" value="<%= String(projectPH._id) %>" />
          <input type="hidden" id="ph-id" name="id" value="" />
          <div class="ph-modal-body ph-form-body">
            <div class="ph-form-card">
              <div class="ph-section-title">
                <span class="ph-section-number">1</span>
                <div>
                  <h2 class="text-sm sm:text-base font-bold text-slate-900">Informasi Utama Merchandise</h2>
                  <p class="text-[11px] text-slate-500">Data dasar barang dan harga produksi per unit.</p>
                </div>
              </div>

              <div class="ph-project-info">
                <div>
                  <span class="ph-info-label">Project</span>
                  <strong><%= projectPH.namaProject %></strong>
                  <span>Kasbon sampel <%= rupiahPH(projectPH.totalKasbonSampel) %> ÷ Qty BOQ <%= angkaPH(projectPH.totalQtyBoq) %></span>
                </div>
                <span class="ph-badge">Sampel otomatis</span>
              </div>

              <div class="ph-grid">
                <div class="ph-field ph-col-span-2">
                  <label for="ph-nama">Nama Barang *</label>
                  <input type="text" id="ph-nama" name="namaBarang" class="ph-input" required placeholder="Contoh: Tumbler Stainless Steel / Goodie Bag Spunbond" />
                </div>
                <div class="ph-field">
                  <label for="ph-qty">Jumlah (Qty) *</label>
                  <input type="number" id="ph-qty" name="qty" class="ph-input" min="1" value="1" required oninput="hitungLive()" />
                </div>
                <div class="ph-field">
                  <label for="ph-satuan">Satuan *</label>
                  <select id="ph-satuan" name="satuan" class="ph-input">
                    <option value="Pcs">Pcs</option>
                    <option value="Unit">Unit</option>
                    <option value="Pasang">Pasang</option>
                    <option value="Lusin">Lusin</option>
                    <option value="Rim">Rim</option>
                    <option value="Set">Set</option>
                  </select>
                </div>
                <div class="ph-field">
                  <label for="ph-tim">Tim Produksi / Vendor *</label>
                  <input type="text" id="ph-tim" name="timProduksi" class="ph-input" required placeholder="Contoh: Corkcicle Official / Mandiri Printing" />
                </div>
                <div class="ph-field">
                  <label for="ph-harga-produksi">Harga Tim Produksi (Rp/Unit) *</label>
                  <input type="number" id="ph-harga-produksi" name="hargaProduksi" class="ph-input" min="0" step="any" value="0" required oninput="hitungLive()" />
                </div>
                <div class="ph-field ph-col-span-2">
                  <div class="ph-switch-wrap">
                    <div>
                      <span class="ph-switch-teks">Termasuk Include All in Harga Produksi</span>
                      <span class="ph-switch-keterangan">Aktifkan jika harga produksi sudah mencakup seluruh biaya tambahan.</span>
                    </div>
                    <label class="ph-switch" title="Aktif / Nonaktif">
                      <input type="checkbox" id="ph-include" name="includeAllIn" onchange="saatIncludeBerubah()" />
                      <span class="ph-switch-track"><span class="ph-switch-dot"></span></span>
                    </label>
                  </div>
                  <div id="ph-include-note" class="ph-include-note">
                    <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
                    <span>Rincian biaya tambahan disembunyikan dan tidak dihitung karena sudah termasuk dalam harga produksi.</span>
                  </div>
                </div>
                <div class="ph-field">
                  <label for="ph-total-manual">Total Keseluruhan Manual (Opsional)</label>
                  <input type="number" id="ph-total-manual" name="totalManual" class="ph-input" min="0" step="any" value="0" oninput="hitungLive()" />
                  <span class="ph-hint">Jika diisi lebih dari 0, angka ini dipakai sebagai total akhir. Jika 0/kosong, total = Harga All-In × Qty.</span>
                </div>
                <div class="ph-field">
                  <label>Total Keseluruhan (Qty × Harga All-In)</label>
                  <input type="text" id="ph-total-qty-display" class="ph-input bg-slate-50 font-bold" value="Rp 0" readonly />
                  <span class="ph-hint">Nilai desial penuh digunakan saat menghitung, dibulatkan hanya saat ditampilkan.</span>
                </div>
              </div>
            </div>

            <div id="ph-bagian-biaya" class="ph-form-card">
              <div class="ph-section-title">
                <span class="ph-section-number">2</span>
                <div>
                  <h2 class="text-sm sm:text-base font-bold text-slate-900">Rincian Biaya Tambahan (per Unit)</h2>
                  <p class="text-[11px] text-slate-500">Pilih rincian dari dropdown. Kolom harga muncul setelah pilihan dipilih.</p>
                </div>
              </div>

              <div class="ph-cost-block">
                <div class="ph-cost-head">
                  <span class="ph-cost-title">Branding & Printing</span>
                  <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('branding')">+ Tambah Rincian</button>
                </div>
                <div id="rows-branding"></div>
              </div>

              <div class="ph-cost-block">
                <div class="ph-cost-head">
                  <span class="ph-cost-title">Packaging</span>
                  <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('packaging')">+ Tambah Rincian</button>
                </div>
                <div id="rows-packaging"></div>
              </div>

              <div class="ph-cost-block">
                <div class="ph-cost-head">
                  <span class="ph-cost-title">Packing Akhir</span>
                  <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('packing')">+ Tambah Rincian</button>
                </div>
                <div id="rows-packing"></div>
              </div>

              <div class="ph-cost-block">
                <div class="ph-cost-head"><span class="ph-cost-title">Logistik Tim & Sampel</span></div>
                <div class="ph-fixed-grid">
                  <div class="ph-field">
                    <label for="ph-ongkir-tim">Ongkir Tim Produksi - DGS (pp)</label>
                    <input type="number" id="ph-ongkir-tim" name="ongkirTimDgs" class="ph-input" min="0" step="any" value="0" oninput="hitungLive()" />
                  </div>
                  <div class="ph-field">
                    <label for="ph-sampel">Sampel / Survey (per Unit)<span class="ph-auto-badge">Otomatis</span></label>
                    <input type="number" id="ph-sampel" name="sampelSurvey" class="ph-input" min="0" step="any" value="<%= Number(projectPH.sampelPerUnit) || 0 %>" readonly oninput="hitungLive()" />
                    <span class="ph-hint">Terisi otomatis dari project, tidak perlu diinput manual.</span>
                  </div>
                  <div class="ph-field">
                    <label for="ph-ongkir-client">Ongkir DGS - Client (Jakarta)</label>
                    <input type="number" id="ph-ongkir-client" name="ongkirDgsClient" class="ph-input" min="0" step="any" value="0" oninput="hitungLive()" />
                  </div>
                </div>
              </div>
            </div>

            <div class="ph-form-card">
              <div class="ph-section-title">
                <span class="ph-section-number">3</span>
                <div>
                  <h2 class="text-sm sm:text-base font-bold text-slate-900">Spesifikasi, PIC & Foto Produk</h2>
                  <p class="text-[11px] text-slate-500">Foto produk wajib di-upload dari perangkat, bukan URL/link.</p>
                </div>
              </div>
              <div class="ph-grid">
                <div class="ph-field ph-col-span-2">
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px;">
                    <label for="ph-spesifikasi" style="margin-bottom: 0;">Spesifikasi Lengkap Barang</label>
                    <button type="button" onclick="sisipkanTemplateSpesifikasi('ph-spesifikasi')" style="display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 7px; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569; font-size: 11px; font-weight: 700; cursor: pointer;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" 
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wand-sparkles preview-icon">
                      <path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/>
                      <path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>
                      <span>Sisipkan Template</span>
                    </button>
                  </div>
                  <textarea id="ph-spesifikasi" name="spesifikasi" class="ph-input" rows="6" placeholder="Warna: Matte black
                  Ukuran: 20oz (270 ml)
                  Fitur: Triple-insulated stainless steel"></textarea>
                </div>
                <div class="ph-field ph-col-span-2">
                  <label for="ph-keterangan">Keterangan / Catatan Tambahan</label>
                  <textarea id="ph-keterangan" name="keterangan" class="ph-input" rows="3" placeholder="Catatan khusus, ketentuan garansi, atau opsi sampel..."></textarea>
                </div>
                <div class="ph-field">
                  <label for="ph-pic">PIC (Person in Charge)</label>
                  <input type="text" id="ph-pic" name="pic" class="ph-input" placeholder="Contoh: Tim Marketing / Budi" />
                </div>
                <div class="ph-field">
                  <label for="ph-waktu">Jangka Waktu Produksi</label>
                  <input type="text" id="ph-waktu" name="jangkaWaktu" class="ph-input" placeholder="Contoh: 14 Hari Kerja" />
                </div>
                <div class="ph-field ph-col-span-2">
                  <label for="ph-foto">Foto Produk Model</label>
                  <input type="file" id="ph-foto" name="foto" class="ph-input" accept="image/*" multiple required onchange="pratinjauFoto(this)" />
                  <span class="ph-hint">Maksimal 10 file gambar (JPG, PNG, WebP), masing-masing maksimal 20 MB.</span>
                  <div id="ph-preview-foto" class="ph-preview-grid"></div>
                </div>
              </div>
            </div>
          </div>

          <div class="ph-form-footer no-print">
            <div class="ph-live-ringkas">
              <div>
                <span class="ph-live-label">Harga All-In / Unit</span>
                <strong id="ph-live-allin">Rp 0</strong>
              </div>
              <div>
                <span class="ph-live-label">Total Pengajuan</span>
                <strong id="ph-live-total">Rp 0</strong>
              </div>
            </div>
            <div class="ph-form-actions">
              <button type="button" onclick="tutupForm()" class="ph-btn ph-btn-neutral cursor-pointer">Batal</button>
              <button type="submit" class="ph-simpan-btn cursor-pointer">
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                <span id="ph-submit-label">Simpan Pengajuan</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- DETAIL POPUP -->
    <div id="ph-detail-modal" class="ph-modal" onclick="if (event.target === this) tutupDetail()">
      <div class="ph-modal-dialog ph-detail-dialog">
        <div class="ph-modal-head">
          <div>
            <span class="text-[10px] uppercase tracking-widest text-maroon-100 font-bold">Detail Pengajuan Harga</span>
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="ph-detail-judul">-</h2>
              <span id="ph-detail-status" class="ph-status-badge">Diajukan</span>
            </div>
            <p id="ph-detail-kode">-</p>
          </div>
          <button type="button" class="ph-modal-close" onclick="tutupDetail()" aria-label="Tutup detail">&times;</button>
        </div>
        <div id="ph-detail-body" class="ph-modal-body"></div>
      </div>
    </div>
    <% } %>

    <script>
      var TEMPLATE_SPESIFIKASI_PH = [
        'Brand: ',
        'Jenis/Model: ',
        'Kapasitas/Ukuran: ',
        'Warna: ',
        'Fitur: ',
        'Branding: '
      ].join('\n');

      function sisipkanTemplateSpesifikasi(idTextarea) {
        var el = document.getElementById(idTextarea);
        if (!el) return;

        var isiSaatIni = el.value.trim();
        if (!isiSaatIni) {
          el.value = TEMPLATE_SPESIFIKASI_PH;
        } else if (isiSaatIni.indexOf('Brand:') === -1) {
          el.value = el.value.replace(/\s*$/, '') + '\n\n' + TEMPLATE_SPESIFIKASI_PH;
        }

        el.focus();
        var posisiKursor = el.value.indexOf('Brand: ') + 'Brand: '.length;
        if (posisiKursor >= 'Brand: '.length && typeof el.setSelectionRange === 'function') {
          el.setSelectionRange(posisiKursor, posisiKursor);
        }
      }
      var PH_DATA = <%- jsonUntukScriptPH(dataPH) %>;
      var PH_PROJECT = <%- jsonUntukScriptPH(projectPH ? {
        id: String(projectPH._id),
        namaProject: projectPH.namaProject || '',
        totalKasbonSampel: Number(projectPH.totalKasbonSampel) || 0,
        totalQtyBoq: Number(projectPH.totalQtyBoq) || 0,
        sampelPerUnit: Number(projectPH.sampelPerUnit) || 0
      } : null) %>;
      var PH_BASE_URL = <%- jsonUntukScriptPH(basePH) %>;
      var PH_BERHASIL = <%- JSON.stringify(Boolean(typeof berhasil !== 'undefined' && berhasil)) %>;
      var PH_DUPLIKAT = <%- JSON.stringify(Boolean(typeof duplikat !== 'undefined' && duplikat)) %>;
      var PH_EDIT = <%- JSON.stringify(Boolean(typeof edit !== 'undefined' && edit)) %>;
      var PH_HAPUS = <%- JSON.stringify(Boolean(typeof hapus !== 'undefined' && hapus)) %>;
      var PH_GAGAL = <%- JSON.stringify(Boolean(typeof gagal !== 'undefined' && gagal)) %>;

      var OPSI_PH = {
        branding: ['sablon', 'bordir', 'grafir 1 sisi', 'grafir 2 sisi', 'print'],
        packaging: ['plastic sealed', 'slongsong', 'custom box'],
        packing: ['kardus', 'karung']
      };
      var JUDUL_GRUP_PH = {
        branding: 'Branding & Printing',
        packaging: 'Packaging',
        packing: 'Packing Akhir'
      };
      var nomorRowPH = 0;

      function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (sidebar) sidebar.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
      }

      function toggleDropdown(element) {
        var parent = element.closest('.nav-item.dropdown');
        if (parent) parent.classList.toggle('active');
      }

      function initIcons() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          try { window.lucide.createIcons(); } catch (err) {}
        }
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      // Bulatkan HANYA saat ditampilkan. Perhitungan tetap memakai float penuh.
      function rupiah(value) {
        return 'Rp ' + Math.round(Number(value || 0)).toLocaleString('id-ID');
      }

      function formatTanggal(value) {
        if (!value) return '-';
        var d = new Date(value);
        if (isNaN(d.getTime())) return String(value);
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
      }

      function teksAman(value) {
        return String(value == null || value === '' ? '-' : value);
      }

      function fotoUrl(nama) {
        if (!nama) return '';
        if (/^https?:\/\//i.test(nama)) return nama;
        return '/uploads/' + encodeURIComponent(nama);
      }

      function tampilToast(pesan, jenis) {
        var container = document.getElementById('toast-container');
        if (!container) return;
        var warna = jenis === 'gagal' ? 'bg-red-600' : 'bg-emerald-600';
        var el = document.createElement('div');
        el.className = 'px-4 py-3 rounded-xl text-white text-xs font-semibold shadow-lg ' + warna;
        el.textContent = pesan;
        container.appendChild(el);
        setTimeout(function () { el.remove(); }, 3500);
      }

      function bukaProject(id) {
        window.location.href = PH_BASE_URL + '/project/' + encodeURIComponent(id);
      }

      function kembaliKeProject() {
        window.location.href = PH_BASE_URL;
      }

      function fokusTambahProject() {
        var form = document.getElementById('ph-project-form');
        if (!form) return;
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        var input = document.getElementById('ph-project-nama-input');
        if (input) setTimeout(function () { input.focus(); }, 250);
      }

      function hitungPreviewSampel() {
        var kasbon = Math.max(0, Number((document.getElementById('ph-project-kasbon') || {}).value) || 0);
        var boq = Number((document.getElementById('ph-project-boq') || {}).value) || 0;
        var sampel = boq > 0 ? kasbon / boq : 0;
        var el = document.getElementById('ph-preview-sampel');
        if (el) el.textContent = rupiah(sampel) + ' / unit';
      }

      function validasiProject() {
        var nama = String((document.getElementById('ph-project-nama-input') || {}).value || '').trim();
        var boq = Number((document.getElementById('ph-project-boq') || {}).value) || 0;
        if (!nama) {
          alert('Nama project wajib diisi.');
          return false;
        }
        if (boq <= 0) {
          alert('Total Qty BOQ harus lebih dari 0.');
          return false;
        }
        return true;
      }

      function dataTersaring() {
        var teks = String((document.getElementById('ph-search') || {}).value || '').toLowerCase().trim();
        var tim = String((document.getElementById('ph-filter-tim') || {}).value || '');
        return PH_DATA.filter(function (item) {
          var gabungan = [
            item.namaBarang, item.timProduksi, item.spesifikasi, item.pic, item.kode,
            Array.isArray(item.biayaTambahan) ? item.biayaTambahan.map(function (b) { return b.item; }).join(' ') : ''
          ].join(' ').toLowerCase();
          return (!teks || gabungan.indexOf(teks) !== -1) && (!tim || item.timProduksi === tim);
        });
      }

      function isiOpsiTim() {
        var select = document.getElementById('ph-filter-tim');
        if (!select) return;
        var tim = [];
        PH_DATA.forEach(function (item) {
          if (item.timProduksi && tim.indexOf(item.timProduksi) === -1) tim.push(item.timProduksi);
        });
        tim.sort();
        tim.forEach(function (nama) {
          var opsi = document.createElement('option');
          opsi.value = nama;
          opsi.textContent = nama;
          select.appendChild(opsi);
        });
      }

      function renderTabel() {
        var body = document.getElementById('ph-table-body');
        if (!body) return;
        var data = dataTersaring();

        if (!data.length) {
          body.innerHTML = '<tr><td colspan="9" class="ph-empty">Belum ada pengajuan harga pada project ini.</td></tr>';
          return;
        }

        var baris = data.map(function (item) {
          var biaya = Number(item.totalBiayaTambahan) || 0;
          return '<tr class="ph-row" onclick="bukaDetail(\'' + item._id + '\')">' +
            '<td><span class="ph-nama">' + escapeHtml(item.namaBarang) + '</span>' +
              '<span class="ph-sub">' + escapeHtml(item.kode || '-') + ' &bull; ' + formatTanggal(item.createdAt) + '</span></td>' +
            '<td>' + escapeHtml(teksAman(item.timProduksi)) + '</td>' +
            '<td><strong>' + Number(item.qty || 0).toLocaleString('id-ID') + '</strong> ' + escapeHtml(item.satuan || 'pcs') + '</td>' +
            '<td>' + rupiah(item.hargaProduksi) + '</td>' +
            '<td>' + rupiah(biaya) + '</td>' +
            '<td><strong class="text-maroon-700">' + rupiah(item.hargaAllIn) + '</strong></td>' +
            '<td><strong class="text-maroon-700">' + rupiah(item.totalHarga) + '</strong></td>' +
            '<td>' + escapeHtml(teksAman(item.pic)) + '<span class="ph-sub">' + escapeHtml(teksAman(item.jangkaWaktu)) + '</span></td>' +
            '<td class="no-print"><div class="ph-aksi-wrap">' +
              '<button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="event.stopPropagation(); bukaDetail(\'' + item._id + '\')">Lihat Detail</button>' +
              '<button type="button" class="ph-action-btn" onclick="event.stopPropagation(); bukaEditPH(\'' + item._id + '\')" title="Edit pengajuan"><i data-lucide="pencil"></i></button>' +
              '<button type="button" class="ph-action-btn ph-duplikat" onclick="event.stopPropagation(); duplikatPH(\'' + item._id + '\')" title="Duplikat ke bawah"><i data-lucide="copy"></i></button>' +
              '<button type="button" class="ph-action-btn ph-hapus" onclick="event.stopPropagation(); hapusPH(\'' + item._id + '\')" title="Hapus pengajuan"><i data-lucide="trash-2"></i></button>' +
            '</div></td>' +
            '</tr>';
        });

        var totalQty = data.reduce(function (a, b) { return a + (Number(b.qty) || 0); }, 0);
        var totalProduksi = data.reduce(function (a, b) { return a + (Number(b.hargaProduksi) || 0); }, 0);
        var totalBiaya = data.reduce(function (a, b) { return a + (Number(b.totalBiayaTambahan) || 0); }, 0);
        var totalSemua = data.reduce(function (a, b) { return a + (Number(b.totalHarga) || 0); }, 0);
        var rata = totalQty > 0 ? totalSemua / totalQty : 0;

        baris.push('<tr class="ph-total-row">' +
          '<td>TOTAL KESELURUHAN</td><td>' + data.length + ' pengajuan</td>' +
          '<td>' + Number(totalQty).toLocaleString('id-ID') + '</td>' +
          '<td>' + rupiah(totalProduksi) + '</td>' +
          '<td>' + rupiah(totalBiaya) + '</td>' +
          '<td>' + rupiah(rata) + '</td>' +
          '<td>' + rupiah(totalSemua) + '</td>' +
          '<td colspan="2" class="no-print">-</td>' +
          '</tr>');

        body.innerHTML = baris.join('');
        initIcons();
      }

      function bukaDetail(id) {
        var item = PH_DATA.find(function (x) { return String(x._id) === String(id); });
        if (!item) return;
        tutupForm();

        document.getElementById('ph-detail-judul').textContent = item.namaBarang || '-';
        document.getElementById('ph-detail-status').textContent = teksAman(item.status || 'Diajukan');
        document.getElementById('ph-detail-kode').textContent =
          (item.kode || '-') + ' • ' + (item.projectNama || (PH_PROJECT && PH_PROJECT.namaProject) || '-') + ' • ' +
          (item.timProduksi || '-') + ' • ' + formatTanggal(item.createdAt);

        var fotoList = Array.isArray(item.gambar) ? item.gambar.filter(Boolean) : [];
        var gambarHtml = fotoList.length
          ? '<img id="ph-foto-utama" class="ph-gallery-main" src="' + fotoUrl(fotoList[0]) + '" alt="Foto ' + escapeHtml(item.namaBarang) + '" />' +
            '<div class="ph-thumbs">' + fotoList.map(function (f, i) {
              return '<img src="' + fotoUrl(f) + '" class="' + (i === 0 ? 'aktif' : '') + '" onclick="gantiFotoDetail(this)" alt="Thumbnail ' + (i + 1) + '" />';
            }).join('') + '</div>'
          : '<div class="ph-gallery-empty">Belum ada foto produk yang di-upload.</div>';

        var biayaRows = ['<tr><th>Harga Tim Produksi</th><td>' + rupiah(item.hargaProduksi) + '</td></tr>'];
        (Array.isArray(item.biayaTambahan) ? item.biayaTambahan : []).forEach(function (b) {
          biayaRows.push('<tr><th>' + escapeHtml(JUDUL_GRUP_PH[b.grup] || b.grup || 'Rincian') + ' &bull; ' + escapeHtml(b.item) + '</th><td>' + rupiah(b.harga) + '</td></tr>');
        });
        biayaRows.push('<tr><th>Ongkir Tim Produksi - DGS (pp)</th><td>' + rupiah(item.ongkirTimDgs) + '</td></tr>');
        biayaRows.push('<tr><th>Sampel / Survey (per Unit, otomatis)</th><td>' + rupiah(item.sampelSurvey) + '</td></tr>');
        biayaRows.push('<tr><th>Ongkir DGS - Client (Jakarta)</th><td>' + rupiah(item.ongkirDgsClient) + '</td></tr>');

        var catatanInclude = item.includeAllIn
          ? '<div class="ph-callout ph-callout-amber"><i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i><span>Biaya tambahan di atas sudah termasuk dalam harga produksi, sehingga tidak dijumlahkan lagi ke harga all-in.</span></div>'
          : '';
        var catatanManual = Number(item.totalManual) > 0
          ? '<div class="ph-callout ph-callout-green"><i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i><span>Total Keseluruhan memakai input manual ' + rupiah(item.totalManual) + ', bukan hasil perkalian otomatis.</span></div>'
          : '';

        document.getElementById('ph-detail-body').innerHTML =
          '<div class="ph-detail-layout">' +
            '<aside class="ph-detail-aside">' +
              '<div class="ph-detail-card">' +
                '<div class="ph-detail-card-head"><h3>Foto Produk</h3><span>' + fotoList.length + ' file</span></div>' +
                gambarHtml +
              '</div>' +
              '<div class="ph-detail-card">' +
                '<div class="ph-detail-card-head"><h3>Informasi Pengajuan</h3></div>' +
                '<div class="ph-side-row"><span class="ph-info-label">Kode Pengajuan</span><span class="ph-info-value">' + escapeHtml(item.kode || '-') + '</span></div>' +
                '<div class="ph-side-row"><span class="ph-info-label">Project</span><span class="ph-info-value">' + escapeHtml(teksAman(item.projectNama || (PH_PROJECT && PH_PROJECT.namaProject))) + '</span></div>' +
                '<div class="ph-side-row"><span class="ph-info-label">Tanggal Diajukan</span><span class="ph-info-value">' + formatTanggal(item.createdAt) + '</span></div>' +
                '<div class="ph-side-row"><span class="ph-info-label">Diinput Oleh</span><span class="ph-info-value">' + escapeHtml(teksAman(item.diinputOleh)) + '</span></div>' +
                '<div class="ph-side-row"><span class="ph-info-label">Status</span><span class="ph-info-value">' + escapeHtml(teksAman(item.status || 'Diajukan')) + '</span></div>' +
              '</div>' +
            '</aside>' +
            '<div class="ph-detail-main">' +
              '<div class="ph-detail-card">' +
                '<div class="ph-detail-card-head"><h3>Informasi Produk</h3><span>Data merchandise</span></div>' +
                '<div class="ph-info-grid">' +
                  '<div><span class="ph-info-label">Qty &amp; Satuan</span><span class="ph-info-value">' + Number(item.qty || 0).toLocaleString('id-ID') + ' ' + escapeHtml(item.satuan || 'pcs') + '</span></div>' +
                  '<div><span class="ph-info-label">Tim Produksi / Vendor</span><span class="ph-info-value">' + escapeHtml(teksAman(item.timProduksi)) + '</span></div>' +
                  '<div><span class="ph-info-label">PIC</span><span class="ph-info-value">' + escapeHtml(teksAman(item.pic)) + '</span></div>' +
                  '<div><span class="ph-info-label">Waktu Produksi</span><span class="ph-info-value">' + escapeHtml(teksAman(item.jangkaWaktu)) + '</span></div>' +
                '</div>' +
                '<div class="ph-detail-note"><span class="ph-info-label">Spesifikasi Detail Produk</span><p>' + escapeHtml(teksAman(item.spesifikasi)) + '</p></div>' +
                '<div class="ph-detail-note"><span class="ph-info-label">Keterangan Tambahan</span><p>' + escapeHtml(teksAman(item.keterangan)) + '</p></div>' +
              '</div>' +
              '<div class="ph-detail-card">' +
                '<div class="ph-detail-card-head"><h3>Rincian Komponen Biaya</h3><span>Nominal per unit</span></div>' +
                '<table class="ph-detail-table">' +
                  '<thead><tr><th>Komponen</th><th>Nominal</th></tr></thead>' +
                  '<tbody>' + biayaRows.join('') + '</tbody>' +
                '</table>' +
                catatanInclude + catatanManual +
              '</div>' +
              '<div class="ph-detail-summary">' +
                '<div class="ph-detail-summary-item">' +
                  '<span class="ph-info-label">Harga All-In per Unit</span>' +
                  '<strong>' + rupiah(item.hargaAllIn) + '</strong>' +
                  '<small>' + (item.includeAllIn ? 'Sudah termasuk biaya tambahan' : 'Termasuk rincian biaya di atas') + '</small>' +
                '</div>' +
                '<div class="ph-detail-summary-item ph-total">' +
                  '<span class="ph-info-label">Total Keseluruhan</span>' +
                  '<strong>' + rupiah(item.totalHarga) + '</strong>' +
                  '<small>' + (Number(item.totalManual) > 0
                    ? 'Input manual ' + rupiah(item.totalManual)
                    : Number(item.qty || 0).toLocaleString('id-ID') + ' ' + escapeHtml(item.satuan || 'pcs') + ' &times; ' + rupiah(item.hargaAllIn)) + '</small>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>';

        document.getElementById('ph-detail-modal').classList.add('terbuka');
        document.body.style.overflow = 'hidden';
        initIcons();
      }

      function gantiFotoDetail(gambar) {
        var utama = document.getElementById('ph-foto-utama');
        if (utama) utama.src = gambar.src;
        document.querySelectorAll('#ph-detail-modal .ph-thumbs img').forEach(function (img) { img.classList.remove('aktif'); });
        gambar.classList.add('aktif');
      }

      function tutupDetail() {
        var modal = document.getElementById('ph-detail-modal');
        if (modal) modal.classList.remove('terbuka');
        if (!document.getElementById('ph-form-modal').classList.contains('terbuka')) document.body.style.overflow = '';
      }

      function tambahBiayaRow(grup, itemTerpilih, hargaAwal) {
        var wadah = document.getElementById('rows-' + grup);
        if (!wadah) return;
        nomorRowPH += 1;
        var opsi = ['<option value="">-- Pilih rincian --</option>'].concat(
          (OPSI_PH[grup] || []).map(function (item) {
            return '<option value="' + item + '">' + item.charAt(0).toUpperCase() + item.slice(1) + '</option>';
          })
        ).join('');
        var row = document.createElement('div');
        row.className = 'ph-cost-row';
        row.innerHTML =
          '<input type="hidden" name="biayaGrup[]" value="' + grup + '" />' +
          '<div class="ph-field">' +
            '<label>Pilihan ' + JUDUL_GRUP_PH[grup] + '</label>' +
            '<select name="biayaItem[]" class="ph-input item-select" data-grup="' + grup + '" onchange="saatItemBerubah(this)">' + opsi + '</select>' +
          '</div>' +
          '<div class="ph-field ph-price-wrap">' +
            '<label>Harga per Unit (Rp)</label>' +
            '<input type="number" name="biayaHarga[]" class="ph-input harga-input" min="0" step="any" value="0" oninput="hitungLive()" />' +
          '</div>' +
          '<button type="button" class="ph-btn ph-btn-neutral cursor-pointer" onclick="hapusBiayaRow(this)">Hapus</button>';

        if (itemTerpilih) {
          row.querySelector('.item-select').value = itemTerpilih;
          row.querySelector('.ph-price-wrap').classList.add('terlihat');
          row.querySelector('.harga-input').value = Number(hargaAwal) || 0;
        }

        wadah.appendChild(row);
      }

      function saatItemBerubah(select) {
        var row = select.closest('.ph-cost-row');
        var wrap = row.querySelector('.ph-price-wrap');
        var input = row.querySelector('.harga-input');
        if (select.value) {
          wrap.classList.add('terlihat');
          if (!input.value) input.value = '0';
        } else {
          wrap.classList.remove('terlihat');
          input.value = '0';
        }
        segarOpsi();
        hitungLive();
      }

      function segarOpsi() {
        var dipakai = {};
        document.querySelectorAll('.item-select').forEach(function (select) {
          if (select.value) dipakai[select.value] = select;
        });
        document.querySelectorAll('.item-select').forEach(function (select) {
          Array.from(select.options).forEach(function (option) {
            if (!option.value) return;
            option.disabled = Boolean(dipakai[option.value] && dipakai[option.value] !== select);
          });
        });
      }

      function hapusBiayaRow(tombol) {
        var row = tombol.closest('.ph-cost-row');
        if (row) row.remove();
        segarOpsi();
        hitungLive();
      }

      function saatIncludeBerubah() {
        var include = Boolean((document.getElementById('ph-include') || {}).checked);
        var bagian = document.getElementById('ph-bagian-biaya');
        var catatan = document.getElementById('ph-include-note');
        if (bagian) bagian.classList.toggle('ph-hide', include);
        if (catatan) catatan.classList.toggle('terlihat', include);
        hitungLive();
      }

      function hitungLive() {
        var qty = Math.max(1, Number((document.getElementById('ph-qty') || {}).value) || 1);
        var produksi = Math.max(0, Number((document.getElementById('ph-harga-produksi') || {}).value) || 0);
        var include = Boolean((document.getElementById('ph-include') || {}).checked);
        var tambahan = 0;

        document.querySelectorAll('.item-select').forEach(function (select) {
          if (!select.value) return;
          var row = select.closest('.ph-cost-row');
          var harga = Number(row.querySelector('.harga-input').value) || 0;
          tambahan += harga;
        });

        tambahan += Math.max(0, Number((document.getElementById('ph-ongkir-tim') || {}).value) || 0);
        // Sampel / Survey berasal dari project (float penuh), bukan input manual.
        tambahan += Math.max(0, Number((document.getElementById('ph-sampel') || {}).value) || 0);
        tambahan += Math.max(0, Number((document.getElementById('ph-ongkir-client') || {}).value) || 0);

        var efektif = include ? 0 : tambahan;
        var allIn = produksi + efektif;
        var manual = Math.max(0, Number((document.getElementById('ph-total-manual') || {}).value) || 0);
        // Tidak ada Math.round di sini. Pembulatan hanya di rupiah() saat ditampilkan.
        var total = manual > 0 ? manual : allIn * qty;

        var elemenAllIn = document.getElementById('ph-live-allin');
        var elemenTotal = document.getElementById('ph-live-total');
        var elemenTotalDisplay = document.getElementById('ph-total-qty-display');
        if (elemenAllIn) elemenAllIn.textContent = rupiah(allIn);
        if (elemenTotal) elemenTotal.textContent = rupiah(total);
        if (elemenTotalDisplay) elemenTotalDisplay.value = rupiah(total);
      }

      function pratinjauFoto(input) {
        var wadah = document.getElementById('ph-preview-foto');
        if (!wadah) return;
        wadah.innerHTML = '';
        Array.from(input.files || []).slice(0, 5).forEach(function (file) {
          if (!file.type || file.type.indexOf('image/') !== 0) return;
          var reader = new FileReader();
          reader.onload = function (e) {
            var img = document.createElement('img');
            img.src = e.target.result;
            img.alt = file.name;
            wadah.appendChild(img);
          };
          reader.readAsDataURL(file);
        });
      }

      function validasiForm() {
        var nama = String((document.getElementById('ph-nama') || {}).value || '').trim();
        var tim = String((document.getElementById('ph-tim') || {}).value || '').trim();
        if (!nama || !tim) {
          alert('Nama barang dan tim produksi wajib diisi.');
          return false;
        }
        var include = Boolean((document.getElementById('ph-include') || {}).checked);
        var valid = true;
        if (!include) {
          document.querySelectorAll('.item-select').forEach(function (select) {
            if (!select.value || !valid) return;
            var row = select.closest('.ph-cost-row');
            var harga = Number(row.querySelector('.harga-input').value) || 0;
            if (harga <= 0) {
              alert('Isi harga untuk rincian "' + select.value + '" dengan nilai lebih dari 0.');
              valid = false;
            }
          });
        }
        return valid;
      }

      function aturModeFormPH(mode) {
        var edit = mode === 'edit';
        var form = document.getElementById('ph-form');
        var judul = document.getElementById('ph-form-judul');
        var subjudul = document.getElementById('ph-form-subjudul');
        var label = document.getElementById('ph-submit-label');
        var file = document.getElementById('ph-foto');
        var idField = document.getElementById('ph-id');

        if (form) form.action = edit ? '/pengajuan-harga/edit' : '/pengajuan-harga/simpan';
        if (idField && !edit) idField.value = '';
        if (judul) judul.textContent = edit ? 'Edit Pengajuan Harga' : 'Input Pengajuan Baru';
        if (subjudul) {
          subjudul.textContent = edit
            ? 'Ubah field yang perlu disesuaikan. Foto lama tetap dipakai jika tidak mengupload baru.'
            : 'Lengkapi data merchandise, rincian biaya, dan foto produk.';
        }
        if (label) label.textContent = edit ? 'Simpan Perubahan' : 'Simpan Pengajuan';
        if (file) file.required = !edit;
      }

      function isiBiayaDariDataPH(item) {
        ['branding', 'packaging', 'packing'].forEach(function (grup) {
          var wadah = document.getElementById('rows-' + grup);
          if (!wadah) return;
          wadah.innerHTML = '';
          var daftar = (Array.isArray(item.biayaTambahan) ? item.biayaTambahan : []).filter(function (b) {
            return b.grup === grup;
          });
          if (!daftar.length) tambahBiayaRow(grup);
          else daftar.forEach(function (b) { tambahBiayaRow(grup, b.item, b.harga); });
        });
      }

      function isiFieldFormPH(item, mode) {
        var penetap = {
          'ph-nama': item.namaBarang || '',
          'ph-qty': Number(item.qty) || 1,
          'ph-satuan': item.satuan || 'pcs',
          'ph-tim': item.timProduksi || '',
          'ph-harga-produksi': Number(item.hargaProduksi) || 0,
          'ph-total-manual': Number(item.totalManual) || 0,
          'ph-ongkir-tim': Number(item.ongkirTimDgs) || 0,
          'ph-ongkir-client': Number(item.ongkirDgsClient) || 0,
          'ph-spesifikasi': item.spesifikasi || '',
          'ph-keterangan': item.keterangan || '',
          'ph-pic': item.pic || '',
          'ph-waktu': item.jangkaWaktu || '',
          'ph-sampel': PH_PROJECT ? PH_PROJECT.sampelPerUnit : (Number(item.sampelSurvey) || 0),
        };
        Object.keys(penetap).forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          var nilai = penetap[id];
          if (el.tagName === 'SELECT') {
            var cocok = Array.from(el.options).find(function (opsi) {
              return String(opsi.value).toLowerCase() === String(nilai).toLowerCase();
            });
            el.value = cocok ? cocok.value : (el.options.length ? el.options[0].value : '');
          } else {
            el.value = nilai;
          }
        });
        var include = document.getElementById('ph-include');
        if (include) include.checked = Boolean(item.includeAllIn);
        if (mode === 'edit') {
          var idField = document.getElementById('ph-id');
          if (idField) idField.value = String(item._id);
        }
      }

      function bukaForm() {
        var form = document.getElementById('ph-form');
        if (form) form.reset();
        aturModeFormPH('tambah');
        ['branding', 'packaging', 'packing'].forEach(function (grup) {
          var wadah = document.getElementById('rows-' + grup);
          if (wadah) wadah.innerHTML = '';
          tambahBiayaRow(grup);
        });
        var preview = document.getElementById('ph-preview-foto');
        if (preview) preview.innerHTML = '';
        segarOpsi();
        saatIncludeBerubah();
        hitungLive();
        document.getElementById('ph-form-modal').classList.add('terbuka');
        document.body.style.overflow = 'hidden';
        initIcons();
        setTimeout(function () {
          var nama = document.getElementById('ph-nama');
          if (nama) nama.focus();
        }, 60);
      }

      function bukaEditPH(id) {
        var item = PH_DATA.find(function (x) { return String(x._id) === String(id); });
        if (!item) return;
        tutupDetail();

        var form = document.getElementById('ph-form');
        if (form) form.reset();
        aturModeFormPH('edit');
        isiFieldFormPH(item, 'edit');
        isiBiayaDariDataPH(item);

        var preview = document.getElementById('ph-preview-foto');
        if (preview) preview.innerHTML = '';
        segarOpsi();
        saatIncludeBerubah();
        hitungLive();

        document.getElementById('ph-form-modal').classList.add('terbuka');
        document.body.style.overflow = 'hidden';
        initIcons();
        setTimeout(function () {
          var nama = document.getElementById('ph-nama');
          if (nama) nama.focus();
        }, 60);
      }

      function kirimAksiPH(rute, id, querySukses) {
        if (!PH_PROJECT) return;
        var badan = new URLSearchParams();
        badan.append('id', String(id));
        badan.append('projectId', String(PH_PROJECT.id));
        fetch(rute, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: badan.toString(),
        }).then(function () {
          window.location.href = PH_BASE_URL + '/project/' + encodeURIComponent(PH_PROJECT.id) + '?' + querySukses + '=1';
        }).catch(function () {
          window.location.reload();
        });
      }

      function duplikatPH(id) {
        kirimAksiPH('/pengajuan-harga/duplikat', id, 'duplikat');
      }

      function hapusPH(id) {
        if (!confirm('Hapus pengajuan harga ini?')) return;
        kirimAksiPH('/pengajuan-harga/hapus', id, 'hapus');
      }

      function tutupForm() {
        var modal = document.getElementById('ph-form-modal');
        if (!modal) return;
        modal.classList.remove('terbuka');
        if (!document.getElementById('ph-detail-modal').classList.contains('terbuka')) document.body.style.overflow = '';
      }

      function angkaCsv(value) {
        return Math.round(Number(value) || 0);
      }

      function eksporCSV() {
        var data = dataTersaring();
        var kepala = [
          'Kode', 'Nama Barang', 'Tim Produksi', 'Qty', 'Satuan', 'Harga Produksi',
          'Biaya Tambahan', 'Sampel per Unit', 'Harga All-In', 'Total Manual', 'Total Harga', 'PIC', 'Waktu Produksi'
        ];
        var baris = data.map(function (item) {
          return [
            item.kode, item.namaBarang, item.timProduksi, angkaCsv(item.qty), item.satuan,
            angkaCsv(item.hargaProduksi), angkaCsv(item.totalBiayaTambahan), angkaCsv(item.sampelSurvey),
            angkaCsv(item.hargaAllIn), angkaCsv(item.totalManual), angkaCsv(item.totalHarga),
            item.pic, item.jangkaWaktu
          ];
        });
        var isi = [kepala].concat(baris).map(function (row) {
          return row.map(function (sel) {
            return '"' + String(sel == null ? '' : sel).replace(/"/g, '""') + '"';
          }).join(',');
        }).join('\r\n');
        var blob = new Blob(['\ufeff' + isi], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'pengajuan-harga.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      document.addEventListener('DOMContentLoaded', function () {
        hitungPreviewSampel();
        isiOpsiTim();
        renderTabel();
        saatIncludeBerubah();
        initIcons();
        if (PH_BERHASIL) tampilToast(PH_PROJECT ? 'Pengajuan harga berhasil disimpan.' : 'Project berhasil ditambahkan.');
        if (PH_DUPLIKAT) tampilToast('Pengajuan berhasil diduplikat di bawah data asal.');
        if (PH_EDIT) tampilToast('Pengajuan harga berhasil diubah.');
        if (PH_HAPUS) tampilToast('Pengajuan harga berhasil dihapus.');
        if (PH_GAGAL) tampilToast('Gagal menyimpan data. Periksa kembali input Anda.', 'gagal');
      });

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (document.getElementById('ph-detail-modal') && document.getElementById('ph-detail-modal').classList.contains('terbuka')) tutupDetail();
        else if (document.getElementById('ph-form-modal') && document.getElementById('ph-form-modal').classList.contains('terbuka')) tutupForm();
      });
    </script>
  </body>
</html>
