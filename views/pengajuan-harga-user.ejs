<%
  var dataPH = (typeof items !== 'undefined' && items) ? items : [];
  var daftarProjectPH = (typeof projects !== 'undefined' && projects) ? projects : [];
  var projectPH = (typeof projectAktif !== 'undefined' && projectAktif) ? projectAktif : null;
  var basePH = (typeof baseUrl !== 'undefined' && baseUrl)
    ? baseUrl
    : ((typeof role !== 'undefined' && role === 'admin') ? '/pengajuan-harga' : '/pengajuan-harga-user');
  var modeProyekPH = Boolean(projectPH);
  var peranPH = 'user';
  var userPH = (typeof user !== 'undefined' && user) ? user : { username: 'User', namaLengkap: 'User' };
  var adminUserPH = (typeof adminUser !== 'undefined' && adminUser) ? adminUser : 'Admin';

  var totalProjectPH = daftarProjectPH.length;
  var totalKasbonPH = daftarProjectPH.reduce(function (a, b) { return a + (Number(b.totalKasbonSampel) || 0); }, 0);
  var totalBoqPH = daftarProjectPH.reduce(function (a, b) { return a + (Number(b.totalQtyBoq) || 0); }, 0);
  var rataSampelPH = totalBoqPH > 0 ? totalKasbonPH / totalBoqPH : 0;

  var totalItemPH = dataPH.length;
  var totalQtyPH = dataPH.reduce(function (a, b) { return a + (Number(b.qty) || 0); }, 0);
  var totalEstimasiPH = dataPH.reduce(function (a, b) { return a + (Number(b.totalHarga) || 0); }, 0);
  var rataUnitPH = totalQtyPH > 0 ? totalEstimasiPH / totalQtyPH : 0;

  function rupiahPH(nilai) {
    return 'Rp ' + Math.round(Number(nilai) || 0).toLocaleString('id-ID');
  }

  function angkaPH(nilai) {
    return Math.round(Number(nilai) || 0).toLocaleString('id-ID');
  }

  function jsonUntukScriptPH(nilai) {
    return JSON.stringify(nilai == null ? null : nilai)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  }
%>
<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head', { pageTitle: (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Pengajuan Harga') + ' — User', useTailwind: true }) %>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/payment-request.css" />
    <link rel="stylesheet" href="/css/stat-cards.css" />
    <style>
      /* =========================================================
         PENGAJUAN HARGA — CSS KHALAMAN (inline, file user)
         ========================================================= */
      #toast-container { z-index: 3000 !important; }
      .ph-main { max-width: 1280px !important; }

      /* Card statistik mengikuti model kartu halaman lain */
      .ph-card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0 0 20px; }
      .ph-card-grid .card-value { font-size: 1.85rem; word-break: break-word; }
      @media (max-width: 1100px) { .ph-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 700px) { .ph-card-grid { grid-template-columns: 1fr; } }

      /* Card project */
      .ph-project-grid {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px;
      }
      @media (max-width: 1050px) { .ph-project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 700px) { .ph-project-grid { grid-template-columns: 1fr; } }
      .ph-project-card {
        cursor: pointer; min-height: 176px; outline: none;
      }
      .ph-project-card:focus-visible { box-shadow: 0 0 0 3px rgba(122,27,27,.25); }
      .ph-project-card .card-title { max-width: 190px; line-height: 1.35; }
      .ph-project-card .card-footer { gap: 8px; }
      .ph-project-empty {
        padding: 46px 20px; text-align: center; color: #94a3b8; font-size: 13px;
        border: 1px dashed #cbd5e1; border-radius: 16px; background: #fff;
      }

      /* Panel */
      .ph-panel {
        background: rgba(255, 255, 255, 0.97);
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
        overflow: hidden;
        margin-bottom: 20px;
      }
      .ph-panel-head {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 12px; padding: 18px 20px; border-bottom: 1px solid #f1f5f9;
      }
      .ph-panel-body { padding: 18px 20px; }
      .ph-toolbar {
        display: flex; flex-wrap: wrap; gap: 10px; padding: 14px 20px;
        border-bottom: 1px solid #f1f5f9; background: #fcfcfd;
      }
      .ph-toolbar select, .ph-toolbar input, .ph-input {
        width: 100%; padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 10px;
        background: #fff; font-size: 13px; color: #1e293b; outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .ph-toolbar select:focus, .ph-toolbar input:focus, .ph-input:focus {
        border-color: #7a1b1b; box-shadow: 0 0 0 3px rgba(122, 27, 27, 0.08);
      }
      .ph-toolbar input::placeholder, .ph-input::placeholder { color: #94a3b8; }
      .ph-input[readonly] { background: #f8fafc; color: #475569; cursor: not-allowed; }
      .ph-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        padding: 10px 14px; border-radius: 10px; border: 1px solid transparent;
        font-size: 12.5px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
      }
      .ph-btn-primary { background: #7a1b1b; color: #fff; box-shadow: 0 6px 16px rgba(122,27,27,.2); }
      .ph-btn-primary:hover { background: #5e1414; }
      .ph-btn-ghost { background: #fff; color: #7a1b1b; border-color: #f2d7d7; }
      .ph-btn-ghost:hover { background: #fdf2f2; }
      .ph-btn-neutral { background: #f8fafc; color: #475569; border-color: #e2e8f0; }
      .ph-btn-neutral:hover { background: #f1f5f9; }
      .ph-badge {
        display: inline-flex; align-items: center; padding: 3px 9px; border-radius: 999px;
        background: #fef3c7; color: #92400e; font-size: 10.5px; font-weight: 700;
      }

      /* Form tambah project di halaman awal */
      .ph-project-form-grid {
        display: grid; grid-template-columns: minmax(220px, 1.4fr) repeat(2, minmax(150px, 1fr)) minmax(180px, 1fr) auto;
        gap: 14px; align-items: end;
      }
      @media (max-width: 1100px) { .ph-project-form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 700px) { .ph-project-form-grid { grid-template-columns: 1fr; } }
      .ph-field label, .ph-field > label:not(.ph-switch) {
        display: block; margin-bottom: 6px; font-size: 11.5px; font-weight: 700; color: #475569;
      }
      .ph-field .ph-hint { display: block; margin-top: 5px; font-size: 10.5px; color: #94a3b8; }
      .ph-preview-sampel {
        padding: 9px 12px; border-radius: 10px; background: #ecfdf5;
        border: 1px solid #a7f3d0; min-height: 42px; display: flex; align-items: center;
      }
      .ph-preview-sampel strong { color: #047857; font-size: 12.5px; font-weight: 800; }

      /* Tabel */
      .ph-table-wrap { width: 100%; overflow-x: auto; }
      .ph-table { width: 100%; min-width: 1120px; border-collapse: collapse; }
      .ph-table thead th {
        padding: 12px 14px; background: #fdf2f2; border-bottom: 1px solid #f4d7d7;
        color: #7a1b1b; font-size: 10.5px; font-weight: 800; letter-spacing: .05em;
        text-transform: uppercase; text-align: left; white-space: nowrap;
      }
      .ph-table tbody td {
        padding: 13px 14px; border-bottom: 1px solid #f1f5f9; font-size: 12.5px;
        color: #334155; vertical-align: top;
      }
      .ph-table tbody tr.ph-row { cursor: pointer; transition: background .18s ease; }
      .ph-table tbody tr.ph-row:hover { background: #fffafa; }
      .ph-table tbody tr.ph-row:last-child td { border-bottom: none; }
      .ph-nama { font-weight: 700; color: #0f172a; font-size: 13px; }
      .ph-sub { display: block; margin-top: 4px; font-size: 11px; color: #94a3b8; }
      .ph-total-row td {
        background: #f8fafc; font-weight: 800; color: #7a1b1b;
        border-top: 2px solid #f1f5f9;
      }
      .ph-empty { padding: 48px 20px; text-align: center; color: #94a3b8; font-size: 13px; }
      .ph-aksi-wrap { display: inline-flex; align-items: center; gap: 5px; flex-wrap: wrap; }
      .ph-action-btn {
        width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid #e2e8f0; border-radius: 8px; background: #fff;
        color: #64748b; cursor: pointer; transition: all .18s ease;
      }
      .ph-action-btn svg { width: 14px; height: 14px; }
      .ph-action-btn:hover { background: #f8fafc; border-color: #cbd5e1; color: #7a1b1b; }
      .ph-action-btn.ph-duplikat:hover { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
      .ph-action-btn.ph-hapus:hover { background: #fff1f2; border-color: #fecdd3; color: #e11d48; }

      /* ========================= MODAL ========================= */
      .ph-modal {
        position: fixed; inset: 0; z-index: 2000; display: none;
        align-items: center; justify-content: center; padding: 24px;
        background: rgba(15, 23, 42, 0.68); backdrop-filter: blur(5px);
      }
      .ph-modal.terbuka { display: flex; }
      .ph-modal-dialog {
        width: min(1120px, 100%); max-height: calc(100vh - 48px); margin: auto;
        display: flex; flex-direction: column; overflow: hidden;
        background: #fff; border-radius: 20px; box-shadow: 0 24px 70px rgba(0,0,0,.3);
      }
      .ph-form-dialog { width: min(1080px, 100%); }
      .ph-detail-dialog { width: min(1140px, 100%); }
      /* Form adalah flex child supaya ph-modal-body bisa benar-benar scroll */
      .ph-modal-dialog form {
        flex: 1; min-height: 0; display: flex; flex-direction: column;
      }
      .ph-modal-head {
        flex-shrink: 0; display: flex; align-items: flex-start; justify-content: space-between;
        gap: 12px; padding: 18px 22px;
        background: linear-gradient(135deg, #7a1b1b 0%, #4d0e0e 100%); color: #fff;
      }
      .ph-modal-head h2 { font-size: 18px; font-weight: 800; margin-top: 2px; }
      .ph-modal-head p { font-size: 11px; color: rgba(255,255,255,.75); margin-top: 2px; }
      .ph-modal-close {
        width: 34px; height: 34px; border-radius: 999px; border: none;
        background: rgba(255,255,255,.14); color: #fff; font-size: 20px; line-height: 1; cursor: pointer;
        transition: background .2s;
      }
      .ph-modal-close:hover { background: rgba(255,255,255,.26); }
      .ph-modal-body {
        flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch; padding: 20px; background: #f8fafc;
      }
      .ph-form-body { padding-bottom: 8px; }

      /* Form di dalam popup */
      .ph-form-card {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15,23,42,.05); padding: 18px; margin-bottom: 16px;
      }
      .ph-section-title {
        display: flex; align-items: flex-start; gap: 10px; padding-bottom: 12px;
        margin-bottom: 15px; border-bottom: 1px solid #f1f5f9;
      }
      .ph-section-number {
        width: 28px; height: 28px; border-radius: 999px; background: #7a1b1b; color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 800; flex-shrink: 0;
      }
      .ph-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
      .ph-col-span-2 { grid-column: span 2; }
      .ph-hide { display: none !important; }
      .ph-project-info {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 10px; padding: 12px 14px; margin-bottom: 16px;
        border-radius: 12px; background: #fdf2f2; border: 1px solid #f4d7d7;
      }
      .ph-project-info strong { display: block; font-size: 13px; color: #7a1b1b; }
      .ph-project-info span { display: block; font-size: 10.5px; color: #94a3b8; margin-top: 3px; }
      .ph-auto-badge {
        display: inline-block; margin-left: 6px; padding: 2px 7px; border-radius: 999px;
        background: #dcfce7; color: #15803d; font-size: 9px; font-weight: 800; letter-spacing: .04em;
      }

      /* Toggle on/off */
      .ph-switch-wrap {
        display: flex; align-items: center; justify-content: space-between; gap: 14px;
        padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc;
      }
      .ph-switch { position: relative; display: inline-flex; align-items: center; cursor: pointer; }
      .ph-switch input { position: absolute; opacity: 0; width: 0; height: 0; }
      .ph-switch-track {
        width: 48px; height: 27px; border-radius: 999px; background: #cbd5e1;
        position: relative; transition: background .25s ease, box-shadow .25s ease;
        box-shadow: inset 0 1px 3px rgba(0,0,0,.15);
      }
      .ph-switch-dot {
        position: absolute; top: 3px; left: 3px; width: 21px; height: 21px; border-radius: 50%;
        background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,.28); transition: transform .25s ease;
      }
      .ph-switch input:checked + .ph-switch-track {
        background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.16), inset 0 1px 3px rgba(0,0,0,.12);
      }
      .ph-switch input:checked + .ph-switch-track .ph-switch-dot { transform: translateX(21px); }
      .ph-switch input:focus-visible + .ph-switch-track { outline: 3px solid rgba(34,197,94,.35); outline-offset: 2px; }
      .ph-switch-teks { display: block; font-size: 12px; font-weight: 700; color: #334155; }
      .ph-switch-keterangan { display: block; margin-top: 2px; font-size: 10.5px; color: #94a3b8; }
      .ph-include-note {
        display: none; align-items: center; gap: 8px; margin-top: 8px; padding: 9px 12px;
        border-radius: 10px; background: #ecfdf5; border: 1px solid #a7f3d0;
        color: #047857; font-size: 11px; font-weight: 600;
      }
      .ph-include-note.terlihat { display: flex; }

      .ph-cost-block {
        border: 1px solid #f1e4e4; border-radius: 14px; padding: 14px;
        background: #fffafa; margin-bottom: 13px;
      }
      .ph-cost-head {
        display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px;
      }
      .ph-cost-title {
        font-size: 12px; font-weight: 800; color: #7a1b1b;
        text-transform: uppercase; letter-spacing: .04em;
      }
      .ph-cost-row {
        display: grid; grid-template-columns: minmax(0, 1fr) 170px auto;
        gap: 10px; align-items: end; margin-top: 10px;
      }
      .ph-price-wrap { display: none; }
      .ph-price-wrap.terlihat { display: block; }
      .ph-fixed-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
      .ph-preview-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
      .ph-preview-grid img { width: 82px; height: 82px; object-fit: cover; border-radius: 10px; border: 1px solid #e2e8f0; }

      /* Footer form + kalkulasi */
      .ph-form-footer {
        flex-shrink: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 14px; padding: 14px 20px; background: #fff; border-top: 1px solid #e2e8f0;
      }
      .ph-live-ringkas { display: flex; flex-wrap: wrap; gap: 26px; }
      .ph-live-label {
        display: block; font-size: 9.5px; font-weight: 800; letter-spacing: .07em;
        text-transform: uppercase; color: #94a3b8;
      }
      .ph-live-ringkas strong { display: block; margin-top: 3px; font-size: 18px; font-weight: 800; color: #7a1b1b; }
      .ph-form-actions { display: flex; flex-wrap: wrap; gap: 9px; }
      .ph-simpan-btn {
        display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px;
        border: none; border-radius: 11px; background: #7a1b1b; color: #fff;
        font-size: 12.5px; font-weight: 800; cursor: pointer; box-shadow: 0 6px 16px rgba(122,27,27,.22);
      }
      .ph-simpan-btn:hover { background: #5e1414; }

      /* ===================== DETAIL MODAL ===================== */
      .ph-detail-layout { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 18px; }
      .ph-detail-aside, .ph-detail-main { display: flex; flex-direction: column; gap: 14px; }
      .ph-detail-card {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px;
        box-shadow: 0 6px 18px rgba(15,23,42,.05);
      }
      .ph-detail-card-head {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        padding-bottom: 10px; margin-bottom: 13px; border-bottom: 1px solid #f1f5f9;
      }
      .ph-detail-card-head h3 {
        font-size: 11px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; color: #7a1b1b;
      }
      .ph-detail-card-head span { font-size: 10px; color: #94a3b8; }
      .ph-status-badge {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px;
        background: rgba(255,255,255,.16); color: #fff; font-size: 10.5px; font-weight: 700;
      }
      .ph-status-badge::before {
        content: ''; width: 6px; height: 6px; border-radius: 50%; background: #4ade80;
        box-shadow: 0 0 6px #4ade80;
      }
      .ph-gallery-main {
        width: 100%; height: 250px; object-fit: contain; background: #f8fafc;
        border: 1px solid #e2e8f0; border-radius: 12px;
      }
      .ph-gallery-empty {
        height: 250px; display: flex; align-items: center; justify-content: center; text-align: center;
        padding: 20px; border: 1px dashed #cbd5e1; border-radius: 12px;
        background: #f8fafc; color: #94a3b8; font-size: 12px;
      }
      .ph-thumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
      .ph-thumbs img {
        width: 56px; height: 56px; object-fit: cover; border-radius: 8px;
        border: 2px solid transparent; cursor: pointer; transition: border-color .2s, transform .2s;
      }
      .ph-thumbs img:hover { transform: translateY(-2px); }
      .ph-thumbs img.aktif { border-color: #7a1b1b; }
      .ph-side-row { display: flex; flex-direction: column; gap: 3px; margin-bottom: 12px; }
      .ph-side-row:last-child { margin-bottom: 0; }
      .ph-info-label {
        display: block; font-size: 9.5px; font-weight: 800; letter-spacing: .07em;
        text-transform: uppercase; color: #94a3b8; margin-bottom: 3px;
      }
      .ph-info-value { display: block; font-size: 13px; font-weight: 600; color: #1e293b; word-break: break-word; }
      .ph-info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .ph-detail-note {
        margin-top: 14px; padding: 12px 14px; border-radius: 12px; background: #f8fafc;
        border: 1px solid #e2e8f0;
      }
      .ph-detail-note p { margin: 0; font-size: 12px; line-height: 1.65; color: #475569; white-space: pre-line; }
      .ph-detail-note + .ph-detail-note { margin-top: 10px; }
      .ph-detail-table { width: 100%; border-collapse: collapse; font-size: 12px; }
      .ph-detail-table thead th {
        padding: 9px 10px; background: #fdf2f2; color: #7a1b1b; font-size: 9.5px;
        text-transform: uppercase; letter-spacing: .06em; text-align: left; border-bottom: 1px solid #f4d7d7;
      }
      .ph-detail-table thead th:last-child { text-align: right; }
      .ph-detail-table tbody th, .ph-detail-table tbody td {
        padding: 9px 10px; border-bottom: 1px solid #f1f5f9; text-align: left;
      }
      .ph-detail-table tbody th { font-weight: 600; color: #475569; }
      .ph-detail-table tbody td { text-align: right; font-weight: 700; color: #1e293b; white-space: nowrap; }
      .ph-detail-table tbody tr:last-child th, .ph-detail-table tbody tr:last-child td { border-bottom: none; }
      .ph-callout {
        display: flex; align-items: flex-start; gap: 8px; margin-top: 12px; padding: 10px 12px;
        border-radius: 10px; font-size: 11px; font-weight: 600; line-height: 1.5;
      }
      .ph-callout-amber { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
      .ph-callout-green { background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; }
      .ph-detail-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .ph-detail-summary-item {
        padding: 15px 17px; border-radius: 14px; background: #fff;
        border: 1px solid #e2e8f0; box-shadow: 0 6px 18px rgba(15,23,42,.05);
      }
      .ph-detail-summary-item strong { display: block; margin-top: 5px; font-size: 20px; font-weight: 800; color: #1e293b; }
      .ph-detail-summary-item small { display: block; margin-top: 4px; font-size: 10px; color: #94a3b8; }
      .ph-detail-summary-item.ph-total {
        background: linear-gradient(135deg, #7a1b1b 0%, #4d0e0e 100%); border-color: transparent;
      }
      .ph-detail-summary-item.ph-total .ph-info-label,
      .ph-detail-summary-item.ph-total small { color: rgba(255,255,255,.72); }
      .ph-detail-summary-item.ph-total strong { color: #fff; font-size: 23px; }

      /* Responsif */
      @media (max-width: 1000px) {
        .ph-detail-layout { grid-template-columns: 1fr; }
        .ph-detail-aside { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
      }
      @media (max-width: 760px) {
        .ph-main { padding: 18px 14px 40px; }
        .ph-grid, .ph-fixed-grid, .ph-info-grid, .ph-detail-summary { grid-template-columns: 1fr; }
        .ph-col-span-2 { grid-column: span 1; }
        .ph-cost-row { grid-template-columns: 1fr; }
        .ph-detail-aside { grid-template-columns: 1fr; }
        .ph-modal { padding: 10px; }
        .ph-modal-dialog { max-height: calc(100vh - 20px); border-radius: 16px; }
        .ph-modal-body { padding: 14px; }
        .ph-modal-head { padding: 15px 16px; }
        .ph-gallery-main, .ph-gallery-empty { height: 210px; }
        .ph-form-footer { padding: 13px 14px; }
      }

      /* Cetak */
      @media print {
        body::before, .sidebar, .sidebar-overlay, .system-banner,
        .ph-modal, .no-print, #toast-container { display: none !important; }
        body, .ph-main { display: block !important; padding: 0 !important; margin: 0 !important; background: #fff !important; }
        .ph-panel, .stat-card { box-shadow: none !important; border: 1px solid #d4d4d8 !important; }
        .ph-table { min-width: 0 !important; }
        .ph-table thead th { background: #f4f4f5 !important; color: #000 !important; }
      }
      /* Pastikan wadah tombol di banner memakai flex */
      .banner-actions,
      .ph-banner-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        width: 100%;
      }

      /* Dorong tombol Input Pengajuan Baru ke paling kanan */
      .btn-banner-primary {
        margin-left: auto;
      }

      @media (max-width: 639px) {
        .btn-banner-primary {
          margin-left: 0;
        }
      }
      .system-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .banner-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .banner-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }

      .banner-actions button,
      .banner-actions .btn-banner-primary {
        margin-top: 0;
      }
    </style>
  </head>
  <body class="text-slate-800 antialiased selection:bg-maroon-800 selection:text-white">
    <%- include('partials/sidebar-user', { activePage: 'pengajuan-harga', user: userPH }) %>

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none no-print"></div>

    <main class="pr-main ph-main">
