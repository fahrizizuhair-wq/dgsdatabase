            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
          <div class="banner-text">
            <span>System Pengadaan &bull; User</span>
            <h1><% if (modeProyekPH) { %>Pengajuan Harga &mdash; <%= projectPH.namaProject %><% } else { %>Pengajuan Harga &mdash; Daftar Project<% } %></h1>
          </div>
        </div>
        <div class="banner-actions">
          <% if (modeProyekPH) { %>
          <button type="button" onclick="kembaliKeProject()" class="ph-btn ph-btn-neutral cursor-pointer" title="Kembali ke daftar project">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Daftar Project</span>
          </button>
          <button type="button" onclick="window.print()" class="ph-btn ph-btn-neutral cursor-pointer" title="Cetak / simpan PDF">
            <i data-lucide="printer" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Cetak</span>
          </button>
          <button type="button" onclick="eksporCSV()" class="ph-btn ph-btn-neutral cursor-pointer" title="Unduh data dalam format CSV">
            <i data-lucide="file-down" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Export CSV</span>
          </button>
          <button type="button" onclick="bukaForm()" class="btn-banner-primary cursor-pointer" title="Buat pengajuan baru pada project ini">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Input Pengajuan Baru</span>
            <span class="sm:hidden">Input Baru</span>
          </button>
          <% } else { %>
          <button type="button" onclick="fokusTambahProject()" class="btn-banner-primary cursor-pointer" title="Tambah project baru">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Tambah Project</span>
          </button>
          <% } %>
        </div>
      </header>

      <% if (!modeProyekPH) { %>
      <!-- ===================== LANDING: CARD PROJECT ===================== -->
      <section id="view-project" class="space-y-5">
        <div class="card-grid ph-card-grid">
          <div class="stat-card card-blue">
            <div class="card-header">
              <span class="card-title">Total Project</span>
              <div class="icon-wrapper icon-blue">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
                  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" 
                  stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dock preview-icon">
                  <path d="M2 8h20"/><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 16h12"/>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= totalProjectPH %></span>
              <span class="card-unit">Project</span>
            </div>
            <div class="card-footer">
              <span class="text-blue">Terdaftar</span>
              <span>Pengajuan harga</span>
            </div>
          </div>

          <div class="stat-card card-gold">
            <div class="card-header">
              <span class="card-title">Total Kasbon Sampel</span>
              <div class="icon-wrapper icon-gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= rupiahPH(totalKasbonPH) %></span>
            </div>
            <div class="card-footer">
              <span class="text-orange">Seluruh project</span>
              <span>Dasar sampel</span>
            </div>
          </div>

          <div class="stat-card card-green">
            <div class="card-header">
              <span class="card-title">Total Qty BOQ</span>
              <div class="icon-wrapper icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= angkaPH(totalBoqPH) %></span>
              <span class="card-unit">Unit</span>
            </div>
            <div class="card-footer">
              <span class="text-green">Akumulasi BOQ</span>
              <span>Seluruh project</span>
            </div>
          </div>

          <div class="stat-card card-red">
            <div class="card-header">
              <span class="card-title">Rata-rata Sampel / Unit</span>
              <div class="icon-wrapper icon-red">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" 
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                class="lucide lucide-chart-no-axes-combined preview-icon"><path d="M12 16v5"/><path d="M16 14.639V21"/>
                <path d="M20 10.656V21"/><path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"/>
                <path d="M4 18.463V21"/><path d="M8 14.656V21"/></svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= rupiahPH(rataSampelPH) %></span>
            </div>
            <div class="card-footer">
              <span class="text-red">Kasbon &divide; BOQ</span>
              <span>Float penuh</span>
            </div>
          </div>
        </div>

        <form id="ph-project-form" class="ph-panel" action="/pengajuan-harga/project/add" method="POST" onsubmit="return validasiProject()">
          <div class="ph-panel-head">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900">Tambah Project Baru</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Sampel / Survey per Unit dihitung otomatis dari kasbon sampel dibagi total qty BOQ.</p>
            </div>
            <span class="ph-badge">Data Project</span>
          </div>
          <div class="ph-panel-body">
            <div class="ph-project-form-grid">
              <div class="ph-field">
                <label for="ph-project-nama-input">Nama Project *</label>
                <input type="text" id="ph-project-nama-input" name="namaProject" class="ph-input" required placeholder="Contoh: Merchandise Event Q4 2026" />
              </div>
              <div class="ph-field">
                <label for="ph-project-kasbon">Total Kasbon Sampel (Rp) *</label>
                <input type="number" id="ph-project-kasbon" name="totalKasbonSampel" class="ph-input" min="0" step="any" value="0" required oninput="hitungPreviewSampel()" />
              </div>
              <div class="ph-field">
                <label for="ph-project-boq">Total Qty BOQ *</label>
                <input type="number" id="ph-project-boq" name="totalQtyBoq" class="ph-input" min="1" step="any" value="1" required oninput="hitungPreviewSampel()" />
              </div>
              <div class="ph-field">
                <label>Sampel / Survey per Unit</label>
                <div class="ph-preview-sampel"><strong id="ph-preview-sampel">Rp 0</strong></div>
              </div>
              <button type="submit" class="ph-simpan-btn cursor-pointer">
                <i data-lucide="folder-plus" class="w-4 h-4"></i>
                Simpan Project
              </button>
            </div>
          </div>
        </form>

        <div class="ph-panel">
          <div class="ph-panel-head">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900">Daftar Project Pengajuan Harga</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Klik card project untuk melihat daftar pengajuan harga pada project tersebut.</p>
            </div>
            <span class="ph-badge"><%= totalProjectPH %> Project</span>
          </div>
          <div class="ph-panel-body">
            <% if (totalProjectPH) { %>
            <div class="ph-project-grid">
              <% daftarProjectPH.forEach(function (project) { %>
              <div class="stat-card card-gold ph-project-card" role="button" tabindex="0"
                   onclick="bukaProject('<%= String(project._id) %>')"
                   onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); bukaProject('<%= String(project._id) %>'); }"
                   title="Perhitungan: <%= Number(project.totalKasbonSampel) || 0 %> &divide; <%= Number(project.totalQtyBoq) || 0 %> = <%= Number(project.sampelPerUnit) || 0 %>">
                <div class="card-header">
                  <span class="card-title"><%= project.namaProject %></span>
                  <div class="icon-wrapper icon-gold">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                </div>  
                <div class="card-footer">
                  <span class="text-orange">Kasbon <%= rupiahPH(project.totalKasbonSampel) %></span>
                  <span>BOQ <%= angkaPH(project.totalQtyBoq) %> &rarr;</span>
                </div>
              </div>
              <% }); %>
            </div>
            <% } else { %>
            <div class="ph-project-empty">Belum ada project. Tambahkan project baru melalui form di atas untuk mulai membuat pengajuan harga.</div>
            <% } %>
          </div>
        </div>
      </section>
      <% } else { %>
      <!-- ===================== DAFTAR PENGAJUAN PER PROJECT ===================== -->
      <section id="view-list" class="space-y-5">
        <div class="card-grid ph-card-grid">
          <div class="stat-card card-blue">
            <div class="card-header">
              <span class="card-title">Total Item Barang</span>
              <div class="icon-wrapper icon-blue">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" 
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package preview-icon">
                <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
                <path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/></svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= totalItemPH %></span>
              <span class="card-unit">Item</span>
            </div>
            <div class="card-footer">
              <span class="text-blue">Jenis merchandise</span>
              <span>Pada project ini</span>
            </div>
          </div>

          <div class="stat-card card-green">
            <div class="card-header">
              <span class="card-title">Total Volume</span>
              <div class="icon-wrapper icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= angkaPH(totalQtyPH) %></span>
              <span class="card-unit">Unit</span>
            </div>
            <div class="card-footer">
              <span class="text-green">Siap produksi</span>
              <span>Pada project ini</span>
            </div>
          </div>

          <div class="stat-card card-gold">
            <div class="card-header">
              <span class="card-title">Total Estimasi Harga</span>
              <div class="icon-wrapper icon-gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= rupiahPH(totalEstimasiPH) %></span>
            </div>
            <div class="card-footer">
              <span class="text-orange">Akumulasi all-in</span>
              <span>Keseluruhan</span>
            </div>
          </div>

          <div class="stat-card card-red">
            <div class="card-header">
              <span class="card-title">Rata-rata Unit All-In</span>
              <div class="icon-wrapper icon-red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
            </div>
            <div class="card-body">
              <span class="card-value"><%= rupiahPH(rataUnitPH) %></span>
            </div>
            <div class="card-footer">
              <span class="text-red">Per satuan unit</span>
              <span>All-in</span>
            </div>
          </div>
        </div>

        <div class="ph-panel">
          <div class="ph-panel-head">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900">Daftar Pengajuan Harga</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">
                Project: <strong class="text-slate-700"><%= projectPH.namaProject %></strong>
                &bull; Sampel otomatis <strong class="text-slate-700"><%= rupiahPH(projectPH.sampelPerUnit) %></strong> / unit
              </p>
            </div>
            <span class="ph-badge"><%= totalItemPH %> Pengajuan</span>
          </div>

          <div class="ph-toolbar no-print">
            <div class="flex-1 min-w-[220px] relative">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="ph-search" class="pl-9" placeholder="         Cari barang, spesifikasi, tim..." oninput="renderTabel()" />
            </div>
            <div class="w-full sm:w-64">
              <select id="ph-filter-tim" onchange="renderTabel()">
                <option value="">Semua Tim Produksi</option>
              </select>
            </div>
          </div>

          <div class="ph-table-wrap">
            <table class="ph-table">
              <thead>
                <tr>
                  <th>Nama Barang</th>
                  <th>Tim Produksi</th>
