<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin - Master Vendor</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #f4f6f9;
      color: #333;
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
      width: 260px;
      background-color: #7a1b1b; /* Warna marun solid */
      color: white;
      padding: 25px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100vh;
      box-sizing: border-box;
      flex-shrink: 0;
      box-shadow: 4px 0 15px rgba(0, 0, 0, 0.05);
    }

    .sidebar-brand {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 30px;
    }

    .nav-menu {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .nav-item a {
      display: block;
      padding: 12px 16px;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 500;
      font-size: 14px;
      transition: all 0.2s ease;
    }

    .nav-item.active a,
    .nav-item a:hover {
      background-color: rgba(255, 255, 255, 0.15);
      color: #ffffff;
    }

    /* GROUP TOMBOL BAWAH */
    .sidebar-footer {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .btn-bottom {
      display: block;
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      text-align: center;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .btn-home {
      background-color: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: white;
    }

    .btn-home:hover {
      background-color: rgba(255, 255, 255, 0.25);
    }

    .btn-logout {
      background-color: #d9534f;
      border: 1px solid #c9302c;
      color: white;
    }

    .btn-logout:hover {
      background-color: #c9302c;
    }

    /* MAIN CONTENT */
    .main-content {
      flex: 1;
      padding: 40px;
      overflow-y: auto;
    }

    .header-section {
      margin-bottom: 30px;
    }

    .header-section h1 {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 6px;
    }

    .header-section p {
      color: #666;
      font-size: 14px;
    }

    /* METRIC CARDS */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: #ffffff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid #eef0f4;
    }

    .card-title {
      font-size: 14px;
      color: #666;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .card-value {
      font-size: 28px;
      font-weight: 700;
      color: #7a1b1b;
    }

    /* DATA TABLE CONTAINER */
    .table-container {
      background: #ffffff;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid #eef0f4;
    }

    .table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .table-title {
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
    }

    .table-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .search-input {
      padding: 10px 14px;
      border: 1px solid #dde1e5;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
      width: 220px;
    }

    .search-input:focus {
      border-color: #7a1b1b;
    }

    .btn-add {
      background-color: #7a1b1b;
      color: white;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .btn-add:hover {
      background-color: #5c1414;
    }

    /* TABLE DESIGN */
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      background-color: #f8f9fa;
      color: #555;
      font-weight: 600;
      font-size: 13px;
      padding: 14px 16px;
      border-bottom: 2px solid #edf0f2;
    }

    td {
      padding: 16px;
      border-bottom: 1px solid #edf0f2;
      font-size: 14px;
      color: #333;
    }

    tr:hover {
      background-color: #fcfcfc;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .badge-active {
      background-color: #e6f4ea;
      color: #137333;
    }

    .badge-review {
      background-color: #fef7e0;
      color: #b06000;
    }

    .badge-inactive {
      background-color: #fce8e6;
      color: #c5221f;
    }

    .btn-action {
      background: none;
      border: none;
      color: #7a1b1b;
      font-weight: 600;
      cursor: pointer;
      margin-right: 10px;
      font-size: 13px;
    }

    .btn-action:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div>
      <div class="sidebar-brand">
        Admin Seblak<br>Aloeng
      </div>
      <ul class="nav-menu">
        <li class="nav-item"><a href="/admin">Ringkasan Penjualan</a></li>
        <li class="nav-item active"><a href="/admin/vendor">Data Vendor</a></li>
        <li class="nav-item"><a href="#">Modal cash</a></li>
        <li class="nav-item"><a href="#">Pengaturan</a></li>
      </ul>
    </div>

    <!-- FOOTER SIDEBAR: KEMBALI KE TAMPILAN AWAL & LOGOUT -->
    <div class="sidebar-footer">
      <a href="/" class="btn-bottom btn-home">&larr; Kembali ke Tampilan Awal</a>
      <a href="/login" class="btn-bottom btn-logout">&#x21AA; Keluar / Ke Login</a>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <!-- HEADER -->
    <header class="header-section">
      <h1>Master Database Vendor</h1>
      <p>Kelola data pemasok, kategori bahan baku, dan status kemitraan vendor.</p>
    </header>

    <!-- CARDS METRIC -->
    <section class="cards-grid">
      <div class="card">
        <div class="card-title">Total Vendor Aktif</div>
        <div class="card-value">12 Vendor</div>
      </div>
      <div class="card">
        <div class="card-title">Kategori Bahan Baku</div>
        <div class="card-value">5 Kategori</div>
      </div>
    </section>

    <!-- DATA TABLE -->
    <section class="table-container">
      <div class="table-header">
        <div class="table-title">Daftar Vendor Bahan Baku</div>
        <div class="table-actions">
          <input type="text" class="search-input" placeholder="Cari nama vendor / kontak...">
          <button class="btn-add">+ Tambah Vendor</button>
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>ID Vendor</th>
            <th>Nama Vendor</th>
            <th>Kategori Supply</th>
            <th>Kontak / No. HP</th>
            <th>Rating</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>VND-001</strong></td>
            <td>Toko Kerupuk Cahaya</td>
            <td>Kerupuk & Topping</td>
            <td>0812-3456-7890</td>
            <td>⭐ 4.8 / 5</td>
            <td><span class="badge badge-active">Aktif</span></td>
            <td>
              <button class="btn-action">Edit</button>
              <button class="btn-action">Detail</button>
            </td>
          </tr>
          <tr>
            <td><strong>VND-002</strong></td>
            <td>Agen Bumbu Rempah Murni</td>
            <td>Bumbu Dapur & Cabai</td>
            <td>0857-9876-5432</td>
            <td>⭐ 4.5 / 5</td>
            <td><span class="badge badge-review">Review</span></td>
            <td>
              <button class="btn-action">Edit</button>
              <button class="btn-action">Detail</button>
            </td>
          </tr>
          <tr>
            <td><strong>VND-003</strong></td>
            <td>Supplier Bakso & Sosis</td>
            <td>Olahan Daging</td>
            <td>0821-1122-3344</td>
            <td>⭐ 4.2 / 5</td>
            <td><span class="badge badge-inactive">Nonaktif</span></td>
            <td>
              <button class="btn-action">Edit</button>
              <button class="btn-action">Detail</button>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

  </main>

</body>
</html>