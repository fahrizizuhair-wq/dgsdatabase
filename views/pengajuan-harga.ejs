<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head', { pageTitle: pageTitle, useTailwind: true }) %>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/payment-request.css" />
    <link rel="stylesheet" href="/css/pengajuan-harga.css" />
  </head>
  <body class="text-slate-800 antialiased selection:bg-maroon-800 selection:text-white">
    <%
      var dataPH = (typeof items !== 'undefined' && items) ? items : [];
      var peranPH = (typeof role !== 'undefined' && role === 'admin') ? 'admin' : 'user';
      var adminUserPH = (typeof adminUser !== 'undefined' && adminUser) ? adminUser : 'Admin';
      var userPH = (typeof user !== 'undefined' && user) ? user : { username: 'User', namaLengkap: 'User' };

      var totalItemPH = dataPH.length;
      var totalQtyPH = dataPH.reduce(function (a, b) { return a + (Number(b.qty) || 0); }, 0);
      var totalEstimasiPH = dataPH.reduce(function (a, b) { return a + (Number(b.totalHarga) || 0); }, 0);
      var rataUnitPH = totalQtyPH > 0 ? Math.round(totalEstimasiPH / totalQtyPH) : 0;

      function jsonUntukScriptPH(nilai) {
        return JSON.stringify(nilai || [])
          .replace(/</g, '\\u003c')
          .replace(/>/g, '\\u003e')
          .replace(/&/g, '\\u0026')
          .replace(/\u2028/g, '\\u2028')
          .replace(/\u2029/g, '\\u2029');
      }
    %>

    <% if (peranPH === 'admin') { %>
      <%- include('partials/sidebar-admin', { activePage: 'pengajuan-harga', adminUser: adminUserPH }) %>
    <% } else { %>
      <%- include('partials/sidebar-user', { activePage: 'pengajuan-harga', user: userPH }) %>
    <% } %>

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none no-print"></div>

    <main class="pr-main ph-main">
      <!-- HEADBAR -->
      <header class="system-banner no-print">
        <div class="banner-title-wrap">
          <button type="button" class="banner-toggle-btn" onclick="toggleSidebar()" aria-label="Buka menu navigasi" title="Buka Menu">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
          <div class="banner-text">
            <span>System Pengadaan &bull; <%= peranPH === 'admin' ? 'Admin' : 'User' %></span>
            <h1>Pengajuan Harga Merchandise</h1>
          </div>
        </div>
        <div class="banner-actions">
          <button type="button" onclick="eksporCSV()" class="ph-btn ph-btn-neutral cursor-pointer" title="Unduh data dalam format CSV">
            <i data-lucide="file-down" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Export CSV</span>
          </button>
          <button type="button" onclick="window.print()" class="ph-btn ph-btn-neutral cursor-pointer" title="Cetak / simpan PDF">
            <i data-lucide="printer" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Cetak</span>
          </button>
          <button type="button" onclick="bukaForm()" class="btn-banner-primary cursor-pointer" title="Buat pengajuan baru">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Input Pengajuan Baru</span>
            <span class="sm:hidden">Input Baru</span>
          </button>
        </div>
      </header>

      <!-- DAFTAR -->
      <section id="view-list" class="ph-list-section space-y-5">
        <div class="ph-stat-grid">
          <div class="ph-stat-card">
            <div class="ph-stat-top">
              <span class="ph-stat-title">Total Item Barang</span>
              <i data-lucide="package" class="w-5 h-5 text-maroon-700"></i>
            </div>
            <span class="ph-stat-value"><%= totalItemPH %></span>
            <span class="ph-stat-note">Jenis merchandise diajukan</span>
          </div>
          <div class="ph-stat-card">
            <div class="ph-stat-top">
              <span class="ph-stat-title">Total Volume</span>
              <i data-lucide="boxes" class="w-5 h-5 text-maroon-700"></i>
            </div>
            <span class="ph-stat-value"><%= Number(totalQtyPH).toLocaleString('id-ID') %></span>
            <span class="ph-stat-note">Total unit siap diproduksi</span>
          </div>
          <div class="ph-stat-card">
            <div class="ph-stat-top">
              <span class="ph-stat-title">Total Estimasi Harga</span>
              <i data-lucide="wallet" class="w-5 h-5 text-maroon-700"></i>
            </div>
            <span class="ph-stat-value">Rp <%= Number(totalEstimasiPH).toLocaleString('id-ID') %></span>
            <span class="ph-stat-note">Akumulasi all-in keseluruhan</span>
          </div>
          <div class="ph-stat-card">
            <div class="ph-stat-top">
              <span class="ph-stat-title">Rata-rata Unit All-In</span>
              <i data-lucide="trending-up" class="w-5 h-5 text-maroon-700"></i>
            </div>
            <span class="ph-stat-value">Rp <%= Number(rataUnitPH).toLocaleString('id-ID') %></span>
            <span class="ph-stat-note">Per satuan unit barang</span>
          </div>
        </div>

        <div class="ph-panel">
          <div class="ph-panel-head">
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900">Daftar Pengajuan Harga</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Klik salah satu baris untuk melihat seluruh detail pengajuan.</p>
            </div>
            <span class="ph-badge"><%= totalItemPH %> Pengajuan</span>
          </div>

          <div class="ph-toolbar no-print">
            <div class="flex-1 min-w-[220px] relative">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="ph-search" class="pl-9" placeholder="    Cari barang, spesifikasi, tim..." oninput="renderTabel()" />
            </div>
            <div class="w-full sm:w-64">
              <select id="ph-filter-tim" onchange="renderTabel()">
                <option value="">Semua Tim Produksi</option>
              </select>
            </div>
          </div>

          <div class="ph-table-wrap">
            <table class="ph-table">
              <thead>
                <tr>
                  <th>Nama Barang</th>
                  <th>Tim Produksi</th>
                  <th>Qty &amp; Satuan</th>
                  <th>Harga Produksi</th>
                  <th>Biaya Tambahan</th>
                  <th>Harga All-In</th>
                  <th>Total Harga</th>
                  <th>PIC &amp; Waktu</th>
                  <th class="no-print">Aksi</th>
                </tr>
              </thead>
              <tbody id="ph-table-body"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- FORM (MASIH DI HALAMAN YANG SAMA) -->
      <section id="view-form" class="ph-form-section hidden no-print">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <button type="button" onclick="tutupForm()" class="ph-btn ph-btn-ghost cursor-pointer">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Kembali ke Daftar
          </button>
          <span class="ph-badge">Pengajuan Baru</span>
        </div>

        <form id="ph-form" action="/pengajuan-harga/simpan" method="POST" enctype="multipart/form-data" onsubmit="return validasiForm()">
          <div class="ph-form-card">
            <div class="ph-section-title">
              <span class="ph-section-number">1</span>
              <h2 class="text-sm sm:text-base font-bold text-slate-900">Informasi Utama Merchandise</h2>
            </div>
            <div class="ph-grid">
              <div class="ph-field ph-col-span-2">
                <label for="ph-nama">Nama Barang *</label>
                <input type="text" id="ph-nama" name="namaBarang" class="ph-input" required placeholder="Contoh: Tumbler Stainless Steel / Goodie Bag Spunbond" />
              </div>
              <div class="ph-field">
                <label for="ph-qty">Jumlah (Qty) *</label>
                <input type="number" id="ph-qty" name="qty" class="ph-input" min="1" value="1" required oninput="hitungLive()" />
              </div>
              <div class="ph-field">
                <label for="ph-satuan">Satuan *</label>
                <input type="text" id="ph-satuan" name="satuan" class="ph-input" value="pcs" required />
              </div>
              <div class="ph-field">
                <label for="ph-tim">Tim Produksi / Vendor *</label>
                <input type="text" id="ph-tim" name="timProduksi" class="ph-input" required placeholder="Contoh: Corkcicle Official / Mandiri Printing" />
              </div>
              <div class="ph-field">
                <label for="ph-harga-produksi">Harga Tim Produksi (Rp/Unit) *</label>
                <input type="number" id="ph-harga-produksi" name="hargaProduksi" class="ph-input" min="0" value="0" required oninput="hitungLive()" />
              </div>
              <div class="ph-field ph-col-span-2">
                <label class="ph-checkbox">
                  <input type="checkbox" id="ph-include" name="includeAllIn" onchange="hitungLive()" />
                  <span>Termasuk (Include All in Harga Produksi)</span>
                </label>
                <span class="ph-hint">Centang jika harga produksi sudah mencakup seluruh biaya tambahan.</span>
              </div>
              <div class="ph-field ph-col-span-2">
                <label>Total Keseluruhan (Qty &times; Harga All-In)</label>
                <input type="text" id="ph-total-qty-display" class="ph-input bg-slate-50 font-bold" value="Rp 0" readonly />
              </div>
            </div>
          </div>

          <div class="ph-form-card">
            <div class="ph-section-title">
              <span class="ph-section-number">2</span>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-slate-900">Rincian Biaya Tambahan (per Unit)</h2>
                <p class="text-[11px] text-slate-500">Pilih rincian dari dropdown. Kolom harga muncul setelah pilihan dipilih.</p>
              </div>
            </div>

            <div class="ph-cost-block">
              <div class="ph-cost-head">
                <span class="ph-cost-title">Branding &amp; Printing</span>
                <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('branding')">+ Tambah Rincian</button>
              </div>
              <div id="rows-branding"></div>
            </div>

            <div class="ph-cost-block">
              <div class="ph-cost-head">
                <span class="ph-cost-title">Packaging</span>
                <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('packaging')">+ Tambah Rincian</button>
              </div>
              <div id="rows-packaging"></div>
            </div>

            <div class="ph-cost-block">
              <div class="ph-cost-head">
                <span class="ph-cost-title">Packing Akhir</span>
                <button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="tambahBiayaRow('packing')">+ Tambah Rincian</button>
              </div>
              <div id="rows-packing"></div>
            </div>

            <div class="ph-cost-block">
              <div class="ph-cost-head"><span class="ph-cost-title">Logistik Tim &amp; Sampel</span></div>
              <div class="ph-fixed-grid">
                <div class="ph-field">
                  <label for="ph-ongkir-tim">Ongkir Tim Produksi - DGS (pp)</label>
                  <input type="number" id="ph-ongkir-tim" name="ongkirTimDgs" class="ph-input" min="0" value="0" oninput="hitungLive()" />
                </div>
                <div class="ph-field">
                  <label for="ph-sampel">Sampel / Survey (per Unit)</label>
                  <input type="number" id="ph-sampel" name="sampelSurvey" class="ph-input" min="0" value="0" oninput="hitungLive()" />
                </div>
                <div class="ph-field">
                  <label for="ph-ongkir-client">Ongkir DGS - Client (Jakarta)</label>
                  <input type="number" id="ph-ongkir-client" name="ongkirDgsClient" class="ph-input" min="0" value="0" oninput="hitungLive()" />
                </div>
              </div>
            </div>
          </div>

          <div class="ph-form-card">
            <div class="ph-section-title">
              <span class="ph-section-number">3</span>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-slate-900">Spesifikasi, PIC &amp; Foto Produk</h2>
                <p class="text-[11px] text-slate-500">Foto produk wajib di-upload dari perangkat, bukan URL/link.</p>
              </div>
            </div>
            <div class="ph-grid">
              <div class="ph-field ph-col-span-2">
                <label for="ph-spesifikasi">Spesifikasi Lengkap Barang</label>
                <textarea id="ph-spesifikasi" name="spesifikasi" class="ph-input" rows="4" placeholder="Warna: Matte black&#10;Ukuran: 20oz (270 ml)&#10;Fitur: Triple-insulated stainless steel"></textarea>
              </div>
              <div class="ph-field ph-col-span-2">
                <label for="ph-keterangan">Keterangan / Catatan Tambahan</label>
                <textarea id="ph-keterangan" name="keterangan" class="ph-input" rows="3" placeholder="Catatan khusus, ketentuan garansi, atau opsi sampel..."></textarea>
              </div>
              <div class="ph-field">
                <label for="ph-pic">PIC (Person in Charge)</label>
                <input type="text" id="ph-pic" name="pic" class="ph-input" placeholder="Contoh: Tim Marketing / Budi" />
              </div>
              <div class="ph-field">
                <label for="ph-waktu">Jangka Waktu Produksi</label>
                <input type="text" id="ph-waktu" name="jangkaWaktu" class="ph-input" placeholder="Contoh: 14 Hari Kerja" />
              </div>
              <div class="ph-field ph-col-span-2">
                <label for="ph-foto">Foto Produk Model</label>
                <input type="file" id="ph-foto" name="foto" class="ph-input" accept="image/*" multiple required onchange="pratinjauFoto(this)" />
                <span class="ph-hint">Maksimal 5 file gambar (JPG, PNG, WebP), masing-masing maksimal 5 MB.</span>
                <div id="ph-preview-foto" class="ph-preview-grid"></div>
              </div>
            </div>
          </div>

          <div class="ph-live-box">
            <div>
              <span class="text-[11px] uppercase tracking-wider text-maroon-100 font-bold">Kalkulasi Otomatis (Live)</span>
              <span id="ph-live-allin" class="ph-live-value">Rp 0</span>
              <span class="text-xs text-maroon-100">Harga All-In per unit</span>
            </div>
            <div class="text-right">
              <span class="text-[11px] uppercase tracking-wider text-maroon-100 font-bold">Total Keseluruhan</span>
              <span id="ph-live-total" class="ph-live-value">Rp 0</span>
              <span class="text-xs text-maroon-100">Qty &times; Harga All-In</span>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
              <button type="button" onclick="tutupForm()" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold cursor-pointer">Batal</button>
              <button type="submit" class="px-5 py-2.5 rounded-xl bg-white text-maroon-800 hover:bg-maroon-50 text-xs sm:text-sm font-extrabold shadow-sm inline-flex items-center gap-1.5 cursor-pointer">
                <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                Tambah Pengajuan
              </button>
            </div>
          </div>
        </form>
      </section>
    </main>

    <!-- MODAL DETAIL (KLIK BARIS) -->
    <div id="ph-detail-modal" class="ph-modal" onclick="if (event.target === this) tutupDetail()">
      <div class="ph-modal-dialog">
        <div class="ph-modal-head">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-maroon-100 font-bold">Detail Pengajuan Harga</span>
            <h2 id="ph-detail-judul" class="text-lg sm:text-xl font-extrabold mt-0.5">-</h2>
            <p id="ph-detail-kode" class="text-[11px] text-maroon-100 mt-0.5">-</p>
          </div>
          <button type="button" class="ph-modal-close" onclick="tutupDetail()" aria-label="Tutup detail">&times;</button>
        </div>
        <div id="ph-detail-body" class="ph-modal-body"></div>
      </div>
    </div>

    <script>
      var PH_DATA = <%- jsonUntukScriptPH(dataPH) %>;
      var PH_BERHASIL = <%- JSON.stringify(Boolean(typeof berhasil !== 'undefined' && berhasil)) %>;
      var PH_GAGAL = <%- JSON.stringify(Boolean(typeof gagal !== 'undefined' && gagal)) %>;

      var OPSI_PH = {
        branding: ['sablon', 'bordir', 'grafir 1 sisi', 'grafir 2 sisi', 'print'],
        packaging: ['plastic sealed', 'slongsong', 'custom box'],
        packing: ['kardus', 'karung']
      };
      var JUDUL_GRUP_PH = {
        branding: 'Branding & Printing',
        packaging: 'Packaging',
        packing: 'Packing Akhir'
      };
      var nomorRowPH = 0;

      function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');
        if (sidebar) sidebar.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
      }

      function toggleDropdown(element) {
        var parent = element.closest('.nav-item.dropdown');
        if (parent) parent.classList.toggle('active');
      }

      function initIcons() {
        if (window.lucide && typeof window.lucide.createIcons === 'function') {
          try { window.lucide.createIcons(); } catch (err) {}
        }
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function rupiah(value) {
        return 'Rp ' + Number(value || 0).toLocaleString('id-ID');
      }

      function formatTanggal(value) {
        if (!value) return '-';
        var d = new Date(value);
        if (isNaN(d.getTime())) return String(value);
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
      }

      function teksAman(value) {
        return String(value == null || value === '' ? '-' : value);
      }

      function fotoUrl(nama) {
        if (!nama) return '';
        if (/^https?:\/\//i.test(nama)) return nama;
        return '/uploads/' + encodeURIComponent(nama);
      }

      function tampilToast(pesan, jenis) {
        var container = document.getElementById('toast-container');
        if (!container) return;
        var warna = jenis === 'gagal' ? 'bg-red-600' : 'bg-emerald-600';
        var el = document.createElement('div');
        el.className = 'px-4 py-3 rounded-xl text-white text-xs font-semibold shadow-lg ' + warna;
        el.textContent = pesan;
        container.appendChild(el);
        setTimeout(function () { el.remove(); }, 3500);
      }

      function dataTersaring() {
        var teks = String((document.getElementById('ph-search') || {}).value || '').toLowerCase().trim();
        var tim = String((document.getElementById('ph-filter-tim') || {}).value || '');
        return PH_DATA.filter(function (item) {
          var gabungan = [
            item.namaBarang, item.timProduksi, item.spesifikasi, item.pic, item.kode,
            Array.isArray(item.biayaTambahan) ? item.biayaTambahan.map(function (b) { return b.item; }).join(' ') : ''
          ].join(' ').toLowerCase();
          return (!teks || gabungan.indexOf(teks) !== -1) && (!tim || item.timProduksi === tim);
        });
      }

      function isiOpsiTim() {
        var select = document.getElementById('ph-filter-tim');
        if (!select) return;
        var tim = [];
        PH_DATA.forEach(function (item) {
          if (item.timProduksi && tim.indexOf(item.timProduksi) === -1) tim.push(item.timProduksi);
        });
        tim.sort();
        tim.forEach(function (nama) {
          var opsi = document.createElement('option');
          opsi.value = nama;
          opsi.textContent = nama;
          select.appendChild(opsi);
        });
      }

      function renderTabel() {
        var body = document.getElementById('ph-table-body');
        if (!body) return;
        var data = dataTersaring();

        if (!data.length) {
          body.innerHTML = '<tr><td colspan="9" class="ph-empty">Belum ada pengajuan harga yang cocok.</td></tr>';
          return;
        }

        var baris = data.map(function (item) {
          var biaya = Number(item.totalBiayaTambahan) || 0;
          return '<tr class="ph-row" onclick="bukaDetail(\'' + item._id + '\')">' +
            '<td><span class="ph-nama">' + escapeHtml(item.namaBarang) + '</span>' +
              '<span class="ph-sub">' + escapeHtml(item.kode || '-') + ' &bull; ' + formatTanggal(item.createdAt) + '</span></td>' +
            '<td>' + escapeHtml(teksAman(item.timProduksi)) + '</td>' +
            '<td><strong>' + Number(item.qty || 0).toLocaleString('id-ID') + '</strong> ' + escapeHtml(item.satuan || 'pcs') + '</td>' +
            '<td>' + rupiah(item.hargaProduksi) + '</td>' +
            '<td>' + rupiah(biaya) + '</td>' +
            '<td><strong class="text-maroon-700">' + rupiah(item.hargaAllIn) + '</strong></td>' +
            '<td><strong class="text-maroon-700">' + rupiah(item.totalHarga) + '</strong></td>' +
            '<td>' + escapeHtml(teksAman(item.pic)) + '<span class="ph-sub">' + escapeHtml(teksAman(item.jangkaWaktu)) + '</span></td>' +
            '<td class="no-print"><button type="button" class="ph-btn ph-btn-ghost cursor-pointer" onclick="event.stopPropagation(); bukaDetail(\'' + item._id + '\')">Lihat Detail</button></td>' +
            '</tr>';
        });

        var totalQty = data.reduce(function (a, b) { return a + (Number(b.qty) || 0); }, 0);
        var totalProduksi = data.reduce(function (a, b) { return a + (Number(b.hargaProduksi) || 0); }, 0);
        var totalBiaya = data.reduce(function (a, b) { return a + (Number(b.totalBiayaTambahan) || 0); }, 0);
        var totalSemua = data.reduce(function (a, b) { return a + (Number(b.totalHarga) || 0); }, 0);
        var rata = totalQty > 0 ? Math.round(totalSemua / totalQty) : 0;

        baris.push('<tr class="ph-total-row">' +
          '<td>TOTAL KESELURUHAN</td><td>' + data.length + ' pengajuan</td>' +
          '<td>' + Number(totalQty).toLocaleString('id-ID') + '</td>' +
          '<td>' + rupiah(totalProduksi) + '</td>' +
          '<td>' + rupiah(totalBiaya) + '</td>' +
          '<td>' + rupiah(rata) + '</td>' +
          '<td>' + rupiah(totalSemua) + '</td>' +
          '<td colspan="2" class="no-print">-</td>' +
          '</tr>');

        body.innerHTML = baris.join('');
      }

      function bukaDetail(id) {
        var item = PH_DATA.find(function (x) { return String(x._id) === String(id); });
        if (!item) return;

        document.getElementById('ph-detail-judul').textContent = item.namaBarang || '-';
        document.getElementById('ph-detail-kode').textContent =
          (item.kode || '-') + ' • ' + (item.timProduksi || '-') + ' • ' + formatTanggal(item.createdAt);

        var fotoList = Array.isArray(item.gambar) ? item.gambar.filter(Boolean) : [];
        var gambarHtml = fotoList.length
          ? '<img id="ph-foto-utama" class="ph-gallery-main" src="' + fotoUrl(fotoList[0]) + '" alt="Foto ' + escapeHtml(item.namaBarang) + '" />' +
            '<div class="ph-thumbs">' + fotoList.map(function (f, i) {
              return '<img src="' + fotoUrl(f) + '" class="' + (i === 0 ? 'aktif' : '') + '" onclick="gantiFotoDetail(this)" alt="Thumbnail ' + (i + 1) + '" />';
            }).join('') + '</div>'
          : '<div class="ph-gallery-empty">Belum ada foto produk yang di-upload.</div>';

        var biayaRows = ['<tr><th>Harga Tim Produksi</th><td class="text-right">' + rupiah(item.hargaProduksi) + '</td></tr>'];
        (Array.isArray(item.biayaTambahan) ? item.biayaTambahan : []).forEach(function (b) {
          biayaRows.push('<tr><th>' + escapeHtml(JUDUL_GRUP_PH[b.grup] || b.grup || 'Rincian') + ' &bull; ' + escapeHtml(b.item) + '</th><td class="text-right">' + rupiah(b.harga) + '</td></tr>');
        });
        biayaRows.push('<tr><th>Ongkir Tim Produksi - DGS (pp)</th><td class="text-right">' + rupiah(item.ongkirTimDgs) + '</td></tr>');
        biayaRows.push('<tr><th>Sampel / Survey (per Unit)</th><td class="text-right">' + rupiah(item.sampelSurvey) + '</td></tr>');
        biayaRows.push('<tr><th>Ongkir DGS - Client (Jakarta)</th><td class="text-right">' + rupiah(item.ongkirDgsClient) + '</td></tr>');

        var catatanInclude = item.includeAllIn
          ? '<p class="mt-2 text-[11px] text-amber-700">Biaya tambahan di atas sudah termasuk dalam harga produksi, sehingga tidak dijumlahkan lagi ke harga all-in.</p>'
          : '';

        document.getElementById('ph-detail-body').innerHTML =
          '<div class="ph-detail-grid">' +
            '<div>' + gambarHtml + '</div>' +
            '<div>' +
              '<div class="ph-info-grid">' +
                '<div><span class="ph-info-label">Qty &amp; Satuan</span><span class="ph-info-value">' + Number(item.qty || 0).toLocaleString('id-ID') + ' ' + escapeHtml(item.satuan || 'pcs') + '</span></div>' +
                '<div><span class="ph-info-label">Tim Produksi / Vendor</span><span class="ph-info-value">' + escapeHtml(teksAman(item.timProduksi)) + '</span></div>' +
                '<div><span class="ph-info-label">PIC</span><span class="ph-info-value">' + escapeHtml(teksAman(item.pic)) + '</span></div>' +
                '<div><span class="ph-info-label">Waktu Produksi</span><span class="ph-info-value">' + escapeHtml(teksAman(item.jangkaWaktu)) + '</span></div>' +
                '<div class="ph-col-span-2"><span class="ph-info-label">Spesifikasi Detail Produk</span><span class="ph-info-value">' + escapeHtml(teksAman(item.spesifikasi)).replace(/\n/g, '<br />') + '</span></div>' +
                '<div class="ph-col-span-2"><span class="ph-info-label">Keterangan Tambahan</span><span class="ph-info-value">' + escapeHtml(teksAman(item.keterangan)).replace(/\n/g, '<br />') + '</span></div>' +
              '</div>' +
              '<h3 class="text-xs font-extrabold text-maroon-800 uppercase tracking-wide mb-2">Rincian Komponen Biaya (per Unit)</h3>' +
              '<table class="ph-detail-table"><tbody>' + biayaRows.join('') + '</tbody></table>' +
              catatanInclude +
              '<div class="ph-detail-total">' +
                '<div><span class="ph-info-label">Harga All-In Unit</span><span class="nilai">' + rupiah(item.hargaAllIn) + '</span></div>' +
                '<div class="text-right"><span class="ph-info-label">Total Keseluruhan (' + Number(item.qty || 0).toLocaleString('id-ID') + ' ' + escapeHtml(item.satuan || 'pcs') + ')</span><span class="nilai">' + rupiah(item.totalHarga) + '</span></div>' +
              '</div>' +
            '</div>' +
          '</div>';

        document.getElementById('ph-detail-modal').classList.add('terbuka');
        document.body.style.overflow = 'hidden';
      }

      function gantiFotoDetail(gambar) {
        var utama = document.getElementById('ph-foto-utama');
        if (utama) utama.src = gambar.src;
        document.querySelectorAll('#ph-detail-modal .ph-thumbs img').forEach(function (img) { img.classList.remove('aktif'); });
        gambar.classList.add('aktif');
      }

      function tutupDetail() {
        document.getElementById('ph-detail-modal').classList.remove('terbuka');
        document.body.style.overflow = '';
      }

      function tambahBiayaRow(grup) {
        var wadah = document.getElementById('rows-' + grup);
        if (!wadah) return;
        nomorRowPH += 1;
        var opsi = ['<option value="">-- Pilih rincian --</option>'].concat(
          (OPSI_PH[grup] || []).map(function (item) {
            return '<option value="' + item + '">' + item.charAt(0).toUpperCase() + item.slice(1) + '</option>';
          })
        ).join('');
        var row = document.createElement('div');
        row.className = 'ph-cost-row';
        row.innerHTML =
          '<input type="hidden" name="biayaGrup[]" value="' + grup + '" />' +
          '<div class="ph-field">' +
            '<label>Pilihan ' + JUDUL_GRUP_PH[grup] + '</label>' +
            '<select name="biayaItem[]" class="ph-input item-select" data-grup="' + grup + '" onchange="saatItemBerubah(this)">' + opsi + '</select>' +
          '</div>' +
          '<div class="ph-field ph-price-wrap">' +
            '<label>Harga per Unit (Rp)</label>' +
            '<input type="number" name="biayaHarga[]" class="ph-input harga-input" min="0" value="0" oninput="hitungLive()" />' +
          '</div>' +
          '<button type="button" class="ph-btn ph-btn-neutral cursor-pointer" onclick="hapusBiayaRow(this)">Hapus</button>';
        wadah.appendChild(row);
      }

      function saatItemBerubah(select) {
        var row = select.closest('.ph-cost-row');
        var wrap = row.querySelector('.ph-price-wrap');
        var input = row.querySelector('.harga-input');
        if (select.value) {
          wrap.classList.add('terlihat');
          if (!input.value) input.value = '0';
        } else {
          wrap.classList.remove('terlihat');
          input.value = '0';
        }
        segarOpsi();
        hitungLive();
      }

      function segarOpsi() {
        var dipakai = {};
        document.querySelectorAll('.item-select').forEach(function (select) {
          if (select.value) dipakai[select.value] = select;
        });
        document.querySelectorAll('.item-select').forEach(function (select) {
          Array.from(select.options).forEach(function (option) {
            if (!option.value) return;
            option.disabled = Boolean(dipakai[option.value] && dipakai[option.value] !== select);
          });
        });
      }

      function hapusBiayaRow(tombol) {
        var row = tombol.closest('.ph-cost-row');
        if (row) row.remove();
        segarOpsi();
        hitungLive();
      }

      function hitungLive() {
        var qty = Math.max(1, Number((document.getElementById('ph-qty') || {}).value) || 1);
        var produksi = Math.max(0, Number((document.getElementById('ph-harga-produksi') || {}).value) || 0);
        var include = Boolean((document.getElementById('ph-include') || {}).checked);
        var tambahan = 0;

        document.querySelectorAll('.item-select').forEach(function (select) {
          if (!select.value) return;
          var row = select.closest('.ph-cost-row');
          var harga = Number(row.querySelector('.harga-input').value) || 0;
          tambahan += harga;
        });

        tambahan += Math.max(0, Number((document.getElementById('ph-ongkir-tim') || {}).value) || 0);
        tambahan += Math.max(0, Number((document.getElementById('ph-sampel') || {}).value) || 0);
        tambahan += Math.max(0, Number((document.getElementById('ph-ongkir-client') || {}).value) || 0);

        var efektif = include ? 0 : tambahan;
        var allIn = produksi + efektif;
        var total = allIn * qty;

        var elemenAllIn = document.getElementById('ph-live-allin');
        var elemenTotal = document.getElementById('ph-live-total');
        var elemenTotalDisplay = document.getElementById('ph-total-qty-display');
        if (elemenAllIn) elemenAllIn.textContent = rupiah(allIn);
        if (elemenTotal) elemenTotal.textContent = rupiah(total);
        if (elemenTotalDisplay) elemenTotalDisplay.value = rupiah(total);
      }

      function pratinjauFoto(input) {
        var wadah = document.getElementById('ph-preview-foto');
        if (!wadah) return;
        wadah.innerHTML = '';
        Array.from(input.files || []).slice(0, 5).forEach(function (file) {
          if (!file.type || file.type.indexOf('image/') !== 0) return;
          var reader = new FileReader();
          reader.onload = function (e) {
            var img = document.createElement('img');
            img.src = e.target.result;
            img.alt = file.name;
            wadah.appendChild(img);
          };
          reader.readAsDataURL(file);
        });
      }

      function validasiForm() {
        var nama = String((document.getElementById('ph-nama') || {}).value || '').trim();
        var tim = String((document.getElementById('ph-tim') || {}).value || '').trim();
        if (!nama || !tim) {
          alert('Nama barang dan tim produksi wajib diisi.');
          return false;
        }
        var valid = true;
        document.querySelectorAll('.item-select').forEach(function (select) {
          if (!select.value || !valid) return;
          var row = select.closest('.ph-cost-row');
          var harga = Number(row.querySelector('.harga-input').value) || 0;
          if (harga <= 0) {
            alert('Isi harga untuk rincian "' + select.value + '" dengan nilai lebih dari 0.');
            valid = false;
          }
        });
        return valid;
      }

      function bukaForm() {
        var form = document.getElementById('ph-form');
        if (form) form.reset();
        ['branding', 'packaging', 'packing'].forEach(function (grup) {
          var wadah = document.getElementById('rows-' + grup);
          if (wadah) wadah.innerHTML = '';
          tambahBiayaRow(grup);
        });
        var preview = document.getElementById('ph-preview-foto');
        if (preview) preview.innerHTML = '';
        segarOpsi();
        hitungLive();
        document.getElementById('view-form').classList.remove('hidden');
        document.getElementById('view-list').classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        initIcons();
      }

      function tutupForm() {
        document.getElementById('view-form').classList.add('hidden');
        document.getElementById('view-list').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function eksporCSV() {
        var data = dataTersaring();
        var kepala = ['Kode', 'Nama Barang', 'Tim Produksi', 'Qty', 'Satuan', 'Harga Produksi', 'Biaya Tambahan', 'Harga All-In', 'Total Harga', 'PIC', 'Waktu Produksi'];
        var baris = data.map(function (item) {
          return [
            item.kode, item.namaBarang, item.timProduksi, item.qty, item.satuan,
            item.hargaProduksi, item.totalBiayaTambahan, item.hargaAllIn, item.totalHarga,
            item.pic, item.jangkaWaktu
          ];
        });
        var isi = [kepala].concat(baris).map(function (row) {
          return row.map(function (sel) {
            return '"' + String(sel == null ? '' : sel).replace(/"/g, '""') + '"';
          }).join(',');
        }).join('\r\n');
        var blob = new Blob(['\ufeff' + isi], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'pengajuan-harga.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      }

      document.addEventListener('DOMContentLoaded', function () {
        isiOpsiTim();
        renderTabel();
        initIcons();
        if (PH_BERHASIL) tampilToast('Pengajuan harga berhasil disimpan.');
        if (PH_GAGAL) tampilToast('Gagal menyimpan pengajuan harga. Periksa kembali input Anda.', 'gagal');
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          tutupDetail();
          if (!document.getElementById('view-form').classList.contains('hidden')) tutupForm();
        }
      });
    </script>
  </body>
</html>
