<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle || 'Cetak Payment Request' %></title>
    <style>
      body {
        margin: 0;
      }
      .no-print {
        padding: 10px 14px;
        background: #f1f5f9;
        border-bottom: 1px solid #cbd5e1;
        margin-bottom: 14px;
        font-family: Arial, Helvetica, sans-serif;
      }
      .no-print button,
      .no-print a {
        font: inherit;
        padding: 6px 12px;
        margin-right: 8px;
        border: 1px solid #334155;
        border-radius: 6px;
        background: #fff;
        color: #0f172a;
        cursor: pointer;
        text-decoration: none;
      }
      @media print {
        .no-print {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="no-print">
      <button type="button" onclick="window.print()">Cetak / Simpan PDF</button>
      <a href="/payment-request/detail/<%= pengajuan._id %>">Kembali ke Detail</a>
    </div>

    <%- include('partials/payment-request-print-sheet', { dataCetak: dataCetak, pengajuan: pengajuan }) %>
  </body>
</html>
