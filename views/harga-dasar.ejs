<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin - Rincian Harga Sampel</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #333;
        display: flex;
        min-height: 100vh;
        position: relative;
        background-color: #f4f6f9;
      }

      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background:
          linear-gradient(
            to bottom,
            rgba(122, 27, 27, 0.85) 0%,
            rgba(122, 27, 27, 0.1) 40%,
            rgba(244, 246, 249, 0.88) 100%
          ),
          url('/images/background.jpg') no-repeat center top fixed;
        background-size: cover;
        z-index: -1;
        pointer-events: none;
      }

      /* Sidebar Styling */
      .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .sidebar-overlay.active {
        display: block;
        opacity: 1;
      }

      /* SIDEBAR */
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        height: 100vh;
        background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
        color: white;
        padding: 28px 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 1000;
        transform: translateX(-100%);
        transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25);
        overflow-y: auto;
      }
      .sidebar.active {
        transform: translateX(0);
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }
      .brand-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .brand-logo-img {
        width: 42px;
        height: 42px;
        object-fit: contain;
        background: rgba(255, 255, 255, 0.12);
        padding: 5px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      .brand-text h2 {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.3px;
        line-height: 1.2;
      }
      .brand-text span {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
      }
      .close-sidebar-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.2s;
      }
      .close-sidebar-btn:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .sidebar-user-card {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .user-avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
      }
      .sidebar-user-info h4 {
        font-size: 13px;
        font-weight: 600;
        color: white;
      }
      .sidebar-user-info span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: #86efac;
        font-weight: 500;
      }
      .sidebar-user-info span::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
      }

      .nav-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: rgba(255, 255, 255, 0.5);
        margin: 10px 0 10px 8px;
      }
      .nav-menu {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .nav-item a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        color: rgba(255, 255, 255, 0.82);
        text-decoration: none;
        border-radius: 10px;
        font-weight: 500;
        font-size: 13.5px;
        transition: all 0.2s ease;
      }
      .nav-item a svg {
        width: 18px;
        height: 18px;
        opacity: 0.8;
        transition: transform 0.2s;
      }
      .nav-item a:hover {
        background-color: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        transform: translateX(3px);
      }
      .nav-item a:hover svg {
        opacity: 1;
        transform: scale(1.1);
      }
      .nav-item.active a {
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%);
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        border-left: 3px solid #f87171;
      }
      .nav-item.active a svg {
        opacity: 1;
      }

      /* DROPDOWN SIDEBAR */
      .nav-item.dropdown {
        position: relative;
      }
      .dropdown-toggle {
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
      }
      .dropdown-toggle-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .dropdown-toggle .arrow {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 11px;
        opacity: 0.8;
      }
      .dropdown-menu {
        list-style: none;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: rgba(50, 10, 10, 0.45);
        border-radius: 10px;
        margin-top: 4px;
        padding-left: 10px;
        border: 1px solid rgba(255, 255, 255, 0.06);
      }
      .dropdown-menu li a {
        padding: 9px 14px;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.75);
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .dropdown-menu li a:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
      }
      .nav-item.dropdown.active .dropdown-menu {
        max-height: 200px;
        padding-top: 6px;
        padding-bottom: 6px;
      }
      .nav-item.dropdown.active .arrow {
        transform: rotate(180deg);
      }

      .sidebar-footer {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
      }
      .btn-bottom {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.2s;
      }
      .btn-bottom:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
      }

      /* MAIN CONTENT */
      .main-content {
        flex: 1;
        padding: 30px;
        width: 100%;
        overflow-x: auto;
      }
      .header-section h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #ffffff;
      }
      .header-section p {
        color: #ffffff;
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin: 25px 0;
      }
      .card {
        background: rgba(255, 255, 255, 0.95);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eef0f4;
        backdrop-filter: blur(5px);
        min-height: 120px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .card-title {
        font-size: 14px;
        color: #666;
        margin-bottom: 8px;
      }
      .card-value {
        font-size: 26px;
        font-weight: 700;
        color: #7a1b1b;
      }
      .card-value1 {
        font-size: 26px;
        font-weight: 700;
        color: #1fbc53;
      }

      /* TABLE STYLING */
      .table-container {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #eef0f4;
        backdrop-filter: blur(5px);
        overflow-x: auto;
      }
      .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }
      .table-header h2 {
        color: #7a1b1b;
        margin-right: auto;
      }
      .search-input {
        padding: 10px 14px;
        border: 1px solid #dde1e5;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        width: 260px;
        background: white;
      }
      .btn-add {
        background-color: #7a1b1b;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 1000px;
      }
      th,
      td {
        padding: 12px 14px;
        border-bottom: 1px solid #edf0f2;
        font-size: 13px;
        vertical-align: top;
      }
      th {
        background-color: #f8f9fa;
        color: #555;
      }

      .item-row {
        transition: background-color 0.2s ease;
      }
      .item-row:hover {
        background-color: #f8eded;
      }

      .col-keterangan {
        max-width: 150px;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      /* BADGES STATUS */
      .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
      }
      .badge-setuju {
        background-color: #e6f4ea;
        color: #137333;
      }
      .badge-pending {
        background-color: #fef7e0;
        color: #b06000;
      }
      .badge-tidak {
        background-color: #fce8e6;
        color: #c5221f;
      }

      .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .btn-edit {
        background-color: #000000;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-edit:hover {
        background-color: #333;
      }
      .btn-delete {
        background-color: #912d2d;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-delete:hover {
        background-color: #7a2222;
      }

      /* MODAL FORM */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 1000;
      }
      .modal-content {
        background: white;
        padding: 30px;
        border-radius: 12px;
        width: 450px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }
      .form-group {
        margin-bottom: 15px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
      }
      .form-group input,
      .form-group select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-family: inherit;
      }

      textarea.input-lg {
        width: 100%;
        min-height: 100px;
        padding: 10px;
        font-size: 13px;
        font-family: inherit;
        border: 1.5px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
        resize: vertical;
      }
      textarea.input-lg:focus {
        border-color: #7a1b1b;
        outline: none;
      }

      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
      }
      .btn-cancel {
        background: #e0e0e0;
        border: none;
        padding: 10px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
      }

      .toggle-btn {
        font-size: 20px;
        background: #ffffff;
        color: rgb(0, 0, 0);
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        margin-bottom: 20px;
      }

      /* ==========================================
   RESPONSIF MOBILE (Layar di bawah 768px)
   ========================================== */
      @media (max-width: 768px) {
        /* 1. Sesuaikan Padding Kontainer Utama */
        .header-container,
        .stats-grid,
        .main-box,
        .middle-grid {
          padding-left: 16px !important;
          padding-right: 16px !important;
          margin-left: 0 !important;
          margin-right: 0 !important;
        }

        /* 2. Kartu Statistik Menjadi 1 Kolom ke Bawah */
        .stats-grid,
        .middle-grid {
          grid-template-columns: 1fr !important; /* Bertumpuk vertikal */
          gap: 12px !important;
        }

        /* 3. Banner Salam / Top Header */
        .box-header,
        .actions-toolbar {
          flex-direction: column !important;
          align-items: stretch !important;
          gap: 10px !important;
        }

        .search-input {
          width: 100% !important; /* Input pencarian memenuhi layar */
        }

        /* 4. Tabel Agar Bisa Di-scroll Horizontal di HP */
        .main-box {
          overflow-x: auto !important; /* Mencegah tabel merusak lebar layar */
        }

        table {
          min-width: 600px; /* Menjaga ukuran isi tabel tetap terbaca */
        }

        /* 5. Ukuran Judul & Teks yang Lebih Pas di HP */
        h1 {
          font-size: 22px !important;
        }

        .stat-value {
          font-size: 22px !important;
        }
      }
    </style>
    <link rel="stylesheet" href="/css/stat-cards.css" />

  <style id="mobile-card-view">
    /* ============================================================
       TAMPILAN KARTU MOBILE — HANYA UNTUK LAYAR <= 768px
       Desktop/laptop tidak berubah.
       ============================================================ */
    @media (max-width: 768px) {
      .main-content {
        padding: 16px !important;
      }
      .main-box {
        padding: 16px !important;
        overflow: visible !important;
      }
      .table-responsive-container,
      .table-responsive-wrapper,
      .table-responsive {
        overflow: visible !important;
      }
      
      /* dasar kartu */
      #itemTable {
        min-width: 0 !important;
        width: 100% !important;
        border: 0 !important;
        background: transparent !important;
      }
      #itemTable thead {
        display: none !important;
      }
      #itemTable,
      #itemTable tbody {
        display: block !important;
        width: 100% !important;
      }
      #itemTable tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 3px 12px;
        align-items: center;
        margin: 0 0 10px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
      }
      #itemTable tbody td {
        display: block;
        padding: 0;
        border: 0 !important;
        background: transparent;
        font-size: 13px;
        line-height: 1.4;
        color: #475569;
        text-align: left !important;
        vertical-align: middle;
        white-space: normal;
      }
      #itemTable tbody td[colspan] {
        display: block !important;
        grid-column: 1 / -1 !important;
        grid-row: 1 / span 4 !important;
        padding: 18px 8px !important;
        text-align: center !important;
      }
      #itemTable tbody td .badge {
        font-size: 10.5px;
        padding: 4px 9px;
      }
      /* tombol aksi kompak */
      #itemTable tbody td .btn-detail,
      #itemTable tbody td .btn-edit,
      #itemTable tbody td .btn-delete,
      #itemTable tbody td .btn-action,
      #itemTable tbody td .btn-sub-action {
        margin: 0 !important;
        padding: 6px 10px !important;
        font-size: 11.5px !important;
        line-height: 1.2;
        border-radius: 6px;
        white-space: nowrap;
      }
      #itemTable tbody td form {
        margin: 0 !important;
        display: inline-flex !important;
      }
      
  
      
      #itemTable tbody tr {
        grid-template-areas:
          "code status"
          "title title"
          "price date"
          "actions actions";
      }
      #itemTable tbody td:nth-child(1) {
        grid-area: date;
        justify-self: end;
        font-size: 11px;
        color: #94a3b8;
      }
      #itemTable tbody td:nth-child(2) {
        grid-area: code;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: #94a3b8;
      }
      #itemTable tbody td:nth-child(3) {
        grid-area: title;
        font-size: 14.5px;
        font-weight: 700;
        color: #0f172a;
      }
      #itemTable tbody td:nth-child(9) {
        grid-area: price;
        font-size: 14px;
        font-weight: 800;
        color: #7a1b1b;
        white-space: nowrap;
      }
      #itemTable tbody td:nth-child(11) {
        grid-area: status;
        justify-self: end;
        align-self: start;
      }
      #itemTable tbody td:nth-child(12) {
        grid-area: actions;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        justify-content: flex-end;
      }
      #itemTable tbody td:nth-child(4),
      #itemTable tbody td:nth-child(5),
      #itemTable tbody td:nth-child(6),
      #itemTable tbody td:nth-child(7),
      #itemTable tbody td:nth-child(8),
      #itemTable tbody td:nth-child(10) {
        display: none;
      }
  
    }
  </style>

</head>
  <body>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

     <%- include('partials/sidebar-admin', { activePage: 'harga-dasar' }) %>

    <main class="main-content">
      <header class="header-section">
        <button class="toggle-btn" onclick="toggleSidebar()" title="Buka Sidebar">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <h1>Rincian Harga Sampel</h1>
        <p>Kelola kalkulasi harga barang dan material dasar.</p>
      </header>

      <%
  var _hargaItems = (typeof items !== 'undefined' && items) ? items : [];
  var _hargaReady = _hargaItems.filter(function (i) { return i.status === 'Ready'; }).length;
  var _hargaPending = _hargaItems.filter(function (i) { return i.status === 'Pending'; }).length;
%>
      <section class="card-grid">
        <div class="stat-card card-blue">
          <div class="card-header">
            <span class="card-title">Total Item Harga Sampel</span>
            <div class="icon-wrapper icon-blue">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalItem !== 'undefined' ? totalItem : 0 %></span>
            <span class="card-unit">Item</span>
          </div>
          <div class="card-footer">
            <span class="text-blue">Data Terbaru</span>
            <span>Harga Material</span>
          </div>
        </div>
        <div class="stat-card card-green">
          <div class="card-header">
            <span class="card-title">Status Ready</span>
            <div class="icon-wrapper icon-green">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof _hargaReady !== 'undefined' ? _hargaReady : 0 %></span>
            <span class="card-unit">Item</span>
          </div>
          <div class="card-footer">
            <span class="text-green">Siap Digunakan</span>
            <span>Status Valid</span>
          </div>
        </div>
        <div class="stat-card card-red">
          <div class="card-header">
            <span class="card-title">Status Pending</span>
            <div class="icon-wrapper icon-red">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof _hargaPending !== 'undefined' ? _hargaPending : 0 %></span>
            <span class="card-unit">Item</span>
          </div>
          <div class="card-footer">
            <span class="text-red">Menunggu Review</span>
            <span>Dalam Peninjauan</span>
          </div>
        </div>
      </section>

      <section class="table-container">
        <div class="table-header">
          <h2>Daftar Harga Barang</h2>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Cari barang..."
            onkeyup="filterItem()"
          />
          <button class="btn-add" onclick="openModal()">+ Tambah Harga Sampel</button>
          <a
            href="/export-harga-dasar-excel"
            style="
              padding: 10px 18px;
              background-color: #1d6f42;
              color: white;
              border-radius: 8px;
              text-decoration: none;
              font-weight: 600;
              font-size: 14px;
              display: inline-flex;
              align-items: center;
              gap: 8px;
              box-shadow: 0 4px 10px rgba(29, 111, 66, 0.2);
            "
          >
            <i class="fa-solid fa-file-excel"></i> Export Excel
          </a>
        </div>

        <table id="itemTable">
          <thead>
            <tr>
              <th>Tanggal</th>
              <th>ID Barang</th>
              <th>Nama Barang</th>
              <th>Merk</th>
              <th>Spesifikasi</th>
              <th>Qty</th>
              <th>Harga</th>
              <th>Harga Satuan</th>
              <th>Final Price</th>
              <th>Waktu Produksi</th>
              <th>Status</th>
              <th style="text-align: center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
            <tr>
              <td colspan="12" style="text-align: center; padding: 20px; color: #888">Belum ada data harga sampel.</td>
            </tr>
            <% } else { %>
            <% items.forEach(function(item) { %>
            <tr class="item-row">
              <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
              <td
                ><strong><%= item.idBarang %></strong></td
              >
              <td><%= item.namaBarang %></td>
              <td><%= item.namaMerk || '-' %></td>
              <td><%= item.spesifikasi || '-' %></td>
              <td><%= item.qty %></td>
              <td
                >Rp
                <%= Number(item.harga || 0).toLocaleString('id-ID') %></td
              >
              <td
                ><strong
                  >Rp
                  <%= Number(item.harga || 0).toLocaleString('id-ID') %></strong
                ></td
              >
              <td><strong style="color: #7a1b1b">Rp <%= Number(item.final || 0).toLocaleString('id-ID') %></strong></td>
              <td class="col-keterangan"><%= item.keterangan || '-' %></td>
              <td>
                <span
                  class="badge <%= item.status === 'Ready' ? 'badge-setuju' : (item.status === 'Pending' ? 'badge-pending' : 'badge-tidak') %>"
                >
                  <%= item.status || 'Pending' %>
                </span>
              </td>
              <td style="text-align: center">
                <div class="action-buttons">
                  <!-- TOMBOL DETAIL DITAMBAHKAN DI SINI -->
                  <a
                    href="/harga-dasar/detail/<%= item._id %>"
                    style="
                      padding: 6px 12px;
                      background-color: #007bff;
                      color: white;
                      border-radius: 6px;
                      text-decoration: none;
                      font-size: 13px;
                      display: inline-flex;
                      align-items: center;
                    "
                    >Detail</a
                  >

                  <button
                    type="button"
                    class="btn-edit"
                    data-id="<%= item._id %>"
                    data-tanggal="<%= item.tanggal ? item.tanggal.toISOString().split('T')[0] : '' %>"
                    data-idbarang="<%= item.idBarang %>"
                    data-namabarang="<%= item.namaBarang %>"
                    data-namamerk="<%= item.namaMerk || '' %>"
                    data-spesifikasi="<%= item.spesifikasi || '' %>"
                    data-qty="<%= item.qty %>"
                    data-harga="<%= item.harga %>"
                    data-final="<%= item.final || 0 %>"
                    data-keterangan="<%= item.keterangan || '' %>"
                    data-status="<%= item.status %>"
                    onclick="openEditModalFromBtn(this)"
                    >Edit</button
                  >

                  <form
                    action="/harga-dasar/delete/<%= item._id %>"
                    method="POST"
                    style="margin: 0"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus item <%= item.namaBarang %>?');"
                  >
                    <button type="submit" class="btn-delete">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </section>
    </main>

    <!-- MODAL TAMBAH HARGA DASAR -->
    <div class="modal" id="itemModal">
      <div class="modal-content">
        <h3 style="margin-bottom: 15px; color: #7a1b1b">Tambah Harga Sampel Baru</h3>

        <!-- TAMBAHKAN enctype DI SINI -->
        <form action="/harga-dasar/add" method="POST" enctype="multipart/form-data">
          <div class="form-group"><label>Tanggal</label><input type="date" name="tanggal" required /></div>
          <div class="form-group"
            ><label>ID Barang</label><input type="text" name="idBarang" placeholder="BRG-008" required
          /></div>
          <div class="form-group"
            ><label>Nama Barang</label><input type="text" name="namaBarang" placeholder="Masukan Nama Barang" required
          /></div>
          <div class="form-group"
            ><label>Merk</label><input type="text" name="namaMerk" placeholder="Nama Merk" required
          /></div>
          <div class="form-group"
            ><label>Spesifikasi</label><input type="text" name="spesifikasi" placeholder="Ukuran / Bahan"
          /></div>
          <div class="form-group"><label>Qty</label><input type="number" name="qty" value="1" min="1" required /></div>
          <div class="form-group"
            ><label>Harga (Satuan Dasar)</label><input type="number" name="harga" placeholder="0" required
          /></div>
          <div class="form-group"
            ><label>Final Price</label><input type="number" name="final" placeholder="0" required
          /></div>
          <div class="form-group"
            ><label>Waktu Produksi</label
            ><textarea name="keterangan" class="input-lg" placeholder="Catatan tambahan..."></textarea>
          </div>
          <div class="form-group">
            <label>Status</label>
            <select name="status">
              <option value="Ready">Ready</option>
              <option value="Pending" selected>Pending</option>
              <option value="Tidak Ready">Tidak Ready</option>
            </select>
          </div>
          <div class="form-group">
            <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
            <input type="file" name="foto" accept="image/*" multiple />
          </div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
            <button type="submit" class="btn-add">Simpan</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL EDIT HARGA DASAR -->
    <div class="modal" id="editItemModal">
      <div class="modal-content">
        <h3 style="margin-bottom: 15px; color: #7a1b1b">Edit Harga Sampel</h3>

        <!-- TAMBAHKAN enctype DI SINI DAN ACTION SESUAIKAN DENGAN ROUTE EDIT -->
        <form id="editForm" action="" method="POST" enctype="multipart/form-data">
          <div class="form-group"
            ><label>Tanggal</label><input type="date" id="editTanggal" name="tanggal" required
          /></div>
          <div class="form-group"
            ><label>ID Barang</label
            ><input type="text" id="editIdBarang" name="idBarang" placeholder="BRG-008" required
          /></div>
          <div class="form-group"
            ><label>Nama Barang</label><input type="text" id="editNamaBarang" name="namaBarang" required
          /></div>
          <div class="form-group"
            ><label>Merk</label><input type="text" id="editNamaMerk" name="namaMerk" required
          /></div>
          <div class="form-group"
            ><label>Spesifikasi</label><input type="text" id="editSpesifikasi" name="spesifikasi"
          /></div>
          <div class="form-group"
            ><label>Qty</label><input type="number" id="editQty" name="qty" min="1" required
          /></div>
          <div class="form-group"
            ><label>Harga (Satuan Dasar)</label><input type="number" id="editHarga" name="harga" required
          /></div>
          <div class="form-group"
            ><label>Final Price</label><input type="number" id="editFinal" name="final" required
          /></div>
          <div class="form-group"
            ><label>Waktu Produksi</label><textarea id="editKeterangan" name="keterangan" class="input-lg"></textarea>
          </div>
          <div class="form-group">
            <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
            <input type="file" name="foto" accept="image/*" multiple />
          </div>
          <div class="form-group">
            <label>Status</label>
            <select id="editStatus" name="status">
              <option value="Ready">Ready</option>
              <option value="Pending">Pending</option>
              <option value="Not Ready">Not Ready</option>
            </select>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeEditModal()">Batal</button>
            <button type="submit" class="btn-add">Simpan Perubahan</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function openModal() {
        document.getElementById('itemModal').style.display = 'flex';
      }
      function closeModal() {
        document.getElementById('itemModal').style.display = 'none';
      }

      function openEditModalFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const tanggal = btn.getAttribute('data-tanggal');
        const idBarang = btn.getAttribute('data-idbarang');
        const namaBarang = btn.getAttribute('data-namabarang');
        const namaMerk = btn.getAttribute('data-namamerk');
        const spesifikasi = btn.getAttribute('data-spesifikasi');
        const qty = btn.getAttribute('data-qty');
        const harga = btn.getAttribute('data-harga');
        const final = btn.getAttribute('data-final');
        const keterangan = btn.getAttribute('data-keterangan');
        const status = btn.getAttribute('data-status');

        document.getElementById('editForm').action = '/harga-dasar/edit/' + id;
        document.getElementById('editTanggal').value = tanggal || '';
        document.getElementById('editIdBarang').value = idBarang;
        document.getElementById('editNamaBarang').value = namaBarang;
        document.getElementById('editNamaMerk').value = namaMerk || '';
        document.getElementById('editSpesifikasi').value = spesifikasi || '';
        document.getElementById('editQty').value = qty;
        document.getElementById('editHarga').value = harga;
        document.getElementById('editFinal').value = final || 0;
        document.getElementById('editKeterangan').value = keterangan || '';
        document.getElementById('editStatus').value = status || 'Pending';
        document.getElementById('editItemModal').style.display = 'flex';
      }

      function closeEditModal() {
        document.getElementById('editItemModal').style.display = 'none';
      }

      function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('sidebarOverlay').classList.toggle('active');
      }

      function filterItem() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.getElementsByClassName('item-row');
        for (let row of rows) {
          const text = row.textContent.toLowerCase();
          row.style.display = text.includes(input) ? '' : 'none';
        }
      }

      function toggleDropdown(element) {
        const parentLi = element.parentElement;
        parentLi.classList.toggle('active');
      }
    </script>
  </body>
</html>
