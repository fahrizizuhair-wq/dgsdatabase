<!DOCTYPE html>
<html lang="id">
  <head>
    <%- include('partials/head') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin - Rincian Harga Sampel</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #333;
        display: flex;
        min-height: 100vh;
        position: relative;
        background-color: #f4f6f9;
      }

      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background:
          linear-gradient(
            to bottom,
            rgba(122, 27, 27, 0.85) 0%,
            rgba(122, 27, 27, 0.1) 40%,
            rgba(244, 246, 249, 0.88) 100%
          ),
          url('/images/background.jpg') no-repeat center top fixed;
        background-size: cover;
        z-index: -1;
        pointer-events: none;
      }

      /* Sidebar Styling */
      .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 999;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .sidebar-overlay.active {
        display: block;
        opacity: 1;
      }

      .toggle-btn {
        font-size: 20px;
        background: #ffffff;
        color: rgb(0, 0, 0);
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        margin-bottom: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      }

      /* MAIN CONTENT */
      .main-content {
        flex: 1;
        padding: 30px;
        width: 100%;
        overflow-x: auto;
      }
      .header-section {
        margin-bottom: 22px;
      }
      .header-section h1 {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 6px;
        color: #ffffff;
      }
      .header-section p {
        color: #ffffff;
        font-size: 14px;
        opacity: 0.95;
      }

      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #7a1b1b;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        transition: all 0.2s ease;
        margin-bottom: 16px;
      }
      .btn-back:hover {
        background: #fff5f5;
        transform: translateX(-3px);
      }

      .project-info-banner {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #e2e8f0;
        border-left: 5px solid #7a1b1b;
        border-radius: 12px;
        padding: 18px 22px;
        margin-bottom: 24px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      }
      .project-info-title h2 {
        font-size: 19px;
        font-weight: 800;
        color: #0f172a;
      }
      .project-info-title p {
        font-size: 12px;
        color: #64748b;
        margin-top: 3px;
      }
      .project-info-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }
      .project-chip {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 7px 13px;
        border-radius: 8px;
        font-size: 12px;
        color: #475569;
      }
      .project-chip strong {
        color: #7a1b1b;
        margin-left: 5px;
      }

      /* PROJECT FORM CARD */
      .project-form-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid #eef0f4;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 26px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.06);
      }
      .project-form-card h2 {
        font-size: 18px;
        font-weight: 800;
        color: #7a1b1b;
        margin-bottom: 4px;
      }
      .project-form-card p {
        font-size: 12.5px;
        color: #64748b;
        margin-bottom: 18px;
      }
      .project-form-grid {
        display: grid;
        grid-template-columns: 2fr 1.3fr 1.3fr auto;
        gap: 14px;
        align-items: flex-end;
      }
      .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .form-field label {
        font-size: 12.5px;
        font-weight: 700;
        color: #334155;
      }
      .form-field input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13.5px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
        background: #ffffff;
      }
      .form-field input:focus {
        border-color: #7a1b1b;
      }
      .btn-submit-project {
        background: #7a1b1b;
        color: white;
        border: none;
        padding: 11px 22px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13.5px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s;
        white-space: nowrap;
        height: 42px;
      }
      .btn-submit-project:hover {
        background: #5c1414;
      }

      /* PROJECT CARDS GRID */
      .project-cards-section {
        margin-top: 10px;
      }
      .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
      }
      .section-heading h2 {
        font-size: 18px;
        font-weight: 800;
        color: #ffffff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
      }
      .section-heading span {
        background: rgba(255,255,255,0.25);
        color: #ffffff;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
      }
      .project-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }
      .project-box-card {
        background: rgba(255, 255, 255, 0.98);
        border: 1px solid #e2e8f0;
        border-top: 5px solid #7a1b1b;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .project-box-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.12);
      }
      .project-box-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }
      .project-box-title {
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.35;
      }
      .project-box-body {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-bottom: 16px;
        padding: 13px 15px;
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
      }
      .project-box-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12.5px;
      }
      .project-box-row span {
        color: #64748b;
      }
      .project-box-row strong {
        color: #1e293b;
        font-weight: 700;
      }
      .project-box-row.kasbon-row {
        border-top: 1px dashed #cbd5e1;
        padding-top: 9px;
        margin-top: 3px;
      }
      .project-box-row.kasbon-row strong {
        color: #7a1b1b;
        font-size: 15px;
        font-weight: 800;
      }
      .project-box-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .btn-open-project {
        flex: 1;
        background: #7a1b1b;
        color: white;
        text-align: center;
        padding: 9px 14px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        font-size: 13px;
        transition: background 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .btn-open-project:hover {
        background: #5c1414;
      }
      .btn-project-edit {
        background: #e2e8f0;
        color: #334155;
        border: none;
        padding: 9px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-project-edit:hover {
        background: #cbd5e1;
      }
      .btn-project-delete {
        background: #fee2e2;
        color: #991b1b;
        border: none;
        padding: 9px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
      }
      .btn-project-delete:hover {
        background: #fecaca;
      }
      .project-empty-state {
        background: rgba(255,255,255,0.95);
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        color: #64748b;
        font-size: 14px;
        border: 1px dashed #cbd5e1;
      }

      /* TABLE STYLING */
      .table-container {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #eef0f4;
        backdrop-filter: blur(5px);
        overflow-x: auto;
      }
      .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }
      .table-header h2 {
        color: #7a1b1b;
        margin-right: auto;
      }
      .search-input {
        padding: 10px 14px;
        border: 1px solid #dde1e5;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        width: 260px;
        background: white;
      }
      .btn-add {
        background-color: #7a1b1b;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13.5px;
      }
      .btn-add:hover {
        background-color: #5c1414;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        min-width: 950px;
      }
      th,
      td {
        padding: 12px 14px;
        border-bottom: 1px solid #edf0f2;
        font-size: 13px;
        vertical-align: top;
      }
      th {
        background-color: #f8f9fa;
        color: #555;
        font-weight: 700;
      }

      .item-row {
        transition: background-color 0.2s ease;
      }
      .item-row:hover {
        background-color: #f8eded;
      }

      .col-keterangan {
        max-width: 180px;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
      .btn-edit {
        background-color: #000000;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-edit:hover {
        background-color: #333;
      }
      .btn-delete {
        background-color: #912d2d;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-delete:hover {
        background-color: #7a2222;
      }

      /* MODAL FORM */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 1000;
      }
      .modal-content {
        background: white;
        padding: 30px;
        border-radius: 12px;
        width: 480px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }
      .form-group {
        margin-bottom: 15px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
      }
      .form-group input,
      .form-group select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-family: inherit;
      }
      .form-group input[readonly] {
        background: #f1f5f9;
        color: #7a1b1b;
        font-weight: 700;
      }

      textarea.input-lg {
        width: 100%;
        min-height: 90px;
        padding: 10px;
        font-size: 13px;
        font-family: inherit;
        border: 1.5px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
        resize: vertical;
      }
      textarea.input-lg:focus {
        border-color: #7a1b1b;
        outline: none;
      }

      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
      }
      .btn-cancel {
        background: #e0e0e0;
        border: none;
        padding: 10px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
      }

      /* RESPONSIF */
      @media (max-width: 900px) {
        .project-form-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 768px) {
        .main-content {
          padding: 16px !important;
        }
        .table-container {
          padding: 16px !important;
          overflow: visible !important;
        }
        #itemTable {
          min-width: 0 !important;
          width: 100% !important;
          border: 0 !important;
          background: transparent !important;
        }
        #itemTable thead {
          display: none !important;
        }
        #itemTable,
        #itemTable tbody {
          display: block !important;
          width: 100% !important;
        }
        #itemTable tbody tr {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          grid-template-areas:
            "code date"
            "title title"
            "price price"
            "actions actions";
          gap: 4px 12px;
          align-items: center;
          margin: 0 0 10px;
          padding: 12px 14px;
          background: #ffffff;
          border: 1px solid #e5e7eb;
          border-radius: 12px;
          box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
        }
        #itemTable tbody td {
          display: block;
          padding: 0;
          border: 0 !important;
          background: transparent;
          font-size: 13px;
          line-height: 1.4;
          color: #475569;
          text-align: left !important;
        }
        #itemTable tbody td[colspan] {
          display: block !important;
          grid-column: 1 / -1 !important;
          padding: 18px 8px !important;
          text-align: center !important;
        }
        #itemTable tbody td:nth-child(1) {
          grid-area: date;
          justify-self: end;
          font-size: 11px;
          color: #94a3b8;
        }
        #itemTable tbody td:nth-child(2) {
          grid-area: code;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.3px;
          color: #94a3b8;
        }
        #itemTable tbody td:nth-child(3) {
          grid-area: title;
          font-size: 14.5px;
          font-weight: 700;
          color: #0f172a;
        }
        #itemTable tbody td:nth-child(8) {
          grid-area: price;
          font-size: 14px;
          font-weight: 800;
          color: #7a1b1b;
          white-space: nowrap;
        }
        #itemTable tbody td:nth-child(10) {
          grid-area: actions;
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          align-items: center;
          justify-content: flex-end;
          margin-top: 6px;
        }
        #itemTable tbody td:nth-child(4),
        #itemTable tbody td:nth-child(5),
        #itemTable tbody td:nth-child(6),
        #itemTable tbody td:nth-child(7),
        #itemTable tbody td:nth-child(9) {
          display: none;
        }
      }
    </style>
    <link rel="stylesheet" href="/css/stat-cards.css" />
  </head>
  <body>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <%- include('partials/sidebar-admin', { activePage: 'harga-dasar' }) %>

    <main class="main-content">
      <header class="header-section">
        <button class="toggle-btn" onclick="toggleSidebar()" title="Buka Sidebar">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <% if (!projectAktif) { %>
        <h1>Rincian Harga Sampel &bull; Project</h1>
        <p>Pilih project untuk melihat rincian harga sampel atau tambahkan project baru.</p>
        <% } else { %>
        <a href="/harga-dasar" class="btn-back">
          <i class="fa-solid fa-arrow-left"></i> &larr; Kembali ke Daftar Project
        </a>
        <h1><%= projectAktif.namaProject %></h1>
        <p>Kelola daftar item sampel, harga satuan, dan kalkulasi total harga untuk project ini.</p>
        <% } %>
      </header>

      <% if (!projectAktif) { %>
      <!-- ============================================================
           MODE 1: LANDING VIEW (DAFTAR PROJECT)
           ============================================================ -->

      <!-- KARTU STATISTIK PROJECT -->
      <section class="card-grid">
        <div class="stat-card card-blue">
          <div class="card-header">
            <span class="card-title">Total Project</span>
            <div class="icon-wrapper icon-blue">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalProject !== 'undefined' ? totalProject : 0 %></span>
            <span class="card-unit">Project</span>
          </div>
          <div class="card-footer">
            <span class="text-blue">Terdaftar</span>
            <span>Project Sampel</span>
          </div>
        </div>

        <div class="stat-card card-green">
          <div class="card-header">
            <span class="card-title">Total Qty</span>
            <div class="icon-wrapper icon-green">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalQtyAll !== 'undefined' ? totalQtyAll : 0 %></span>
            <span class="card-unit">Qty</span>
          </div>
          <div class="card-footer">
            <span class="text-green">Seluruh Project</span>
            <span>Item Sampel</span>
          </div>
        </div>

        <div class="stat-card card-red">
          <div class="card-header">
            <span class="card-title">Estimasi Total Kasbon</span>
            <div class="icon-wrapper icon-red">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value">Rp <%= Number(typeof estimasiTotalKasbonAll !== 'undefined' ? estimasiTotalKasbonAll : 0).toLocaleString('id-ID') %></span>
          </div>
          <div class="card-footer">
            <span class="text-red">Akumulasi Kasbon</span>
            <span>Total Sampel + Opr + Trf</span>
          </div>
        </div>
      </section>

      <!-- FORM TAMBAH PROJECT BARU -->
      <section class="project-form-card">
        <h2><i class="fa-solid fa-folder-plus"></i> Tambah Project Baru</h2>
        <p>Input nama project beserta biaya operasional dan biaya transfer beda bank untuk memulai penginputan data sampel.</p>
        <form action="/harga-dasar/project/add" method="POST">
          <div class="project-form-grid">
            <div class="form-field">
              <label for="inputNamaProject">Nama Project *</label>
              <input
                type="text"
                id="inputNamaProject"
                name="namaProject"
                placeholder="Contoh: Merchandise Own Channel 2026"
                required
              />
            </div>
            <div class="form-field">
              <label for="inputBiayaOperasional">Biaya Operasional (Rp)</label>
              <input
                type="number"
                id="inputBiayaOperasional"
                name="biayaOperasional"
                min="0"
                value="0"
                placeholder="0"
                required
              />
            </div>
            <div class="form-field">
              <label for="inputBiayaTransfer">Biaya Transfer Beda Bank (Rp)</label>
              <input
                type="number"
                id="inputBiayaTransfer"
                name="biayaTransferBedaBank"
                min="0"
                value="0"
                placeholder="0"
                required
              />
            </div>
            <button type="submit" class="btn-submit-project">
              <i class="fa-solid fa-plus"></i> Simpan Project
            </button>
          </div>
        </form>
      </section>

      <!-- DAFTAR CARD PROJECT -->
      <section class="project-cards-section">
        <div class="section-heading">
          <h2>Daftar Project Harga Sampel</h2>
          <span><%= projects ? projects.length : 0 %> Project</span>
        </div>

        <% if (!projects || projects.length === 0) { %>
        <div class="project-empty-state">
          <i class="fa-regular fa-folder-open" style="font-size: 32px; margin-bottom: 10px; color: #94a3b8; display: block;"></i>
          Belum ada project harga sampel. Silakan tambahkan project baru melalui form di atas.
        </div>
        <% } else { %>
        <div class="project-card-grid">
          <% projects.forEach(function(p) { %>
          <div class="project-box-card">
            <div>
              <div class="project-box-header">
                <div class="project-box-title"><%= p.namaProject %></div>
                <div class="project-box-badge"><%= p.totalItem || 0 %> Item</div>
              </div>
              <div class="project-box-body">
                <div class="project-box-row">
                  <span>Biaya Operasional:</span>
                  <strong>Rp <%= Number(p.biayaOperasional || 0).toLocaleString('id-ID') %></strong>
                </div>
                <div class="project-box-row">
                  <span>Biaya Trf Beda Bank:</span>
                  <strong>Rp <%= Number(p.biayaTransferBedaBank || 0).toLocaleString('id-ID') %></strong>
                </div>
                <div class="project-box-row">
                  <span>Total Qty Item:</span>
                  <strong><%= p.totalQty || 0 %> Qty</strong>
                </div>
                <div class="project-box-row kasbon-row">
                  <span>Estimasi Kasbon:</span>
                  <strong>Rp <%= Number(p.estimasiTotalKasbon || 0).toLocaleString('id-ID') %></strong>
                </div>
              </div>
            </div>
            <div class="project-box-actions">
              <a href="/harga-dasar/project/<%= p._id %>" class="btn-open-project">
                Buka Project <i class="fa-solid fa-arrow-right"></i>
              </a>
              <button
                type="button"
                class="btn-project-edit"
                data-id="<%= p._id %>"
                data-nama="<%= p.namaProject %>"
                data-opr="<%= p.biayaOperasional || 0 %>"
                data-trf="<%= p.biayaTransferBedaBank || 0 %>"
                onclick="openEditProjectModal(this)"
                title="Edit Project"
              >
                <i class="fa-solid fa-pen"></i>
              </button>
              <form
                action="/harga-dasar/project/delete/<%= p._id %>"
                method="POST"
                style="margin: 0"
                onsubmit="return confirm('Hapus project <%= p.namaProject %> beserta seluruh data item sampel di dalamnya?');"
              >
                <button type="submit" class="btn-project-delete" title="Hapus Project">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>

      <!-- MODAL EDIT PROJECT -->
      <div class="modal" id="editProjectModal">
        <div class="modal-content">
          <h3 style="margin-bottom: 15px; color: #7a1b1b">Edit Project</h3>
          <form id="editProjectForm" action="" method="POST">
            <div class="form-group">
              <label>Nama Project *</label>
              <input type="text" id="editNamaProject" name="namaProject" required />
            </div>
            <div class="form-group">
              <label>Biaya Operasional (Rp)</label>
              <input type="number" id="editBiayaOperasional" name="biayaOperasional" min="0" required />
            </div>
            <div class="form-group">
              <label>Biaya Transfer Beda Bank (Rp)</label>
              <input type="number" id="editBiayaTransfer" name="biayaTransferBedaBank" min="0" required />
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-cancel" onclick="closeEditProjectModal()">Batal</button>
              <button type="submit" class="btn-add">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>

      <% } else { %>
      <!-- ============================================================
           MODE 2: PROJECT VIEW (DATA TABEL ITEM SAMPEL)
           ============================================================ -->

      <!-- BANNER DETAIL BIAYA PROJECT -->
      <div class="project-info-banner">
        <div class="project-info-title">
          <h2><%= projectAktif.namaProject %></h2>
          <p>Estimasi Total Kasbon = Seluruh Total Harga Sampel + Biaya Operasional + Biaya Transfer Beda Bank</p>
        </div>
        <div class="project-info-chips">
          <div class="project-chip">
            Biaya Operasional: <strong>Rp <%= Number(projectAktif.biayaOperasional || 0).toLocaleString('id-ID') %></strong>
          </div>
          <div class="project-chip">
            Biaya Transfer: <strong>Rp <%= Number(projectAktif.biayaTransferBedaBank || 0).toLocaleString('id-ID') %></strong>
          </div>
        </div>
      </div>

      <!-- KARTU STATISTIK PROJECT AKTIF -->
      <section class="card-grid">
        <div class="stat-card card-blue">
          <div class="card-header">
            <span class="card-title">Total Item Sampel</span>
            <div class="icon-wrapper icon-blue">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalItem !== 'undefined' ? totalItem : 0 %></span>
            <span class="card-unit">Item</span>
          </div>
          <div class="card-footer">
            <span class="text-blue">Data Sampel</span>
            <span>Project Ini</span>
          </div>
        </div>

        <div class="stat-card card-green">
          <div class="card-header">
            <span class="card-title">Total Qty</span>
            <div class="icon-wrapper icon-green">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value"><%= typeof totalQty !== 'undefined' ? totalQty : 0 %></span>
            <span class="card-unit">Qty</span>
          </div>
          <div class="card-footer">
            <span class="text-green">Akumulasi Qty</span>
            <span>Tabel Sampel</span>
          </div>
        </div>

        <div class="stat-card card-red">
          <div class="card-header">
            <span class="card-title">Estimasi Total Kasbon</span>
            <div class="icon-wrapper icon-red">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
          </div>
          <div class="card-body">
            <span class="card-value">Rp <%= Number(typeof estimasiTotalKasbon !== 'undefined' ? estimasiTotalKasbon : 0).toLocaleString('id-ID') %></span>
          </div>
          <div class="card-footer">
            <span class="text-red">Total Sampel + Opr + Trf</span>
            <span>Project Ini</span>
          </div>
        </div>
      </section>

      <!-- TABEL DATA ITEM SAMPEL -->
      <section class="table-container">
        <div class="table-header">
          <h2>Daftar Harga Sampel</h2>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Cari barang..."
            onkeyup="filterItem()"
          />
          <button class="btn-add" onclick="openModal()">+ Tambah Harga Sampel</button>
          <a
            href="/export-harga-dasar-excel?projectId=<%= projectAktif._id %>"
            style="
              padding: 10px 18px;
              background-color: #1d6f42;
              color: white;
              border-radius: 8px;
              text-decoration: none;
              font-weight: 600;
              font-size: 14px;
              display: inline-flex;
              align-items: center;
              gap: 8px;
              box-shadow: 0 4px 10px rgba(29, 111, 66, 0.2);
            "
          >
            <i class="fa-solid fa-file-excel"></i> Export Excel
          </a>
        </div>

        <table id="itemTable">
          <thead>
            <tr>
              <th>Tanggal</th>
              <th>ID Barang</th>
              <th>Nama Barang</th>
              <th>Merk</th>
              <th>Spesifikasi</th>
              <th>Qty</th>
              <th>Harga Satuan</th>
              <th>Total Harga</th>
              <th>Waktu Produksi</th>
              <th style="text-align: center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
            <tr>
              <td colspan="10" style="text-align: center; padding: 25px; color: #888">
                Belum ada data harga sampel pada project ini. Klik "+ Tambah Harga Sampel" di atas.
              </td>
            </tr>
            <% } else { %>
            <% items.forEach(function(item) { %>
            <tr class="item-row">
              <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
              <td><strong><%= item.idBarang %></strong></td>
              <td><%= item.namaBarang %></td>
              <td><%= item.namaMerk || '-' %></td>
              <td><%= item.spesifikasi || '-' %></td>
              <td><%= item.qty %></td>
              <td>Rp <%= Number(item.harga || 0).toLocaleString('id-ID') %></td>
              <td><strong style="color: #7a1b1b">Rp <%= Number(item.final || (item.qty * item.harga) || 0).toLocaleString('id-ID') %></strong></td>
              <td class="col-keterangan"><%= item.keterangan || '-' %></td>
              <td style="text-align: center">
                <div class="action-buttons">
                  <a
                    href="/harga-dasar/detail/<%= item._id %>"
                    style="
                      padding: 6px 12px;
                      background-color: #007bff;
                      color: white;
                      border-radius: 6px;
                      text-decoration: none;
                      font-size: 12px;
                      font-weight: 600;
                      display: inline-flex;
                      align-items: center;
                    "
                  >Detail</a>

                  <button
                    type="button"
                    class="btn-edit"
                    data-id="<%= item._id %>"
                    data-tanggal="<%= item.tanggal ? item.tanggal.toISOString().split('T')[0] : '' %>"
                    data-idbarang="<%= item.idBarang %>"
                    data-namabarang="<%= item.namaBarang %>"
                    data-namamerk="<%= item.namaMerk || '' %>"
                    data-spesifikasi="<%= item.spesifikasi || '' %>"
                    data-qty="<%= item.qty %>"
                    data-harga="<%= item.harga %>"
                    data-final="<%= item.final || (item.qty * item.harga) || 0 %>"
                    data-keterangan="<%= item.keterangan || '' %>"
                    onclick="openEditModalFromBtn(this)"
                  >Edit</button>

                  <form
                    action="/harga-dasar/delete/<%= item._id %>"
                    method="POST"
                    style="margin: 0"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus item <%= item.namaBarang %>?');"
                  >
                    <button type="submit" class="btn-delete">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </section>

      <!-- MODAL TAMBAH HARGA SAMPEL -->
      <div class="modal" id="itemModal">
        <div class="modal-content">
          <h3 style="margin-bottom: 15px; color: #7a1b1b">Tambah Harga Sampel Baru</h3>
          <form action="/harga-dasar/add" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="projectId" value="<%= projectAktif._id %>" />
            <div class="form-group"><label>Tanggal</label><input type="date" name="tanggal" required /></div>
            <div class="form-group"><label>ID Barang</label><input type="text" name="idBarang" placeholder="BRG-001" required /></div>
            <div class="form-group"><label>Nama Barang</label><input type="text" name="namaBarang" placeholder="Masukan Nama Barang" required /></div>
            <div class="form-group"><label>Merk</label><input type="text" name="namaMerk" placeholder="Nama Merk" required /></div>
            <div class="form-group"><label>Spesifikasi</label><input type="text" name="spesifikasi" placeholder="Ukuran / Bahan" /></div>
            <div class="form-group">
              <label>Qty</label>
              <input type="number" id="addQty" name="qty" value="1" min="1" required oninput="hitungAddTotal()" />
            </div>
            <div class="form-group">
              <label>Harga Satuan (Rp)</label>
              <input type="number" id="addHarga" name="harga" placeholder="0" min="0" required oninput="hitungAddTotal()" />
            </div>
            <div class="form-group">
              <label>Total Harga (Otomatis: Qty &times; Harga Satuan)</label>
              <input type="number" id="addFinal" name="final" placeholder="0" readonly />
            </div>
            <div class="form-group">
              <label>Waktu Produksi / Keterangan</label>
              <textarea name="keterangan" class="input-lg" placeholder="Catatan waktu produksi atau keterangan tambahan..."></textarea>
            </div>
            <div class="form-group">
              <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
              <input type="file" name="foto" accept="image/*" multiple />
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
              <button type="submit" class="btn-add">Simpan</button>
            </div>
          </form>
        </div>
      </div>

      <!-- MODAL EDIT HARGA SAMPEL -->
      <div class="modal" id="editItemModal">
        <div class="modal-content">
          <h3 style="margin-bottom: 15px; color: #7a1b1b">Edit Harga Sampel</h3>
          <form id="editForm" action="" method="POST" enctype="multipart/form-data">
            <div class="form-group"><label>Tanggal</label><input type="date" id="editTanggal" name="tanggal" required /></div>
            <div class="form-group"><label>ID Barang</label><input type="text" id="editIdBarang" name="idBarang" required /></div>
            <div class="form-group"><label>Nama Barang</label><input type="text" id="editNamaBarang" name="namaBarang" required /></div>
            <div class="form-group"><label>Merk</label><input type="text" id="editNamaMerk" name="namaMerk" required /></div>
            <div class="form-group"><label>Spesifikasi</label><input type="text" id="editSpesifikasi" name="spesifikasi" /></div>
            <div class="form-group">
              <label>Qty</label>
              <input type="number" id="editQty" name="qty" min="1" required oninput="hitungEditTotal()" />
            </div>
            <div class="form-group">
              <label>Harga Satuan (Rp)</label>
              <input type="number" id="editHarga" name="harga" min="0" required oninput="hitungEditTotal()" />
            </div>
            <div class="form-group">
              <label>Total Harga (Otomatis: Qty &times; Harga Satuan)</label>
              <input type="number" id="editFinal" name="final" readonly />
            </div>
            <div class="form-group">
              <label>Waktu Produksi / Keterangan</label>
              <textarea id="editKeterangan" name="keterangan" class="input-lg"></textarea>
            </div>
            <div class="form-group">
              <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
              <input type="file" name="foto" accept="image/*" multiple />
            </div>
            <div class="modal-actions">
              <button type="button" class="btn-cancel" onclick="closeEditModal()">Batal</button>
              <button type="submit" class="btn-add">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>
      <% } %>
    </main>

    <script>
      function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('active');
        document.getElementById('sidebarOverlay').classList.toggle('active');
      }

      function filterItem() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.getElementsByClassName('item-row');
        for (let row of rows) {
          const text = row.textContent.toLowerCase();
          row.style.display = text.includes(input) ? '' : 'none';
        }
      }

      function hitungAddTotal() {
        const qty = parseFloat(document.getElementById('addQty').value) || 0;
        const harga = parseFloat(document.getElementById('addHarga').value) || 0;
        document.getElementById('addFinal').value = Math.round(qty * harga);
      }

      function hitungEditTotal() {
        const qty = parseFloat(document.getElementById('editQty').value) || 0;
        const harga = parseFloat(document.getElementById('editHarga').value) || 0;
        document.getElementById('editFinal').value = Math.round(qty * harga);
      }

      function openModal() {
        document.getElementById('itemModal').style.display = 'flex';
        hitungAddTotal();
      }
      function closeModal() {
        document.getElementById('itemModal').style.display = 'none';
      }

      function openEditModalFromBtn(btn) {
        const id = btn.getAttribute('data-id');
        const tanggal = btn.getAttribute('data-tanggal');
        const idBarang = btn.getAttribute('data-idbarang');
        const namaBarang = btn.getAttribute('data-namabarang');
        const namaMerk = btn.getAttribute('data-namamerk');
        const spesifikasi = btn.getAttribute('data-spesifikasi');
        const qty = btn.getAttribute('data-qty') || 1;
        const harga = btn.getAttribute('data-harga') || 0;
        const final = btn.getAttribute('data-final') || (qty * harga);
        const keterangan = btn.getAttribute('data-keterangan');

        document.getElementById('editForm').action = '/harga-dasar/edit/' + id;
        document.getElementById('editTanggal').value = tanggal || '';
        document.getElementById('editIdBarang').value = idBarang;
        document.getElementById('editNamaBarang').value = namaBarang;
        document.getElementById('editNamaMerk').value = namaMerk || '';
        document.getElementById('editSpesifikasi').value = spesifikasi || '';
        document.getElementById('editQty').value = qty;
        document.getElementById('editHarga').value = harga;
        document.getElementById('editFinal').value = final;
        document.getElementById('editKeterangan').value = keterangan || '';
        document.getElementById('editItemModal').style.display = 'flex';
      }

      function closeEditModal() {
        document.getElementById('editItemModal').style.display = 'none';
      }

      function openEditProjectModal(btn) {
        const id = btn.getAttribute('data-id');
        const nama = btn.getAttribute('data-nama');
        const opr = btn.getAttribute('data-opr');
        const trf = btn.getAttribute('data-trf');

        document.getElementById('editProjectForm').action = '/harga-dasar/project/edit/' + id;
        document.getElementById('editNamaProject').value = nama;
        document.getElementById('editBiayaOperasional').value = opr;
        document.getElementById('editBiayaTransfer').value = trf;
        document.getElementById('editProjectModal').style.display = 'flex';
      }

      function closeEditProjectModal() {
        document.getElementById('editProjectModal').style.display = 'none';
      }
    </script>
  </body>
</html>
