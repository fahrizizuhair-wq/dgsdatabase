<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Katalog Harga Dasar - User</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: 100%; height: 100%; overflow-x: hidden; }
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; color: #333; display: flex; min-height: 100vh;
      position: relative; background-color: #f4f6f9;
    }
    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(to bottom, rgba(122, 27, 27, 0.85) 0%, rgba(122, 27, 27, 0.1) 40%, rgba(244, 246, 249, 0.88) 100%), 
                  url('/images/background.jpg') no-repeat center top fixed;
      background-size: cover; z-index: -1; pointer-events: none;
    }
    
   /* Sidebar Styling */
    .sidebar-overlay { 
      display: none; 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 100vw; 
      height: 100vh; 
      background: rgba(15, 23, 42, 0.55); 
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 999; 
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .sidebar-overlay.active { 
      display: block; 
      opacity: 1;
    }

    /* SIDEBAR */
    .sidebar { 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 280px; 
      height: 100vh; 
      background: linear-gradient(180deg, #4d0e0e 0%, #7a1b1b 50%, #3e0b0b 100%);
      color: white; 
      padding: 28px 22px; 
      display: flex; 
      flex-direction: column; 
      justify-content: space-between; 
      z-index: 1000; 
      transform: translateX(-100%); 
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); 
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.25); 
      overflow-y: auto;
    }
    .sidebar.active { transform: translateX(0); }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 25px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-logo-img {
      width: 42px;
      height: 42px;
      object-fit: contain;
      background: rgba(255, 255, 255, 0.12);
      padding: 5px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .brand-text h2 {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }
    .brand-text span {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 600;
    }
    .close-sidebar-btn {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: white;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 16px;
      transition: all 0.2s;
    }
    .close-sidebar-btn:hover { background: rgba(255, 255, 255, 0.2); }

    .sidebar-user-card {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 12px 14px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .user-avatar-circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #c9933b 0%, #7a1b1b 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }
    .sidebar-user-info h4 {
      font-size: 13px;
      font-weight: 600;
      color: white;
    }
    .sidebar-user-info span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: #86efac;
      font-weight: 500;
    }
    .sidebar-user-info span::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 6px #22c55e;
    }

    .nav-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: rgba(255, 255, 255, 0.5);
      margin: 10px 0 10px 8px;
    }
    .nav-menu { 
      list-style: none; 
      display: flex; 
      flex-direction: column; 
      gap: 6px; 
    }
    .nav-item a { 
      display: flex; 
      align-items: center;
      gap: 12px;
      padding: 11px 14px; 
      color: rgba(255, 255, 255, 0.82); 
      text-decoration: none; 
      border-radius: 10px; 
      font-weight: 500; 
      font-size: 13.5px; 
      transition: all 0.2s ease;
    }
    .nav-item a svg {
      width: 18px;
      height: 18px;
      opacity: 0.8;
      transition: transform 0.2s;
    }
    .nav-item a:hover { 
      background-color: rgba(255, 255, 255, 0.12); 
      color: #ffffff; 
      transform: translateX(3px);
    }
    .nav-item a:hover svg {
      opacity: 1;
      transform: scale(1.1);
    }
    .nav-item.active a { 
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.12) 100%); 
      color: #ffffff; 
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      border-left: 3px solid #f87171;
    }
    .nav-item.active a svg { opacity: 1; }

    /* DROPDOWN SIDEBAR */
    .nav-item.dropdown { position: relative; }
    .dropdown-toggle { 
      display: flex !important; 
      justify-content: space-between; 
      align-items: center; 
      cursor: pointer;
    }
    .dropdown-toggle-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .dropdown-toggle .arrow { 
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
      font-size: 11px; 
      opacity: 0.8;
    }
    .dropdown-menu {
      list-style: none; 
      max-height: 0; 
      overflow: hidden; 
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      background-color: rgba(50, 10, 10, 0.45); 
      border-radius: 10px; 
      margin-top: 4px; 
      padding-left: 10px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .dropdown-menu li a { 
      padding: 9px 14px; 
      font-size: 13px; 
      color: rgba(255, 255, 255, 0.75); 
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .dropdown-menu li a:hover { 
      color: #ffffff; 
      background-color: rgba(255, 255, 255, 0.08); 
    }
    .nav-item.dropdown.active .dropdown-menu { 
      max-height: 200px; 
      padding-top: 6px;
      padding-bottom: 6px;
    }
    .nav-item.dropdown.active .arrow { transform: rotate(180deg); }

    .sidebar-footer { 
      display: flex; 
      flex-direction: column; 
      gap: 10px; 
      margin-top: 25px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .btn-bottom {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      color: rgba(255, 255, 255, 0.8);
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 500;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .btn-bottom:hover {
      background: rgba(255, 255, 255, 0.1);
      color: white;
    }

    /* MAIN CONTENT */
    .main-content { flex: 1; padding: 30px; width: 100%; overflow-x: auto; }
    .header-section h1 { font-size: 28px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .header-section p { color: #ffffff; }
    
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin: 25px 0; }
    .card { 
      background: rgba(255, 255, 255, 0.95); padding: 20px; border-radius: 12px; 
      border: 1px solid #eef0f4; backdrop-filter: blur(5px); min-height: 120px; 
      display: flex; flex-direction: column; justify-content: center;
    }
    .card-title { font-size: 14px; color: #666; margin-bottom: 8px; }
    .card-value { font-size: 26px; font-weight: 700; color: #7a1b1b; }
    .card-value1 { font-size: 26px; font-weight: 700; color: #1fbc53; }

    /* TABLE STYLING */
    .table-container { background: rgba(255, 255, 255, 0.95); border-radius: 12px; padding: 24px; border: 1px solid #eef0f4; backdrop-filter: blur(5px); overflow-x: auto; }
    .table-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
    .table-header h2 { color: #7a1b1b; margin-right: auto; }
    .search-input { padding: 10px 14px; border: 1px solid #dde1e5; border-radius: 8px; font-size: 14px; outline: none; width: 260px; background: white; }
    .btn-add { background-color: #7a1b1b; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .btn-add:hover { background-color: #5c1313; }

    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 900px; }
    th, td { padding: 12px 14px; border-bottom: 1px solid #edf0f2; font-size: 13px; vertical-align: top; }
    th { background-color: #f8f9fa; color: #555; }

    .item-row { transition: background-color 0.2s ease; }
    .item-row:hover { background-color: #f8eded; }
    .col-keterangan { max-width: 150px; white-space: normal; word-wrap: break-word; overflow-wrap: break-word; }

    /* BADGES STATUS */
    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .badge-setuju { background-color: #e6f4ea; color: #137333; }
    .badge-pending { background-color: #fef7e0; color: #b06000; }
    .badge-tidak { background-color: #fce8e6; color: #c5221f; }

    /* MODAL FORM TAMBAH */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
    .modal-content { background: white; padding: 30px; border-radius: 12px; width: 450px; max-height: 85vh; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 5px; }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-family: inherit; }
    
    textarea.input-lg { width: 100%; min-height: 100px; padding: 10px; font-size: 13px; font-family: inherit; border: 1.5px solid #ccc; border-radius: 8px; box-sizing: border-box; resize: vertical; }
    textarea.input-lg:focus { border-color: #7a1b1b; outline: none; }

    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
    .btn-cancel { background: #e0e0e0; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: 600; }
    .btn-cancel:hover { background: #d0d0d0; }

    .toggle-btn { font-size: 20px; background: #ffffff; color: rgb(0, 0, 0); border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }

    /* ==========================================
   RESPONSIF MOBILE (Layar di bawah 768px)
   ========================================== */
@media (max-width: 768px) {
  /* 1. Sesuaikan Padding Kontainer Utama */
  .header-container, 
  .stats-grid, 
  .main-box,
  .middle-grid {
    padding-left: 16px !important;
    padding-right: 16px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  /* 2. Kartu Statistik Menjadi 1 Kolom ke Bawah */
  .stats-grid, 
  .middle-grid {
    grid-template-columns: 1fr !important; /* Bertumpuk vertikal */
    gap: 12px !important;
  }

  /* 3. Banner Salam / Top Header */
  .box-header,
  .actions-toolbar {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
  }

  .search-input {
    width: 100% !important; /* Input pencarian memenuhi layar */
  }

  /* 4. Tabel Agar Bisa Di-scroll Horizontal di HP */
  .main-box {
    overflow-x: auto !important; /* Mencegah tabel merusak lebar layar */
  }

  table {
    min-width: 600px; /* Menjaga ukuran isi tabel tetap terbaca */
  }

  /* 5. Ukuran Judul & Teks yang Lebih Pas di HP */
  h1 {
    font-size: 22px !important;
  }
  
  .stat-value {
    font-size: 22px !important;
  }
}

  </style>
</head>
