  <main class="main-content">
    <button class="toggle-btn" onclick="toggleSidebar()">☰</button>

    <header class="header-section">
      <h1>Katalog Harga Dasar</h1>
      <p>Lihat dan tambahkan kalkulasi harga barang serta material dasar.</p>
    </header>

    <section class="cards-grid">
      <div class="card">
        <div class="card-title">Total Item Harga Dasar</div>
        <div class="card-value"><%= typeof totalItem !== 'undefined' ? totalItem : 0 %> Item</div>
      </div>
      <div class="card">
        <div class="card-title">Status Data</div>
        <div class="card-value1">Sinkron</div>
      </div>
    </section>

    <section class="table-container">
      <div class="table-header">
        <h2>Daftar Harga Barang</h2>
        <input type="text" id="searchInput" class="search-input" placeholder="Cari barang..." onkeyup="filterItem()">
        <button class="btn-add" onclick="openModal()">+ Tambah Harga Dasar</button>
        <a href="/export-harga-dasar-excel" style="padding: 10px 18px; background-color: #1d6f42; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(29, 111, 66, 0.2);">
          <i class="fa-solid fa-file-excel"></i> Export Excel
        </a>
      </div>

          <table id="itemTable">
            <thead>
              <tr>
                <th>Tanggal</th>
                <th>ID Barang</th>
                <th>Nama Barang</th>
                <th>Merk</th>
                <th>Spesifikasi</th>
                <th>Stok</th>
                <th>Harga Satuan</th>
                <th>Final Price</th>
                <th>Waktu Produksi</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (!items || items.length === 0) { %>
                <tr>
                  <td colspan="10" style="text-align: center; padding: 20px; color: #888;">Belum ada data harga dasar.</td>
                </tr>
              <% } else { %>
                <% items.forEach(function(item) { %>
                  <!-- Tambahkan onclick, cursor pointer, dan efek hover tipis jika mau -->
                  <tr class="item-row" onclick="window.location.href='/harga-dasar/detail/<%= item._id %>'" style="cursor: pointer;" title="Klik untuk melihat detail barang">
                    <td><%= item.tanggal ? new Date(item.tanggal).toLocaleDateString('id-ID') : '-' %></td>
                    <td><strong><%= item.idBarang %></strong></td>
                    <td>
                      <!-- Atau jika ingin link khusus di nama barang saja tanpa seluruh baris diklik: -->
                      <span style="color: #7a1b1b; font-weight: 600;"><%= item.namaBarang %></span>
                    </td>
                    <td><%= item.namaMerk || '-' %></td>
                    <td><%= item.spesifikasi || '-' %></td>
                    <td><%= item.qty %></td>
                    <td><strong>Rp <%= Number(item.harga || 0).toLocaleString('id-ID') %></strong></td>
                    <td><strong style="color: #7a1b1b;">Rp <%= Number(item.final || 0).toLocaleString('id-ID') %></strong></td>
                    <td class="col-keterangan"><%= item.keterangan || '-' %></td>
                    <td>
                      <span class="badge <%= item.status === 'Ready' ? 'badge-setuju' : (item.status === 'Pending' ? 'badge-pending' : 'badge-tidak') %>">
                        <%= item.status || 'Pending' %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
    </section>
  </main>

  <!-- MODAL TAMBAH HARGA DASAR KHUSUS USER -->
  <div class="modal" id="itemModal">
    <div class="modal-content">
      <h3 style="margin-bottom: 15px; color: #7a1b1b;">Tambah Harga Dasar Baru</h3> 
      <form action="/harga-dasar-user/add" method="POST">
        <div class="form-group"><label>Tanggal</label><input type="date" name="tanggal" required></div>
        <div class="form-group"><label>ID Barang</label><input type="text" name="idBarang" placeholder="BRG-001" required></div>
        <div class="form-group"><label>Nama Barang</label><input type="text" name="namaBarang" placeholder="Masukan Nama Barang" required></div>
        <div class="form-group"><label>Merk</label><input type="text" name="namaMerk" placeholder="Nama Merk" required></div>
        <div class="form-group"><label>Spesifikasi</label><input type="text" name="spesifikasi" placeholder="Ukuran / Bahan"></div>
        <div class="form-group"><label>Stok</label><input type="number" name="qty" value="1" min="1" required></div>
        <div class="form-group"><label>Harga (Satuan Dasar)</label><input type="number" name="harga" placeholder="0" required></div>
        <div class="form-group"><label>Final Price</label><input type="number" name="final" placeholder="0" required></div>
        <div class="form-group"><label>Waktu Produksi</label><textarea name="keterangan" class="input-lg" placeholder="Catatan tambahan..."></textarea></div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="Ready">Ready</option>
            <option value="Pending" selected>Pending</option>
            <option value="Tidak Ready">Tidak Ready</option>
          </select>
        </div>
        <div class="form-group">
          <label>Foto Vendor / Produk (Opsional, bisa pilih lebih dari satu)</label>
          <input type="file" name="foto" accept="image/*" multiple>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeModal()">Batal</button>
          <button type="submit" class="btn-add">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() { document.getElementById('itemModal').style.display = 'flex'; }
    function closeModal() { document.getElementById('itemModal').style.display = 'none'; }

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
      document.getElementById('sidebarOverlay').classList.toggle('active');
    }

    function filterItem() {
      const input = document.getElementById('searchInput').value.toLowerCase();
      const rows = document.getElementsByClassName('item-row');
      for (let row of rows) {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
      }
    }

    function toggleDropdown(element) {
      const parentLi = element.parentElement;
      parentLi.classList.toggle('active');
    }
  </script>
</body>
</html>