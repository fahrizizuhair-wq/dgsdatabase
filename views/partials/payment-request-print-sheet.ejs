<%
  /* ===== Helper format ===== */
  function escPR(teks) {
    return String(teks == null ? '' : teks)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function angkaPR(nilai) {
    return new Intl.NumberFormat('id-ID', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(Number(nilai) || 0);
  }

  /* Format akuntansi ala Excel: "Rp" rata kiri, angka rata kanan dalam satu sel */
  function rpAkunPR(nilai, tebal) {
    var isi = '<span>Rp</span><span>' + angkaPR(nilai) + '</span>';
    return '<span class="acc' + (tebal ? ' acc-bold' : '') + '">' + isi + '</span>';
  }

  /* Format "Rp  1.500.000" untuk baris Cost Summary */
  function rpRingkasPR(nilai) {
    return '<strong>Rp&nbsp;&nbsp;' + angkaPR(nilai) + '</strong>';
  }

  function tanggalPR(nilai) {
    if (!nilai) return '-';
    var t = new Date(nilai);
    if (isNaN(t.getTime())) return String(nilai);
    return t.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function teksPR(nilai, pengganti) {
    var hasil = String(nilai == null ? '' : nilai).trim();
    return hasil || (pengganti || '-');
  }

  /* Rekening tujuan: "Bank BCA" / nomor (tebal) / "a.n Nama" seperti di Excel */
  function rekeningHtmlPR(nilai) {
    var teks = String(nilai == null ? '' : nilai).trim();
    if (!teks) return '-';
    teks = teks.replace(/\s+(?=a\.?\s?\/?n\.?\s)/i, '\n');
    var baris = teks.split(/\r?\n/).map(function (b) {
      var aman = escPR(b.trim());
      aman = aman.replace(/\s*[-–]\s*(\d{6,})/g, ' $1').replace(/\s*[-–]\s*$/, '');
      return aman.replace(/(\d{6,})/g, '<strong class="no-rek">$1</strong>');
    });
    return baris.filter(Boolean).map(function (b) { return '<div>' + b + '</div>'; }).join('');
  }

  /* Pisahkan nama vendor dan PIC supaya PIC tampil di baris kedua */
  function vendorBagianPR(p) {
    var nama = teksPR(p && p.vendorName);
    var pic = String((p && p.pic) || '').trim();
    var idx = nama.search(/PIC\s*:/i);
    if (idx > 0) {
      pic = nama.slice(idx).trim();
      nama = nama.slice(0, idx).trim();
    } else if (pic && pic !== '-') {
      pic = /^pic/i.test(pic) ? pic : 'PIC: ' + pic;
    } else {
      pic = '';
    }
    return { nama: nama, pic: pic };
  }

  function warnaGrupPR(indeks) {
    var daftar = ['#D9EAD3', '#E6B8AF', '#FFE599', '#EAD1DC'];
    return daftar[indeks % daftar.length];
  }

  /* ===== Data ===== */
  var dcCetak = dataCetak || {};
  var penerimaCetak = dcCetak.penerima || [];
  var kasbonCetak = dcCetak.kasbonItems || dcCetak.itemsSemua || [];
  var aktualCetak = dcCetak.aktualItems || dcCetak.itemsSemua || [];
  var totalKasbonCetak = kasbonCetak.reduce(function (jumlah, it) {
    return jumlah + (Number(it.total) || 0);
  }, 0) || Number(dcCetak.grandTotal) || 0;
  var totalAktualCetak = aktualCetak.reduce(function (jumlah, it) {
    return jumlah + (Number(it.total) || 0);
  }, 0) || Number(dcCetak.grandTotal) || 0;
  var namaPemohonCetak =
    (pengajuan && (pengajuan.pemohon || pengajuan.diinputOleh)) ||
    (dcCetak.info && dcCetak.info.namaLpj) || 'Admin';

  function ketAktualPR(it) {
    var qty = (Number(it.qty) || 1) + ' pcs';
    var v = String(it.vendor == null ? '' : it.vendor).trim();
    return v && v !== '-' ? qty + '  (' + v + ')' : qty;
  }
%>
<style>
  @page {
    size: A4 portrait;
    margin: 8mm;
  }

  .pr-print-sheet,
  .pr-print-sheet * {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    box-sizing: border-box;
  }

  .pr-print-sheet {
    color: #000;
    background: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9pt;
    line-height: 1.25;
    width: 100%;
  }

  .pr-print-sheet table {
    border-collapse: collapse;
    width: 100%;
    table-layout: fixed;
  }

  /* Lebar kolom mengikuti Excel: A=16, B=1.5, C=28.38, D=7.75, E=12.88, F=18.75, G=20.13 */
  .pr-print-sheet col.col-a { width: 15.2%; }
  .pr-print-sheet col.col-b { width: 1.4%; }
  .pr-print-sheet col.col-c { width: 26.9%; }
  .pr-print-sheet col.col-d { width: 7.3%; }
  .pr-print-sheet col.col-e { width: 12.2%; }
  .pr-print-sheet col.col-f { width: 17.9%; }
  .pr-print-sheet col.col-g { width: 19.1%; }

  /* Kop */
  .pr-print-sheet .logo-band { padding: 2px 0 0; }
  .pr-print-sheet .logo-band img { width: 100%; height: auto; display: block; }
  .pr-print-sheet .blue-band { height: 5px; background: #CFE2F3; padding: 0; }
  .pr-print-sheet .title-pr {
    text-align: center;
    font-size: 11pt;
    font-weight: 700;
    padding: 10px 0 12px;
  }

  /* Informasi & ringkasan per penerima */
  .pr-print-sheet .info-cell { padding: 1px 3px; vertical-align: top; }
  .pr-print-sheet .info-label { white-space: nowrap; }
  .pr-print-sheet .group-cell { padding: 1px 3px; vertical-align: top; }
  .pr-print-sheet .group-bold { font-weight: 700; }
  .pr-print-sheet .italic { font-style: italic; }
  .pr-print-sheet .pre-line { white-space: pre-line; }

  /* Format akuntansi (Rp kiri, angka kanan) */
  .pr-print-sheet .acc {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    white-space: nowrap;
  }
  .pr-print-sheet .acc-bold { font-weight: 700; }

  /* Tabel rincian biaya */
  .pr-print-sheet .items {
    margin-top: 8px;
    font-size: 8.5pt;
    border: 2px solid #000;
  }
  .pr-print-sheet .items th,
  .pr-print-sheet .items td {
    border: 1px solid #000;
    padding: 2px 4px;
    vertical-align: middle;
  }
  .pr-print-sheet .items thead th {
    border-width: 2px;
    text-align: center;
    font-weight: 700;
    padding: 6px 4px;
  }
  .pr-print-sheet .items .vendor-cell { vertical-align: top; }
  .pr-print-sheet .items .vendor-cell strong { font-weight: 700; }
  .pr-print-sheet .items .total-row td {
    border-top-width: 2px;
    border-bottom-width: 2px;
    font-weight: 700;
  }
  .pr-print-sheet .items .rek-cell {
    text-align: center;
    vertical-align: middle;
    padding: 4px;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .pr-print-sheet .items .rek-cell .no-rek { display: block; font-weight: 700; }
  .pr-print-sheet .center { text-align: center; }
  .pr-print-sheet .right { text-align: right; white-space: nowrap; }
  .pr-print-sheet .wrap { word-wrap: break-word; overflow-wrap: break-word; }

  .pr-print-sheet .ttd-wrap { break-inside: avoid; page-break-inside: avoid; }
  .pr-print-sheet .block { break-inside: avoid; page-break-inside: avoid; }

  /* Tanda tangan: kolom A-C | D-F | G */
  .pr-print-sheet .ttd { margin-top: 10px; font-size: 9pt; }
  .pr-print-sheet .ttd td { vertical-align: top; padding: 0 3px; text-align: left; }
  .pr-print-sheet .ttd .ruang { height: 62px; }
  .pr-print-sheet .ttd .nama { font-weight: 700; text-decoration: underline; }
  .pr-print-sheet .ttd col.t1 { width: 43.5%; }
  .pr-print-sheet .ttd col.t2 { width: 37.4%; }
  .pr-print-sheet .ttd col.t3 { width: 19.1%; }

  /* Blok bawah (lebar mengikuti kolom A-E = 63% halaman) */
  .pr-print-sheet .block { margin-top: 16px; width: 63%; }
  .pr-print-sheet .block-title { font-weight: 700; font-size: 9pt; margin-bottom: 4px; }
  .pr-print-sheet .simple { font-size: 8.5pt; border: 1px solid #000; }
  .pr-print-sheet .simple td,
  .pr-print-sheet .simple th { padding: 2px 4px; vertical-align: middle; }
  .pr-print-sheet .simple col.s-a { width: 40%; }
  .pr-print-sheet .simple col.s-b { width: 34%; }
  .pr-print-sheet .simple col.s-c { width: 26%; }
  .pr-print-sheet .simple thead th {
    border: 1px solid #000;
    text-align: center;
    font-weight: 700;
  }
  .pr-print-sheet .simple .total td {
    font-weight: 700;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
  }
  .pr-print-sheet .kuning { background: #FFFF00; }
  .pr-print-sheet .kream { background: #FFF2CC; }
  .pr-print-sheet .group-bold { font-weight: 700; }
  .pr-print-sheet .merah { color: #FF0000; font-weight: 700; }
  .pr-print-sheet .blok-sambung { margin-top: 0; border-top: 0; }

  @media print {
    .pr-print-sheet tr { page-break-inside: avoid; }
    .pr-print-sheet .items thead { display: table-header-group; }
  }
</style>

<div class="pr-print-sheet">
  <table>
    <colgroup>
      <col class="col-a" /><col class="col-b" /><col class="col-c" />
      <col class="col-d" /><col class="col-e" /><col class="col-f" /><col class="col-g" />
    </colgroup>
    <tbody>
      <tr>
        <td colspan="7" class="logo-band">
          <img src="/images/pr-logo.png" alt="PT Dian Giri Saputra" />
        </td>
      </tr>
      <tr><td colspan="7" class="blue-band"></td></tr>
      <tr><td colspan="7" class="title-pr">Payment Request</td></tr>

      <tr>
        <td class="info-cell info-label">Pekerjaan</td>
        <td class="info-cell">:</td>
        <td colspan="5" class="info-cell"><%= teksPR(dcCetak.pekerjaan) %></td>
      </tr>
      <tr>
        <td class="info-cell info-label">Est. Transfer</td>
        <td class="info-cell">:</td>
        <td colspan="5" class="info-cell"><%= teksPR(dcCetak.estTransfer) %></td>
      </tr>
      <tr>
        <td class="info-cell info-label">Lokasi</td>
        <td class="info-cell">:</td>
        <td colspan="5" class="info-cell"><%= teksPR(dcCetak.lokasi) %></td>
      </tr>
      <tr>
        <td class="info-cell info-label">Detail</td>
        <td class="info-cell">:</td>
        <td colspan="5" class="info-cell"><%= teksPR(dcCetak.detail) %></td>
      </tr>

      <% penerimaCetak.forEach(function (p, indeks) { %>
        <tr style="background: <%= warnaGrupPR(indeks) %>">
          <td colspan="7" class="group-cell group-bold"><%= p.no || indeks + 1 %>. <%= teksPR(p.summaryTitle) %></td>
        </tr>
        <tr style="background: <%= warnaGrupPR(indeks) %>">
          <td class="group-cell">Cost Summary</td>
          <td class="group-cell">:</td>
          <td class="group-cell"><%- rpRingkasPR(p.total) %></td>
          <td colspan="4" class="group-cell italic"><%= teksPR(p.terbilang) %></td>
        </tr>
        <tr style="background: <%= warnaGrupPR(indeks) %>">
          <td class="group-cell">Bank/No. Rek</td>
          <td class="group-cell">:</td>
          <td colspan="5" class="group-cell"><%= teksPR(String(p.rekening == null ? '' : p.rekening).replace(/\s*\r?\n\s*/g, ' ')) %></td>
        </tr>
      <% }) %>

      <tr>
        <td class="info-cell info-label">Lampiran</td>
        <td class="info-cell">:</td>
        <td colspan="5" class="info-cell pre-line"><%= teksPR(dcCetak.lampiran) %></td>
      </tr>
    </tbody>
  </table>

  <table class="items">
    <colgroup>
      <col class="col-a" /><col class="col-b" /><col class="col-c" />
      <col class="col-d" /><col class="col-e" /><col class="col-f" /><col class="col-g" />
    </colgroup>
    <thead>
      <tr>
        <th>No</th>
        <th colspan="2">Deskripsi</th>
        <th>Qty</th>
        <th>Harga Satuan</th>
        <th>Total Harga</th>
        <th>Rekening Tujuan</th>
      </tr>
    </thead>
    <tbody>
      <% if (!penerimaCetak.length) { %>
        <tr><td colspan="7" class="center">Belum ada rincian biaya.</td></tr>
      <% } %>
      <% penerimaCetak.forEach(function (p, indeks) { %>
        <%
          var daftarItem = (p.items && p.items.length) ? p.items : null;
          var jumlahBaris = daftarItem ? daftarItem.length : 1;
          var warna = warnaGrupPR(indeks);
          var vendor = vendorBagianPR(p);
        %>
        <tr>
          <td rowspan="<%= jumlahBaris + 1 %>" class="center" style="font-weight:700"><%= p.no || indeks + 1 %></td>
          <td colspan="5" class="vendor-cell wrap">
            <strong><%= vendor.nama %></strong>
            <% if (vendor.pic) { %><br><%= vendor.pic %><% } %>
          </td>
          <td rowspan="<%= jumlahBaris + 2 %>" class="rek-cell"><%- rekeningHtmlPR(p.rekening) %></td>
        </tr>
        <% if (!daftarItem) { %>
          <tr>
            <td colspan="2" class="wrap">-</td>
            <td class="center">1</td>
            <td><%- rpAkunPR(p.total) %></td>
            <td><%- rpAkunPR(p.total) %></td>
          </tr>
        <% } else { %>
          <% daftarItem.forEach(function (it) { %>
            <tr>
              <td colspan="2" class="wrap"><%= teksPR(it.desc) %></td>
              <td class="center"><%= it.qty %></td>
              <td><%- rpAkunPR(it.price) %></td>
              <td><%- rpAkunPR(it.total) %></td>
            </tr>
          <% }) %>
        <% } %>
        <tr class="total-row" style="background: <%= warna %>">
          <td colspan="5" class="center">Total Pembayaran</td>
          <td><%- rpAkunPR(p.total, true) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="ttd-wrap">
  <table class="ttd">
    <colgroup><col class="t1" /><col class="t2" /><col class="t3" /></colgroup>
    <tbody>
      <tr>
        <td>Mengajukan,</td>
        <td>Approved by,</td>
        <td>Mengetahui,</td>
      </tr>
      <tr>
        <td class="ruang"><%= tanggalPR(pengajuan && (pengajuan.tanggalPengajuan || pengajuan.createdAt)) %></td>
        <td class="ruang">&nbsp;</td>
        <td class="ruang">&nbsp;</td>
      </tr>
      <tr>
        <td class="nama"><span style="text-decoration: underline"><%= teksPR(namaPemohonCetak) %></span></td>
        <td class="nama"><span style="text-decoration: underline">Dani Kurniawan</span></td>
        <td class="nama"><span style="text-decoration: underline">Nila Akbaria</span></td>
      </tr>
      <tr>
        <td>Admin</td>
        <td>Koordinator<br>Tim Pengadaan</td>
        <td>Direktur</td>
      </tr>
    </tbody>
  </table>
  </div>

  <div class="block">
    <div class="block-title">Rincian Pengeluaran</div>
    <table class="simple">
      <colgroup><col class="s-a" /><col class="s-b" /><col class="s-c" /></colgroup>
      <thead>
        <tr class="kuning">
          <th colspan="2">Keterangan</th>
          <th>Nominal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="2">1. Anggaran Pengadaan<%= dcCetak.info && dcCetak.info.namaLpj ? ' (' + dcCetak.info.namaLpj + ')' : '' %></td>
          <td><%- rpAkunPR(dcCetak.anggaran) %></td>
        </tr>
        <% penerimaCetak.forEach(function (p, i) { %>
          <tr>
            <td colspan="2"><%= i + 2 %>. <%= teksPR(p.summaryTitle) %></td>
            <td><%- rpAkunPR(p.total) %></td>
          </tr>
        <% }) %>
        <tr><td colspan="3" style="height: 10px"></td></tr>
        <tr class="kuning total">
          <td colspan="2">Sisa Anggaran</td>
          <td><%- rpAkunPR(dcCetak.sisaAnggaran, true) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="block">
    <table class="simple">
      <colgroup><col class="s-a" /><col class="s-b" /><col class="s-c" /></colgroup>
      <tbody>
        <tr>
          <td colspan="3" class="group-bold" style="border-bottom: 1px solid #000">Pengajuan Kasbon</td>
        </tr>
        <% kasbonCetak.forEach(function (it, i) { %>
          <tr>
            <td class="wrap"><%= i + 1 %>. <%= teksPR(it.desc) %></td>
            <td><%= Number(it.qty) || 1 %> pcs</td>
            <td><%- rpAkunPR(it.total) %></td>
          </tr>
        <% }) %>
        <% if (!kasbonCetak.length) { %>
          <tr><td>-</td><td></td><td><%- rpAkunPR(0) %></td></tr>
        <% } %>
        <tr class="total">
          <td colspan="2">Total kasbon</td>
          <td><%- rpAkunPR(totalKasbonCetak, true) %></td>
        </tr>

        <tr>
          <td colspan="3" class="group-bold" style="padding: 0">
            <span class="kream" style="display: inline-block; padding: 2px 4px">Aktual pengeluaran</span>
          </td>
        </tr>
        <% aktualCetak.forEach(function (it, i) { %>
          <tr>
            <td class="wrap"><%= i + 1 %>. <%= teksPR(it.desc) %></td>
            <td class="wrap"><%= ketAktualPR(it) %></td>
            <td><%- rpAkunPR(it.total) %></td>
          </tr>
        <% }) %>
        <% if (!aktualCetak.length) { %>
          <tr><td>-</td><td></td><td><%- rpAkunPR(0) %></td></tr>
        <% } %>
        <tr class="total">
          <td colspan="2">Total aktual pengeluaran</td>
          <td><%- rpAkunPR(totalAktualCetak, true) %></td>
        </tr>
        <tr class="merah">
          <td colspan="2" class="merah">Selisih kasbon dengan aktual</td>
          <td class="merah"><%- rpAkunPR(totalKasbonCetak - totalAktualCetak, true) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
