<%
  var _active = (typeof activePage !== 'undefined' && activePage) ? activePage : '';
  var _adminName = (typeof adminUser !== 'undefined' && adminUser) ? adminUser : 'Administrator';
  var _adminInitial = String(_adminName).trim().substring(0, 2).toUpperCase() || 'AD';
  var _stokActive = ['stok-masuk', 'stok-keluar', 'stok-opname', 'stok-gudang'].indexOf(_active) !== -1;
  var _laporanActive = ['laporan', 'surat-jalan', 'lpj'].indexOf(_active) !== -1;
  var _masterActive = ['vendor', 'data-vendor', 'data-kain'].indexOf(_active) !== -1;
  var _dashboardActive = ['dashboard-admin', 'dashboard'].indexOf(_active) !== -1;
%>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top-section">
    <div class="sidebar-header">
      <div class="brand-wrap">
        <img src="/images/dgs.png" alt="Logo DGS" class="brand-logo-img" onerror="this.style.display = 'none'" />
        <div class="brand-text">
          <h2>Dian Giri Saputra</h2>
          <span>Admin Database</span>
        </div>
      </div>
      <button class="close-sidebar-btn" onclick="toggleSidebar()" title="Tutup Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" 
        fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" 
        stroke-linejoin="round" class="lucide lucide-panel-left-close preview-icon">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/>
        <path d="m16 15-3-3 3-3"/></svg>
      </button>
    </div>

    <!-- Mini Profile Info Admin -->
    <div class="sidebar-user-card">
      <div class="user-avatar-circle"><%= _adminInitial %></div>
      <div class="sidebar-user-info">
        <h4><%= _adminName %></h4>
        <span>Admin Master Control</span>
      </div>
    </div>

    <div class="nav-label">Menu Administrasi</div>
    <ul class="nav-menu">
      <li class="nav-item <%= _dashboardActive ? 'active' : '' %>">
        <a href="/dashboard-admin">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Dashboard Admin</span>
        </a>
      </li>
      <li class="nav-item dropdown <%= _masterActive ? 'active' : '' %>">
        <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
          <div class="dropdown-toggle-left">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Master Data</span>
          </div>
          <span class="arrow">&#9662;</span>
        </a>
        <ul class="dropdown-menu">
          <li>
            <a href="/admin">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Data Vendor</span>
            </a>
          </li>
          <li>
            <a href="/data-kain-admin">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Data Kain</span>
            </a>
          </li>
        </ul>
      </li>
      <li class="nav-item <%= _active === 'harga-dasar' ? 'active' : '' %>">
        <a href="/harga-dasar">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Harga Sampel</span>
        </a>
      </li>

      <li class="nav-item <%= _active === 'pengajuan-harga' ? 'active' : '' %>">
        <a href="/pengajuan-harga">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" 
            stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card-check preview-icon">
            <path d="M12.5 19H4a2 2 0 01-2-2V7a2 2 0 012-2h16a2 2 0 012 2v4"/><path d="M2 10h20"/><path d="M6 14h2"/>
            <path d="m16 17 2 2 4-4"/>
          </svg>
          <span>Pengajuan Harga</span>
        </a>
      </li>

      <li class="nav-item <%= _active === 'catatan-keuangan' ? 'active' : '' %>">
        <a href="/catatan-keuangan">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-pie preview-icon">
          <path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/>
          <path d="M21.21 15.89A10 10 0 1 1 8 2.83"/></svg>
          <span>Catatan Keuangan</span>
        </a>
      </li>

      <li class="nav-item dropdown <%= _stokActive ? 'active' : '' %>">
        <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
          <div class="dropdown-toggle-left">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path>
