<%
  var _active = (typeof activePage !== 'undefined' && activePage) ? activePage : '';
  var _namaUser = (typeof user !== 'undefined' && user && (user.namaLengkap || user.username))
    ? (user.namaLengkap || user.username)
    : 'User';
  var _userInitial = (typeof user !== 'undefined' && user && user.username)
    ? user.username.substring(0, 2).toUpperCase()
    : 'DG';
  var _stokActive = ['stok-masuk', 'stok-keluar', 'stok-opname', 'stok-gudang'].indexOf(_active) !== -1;
  var _laporanActive = ['laporan', 'surat-jalan', 'lpj'].indexOf(_active) !== -1;
%>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top-section">
    <div class="sidebar-header">
      <div class="brand-wrap">
        <img src="/images/dgs.png" alt="Logo DGS" class="brand-logo-img" onerror="this.style.display = 'none'" />
        <div class="brand-text">
          <h2>Dian Giri Saputra</h2>
          <span>User Database</span>
        </div>
      </div>
      <button class="close-sidebar-btn" onclick="toggleSidebar()" title="Tutup Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" 
        fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" 
        stroke-linejoin="round" class="lucide lucide-panel-left-close preview-icon">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/>
        <path d="m16 15-3-3 3-3"/></svg>
      </button>
    </div>

    <!-- Mini Profile Info -->
    <div class="sidebar-user-card">
      <div class="user-avatar-circle"><%= _userInitial %></div>
      <div class="sidebar-user-info">
        <h4><%= _namaUser %></h4>
        <span>User Operasional</span>
      </div>
    </div>

    <div class="nav-label">Menu Navigasi</div>
    <ul class="nav-menu">
      <li class="nav-item <%= _active === 'dashboard' ? 'active' : '' %>">
        <a href="/dashboard">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Dashboard Utama</span>
        </a>
      </li>
      <li class="nav-item <%= _active === 'vendor' ? 'active' : '' %>">
        <a href="/user">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span>Data Vendor</span>
        </a>
      </li>
      <li class="nav-item <%= _active === 'harga-dasar' ? 'active' : '' %>">
        <a href="/harga-dasar-user">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span>Harga Dasar</span>
        </a>
      </li>
      <li class="nav-item dropdown <%= _stokActive ? 'active' : '' %>">
        <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
          <div class="dropdown-toggle-left">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span>Stok & Barang</span>
          </div>
          <span class="arrow">&#9662;</span>
        </a>
        <ul class="dropdown-menu">
          <li>
              <a href="/stok-masuk-user">
                <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" height="24" 
                viewBox="0 0 24 24" fill="none" 
                stroke="currentColor" stroke-width="2" 
                stroke-linecap="round" stroke-linejoin="round" 
                class="lucide lucide-package-plus preview-icon">
                <path d="M12 22V12"/><path d="M16 17h6"/>
                <path d="M19 14v6"/><path d="M21 10.535V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.675-.955"/>
                <path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 8.997 5.148"/></svg>
                <span>Stok Masuk</span>
              </a>
            </li>
            <li>
              <a href="/stok-keluar-user">
                <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" height="24" 
                viewBox="0 0 24 24" fill="none" 
                stroke="currentColor" stroke-width="2" 
                stroke-linecap="round" stroke-linejoin="round" 
                class="lucide lucide-package-minus preview-icon">
                <path d="M12 22V12"/><path d="M16 17h6"/><path d="M21 13V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.675-.955"/>
                <path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 8.997 5.148"/></svg>
                <span>Stok Keluar</span>
              </a>
            </li>
            <li>
              <a href="/stok-opname-user">
                <svg xmlns="http://www.w3.org/2000/svg" 
                width="24" height="24" viewBox="0 0 24 24" 
                fill="none" stroke="currentColor" 
                stroke-width="2" stroke-linecap="round" 
                stroke-linejoin="round" class="lucide lucide-package-check preview-icon"><path d="M12 22V12"/>
                <path d="m16 17 2 2 4-4"/><path d="M21 11.127V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.32-.753"/>
                <path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 8.997 5.148"/></svg>
                <span>Stok Opname</span>
              </a>
            </li>
            <li>
              <a href="/stok-gudang-user"><svg xmlns="http://www.w3.org/2000/svg" width="24" 
                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" 
                stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-door-closed-package preview-icon">
                <path d="M18 13v3"/><path d="M19 9V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"/><path d="M2 21h8"/><path 
                d="M9 12h.01"/><rect x="14" y="13" width="8" height="8" rx="1"/></svg>
                <span>Kelola Gudang</span></a>
            </li>
        </ul>
      </li>

      <!-- Menu Dropdown Laporan -->
      <li class="nav-item dropdown <%= _laporanActive ? 'active' : '' %>">
        <a href="javascript:void(0)" class="dropdown-toggle" onclick="toggleDropdown(this)">
          <div class="dropdown-toggle-left">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Laporan</span>
          </div>
          <span class="arrow">&#9662;</span>
        </a>
        <ul class="dropdown-menu">
          <li>
            <a href="/laporan-user">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Data Laporan</span>
            </a>
          </li>
          <li>
            <a href="/lpj-user">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>LPJ</span>
            </a>
          </li>
          <li>
            <a href="/surat-jalan-user">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>Surat Jalan</span>
            </a>
          </li>
        </ul>
      </li>

      <li class="nav-item <%= _active === 'data-kain' ? 'active' : '' %>">
        <a href="/data-bahan-kain">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shirt preview-icon"><path 
               d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
          <span>Data Kain</span>
        </a>
      </li>

      <li class="nav-item <%= _active === 'materi-approval' ? 'active' : '' %>">
        <a href="/materi-approval-user">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
          <span>Materi Approval</span>
        </a>
      </li>

      <li class="nav-item <%= _active === 'payment-request' ? 'active' : '' %>">
        <a href="/payment-request-user">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <path d="M2 10h20"></path>
          </svg>
          <span>Payment Request</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="sidebar-footer">
    <a href="/" class="btn-bottom">
      <svg xmlns="http://www.w3.org/2000/svg" 
      width="24" 
      height="24" 
      viewBox="0 0 24 24" 
      fill="none" 
      stroke="currentColor" 
      stroke-width="2" 
      stroke-linecap="round" 
      stroke-linejoin="round" 
      class="lucide lucide-square-arrow-left-exit preview-icon"
      ><path d="M13 12H3"/><path d="M3 17.67V19a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v1.33"/>
      <path d="m7 8-4 4 4 4"/></svg>
      <span>Keluar / Logout</span>
    </a>
  </div>
</aside>
